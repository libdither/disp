// The double-pass barrel: first pass raw (bind every definition, no checks),
// second pass checked (annotations verify and tests run with everything bound).
// Run this file to check the whole standalone kernel + library.
open use raw "../prelude.disp" {}
open use raw "kernel.disp" {}
open use raw "types.disp" {}
open use "kernel.disp" {}
open use "types.disp" {}
