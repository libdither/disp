// Dependent types with operators, no polymorphism: programs that build predicates from predicates.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../machine.disp" {}
open use raw "../claim.disp" {}
open use raw "../stream.disp" {}
open use raw "../tests/fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}
open use raw "cube.disp" {}

theory := corner([depd, oper])
test power(theory) = [true, false, true, true, false, false, true, false]
imp_self := lam(arrow(base, star), lam(base, arrow(app(tv(1), tv(0)), app(tv(1), tv(0)))))
test accepts(theory, pi(arrow(base, star), arrow(base, star)), imp_self) = "Proved"
// the built predicate computes while checking: at any x it is other -> other
built := lam(base, app(app(imp_self, family), tv(0)))
test accepts(theory, arrow(base, star), built) = "Proved"
use_built := lam(base, lam(app(app(imp_self, family), tv(0)), tv(0)))
test accepts(theory, pi(base, arrow(arrow(other, other), arrow(other, other))), use_built) = "Proved"
test accepts(theory, pi(base, arrow(arrow(other, base), arrow(other, base))), use_built).is_refuted = true
