open use raw "prelude.disp" {}

// LLMs may not comment in this file beyond this one; the code is meant to be self-explanatory.
// Comments are specifically only to be added, modified, and removed by human reviewers for their own understanding
// Unused-looking defs below may be compiler sugar targets looked up by name:
// make_record + list_const (record literals), Coproduct (sum literals), prod (match).

nil := t
cons := {h, tl} -> t h tl
list_const := {x} -> t t x
make_record := {names, payload} -> pair names payload
inj := {name, payload} -> pair name payload
Coproduct := {variants} -> variants
Tree := t
/// prod eliminator
prod := {table} -> (fix ({go, names, arms, v} ->
  if (is_leaf names) {
    if (is_leaf arms) { t } else { (pair_fst arms) (pair_snd v) }
  } else if (tree_eq (pair_fst names) (pair_fst v)) {
    (pair_fst arms) (pair_snd v)
  } else {
    go (pair_snd names) (pair_snd arms) v
  })) (pair_fst table) (pair_snd table)

wait_payload := {w} -> pair_snd (pair_snd w)
sig_of := {marker} -> pair_fst (wait marker t)
has_sig := {sig, v} -> and (is_fork v) (tree_eq (pair_fst v) sig)
tree_eq_sig := sig_of tree_eq

hyp_marker := {a, b} -> a
make_mark := {meta} -> wait hyp_marker meta
make_hyp := {ty, history} -> make_mark (pair ty history)
hyp_sig := sig_of hyp_marker
is_neutral := has_sig hyp_sig
neutral_type := {v} -> pair_fst (wait_payload v)
neutral_history := {v} -> pair_snd (wait_payload v)

invalid_marker := {a, b} -> b
invalid := {reason} -> wait invalid_marker reason
invalid_sig := sig_of invalid_marker
is_invalid := has_sig invalid_sig

member := fix ({self, node, xs} ->
  if (is_leaf xs) { false } else if (tree_eq node (pair_fst xs)) { true } else { self node (pair_snd xs) })
list_all := fix ({self, p, xs} ->
  if (is_leaf xs) { true } else { and (p (pair_fst xs)) (self p (pair_snd xs)) })
list_map := fix ({self, f, xs} ->
  if (is_leaf xs) { nil } else { cons (f (pair_fst xs)) (self f (pair_snd xs)) })
list_len := fix ({self, xs} ->
  if (is_leaf xs) { zero } else { succ (self (pair_snd xs)) })
list_snoc := fix ({self, xs, x} ->
  if (is_leaf xs) { cons x nil } else { cons (pair_fst xs) (self (pair_snd xs) x) })
list_zip := fix ({self, xs, ys} ->
  if (is_leaf xs) { nil } else { cons (pair (pair_fst xs) (pair_fst ys)) (self (pair_snd xs) (pair_snd ys)) })
list_apply := fix ({self, f, xs} ->
  if (is_leaf xs) { f } else { self (f (pair_fst xs)) (pair_snd xs) })

field_cell := fix ({self, r, name} -> {
  let names := pair_fst r
  let payloads := pair_snd r
  if (is_leaf names) { t }
  else if (tree_eq (pair_fst names) name) { pair_fst payloads }
  else { self (pair (pair_snd names) (pair_snd payloads)) name }
})
field := {r, name} -> pair_snd (field_cell r name)
field_or := {r, name, dflt} -> {
  let c := field_cell r name
  if (is_leaf c) { dflt } else { pair_snd c }
}

resumable := fix ({self, set, arg} -> (field set "recognize") (wait self set) arg)
make_type := {set} -> wait resumable set
type_recognizer := {T} -> field (wait_payload T) "recognize"
type_gate := {T} -> field (wait_payload T) "gate"
type_members := {T} -> field (wait_payload T) "members"
type_elim := {T} -> field (wait_payload T) "elim"
type_tele := {T} -> field (wait_payload T) "tele"
type_code := {T} -> field (wait_payload T) "code"

elim_marker := fix ({self, payload, arg} -> (pair_fst payload) (wait self payload) arg)
elim_of := {Ind, B} -> wait elim_marker (pair (type_elim Ind) (pair Ind B))
elim_raw := {E} -> pair_fst (wait_payload E)
elim_ind := {E} -> pair_fst (pair_snd (wait_payload E))
elim_motive := {E} -> pair_snd (pair_snd (wait_payload E))
elim_sig := sig_of elim_marker
is_elim_head := has_sig elim_sig
elim_arity := {E} -> list_len ((type_gate (elim_ind E)) (elim_ind E) (elim_motive E))

Obs := < App, Self, Prj : Tree >
Row := < Fresh : Tree, J : Tree >
PredType := {p} -> make_type ({ recognize := {_self, v} -> p v })
IsType := PredType (has_sig (sig_of resumable))
PiCode := {A, B} -> make_type ({ tele := pair (Fresh A) ({x} -> pair (J (pair App (B x))) ({_} -> nil)) })
AnyTree : IsType := PredType ({_v} -> true)
Sum := {variants} -> {
  let tags := list_map pair_fst variants
  let co := fix ({go, st, arg} -> {
    let args := list_snoc (pair_snd st) arg
    if (tree_eq (list_len args) (list_len variants)) { prod (pair tags args) (pair_fst st) } else { wait go (pair (pair_fst st) args) }
  })
  make_type ({
    recognize := {_self, v} -> and (is_fork v) (member (pair_fst v) tags)
    gate := {_Ind, B} -> list_map ({v} -> PiCode AnyTree ({p} -> B (inj (pair_fst v) p))) variants
    elim := {_self, v} -> wait co (pair v nil)
    code := variants
  })
}
case_of := {T, B, arms} -> {
  let tags := list_map pair_fst (type_code T)
  let dflt := field arms "_"
  let pick := {tg} -> {
    let a := field arms tg
    if (is_leaf a) { dflt } else { a }
  }
  if (and (list_all ({tg} -> not (is_leaf (pick tg))) tags)
          (list_all ({n} -> or (tree_eq n "_") (member n tags)) (pair_fst arms))) {
    let ordered := list_map pick tags
    {scr} -> list_apply ((elim_of T B) scr) ordered
  } else {
    {_scr} -> invalid arms
  }
}
RowType : IsType := Sum Row
ObsType : IsType := Sum Obs

Frame := < Acc : Tree, Elim : Tree >
is_acc := has_sig "Acc"
is_elim_frame := has_sig "Elim"
respond_face := {T, frame, self} -> {
  let rows := type_tele T
  if (is_fork rows) {
    (fix ({go, rows2} ->
      if (is_leaf rows2) { invalid frame } else {
        let tail := pair_snd rows2
        match (pair_fst rows2) : (case_of RowType ({_} -> AnyTree)) {
          Fresh ty => (if (is_acc frame) { invalid frame } else {
            match (pair_fst (tail frame)) {
              J ob cod => (match ob { App _ => (pair (cons (pair ty frame) nil) cod); _ => (invalid frame) })
              _ => (invalid frame)
            }
          })
          J ob ty => (match ob : (case_of ObsType ({_} -> AnyTree)) {
            Prj a => (match frame {
              Acc fa => (if (tree_eq a fa) { pair nil ty } else { go (tail (make_hyp ty (pair "Ob" (pair (Acc a) self)))) })
              _ => (invalid frame)
            })
            Self _ => (go (tail t))
            App _ => (invalid frame)
          })
        }
      })) rows
  } else {
    match frame {
      Elim E arms => {
        let g := type_gate T
        if (is_leaf g) { invalid frame }
        else if (and (tree_eq (elim_ind E) T) (tree_eq (elim_raw E) (type_elim T))) {
          let tys := g T (elim_motive E)
          if (tree_eq (list_len tys) (list_len arms)) {
            pair (list_zip tys arms) ((elim_motive E) self)
          } else { invalid frame }
        } else { invalid frame }
      }
      _ => (invalid frame)
    }
  }
}

Eff := < Pure : Tree, Op : Tree >
perform := {q, k} -> Op (pair q k)
handle := {h, m} -> {
  let ret := field h "return"
  let on_op := field h "op"
  (fix ({go, m2} -> match m2 {
    Pure x => (ret x)
    Op q k => (on_op q ({x} -> go (k x)))
    _ => (invalid m2)
  })) m
}

Ask := < Mint : Tree, Call : Tree, Judge : Tree, Read : Tree, Lift : Tree >
check := fix ({self, rows, f, prior} ->
  if (is_leaf rows) { Pure true } else {
    let tail := pair_snd rows
    match (pair_fst rows) : (case_of RowType ({_} -> AnyTree)) {
      Fresh ty => (perform (Mint (pair ty tail)) ({x} ->
        perform (Read x) ({xr} -> self (tail xr) f x)))
      J ob ty => (match ob : (case_of ObsType ({_} -> AnyTree)) {
        App _ => (perform (Call (pair f prior)) ({r} ->
          perform (Judge (pair ty r)) ({ok} ->
            if ok { perform (Read r) ({rr} -> self (tail rr) f prior) } else { Pure false })))
        Self _ => (perform (Judge (pair ty f)) ({ok} ->
          if ok { perform (Read f) ({fr} -> self (tail fr) f prior) } else { Pure false }))
        Prj a => (perform (Read f) ({fr} -> {
          let o := a fr
          perform (Lift o) ({lo} ->
            perform (Judge (pair ty lo)) ({ok} ->
              if ok { self (tail o) f prior } else { Pure false }))
        }))
      })
    }
  })

Tele := {table, tele} -> {
  let admit := field_or table "admit" ({_f} -> true)
  let lift := field_or table "lift" ({v} -> v)
  let fresh := field table "fresh"
  let apply := field_or table "apply" ({_chk, f, a} -> f a)
  let read := field_or table "read" ({v} -> v)
  let judge := field_or table "judge" ({_chk, _st, T, r} -> T r)
  let run := fix ({chk, st, rows, fV, prior} ->
    handle ({
      return := {b} -> {_s} -> b
      op := {q, resume} -> {s} -> (match q {
        Mint ty tail => {
          let points := fresh s ty tail
          if (is_leaf points) { false } else { list_all ({p} -> resume (pair_fst p) (pair_snd p)) points }
        }
        Call g x => (resume (apply chk g x) s)
        Judge ty v => (resume (judge chk s ty v) s)
        Read v => (resume (read v) s)
        Lift v => (resume (lift v) s)
      })
    }) (check rows fV prior) st)
  make_type ({ recognize := {_self, f} -> if (admit f) { run t tele (lift f) t } else { false }, tele })
}

Pi := {table, A, B} -> Tele table (type_tele (PiCode A B))
Sigma := {table, A, B} -> Tele table (pair (J (pair Self (PredType is_fork))) ({_} ->
  pair (J (pair (Prj pair_fst) A)) ({a} ->
  pair (J (pair (Prj pair_snd) (B a))) ({_} -> nil))))
Isect := {table, A, P} -> Tele table (pair (Fresh A) ({x} -> pair (J (pair Self (P x))) ({_} -> nil)))
Enum := ({ fresh := {st, ty, _tail} -> list_map ({a} -> pair a st) (type_members ty) })
Sampled := {samples} -> ({ fresh := {st, _ty, _tail} -> list_map ({a} -> pair a st) samples })

Meta := {
  let Value := < Conc : Tree, Neu : Tree, Stem : Tree, Fork : Tree, Poison : Tree, Chain : Tree >
  let vstem := {V} -> if let Conc c = V { Conc (t c) } else { Stem V }
  let vfork := {L, R} -> if let Conc lc = L { if let Conc rc = R { Conc (t lc rc) } else { Fork (pair L R) } } else { Fork (pair L R) }
  let readback := (fix ({rb, V} ->
    match V {
      Conc tr => tr
      Neu m => (make_mark m)
      Stem c => (t (rb c))
      Fork l r => (t (rb l) (rb r))
      Poison r => (invalid r)
      Chain e scr args => (invalid (pair e (pair scr args)))
    }))
  let collect := (fix ({co, V, acc} ->
    match V {
      Conc tr => acc
      Neu m => (cons (make_mark m) acc)
      Stem c => (co c acc)
      Fork l r => (co l (co r acc))
      Poison r => acc
      Chain e scr args => acc
    }))
  let verify_inband := (fix ({vf, minted, T, v} ->
    if (is_invalid v) {
      false
    } else if (is_neutral v) {
      and (tree_eq (neutral_type v) T) (member v minted)
    } else {
      (type_recognizer T) (wait (wait vf minted) T) v
    }))
  let vcheck := ({chk, T, V} ->
    match V {
      Poison r => false
      Neu ty _ => (tree_eq ty T)
      _ => {
        let rows := type_tele T
        if (is_fork rows) { chk t rows V t }
        else if let Conc tr = V { T tr }
        else { verify_inband (collect V nil) T (readback V) }
      }
    })
  let s_rule := ({self, chk, C, TB, X} -> self chk (self chk C X) (self chk TB X))
  let triage_case := ({self, chk, TC, TD, TB, X} ->
    match X {
      Conc xt => (triage TC ({u} -> self chk TD (Conc u)) ({l, r} -> self chk (self chk TB (Conc l)) (Conc r)) xt)
      Neu m => (if (and (tree_eq TC (Conc t)) (and (tree_eq TD (Conc t)) (tree_eq TB (Conc t)))) { Neu m } else { Poison (Neu m) })
      Stem c => (self chk TD c)
      Fork l r => (self chk (self chk TB l) r)
      Poison r => (Poison r)
      Chain e scr args => (Poison (Chain (pair e (pair scr args))))
    })
  let apply_fork := ({self, chk, A, TB, X} ->
    match A {
      Conc at => (if (is_leaf at) {
        TB
      } else if (is_stem at) {
        s_rule self chk (Conc (stem_child at)) TB X
      } else {
        triage_case self chk (Conc (pair_fst at)) (Conc (pair_snd at)) TB X
      })
      Stem c => (s_rule self chk c TB X)
      Fork tc td => (triage_case self chk tc td TB X)
      Neu m => (Poison (Neu m))
      Poison r => (Poison r)
      Chain e scr args => (Poison (Chain (pair e (pair scr args))))
    })
  let mwalk := (fix ({self, chk, F, X} ->
    if let Poison _ = X {
      X
    } else {
      match F {
        Conc tr => (if (tree_eq tr is_neutral) {
          Conc false
        } else if (or (tree_eq tr tree_eq) (has_sig tree_eq_sig tr)) {
          (if let Conc xt = X { Conc (tr xt) } else { Poison X })
        } else if let Conc xt = X {
          Conc (tr xt)
        } else if (or (tree_eq tr pair_fst) (tree_eq tr pair_snd)) {
          if let Neu m2 = X { self chk X (Conc (Acc tr)) } else { Poison X }
        } else if (is_elim_head tr) {
          if let Neu m = X { Chain (pair tr (pair X nil)) } else { self chk (Conc ((elim_raw tr) tr)) X }
        } else {
          triage (vstem X) ({a} -> vfork (Conc a) X) ({a, b} -> apply_fork self chk (Conc a) (Conc b) X) tr
        })
        Neu m => {
          let fr := readback X
          let vlift := {tr} -> if (is_neutral tr) { Neu (wait_payload tr) } else { Conc tr }
          let r := respond_face (pair_fst m) fr (make_mark m)
          if (is_invalid r) { Poison (Neu m) }
          else if (list_all ({ob} -> vcheck chk (pair_fst ob) (if (is_elim_frame fr) { vlift (pair_snd ob) } else { X })) (pair_fst r)) {
            Neu (pair (pair_snd r) (pair "Ob" (pair fr (make_mark m))))
          } else { Poison (Neu m) }
        }
        Poison r => (Poison r)
        Chain e scr args => {
          let args2 := list_snoc args X
          if (tree_eq (list_len args2) (elim_arity e)) {
            self chk scr (Conc (Elim (pair e (list_map readback args2))))
          } else { Chain (pair e (pair scr args2)) }
        }
        Stem c => (vfork c X)
        Fork a b => (apply_fork self chk a b X)
      }
    }))
  ({ fresh := {st, ty, tail} -> cons (pair (Neu (pair ty tail)) st) nil, lift := {f} -> Conc f, apply := mwalk, read := readback, judge := {chk, _st, T, r} -> vcheck chk T r })
}

neutral_free := fix ({self, v} ->
  if (is_neutral v) { false } else { triage true ({c} -> self c) ({l, r} -> and (self l) (self r)) v })

GuardAt := {on_is_neutral, on_tree_eq} -> {
  let hyp_apply := {f, x} -> {
    let r := respond_face (neutral_type f) x f
    if (is_invalid r) { invalid f } else { make_hyp (pair_snd r) (pair "Ob" (pair x f)) }
  }
  let shim := fix ({sm, payload, arg} -> {
    let E := pair_fst payload
    let seen := pair_snd payload
    if (is_leaf seen) {
      if (is_neutral arg) { wait sm (pair E (cons arg nil)) } else { (elim_raw E) (wait sm (pair E nil)) arg }
    } else {
      let args := list_snoc (pair_snd seen) arg
      if (tree_eq (list_len args) (elim_arity E)) {
        hyp_apply (pair_fst seen) (Elim (pair E args))
      } else {
        wait sm (pair E (cons (pair_fst seen) args))
      }
    }
  })
  let shim_sig := sig_of shim
  let w_stem := {a, x} -> {
    let r := t a x
    if (is_neutral r) { invalid r } else { r }
  }
  let w_s := {self, c, b, x} -> {
    let cx := self c x
    if (is_invalid cx) { cx } else {
      let bx := self b x
      if (is_invalid bx) { bx } else { self cx bx }
    }
  }
  let w_tfk := {self, b, l, r} -> {
    let bl := self b l
    if (is_invalid bl) { bl } else { self bl r }
  }
  let w_fork := {self, a, b, x} ->
    (triage
      b
      ({c} -> w_s self c b x)
      ({tc, td} ->
        if (is_neutral x) { invalid x }
        else { triage tc ({ci} -> self td ci) ({l, r} -> w_tfk self b l r) x })
      a)
  let walk := fix ({self, f, x} ->
    if (is_invalid f) { f }
    else if (tree_eq f tree_eq) { on_tree_eq ({_} -> wait tree_eq x) x }
    else if (has_sig tree_eq_sig f) { on_tree_eq ({_} -> f x) x }
    else if (tree_eq f is_neutral) { on_is_neutral ({_} -> is_neutral x) x }
    else if (is_neutral f) { hyp_apply f x }
    else if (is_elim_head f) { (wait shim (pair f nil)) x }
    else if (has_sig shim_sig f) { f x }
    else if (tree_eq f ({x} -> x)) { x }
    else if (and (is_neutral x) (or (tree_eq f pair_fst) (tree_eq f pair_snd))) { self x (Acc f) }
    else { triage (t x) ({a} -> w_stem a x) ({a, b} -> w_fork self a b x) f })
  let hyp_ok := (fix ({ok, vch, legit, v} ->
    if (member v legit) {
      true
    } else {
      let hist := neutral_history v
      if (tree_eq (pair_fst hist) "Ob") {
        let frame := pair_fst (pair_snd hist)
        let parent := pair_snd (pair_snd hist)
        let r := respond_face (neutral_type parent) frame parent
        if (is_invalid r) { false }
        else {
          and (ok vch legit parent)
          (and (tree_eq (neutral_type v) (pair_snd r))
               (list_all ({ob} -> vch (pair_fst ob) (pair_snd ob)) (pair_fst r)))
        }
      } else { false }
    }))
  let fresh := {st, ty, tail} -> {
    let x := make_hyp ty tail
    cons (pair x (cons x st)) nil
  }
  let judge := {chk, st, T, v} ->
    (fix ({vf, T2, v2} ->
      if (is_invalid v2) {
        false
      } else if (is_neutral v2) {
        and (tree_eq (neutral_type v2) T2) (hyp_ok vf st v2)
      } else {
        let rows := type_tele T2
        if (is_leaf rows) { (type_recognizer T2) (wait vf T2) v2 } else { chk st rows v2 t }
      })) T v
  ({ fresh := fresh, admit := neutral_free, apply := {_chk, f, x} -> walk f x, judge })
}
Guard := GuardAt
  ({_resume, _x} -> false)
  ({resume, x} -> if (neutral_free x) { resume t } else { invalid x })
Ambient := GuardAt
  ({resume, _x} -> resume t)
  ({resume, _x} -> resume t)

NatType : IsType := make_type ({
  recognize := {self, v} -> triage true ({_} -> false) ({l, r} -> and (tree_eq l t) (self r)) v
  gate := {Ind, B} -> cons (B zero) (cons (PiCode Ind ({k} -> PiCode (B k) ({_} -> B (succ k)))) nil)
  elim := {self, n, base, step} -> triage base ({_} -> base) ({_l, k} -> step k (self k base step)) n
})
nat_step_ty : IsType := pair_fst (pair_snd (type_gate NatType NatType ({_} -> NatType)))
nat_rec : Pi Guard NatType ({_} -> Pi Guard NatType ({_} -> Pi Guard nat_step_ty ({_} -> NatType))) := elim_of NatType ({_} -> NatType)

BoolType : IsType := make_type ({
  recognize := {_self, v} -> triage true ({c} -> tree_eq c t) ({l, r} -> false) v
  gate := {_Ind, B} -> cons (B true) (cons (B false) nil)
  members := cons true (cons false nil)
  elim := {_self, b, true_case, false_case} -> triage true_case ({_} -> false_case) ({_l, _r} -> true_case) b
})
bool_rec : Pi Guard BoolType ({_} -> Pi Guard BoolType ({_} -> Pi Guard BoolType ({_} -> BoolType))) := elim_of BoolType ({_} -> BoolType)

Point := {c} -> make_type ({ recognize := {_self, v} -> tree_eq c v, members := cons c nil })

TreeType : IsType := make_type ({
  recognize := {_self, _v} -> true
  gate := {Ind, B} -> cons (B t) (cons (PiCode Ind ({c} -> PiCode (B c) ({_} -> B (t c)))) (cons (PiCode Ind ({l} -> PiCode Ind ({r} -> PiCode (B l) ({_} -> PiCode (B r) ({_} -> B (t l r)))))) nil))
  elim := {self, v, on_leaf, on_stem, on_fork} -> triage on_leaf ({c} -> on_stem c (self c on_leaf on_stem on_fork)) ({l, r} -> on_fork l r (self l on_leaf on_stem on_fork) (self r on_leaf on_stem on_fork)) v
})

List : Pi Guard IsType ({_} -> IsType) := {A} -> make_type ({
  recognize := {self, v} -> triage true ({_} -> false) ({h, tl} -> and (A h) (self tl)) v
  gate := {Ind, B} -> cons (B nil) (cons (PiCode A ({h} -> PiCode Ind ({tl} -> PiCode (B tl) ({_} -> B (cons h tl))))) nil)
  elim := {self, xs, base, step} -> triage base ({_} -> base) ({h, tl} -> step h tl (self tl base step)) xs
})

RecordType : Pi Guard AnyTree ({_} -> IsType) := {entries} -> make_type ({ recognize := {_self, r} -> list_all ({e} -> (pair_snd e) (field r (pair_fst e))) entries })

EffType : Pi Guard IsType ({_} -> Pi Guard IsType ({_} -> Pi Guard IsType ({_} -> IsType))) := {Q, Ans, X} -> make_type ({
  recognize := {self, v} -> (match v { Pure x => (X x); Op q k => (and (Q q) (self (k t))); _ => false })
  gate := {Ind, B} -> cons (PiCode X ({x} -> B (Pure x))) (cons (PiCode Q ({q} -> PiCode (PiCode Ans ({_} -> Ind)) ({k} -> PiCode (PiCode Ans ({r} -> B (k r))) ({_} -> B (Op (pair q k)))))) nil)
  elim := {self, m, on_pure, on_op} -> (match m { Pure x => (on_pure x); Op q k => (on_op q k ({r} -> self (k r) on_pure on_op)) })
})

GuardNatToNat : IsType := Pi Guard NatType ({_} -> NatType)

add : Pi Guard NatType ({_} -> GuardNatToNat) := {n, m} -> nat_rec n m ({k, ih} -> succ ih)
not_bool : Pi Guard BoolType ({_} -> BoolType) := {b} -> bool_rec b false true
elim_id : GuardNatToNat := {n} -> nat_rec n zero ({k, ih} -> succ ih)
