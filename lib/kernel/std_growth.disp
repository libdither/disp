// Re-typechecked growth-curve / polynomial step-bound library (`lib/growth.disp`).
open use "prelude.disp"
let MMod := use "std_machine.disp"
open use raw "../machine.disp" {}
open use raw "../growth.disp" {}

let Machine := MMod.Machine
let machine_lems := cert_pick(MMod.machine_cert, ["ck_m_start", "ck_m_finished", "ck_m_advance"])
let helper_cert := certify(check_depth, check_fuel, "all", [], [
	pair("nat_le", pair(Nat -> Nat -> Bool, nat_le)),
	pair("nat_lt", pair(Nat -> Nat -> Bool, nat_lt)),
	pair("append_n", pair(List(Nat) -> List(Nat) -> List(Nat), append)),
	pair("length_n", pair(List(Nat) -> Nat, length))
])
let check_module := check_with(check_depth, check_fuel, "all", [machine_lems, helper_cert])

// All 15 definitions of `lib/growth.disp`:
// 13 structurally total (LTR or RTL lexicographic), 2 partial (`newton` recurses on `diffs(xs)`, `fit` calls `newton`);
// hot arithmetic/list builders carry pointwise-equivalence guards for `std_growth.opt.disp`
guard(fn2_equiv_guard(Nat, Nat)) ck_add2 : Nat -> Nat -> Nat := add2
ck_minus : Tree -> Tree -> Tree := minus
ck_diffs : List(Tree) -> List(Tree) := diffs
guard(fn_equiv_guard(List(Tree))) ck_all_zero : List(Tree) -> Bool := all_zero
guard(fn_equiv_guard(Nat)) ck_sizes_upto : Nat -> List(Nat) := sizes_upto
guard(fn_equiv_guard(List(Nat))) ck_degree : List(Nat) -> Nat := degree
ck_newton_step : List(Nat) -> List(Nat) := newton_step
ck_newton_at : List(Nat) -> Nat -> Nat := newton_at
ck_bound_of : List(Nat) -> Nat -> Nat := bound_of
ck_cheaper : List(Nat) -> List(Nat) -> Bool := cheaper
ck_newton : PartialFn(List(Tree), Tree) := newton
ck_count_steps : Machine -> Nat -> Nat -> Tree := count_steps
ck_steps_of : Tree -> Tree -> Nat -> Tree := steps_of
ck_curve : Tree -> Nat -> Nat -> List(Tree) := curve
ck_fit : PartialFn(Tree, PartialFn(Nat, PartialFn(Nat, Tree))) := fit
