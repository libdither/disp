// Tests for lib/confirm.disp, the symbolic confirmer: CHECK2's tests, Tree as a
// code type, streams, quotients, and the attacks A-I its header lists. Every Proved
// is cross-checked against the enumeration refuter (IDEAS.disp's Arrow).
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../stream.disp" {}
open use raw "fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "../confirm.disp" {}

// ---------------------------------------------------------------- (C) quotients, the v1 confirmer's generator form
// The v1 confirmer's form (CHECK.disp, deleted after fe53c8a), kept ONLY as the reproduction of attack D: it trusts a
// user-supplied generator (a ~ gen a) and nothing ties gen to the quotient —
// not a checker entry point. The hypothesis names f k and f (gen k) alike.
gen_parity := {a} => succ(succ(a))
with_partner :: {gen : Val -> Val, verdict : Verdict} -> Verdict :=>
	if (verdict.is_refuted) { refuted(pair(verdict.snd, gen(verdict.snd))) } else { verdict }
respects_by_induction :: {step_fn : Tree, gen : Val -> Val} -> Verdict :=> {
	let ih := hypothesis(NatR, NatR, [], gen)
	let both := {fn_val, a} => and_then(sapply(fn_val, a, run_fuel), {r1} => and_then(sapply(fn_val, gen(a), run_fuel), {r2} => same_val(r1, r2)))
	with_partner(gen, search({a} =>
		if (a.is_known) { both(fix(step_fn), a) }
		else { and_then(run(step_fn, ih), {with_ih} => both(with_ih, a)) }
	, piece(NatR, []), split_depth))
}

// ---------------------------------------------------------------- subjects
two_base_step := {f, n} => if (is_zero(n)) { zero } else if (is_zero(nat_pred(n))) { succ(zero) } else { succ(f(nat_pred(n))) }
test dbl(3) = 6
test tree_eq(dbl, fix(dbl_step)) = true
// `pair t x` is how `succ x` compiles, so this spelling is the same tree, and only a different tree tests anything
test tree_eq(dbl_step, {d2, n} => if (is_zero(n)) { zero } else { pair(t, pair(t, d2(nat_pred(n)))) }) = true
test tree_eq(dbl_step, dbl_step_add) = false
test add(2, 3) = 5

// ================================================================ CHECK2's tests, unchanged
test run(dbl, 3) = answered(6)
test run({n} => pair(n, n), piece(NatR, [])) = answered(pair(piece(NatR, []), piece(NatR, [])))
test run(succ, piece(NatR, [])) = answered(succ(piece(NatR, [])))
test run(id, piece(NatR, [])) = answered(piece(NatR, []))
test run(is_zero, piece(NatR, [])) = need(piece(NatR, []))
test run(is_zero, sym_at(1, [])) = answered(false)
test canon(sym_at(2, [])) = piece(NatR, [])
test canon(succ(piece(NatR, ["right", "right"]))) = piece(NatR, ["right"])
test apply_ih(NatR, [], same, sym_at(1, [])) = stuck
// the hypothesis applied to a smaller piece is an application, the argument named canonically
test apply_ih(NatR, [], same, piece(NatR, ["right"])) = answered(app_val(plain_ih, piece(NatR, ["right"])))
test apply_ih(NatR, [], same, succ(piece(NatR, ["right", "right"]))) = answered(app_val(plain_ih, piece(NatR, ["right"])))
test run(dbl, sym_at(1, [])) = need(piece(NatR, ["right"]))
test run(fix(bad_step), 1) = stuck
test step_with_ih(bad_step, sym_at(1, [])) = stuck
test step_with_ih(dbl_step, sym_at(1, [])) = answered(succ(succ(app_val(plain_ih, piece(NatR, ["right"])))))
test check_by_structure(succ) = "Proved"
test check_by_structure({_n} => pair(5, 5)) = refuted(0)
test check_by_structure({n} => pair(n, n)) = refuted(1)
test check_by_structure(dbl) = "Open"
test check_by_induction(dbl_step) = "Proved"
test check_by_induction({_dbl2, _n} => pair(5, 5)) = refuted(0)
test check_by_induction({_dbl2, n} => pair(n, n)) = refuted(1)
test check_by_induction(bad_step) = "Open"
test check_by_induction(two_base_step) = "Proved"
test eq_by_symbol(id, shift) = "Proved"
test eq_by_symbol(id, {n} => succ(n)) = refuted(0)
test eq_by_symbol(dbl, fix(dbl_step)) = "Open"
test eq_by_induction(dbl_step, dbl_step_add) = "Proved"
test eq_by_induction(dbl_step, {d2, n} => if (is_zero(n)) { zero } else { succ(d2(nat_pred(n))) }) = refuted(1)
same_on :: {Dom : Code, fuel : Nat, fn : Tree, gn : Tree} -> Bool :=>
	Trees.as_items.bounded(fuel).s_filter(Dom).s_all({n} => fn(n) == gn(n))
same_on_nats :: {fuel : Nat, fn : Tree, gn : Tree} -> Bool :=> same_on(NatR, fuel, fn, gn)
test Trees.as_items.bounded(40).s_filter(NatR).s_take(9).s_items = [0, 1, 2]
test agrees(check_by_structure(succ), Arrow(NatR, NatR, 40, succ)) = true
test agrees(check_by_structure({n} => pair(n, n)), Arrow(NatR, NatR, 40, {n} => pair(n, n))) = true
test agrees(check_by_structure(dbl), Arrow(NatR, NatR, 40, dbl)) = true
test agrees(check_by_induction(dbl_step), Arrow(NatR, NatR, 40, fix(dbl_step))) = true
test agrees(check_by_induction(two_base_step), Arrow(NatR, NatR, 40, fix(two_base_step))) = true
test agrees(check_by_induction({_d, n} => pair(n, n)), Arrow(NatR, NatR, 40, fix({_d, n} => pair(n, n)))) = true
test agrees(eq_by_symbol(id, shift), same_on_nats(40, id, shift)) = true
test agrees(eq_by_symbol(id, {n} => succ(n)), same_on_nats(40, id, {n} => succ(n))) = true
test agrees(eq_by_induction(dbl_step, dbl_step_add), same_on_nats(40, fix(dbl_step), fix(dbl_step_add))) = true
sweep := candidates.map({fn} => pair(check_by_structure(fn), Arrow(NatR, NatR, 40, fn)))
test sweep.all({p} => agrees(p.fst, p.snd)) = true
test sweep.filter({p} => p.fst == "Proved").length = 8
test sweep.filter({p} => p.fst == "Open").length = 0

// ================================================================ (A) Tree as the code type
// the same functions at Tree -> Tree: inspection now sees stems and forks
test eq_arrow(TreeR, id, shift) = refuted(t(t))
test eq_arrow(TreeR, id, id) = "Proved"
test check_arrow(TreeR, TreeR, {x} => pair(x, x)) = "Proved"
test check_arrow(TreeR, NatR, id) = refuted(t(t))
test check_arrow(TreeR, NatR, succ) = refuted(t(t))
// inspection is legitimate at the code type: Tree -> Bool
test check_arrow(TreeR, Bool, is_leaf) = "Proved"
test check_arrow(TreeR, Bool, {x} => tree_eq(x, t)) = "Proved"
test check_arrow(TreeR, Bool, is_fork) = "Proved"
test check_arrow(TreeR, Bool, {x} => pair(x, x)) = refuted(t)
test check_arrow(NatR, Bool, is_zero) = "Proved"
test check_arrow(TreeR, Bool, id) = refuted(t(t(t)))
test agrees(eq_arrow(TreeR, id, shift), same_on(TreeR, 40, id, shift)) = true
test agrees(check_arrow(TreeR, Bool, is_leaf), Arrow(TreeR, Bool, 40, is_leaf)) = true
test agrees(check_arrow(TreeR, Bool, {x} => tree_eq(x, t)), Arrow(TreeR, Bool, 40, {x} => tree_eq(x, t))) = true
test agrees(check_arrow(TreeR, NatR, id), Arrow(TreeR, NatR, 40, id)) = true
test agrees(check_arrow(TreeR, TreeR, {x} => pair(x, x)), Arrow(TreeR, TreeR, 40, {x} => pair(x, x))) = true
tree_sweep := candidates.map({fn} => pair(check_arrow(TreeR, Bool, fn), Arrow(TreeR, Bool, 40, fn)))
test tree_sweep.all({p} => agrees(p.fst, p.snd)) = true

// ================================================================ (B) streams
// skips: a step that yields nothing on zero, then counts
skip0 := s_new({n} => if (is_zero(n)) { running(emit(skip, succ(n))) } else { running(emit(yield(n), succ(n))) }, zero)
skip0_add := s_new({n} => if (is_zero(n)) { running(emit(skip, add(1, n))) } else { running(emit(yield(n), add(1, n))) }, zero)
// a different state space: the counter carried in a pair
nats_pair := s_new({p} => running(emit(yield(p.fst), pair(succ(p.fst), t))), pair(zero, t))
pair_states := {x} => pair(x, pair(x, t))
// the same items as nats, but a skip before each one (weakly equal, not strongly)
slow := s_new({p} => if (is_leaf(p.fst)) { running(emit(skip, pair(false, p.snd))) } else { running(emit(yield(p.snd), pair(t, succ(p.snd)))) }, pair(t, zero))

test related(same_states, 3, 3) = "Yes"
test related(same_states, 3, 4) = "Unrelated"
test related(pair_states, sym_at(1, []), pair(sym_at(1, []), t)) = "Yes"
test observe(naturals, zero, 4) = answered([0, 1, 2, 3])
test observe(skip0, zero, 4) = answered(["skip", 1, 2, 3])
test stream_eq(NatR, same_states, naturals, nats_add) = "Proved"
test stream_eq(NatR, same_states, naturals, by_two) = refuted(pair([0, 1, 2, 3], [0, 2, 4, 6]))
test stream_eq(NatR, same_states, skip0, skip0_add) = "Proved"
test stream_eq(NatR, same_states, naturals, skip0) = refuted(pair([0, 1, 2, 3], ["skip", 1, 2, 3]))
test stream_eq(NatR, pair_states, naturals, nats_pair) = "Proved"
test stream_eq(NatR, same_states, naturals, nats_pair) = "Open"
// a yield may not meet a skip (strong), even when the items would agree
test bisim_step(same_states, running(emit(yield(0), 1)), running(emit(skip, 1))) = "NotBisim"
test bisim_step(same_states, finished(exhausted), finished(spent)) = "NotBisim"
test observe(slow, pair(t, zero), 4) = answered(["skip", 0, "skip", 1])
test stream_eq(NatR, pair_states, naturals, slow) = refuted(pair([0, 1, 2, 3], ["skip", 0, "skip", 1]))
// the bounded prefix comparison (lib/stream.disp's s_take) must agree with every verdict
prefix_eq :: {k : Nat, s1 : Items(V), s2 : Items(V)} -> Bool :=> s1.bounded(k).s_take(k).s_items == s2.bounded(k).s_take(k).s_items
test agrees(stream_eq(NatR, same_states, naturals, nats_add), prefix_eq(6, naturals, nats_add)) = true
test agrees(stream_eq(NatR, same_states, naturals, by_two), prefix_eq(6, naturals, by_two)) = true
test agrees(stream_eq(NatR, same_states, skip0, skip0_add), prefix_eq(6, skip0, skip0_add)) = true
test agrees(stream_eq(NatR, pair_states, naturals, nats_pair), prefix_eq(6, naturals, nats_pair)) = true
test agrees(stream_eq(NatR, same_states, naturals, skip0), prefix_eq(6, naturals, skip0)) = true
test agrees(stream_eq(NatR, pair_states, naturals, slow), prefix_eq(6, naturals, slow)) = true

// ================================================================ (C) quotients, the v1 confirmer's generator form
is_even_not_step := {ie, n} => if (is_zero(n)) { true } else { not(ie(nat_pred(n))) }
test is_even(4) = true
test is_even(5) = false
test apply_ih(NatR, [], gen_parity, gen_parity(piece(NatR, ["right"]))) = answered(app_val(hypothesis(NatR, NatR, [], gen_parity), piece(NatR, ["right"])))
test apply_ih(NatR, [], gen_parity, gen_parity(piece(NatR, []))) = stuck
test respects_by_induction(is_even_step, gen_parity) = "Proved"
test respects_by_induction(id_step, gen_parity) = refuted(pair(0, 2))
// `not` inspects the hypothesis symbol (it triages its argument), so this
// spelling stays Open: the probe has no neutral-term form for `not X`
test respects_by_induction(is_even_not_step, gen_parity) = "Open"
respects_on :: {fuel : Nat, fn : Tree} -> Bool :=> Trees.as_items.bounded(fuel).s_filter(NatR).s_all({a} => fn(a) == fn(succ(succ(a))))
test agrees(respects_by_induction(is_even_step, gen_parity), respects_on(40, is_even)) = true
test agrees(respects_by_induction(id_step, gen_parity), respects_on(40, fix(id_step))) = true
test agrees(respects_by_induction(is_even_not_step, gen_parity), respects_on(40, fix(is_even_not_step))) = true

// ================================================================ the attacks
// Each case: the v1 confirmer's verdict (reproduced against it in a scratch run) as
// a comment, then the honest verdict pinned.
NatFn := ArrowC(NatR, NatR)

// ---- A. vacuous Proved from an EMPTY split table (fatal)
// the v1 confirmer: check_arrow NatFn Bool sniff = "Proved"; check_arrow StemR NatR id = "Proved";
//         check_arrow NatFn NatR ({f} => f) = "Proved" — no table => [] => combine [] = Proved
StemR := {v} => is_stem(v)
test table(NatFn, id) = none
// a recognizer's cases are derived by running it: a stem of any tree, and nothing at all for False
test table(StemR, {s} => piece(StemR, [s])) = some([t(piece(TreeR, ["child"]))])
test table(FalseR, id) = some([])
// one that never stops off zero has none, so its symbols never split
test table(LoopR, id) = none
test is_positive(NatR) = true
test is_positive(NatFn) = false
test is_splittable(piece(NatFn, [])) = false
// inspecting a negative symbol is stuck with a reason, never a need
test run(sniff, piece(NatFn, [])) = stuck_on(pair("no split table", piece(NatFn, [])))
// the search does not split it: Open with the reason; the driver then grounds
// the symbol on the stored pair (id, shift): sniff id = true, sniff shift = false
test search({input} => and_then(run(sniff, input), judge_bool), piece(NatFn, []), split_depth) = "Open"
test check_arrow(NatFn, Bool, sniff) = refuted(pair(id, shift))
// with StemR's cases derived, the stem of the leaf is a member that id does not make a Nat
test check_arrow_r(StemR, NatR, id) = refuted(t(t))
test check_arrow(StemR, NatR, id) = refuted(t(t))
// {f} => f at (Nat -> Nat) -> Nat: grounded on the member id, which is no Nat
test check_arrow(NatFn, NatR, {f} => f) = refuted(id)
// a declared EMPTY grammar is the one place a vacuous Proved is right
test check_arrow(FalseR, NatR, id) = "Proved"
test check_arrow(FalseR, TreeR, {x} => pair(x, x)) = "Proved"

// ---- B. a COARSE symbol at a FINE position (serious)
// the v1 confirmer: check_arrow NatFn TreeR wrap = "Proved" (and pair f zero, and {f} => f):
//         judge_tree said Yes to anything
wrap := {f} => t(f)
test judge_tree(t(piece(NatFn, []))) = coarse(piece(NatFn, []))
test judge_tree(succ(piece(NatR, []))) = "Yes"
test judge_tree(app_val(piece(NatFn, []), 0)) = "Yes"
test judge_tree(app_val(piece(NatFn, []), id)) = stuck_on(pair("argument outside the domain", piece(NatFn, [])))
test check_arrow_r(NatFn, TreeR, {f} => f(1)) = "Proved"
test check_arrow(NatFn, TreeR, wrap) = refuted(pair(id, shift))
test check_arrow(NatFn, TreeR, {f} => pair(f, zero)) = refuted(pair(id, shift))
test check_arrow(NatFn, TreeR, {f} => f) = refuted(pair(id, shift))
test tree_eq(wrap(id), wrap(shift)) = false
// the pair really is related at Nat -> Nat (both members, same normal form)
test eq_arrow_at(NatR, NatR, id, shift) = "Proved"
test tree_eq(id, shift) = false
// {f} => f 0 IS a member at (Nat -> Nat) -> Nat: the neutral term App f [0] is
// judged at Nat by the arrow rule (f : Nat -> Nat, 0 : Nat) — Proved, and at
// Tree the same term is shielded (its codomain Nat is fine) — Proved
test run({f} => f(0), piece(NatFn, [])) = answered(app_val(piece(NatFn, []), 0))
test check_arrow(NatFn, NatR, {f} => f(0)) = "Proved"
test check_arrow(NatFn, TreeR, {f} => f(0)) = "Proved"
// f applied OUTSIDE its domain is unconstrained: id id and shift id differ
test check_arrow(NatFn, TreeR, {f} => f(id)) = refuted(pair(id, shift))
// inspecting a neutral term is opaque (no codomain split, see C): Open, honestly
test check_arrow_r(NatFn, Bool, {f} => is_zero(f(0))) = open_on(pair("opaque value", app_val(piece(NatFn, []), 0)))

// ---- C. forged descent through a codomain split (serious)
// the v1 confirmer (and this file) never split a stuck application by its codomain: `dbl s`
// on a symbol NEEDS s, the search splits s, and the depth runs out — Open.
// The license accepts only pieces of the input being inducted on: a piece of another input,
// or an application (the hypothesis's own answer), never descends.
spin_step := {self, n} => if (is_zero(n)) { zero } else { self(nat_pred(dbl(nat_pred(n)))) }
test run(fix(spin_step), 2) = answered(0)
test run(fix(spin_step), 3) = stuck
test check_by_induction(spin_step) = "Open"
test apply_ih(NatR, [], same, piece_at(NatR, 1, ["right"])) = stuck
test apply_ih(NatR, [], same, succ(piece_at(NatR, 1, ["right", "right"]))) = stuck
test apply_ih(NatR, [], same, app_val(plain_ih, piece(NatR, ["right"]))) = stuck

// ---- D. quotient respect must use the NORMALIZER (serious)
// the v1 confirmer: respects_by_induction id_step ({a} => a) = "Proved" (the identity
//         generator forges respect of anything); respects_by_induction
//         is_even_step gen_parity = "Proved" is the same run whatever quotient
//         the user meant (nothing names it) — so is_even "respects" All.
test respects_by_induction(id_step, {a} => a) = "Proved"
test parity(5) = 1
test parity(4) = 0
// the normalizer on a sub-symbol is a neutral term; on the root it is a need
test run(parity, piece(NatR, ["right"])) = answered(app_val(parity, piece(NatR, ["right"])))
test run(parity, piece(NatR, [])) = need(piece(NatR, []))
test run(parity, sym_at(2, [])) = answered(app_val(parity, piece(NatR, ["right", "right"])))
// the quotient's hypothesis takes nf k for k, so f (nf k) and f k are one application
test apply_ih_at(NatR, Bool, [], {a} => app_val(parity, a), app_val(parity, piece(NatR, ["right"]))) = answered(app_val(hypothesis(NatR, Bool, [], {a} => app_val(parity, a)), piece(NatR, ["right"])))
test apply_ih_at(NatR, Bool, [], {a} => app_val(parity, a), app_val(parity, piece(NatR, []))) = stuck
test respects_nf(is_even_step, parity, Bool) = "Proved"
test respects_nf(id_step, parity, NatR) = refuted(pair(0, 2))
test respects_nf(is_even_step, always_zero, Bool) = refuted(pair(0, 1))
test respects_nf(is_even_not_step, parity, Bool) = "Open"
test check_arrow(Parity, NatR, id) = refuted(pair(0, 2))
// a plain fixpoint (not a step) at a quotient domain has no hypothesis: Open
test check_arrow(Parity, Bool, is_even) = "Open"
test check_arrow(All, Bool, {n} => true) = "Proved"
test check_arrow(All, NatR, always_zero) = "Proved"
respects_nf_on :: {fuel : Nat, fn : Tree, nf : Tree} -> Bool :=> Trees.as_items.bounded(fuel).s_filter(NatR).s_all({a} => fn(a) == fn(nf(a)))
test agrees(respects_nf(is_even_step, parity, Bool), respects_nf_on(40, is_even, parity)) = true
test agrees(respects_nf(id_step, parity, NatR), respects_nf_on(40, fix(id_step), parity)) = true
test agrees(respects_nf(is_even_step, always_zero, Bool), respects_nf_on(40, is_even, always_zero)) = true

// ---- E. equality without membership (serious)
// the v1 confirmer: eq_arrow NatR ({n} => pair n n) ({n} => pair n n) = "Proved" and
//         eq_by_symbol id id = "Proved" (at Nat -> Bool, unstatable there):
//         same_val never asked whether either side is a member
test eq_arrow(NatR, {n} => pair(n, n), {n} => pair(n, n)) = refuted(1)
test eq_arrow_at(NatR, Bool, id, id) = refuted(1)
test eq_arrow_at(NatR, Bool, is_zero, is_zero) = "Proved"
test eq_arrow_at(NatR, NatR, id, id) = "Proved"
test eq_arrow_at(NatR, Bool, id, is_zero) = refuted(1)
// at 0 the outputs already differ: dbl 0 = 0, pair 0 0 = 2 (a Nat)
test eq_by_induction(dbl_step, {_d, n} => pair(n, n)) = refuted(0)
// beta-equal spellings at a coarse domain and a fine codomain: neither is a
// member, and the stored pair shows it (f id = id, g shift = shift)
test eq_arrow_at(NatFn, TreeR, {h} => h, {h} => id(h)) = refuted(pair(id, shift))
// at a coarse codomain the symbol is a member of its own type, so the two are equal
test eq_arrow_at(NatFn, NatFn, {h} => h, {h} => id(h)) = "Proved"
// two non-total functions are never equal at a total type: `loop` on the
// hypothesis unrolls until the fuel is gone — Open, never Proved
test eq_by_induction(loop_f_step, loop_g_step) = "Open"
test check_by_induction(loop_f_step) = "Open"

// ---- F. a diverging recognizer: membership there is Open, never a verdict
// the v1 confirmer: check_arrow LoopR NatR id = "Proved" (no table => vacuous)
test check_arrow(LoopR, NatR, id) = "Open"
test judge_as(LoopR, 0) = "Yes"
test judge_as(LoopR, 1) = stuck
test judge_as(LoopR, piece(NatR, [])) = need(piece(NatR, []))
test check_arrow(NatR, LoopR, id) = "Open"
test check_arrow(NatR, LoopR, succ) = "Open"
test check_arrow(NatR, LoopR, {_} => zero) = "Proved"
// (the enumeration refuter cannot be consulted for LoopR: it would hang)

// ---- G. curried claims need distinct roots (serious)
// the v1 confirmer: with path-only names both arguments were `piece NatR []`, one
//         symbol, and the check was of f n n: check_arrow2 NatR NatR NatR f2 = "Proved"
f2 := {a, b} => if (is_zero(a)) { if (is_zero(b)) { zero } else { false } } else { zero }
test f2(0, 1) = false
test NatR(f2(0, 1)) = false
test tree_eq(piece_at(NatR, 0, []), piece_at(NatR, 1, [])) = false
test check_arrow2(NatR, NatR, NatR, f2) = refuted(pair(0, 1))
test check_arrow2(NatR, NatR, NatR, {a, b} => pair(a, b)) = refuted(pair(1, 0))
test check_arrow2(NatR, NatR, NatR, {a, _b} => a) = "Proved"
test fix(add_step, 2, 3) = 5
// the second root is never a descendant of the first: no license on it
test apply_ih(NatR, [], same, piece_at(NatR, 1, [])) = stuck
test check_by_induction2(NatR, NatR, add_step) = "Proved"
test check_by_induction2(NatR, NatR, {self, a, b} => if (is_zero(a)) { b } else { succ(self(a, b)) }) = "Open"
test check_by_induction2(NatR, NatR, {_self, a, b} => if (is_zero(a)) { pair(b, b) } else { zero }) = refuted(pair(0, 1))
test Trees.as_items.bounded(40).s_filter(NatR).s_all({a} => Trees.as_items.bounded(40).s_filter(NatR).s_all({b} => NatR(fix(add_step, a, b)))) = true

// ---- H. fuel bounds steps, not depth
// The v1 confirmer hands each sub-run fuel-1 and rule_s spawns three, so its fuel bounds
// depth, not work. (The panel's `twice` example does NOT blow it up: both
// sub-calls are the same application at the same fuel, so the host's memo
// answers the second one — the v1 confirmer is Open there in 4 s at k = 18.) A blowup
// whose sub-calls are DISTINCT (an accumulator that spells the path) is 2^k
// interpreted runs, and the host memo grows one entry per interpreted step:
// The v1 confirmer is OOM-killed at the 3 GB cap after ~28 s at k = 10 and at k = 12
// (measured; memory, not time, is what gives out). Now every dispatch spends
// one unit of ONE budget: the run is stuck at run_fuel dispatches and the
// verdict is Open in load time at k = 20. (The computation must mention the
// input — a closed sub-term is folded natively by the elaborator before the
// evaluator ever sees it.)
blowup := fix({self, n, acc} => if (is_zero(n)) { acc } else { pair(self(nat_pred(n), t(acc)), self(nat_pred(n), t(t, acc))) })
spend := {n} => if (is_leaf(blowup(add(20, n), t))) { n } else { n }
test run(spend, 0) = stuck
test nat_lt((sapply_s(succ, 0, 100)).snd, 100) = true
test check_by_structure(spend) = "Open"
test run({n} => n, 0) = answered(0)

// ---- I. a program that builds the hole marker (fatal)
// a hole is a plain tree, so a program can build one: before the escape these were all
// Proved (a fork is no Nat). Forged trees are opaque, so the verdict is Open.
forge := {_n} => piece(NatR, [])
forge_late := {n} => if (is_zero(n)) { zero } else { piece(NatR, []) }
test check_by_structure(forge) = "Open"
test check_arrow(TreeR, NatR, forge_late) = "Open"
// built at run time: natively, and by the stem rule on a partly-known argument
test check_arrow(NatR, NatR, {_n} => t(hole_sig, t(t, pair("Sym", pair(NatR, pair("In", pair(0, []))))))) = "Open"
test check_arrow(TreeR, NatR, {x} => t(hole_sig, x)) = "Open"
