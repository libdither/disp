// Finite types: types whose cases are all known, so splitting a symbol of one lists its members and every claim about them is decided by running. A function type between finite types is finite too, with its lookup tables as its cases, which is what makes higher-order types decided. A finite type is a recognizer, its members derived as its cases; the function type is the one behaviour record, its cases written as tables.
open use raw "base.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}

// a finite type: a recognizer for its member list, built once as a chain of comparisons, so its
// cases are derived, and they are the members
rec one_of :: {members : List(Tree)} -> Tree :=>
	if (members.is_nil) { {_v} => false } else { let m := members.head; let rest := one_of(members.tail); {v} => if (v == m) { true } else { rest(v) } }
f_base := one_of
elements := cases_of
f_prod := {a, b} => f_base(elements(a).cross(elements(b), pair))
rec table_get :: {entries : List(Pair(Tree, Tree)), x : Tree} -> Tree :=>
	if (entries.is_nil) { t } else if (entries.head.fst == x) { entries.head.snd } else { table_get(entries.tail, x) }
// every assignment of one output per input
rec assignments :: {dom : List(Tree), cod : List(Tree)} -> List(List(Pair(Tree, Tree))) :=>
	if (dom.is_nil) { [[]] }
	else { cod.cross(assignments(dom.tail, cod), {y, rest} => cons(pair(dom.head, y), rest)) }
// the function type between finite types: a member answers in the codomain on every member, and its cases are every table
f_arrow := {a, b} => of_type(behaviour{
	admits := {at, _self, v} => if (v.is_known) { all_yes(elements(a).map({x} => and_then(sapply(v, x, run_fuel), at(b)))) } else { inspect(v) },
	applied := some(pair(a, {_x} => b)),
	cases := some({_self, _child} => assignments(elements(a), elements(b)).map(table_get))})

bb := f_base([true, false])
bb2 := f_arrow(bb, bb)
spin := fix({self, x} => self(x))
test elements(bb).length = 2
test elements(bb2).length = 4
test elements(f_arrow(bb2, bb)).length = 16
test elements(f_prod(bb, bb)).length = 4
test elements(bb2).all(holds(bb2)) = true
test judge(bb2, not) = "Proved"
test judge(bb2, {x} => pair(x, x)) = refuted([true])
// a run that does not finish is never a verdict: Open, not refuted
test judge(bb2, spin).is_open = true
test holds(bb2, spin) = false
// higher order: the function argument splits into its four tables, so even a program that looks at what it returns is decided
at_true := {f} => f(true)
test judge(f_arrow(bb2, bb), at_true) = "Proved"
test judge(f_arrow(bb2, bb), {f} => not(f(true))) = "Proved"
test judge(f_arrow(bb2, bb), {f} => f).is_refuted = true
// equal behaviour at a type is decided, though the trees differ
twice_not := {x} => not(not(x))
test tree_eq(twice_not, {x} => x) = false
test eq_arrow(bb, twice_not, {x} => x) = "Proved"
test eq_arrow(bb, not, {x} => x).is_refuted = true
test eq_arrow_at(bb2, bb, at_true, {f} => f(not(false))) = "Proved"

// the cover as a lens into the claim over all trees: outside Bool nothing is asked; a cover that skips a member is refuted
bool_claim := {w, x} => if (Bool(x)) { Bool(w(x)) } else { true }
cover := lens({w} => w, {_w, x} => if (Bool(x)) { x } else { true })
bad_cover := lens({w} => w, {_w, _x} => true)
half_bad := {x} => if (x) { true } else { pair(x, x) }
test honest(Trees.as_items, lens_holds(bool_claim, bool_claim, cover), half_bad, 30) = "Open"
test honest(Trees.as_items, lens_holds(bool_claim, bool_claim, bad_cover), half_bad, 30) = refuted(false)
