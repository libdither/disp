open use raw "../prelude.disp" {}
open use raw "kernel.disp" {}

// The kernel's library types, split out of kernel.disp: everything the
// checker itself does not need to exist. kernel.disp keeps the machinery and
// its constitutive types (Bool, Unit, Tree, Pred, ShallowType, Space,
// Row/Obs, Sum, the Pi/Tele formers, the tables, Record + the declaration
// protocol).
// prelude.disp is the double-pass barrel that loads both raw, then checked.
// The ambient-walker parameter lives here with the annotated surface it
// governs (givens do not cross opens); filling it with another table
// re-verifies every arrow-spelled definition below under that walker.
// Pi-Guard-literal annotations are the deliberate opt-out; the one entry
// left is TreeOf, whose branching row program blows up Meta's simulation.
given DefaultWalker : Tree := Guard
Fn : Pi (Sampled [Bool]) ShallowType ({_} => Pi (Sampled [{_v} => Bool]) Tree ({_} => Space)) := Pi DefaultWalker
// Re-point the binder sugar at Fn here: the raw kernel open exports a
// neutral-Fn settings entry (givens unfilled), so the real one must rebind.
elab_settings := [t "Pi" Fn]

// arm k g: the k-th eliminator arm of a gate's list (head/tail spine indexing).
arm := idx

node_like : ShallowType := Pred ({n} => or (is_leaf n) (is_fork n))

Refine : ShallowType -> Tree -> ShallowType
  := {A, p} => ({
  #recognize := {_self, v} => and (A v) (p v)
  check := {jdg, _T, v} => and (jdg A v) (p v)
})
Quotient : ShallowType -> Tree -> ShallowType
  := {A, nf} => ({
  #recognize := {_self, v} => A v
  check := {jdg, _T, v} => jdg A v
  norm := nf
  under := A
})
canon := {A, v} => {
  let nf := A.norm
  if (is_leaf nf) { v } else if (neutral_free v) { nf v } else { v }
}
Named : Tree -> ShallowType -> ShallowType
  := {name, T} => ({
  #recognize := {_self, v} => T v
  check := {jdg, _T2, v} => jdg T v
  name := name
  under := T
})

key_insert := {K} => fix ({self, k, ks} =>
  if (is_leaf ks) { [k] }
  else if (tree_eq k ks.fst) { ks }
  else if (tree_lt k ks.fst) { cons K k ks }
  else { cons K ks.fst (self k ks.snd) })
key_sort := {K} => fix ({self, ks} => if (is_leaf ks) { [] } else { key_insert K ks.fst (self ks.snd) })
Tuple : Pi (Sampled [[Bool, Unit]]) Tree ({_} => Space)
  := {keys} => {
  let ks := key_sort ShallowType keys
  if (not (tree_eq (list_len Tree ks) (list_len Tree keys))) { invalid keys }
  else { (fix ({self, ks2} =>
    if (is_leaf ks2.snd) { ks2.fst } else { Sigma DefaultWalker ks2.fst ({_} => self ks2.snd) })) ks }
}
at := {K, keys, s} => (fix ({self, ks, v} =>
  if (is_leaf ks) { invalid K }
  else if (tree_eq K ks.fst) { if (is_leaf ks.snd) { v } else { v.fst } }
  else { self ks.snd v.snd })) (key_sort ShallowType keys) s

GoodGate : Pi (Sampled [Bool, Unit, Row]) ShallowType ({_} => Bool)
  := {T} => {
  let g := T.gate
  if (is_leaf g) { false } else {
    let B := {_} => inj "@GoodGate" T
    let tys := g T B
    let pis := fix ({self, l, end} => if (is_leaf l) { end } else { Pi Guard l.fst ({_} => self l.snd end) })
    and (Pi Guard T ({x} => pis tys (B x)) (elim_of T B))
        (list_all ShallowType ({ty} => not (Pi Guard Tree ({_} => ty) ({j} => j))) tys)
  }
}
Coherent : Pi (Sampled [Bool, Unit, Row, Tree]) ShallowType ({_} => Bool)
  := {T} => {
  let e := T.ends
  let ck := T.check
  let ends_ok := if (is_fork e) { or (tree_eq e.fst e.snd) (list_all Tree ({v} => not (T v)) probes) } else { true }
  let check_ok := if (is_leaf ck) { true } else { list_all Tree ({v} => tree_eq (T v) (ck ({ty, a} => ty a) T v)) probes }
  let members_ok := and (list_all T T T.members) (if (is_leaf T.members) { true } else { list_all Tree ({v} => or (not (T v)) (member T v T.members)) probes })
  let gate_ok := if (is_leaf T.gate) { true } else { GoodGate T }
  let norm_ok := if (is_leaf T.norm) { true } else {
    list_all Tree ({v} => if (T v) { and (T (T.norm v)) (tree_eq (T.norm (T.norm v)) (T.norm v)) } else { true }) probes
  }
  // The strength of a rows slot, stated as a law rather than left to the slot name:
  // tele rows are DEFINITIONAL (the judge runs them and they override the recognizer,
  // pinned below), so a type carrying them must recognize exactly what they accept.
  // obs rows are descriptive and carry no such duty -- they only license observations.
  let rows_ok := if (is_leaf T.tele) { true } else { list_all Tree ({v} => tree_eq (T v) ((Tele Guard T) v)) probes }
  and ends_ok (and check_ok (and members_ok (and gate_ok (and norm_ok rows_ok))))
}

False : Refine Space Coherent := Sum Tree []

Not : ShallowType -> Space := {P} => Fn P ({_} => False)
test False t = false
test False 5 = false
test Not False ({p} => p) = true

Nat : Refine Space Coherent := ({
  #recognize := {self, v} => triage true ({_} => false) ({l, r} => and (tree_eq l t) (self r)) v
  gate := {Ind, B} => [B zero, PiCode Ind ({k} => PiCode (B k) ({_} => B (succ k)))]
  elim := {self, n, base, step} => triage base ({_} => base) ({_l, k} => step k (self k base step)) n
})
test Nat zero = true
test Nat (succ (succ zero)) = true
test is_leaf Nat.tele = true
test Nat (t t) = false
test Nat (make_hyp Nat Nat) = false
test Nat (succ (make_hyp Nat Nat)) = false
nat_step_ty : Space := arm 1 (Nat.gate Nat ({_} => Nat))
nat_rec : {C : ShallowType} -> Nat -> C -> (arm 1 (Nat.gate Nat (const_fn C))) -> C
  := {C} => elim_of Nat ({_} => C)

test ShallowType Bool = true
test tree_eq (Tuple [Nat, Bool]) (Tuple [Bool, Nat]) = true
test Tuple [Nat, Bool] (pair true 2) = true
test Tuple [Nat, Bool] (pair 2 true) = false
test (Named "cost" Nat) 3 = true
test (Named "cost" Nat).name = "cost"
test tree_eq (Named "cost" Nat).under Nat = true
test tree_eq (Named "cost" Nat) (Named "price" Nat) = false
test field (make_record [Nat] [list_const 7]) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Bool = true
test tree_eq ({ (Nat) := 7, (Bool) := true }) ({ (Bool) := true, (Nat) := 7 }) = true
test field ({ label := "flip", ((Named "cost" Nat)) := 3 }) (Named "cost" Nat) = 3
test Fn ShallowType ({_} => Bool) ({T} => T 5) = true
test Fn ShallowType ({_} => Bool) ({T} => bool_case Bool (T 5) false true) = true
test Fn ShallowType ({_} => Nat) ({T} => T 5) = false

Point : Tree -> Refine Space Coherent
  := {c} => ({ #recognize := {_self, v} => tree_eq c v, members := [c] })

// One shape under wait and tag: a suspended S-redex fork(stem f, K x), the
// stored tree at .snd.snd. Sus is the shared super-type; Tagged keys identity
// on the head (wait: the sig is a fixed stem of the marker), Faced on the
// meta slot (tag: the head embeds behavior, so no constant sig exists).
Sus := Pred ({v} =>
  if (is_fork v) {
    if (is_stem (pair_fst v)) {
      if (is_fork (pair_snd v)) { is_leaf (pair_fst (pair_snd v)) } else { false }
    } else { false }
  } else { false })
Tagged : Tree -> Tree -> ShallowType
  := {S, P} => ({ #recognize := {_self, v} =>
  if (Sus v) { if (has_sig S v) { P (wait_payload v) } else { false } } else { false } })
Faced : Tree -> Tree -> ShallowType
  := {name, P} => ({ #recognize := {_self, v} =>
  if (Sus v) {
    let m := wait_payload v
    if (is_fork m) { if (tree_eq (pair_fst m) name) { P (pair_snd m) } else { false } } else { false }
  } else { false } })
// Shape, not trust: sig-valid forgeries are members. Blessing is the
// walker's judgment (hyp_ok, the elim_raw-vs-T.elim comparison), never a
// tree predicate.
Hyp : ShallowType := Tagged hyp_sig Tree
Invalid : ShallowType := Tagged invalid_sig Tree
OpenChain : ShallowType := Tagged open_sig Tree
TypeFace : ShallowType := Faced "recognize" Tree
// Rows spelling of the same shape: a wait form IS a nested Sigma, so these
// carry a tele and hypotheses of them support payload projection under
// Guard. The checker's three CONTROL markers cannot ride it and keep the
// recognize spellings above: hyp marks are its mints (admit + the
// is_neutral judge branch claim them), invalid marks are its error
// propagation (the is_invalid branch refuses them as values), open chains
// are its pending completions (the is_open_chain branch routes them to
// complete). Rows work for the data-shaped rest.
TaggedRows : Tree -> Tree -> Space
  := {S, P} => Sigma Guard (Point S) ({_} => Sigma Guard (Point t) ({_} => P))
SusRows : Space := Sigma Guard (Pred is_stem) ({_} => Sigma Guard (Point t) ({_} => Tree))
ElimPayload : Space := Sigma Guard Tree ({_} => Sigma Guard Space ({_} => Tree))
ElimHead : Space := TaggedRows elim_sig ElimPayload
StuckElim : Space := TaggedRows elim_stuck_sig Tree
TeqPartial : Space := TaggedRows tree_eq_sig Tree
test Sus (make_hyp Nat t) = true
test Sus Nat = true
test Sus (pair 1 2) = false
test Sus (Acc pair_fst) = false
test Sus (list_const 5) = false
test Hyp (make_hyp Nat t) = true
test Hyp (make_hyp Bool Bool) = true
test Hyp (elim_of Nat ({_} => Nat)) = false
test Hyp (inj hyp_sig t) = false
test Hyp Nat = false
test ElimHead (elim_of Nat ({_} => Nat)) = true
test ElimHead (wait elim_marker (pair t (pair Nat ({_} => Bool)))) = true
test Invalid (invalid 5) = true
test Invalid (make_hyp Nat t) = false
test OpenChain (wait open_chain (pair t (pair t []))) = true
test StuckElim (wait elim_stuck (pair t (pair t []))) = true
// Boundary: rows membership refuses any payload embedding a live mint (the
// judge claims neutrals at their recorded type), so a real stuck collector
// carrying a hypothesis scrutinee is not a member; rows spellings describe
// the neutral-free shape only.
test StuckElim (wait elim_stuck (pair (elim_of Nat ({_} => Nat)) (pair (make_hyp Nat t) []))) = false
test TeqPartial (wait tree_eq 5) = true
test TypeFace Nat = true
test TypeFace Bool = true
test TypeFace (make_hyp Nat t) = false
test TypeFace (pair "recognize" 5) = false
test ShallowType Hyp = true
test ShallowType TypeFace = true
// Conduct: hypotheses of rows-spelled tagged types project sig and payload
// legally; undeclared observations refuse.
test (SusRows -> Tree) ({h} => (h.snd).snd) = true
test (SusRows -> Tree) ({h} => h 5) = false
test (ElimHead -> Space) ({E} => (((E.snd).snd).snd).fst) = true
test (ElimHead -> Tree) ({E} => ((E.snd).snd).fst) = true

refl := t
Eq : Pi (Sampled [Nat]) ShallowType ({A} => Pi (Sampled [2]) A ({x} => Pi (Sampled [2]) A ({y} => Space)))
  := {A, x, y} => {
  let nx := canon A x
  let ny := canon A y
  ({
    #recognize := {_self, v} => tree_eq (pair nx v) (pair ny refl)
    gate := {_Ind, B} => [B nx]
    elim := {_self, _p, base} => base
    land := {B, _self} => B ny
    ends := pair nx ny
    under := A
  })
}
// J at the dependent tier: each lemma's motive computes on the bound
// endpoint, so it is an honest transport (the old constant motives assumed
// their conclusion and only passed at concrete endpoints). Carriers are
// sampled; endpoints, families, proofs and bases are hypotheses.
// Pi-Guard-literal: under the TwoFace differential the probe expansion over
// six binders is unaffordable (measured past 6.5 GB on the kernel suite).
eq_subst : Pi (Sampled [Nat]) ShallowType ({A} => Pi Guard A ({x} => Pi Guard A ({y} => Pi Guard (Pi Guard A ({_} => ShallowType)) ({B} => Pi Guard (Eq A x y) ({_} => Pi Guard (B x) ({_} => B y))))))
  := {A, x, y, B, p, base} => elim_of (Eq A x y) B p base
eq_sym : Pi (Sampled [Nat]) ShallowType ({A} => Pi Guard A ({x} => Pi Guard A ({y} => Pi Guard (Eq A x y) ({_} => Eq A y x))))
  := {A, x, y, p} => eq_subst A x y ({z} => Eq A z x) p refl
eq_trans : Pi (Sampled [Nat]) ShallowType ({A} => Pi Guard A ({x} => Pi Guard A ({y} => Pi Guard A ({z} => Pi Guard (Eq A x y) ({_} => Pi Guard (Eq A y z) ({_} => Eq A x z))))))
  := {A, x, y, z, p, q} => eq_subst A y z ({w} => Eq A x w) q p
eq_cong : Pi (Sampled [Nat]) ShallowType ({A} => Pi (Sampled [Nat]) ShallowType ({A2} => Pi Guard (Pi Guard A ({_} => A2)) ({f} => Pi Guard A ({x} => Pi Guard A ({y} => Pi Guard (Eq A x y) ({_} => Eq A2 (f x) (f y)))))))
  := {A, A2, f, x, y, p} => eq_subst A x y ({z} => Eq A2 (f x) (f z)) p refl
test Eq Nat 2 2 refl = true
test Eq Nat 2 3 refl = false
test Eq Nat 2 2 (t t) = false
test eq_subst Nat 2 2 ({_} => Nat) refl 7 = 7
test eq_sym Nat 2 2 refl = refl
test eq_trans Nat 2 2 2 refl refl = refl
test eq_cong Nat Nat succ 2 2 refl = refl

// The ask face: a property query on an abstract type answers as a witness
// typed Cell (P T) -- nobody answers, the witness is a mint, so certificates
// hold for every dictionary. Since stage R the license is row data: the
// universes' obs carry one Property row per slot, the walk retries a
// parametric refusal as an Acc frame against the rows, and Meta answers
// through the same replay (the Fn/Meta/TwoFace spellings are pinned in
// kernel.test; the pins here keep the original Pi-Guard-literal spelling).
// Consuming a witness (case, projection, application) is the documented
// boundary: the answer type is Sum-built, and scrutinizing formers refuse to
// CONSTRUCT over an embedded mint inside a walked body (last pin), so
// witness elimination waits on a dedicated case head.
test (Pi Guard ShallowType ({T} => Cell (MembersP T))) ({T} => ask T MembersP) = true
test (Pi Guard ShallowType ({T} => Cell (GateP T))) ({T} => ask T MembersP) = false
test (Pi Guard ShallowType ({T} => Tree)) ({T} => ask T ({X} => X)) = false
test (Pi Guard Nat ({n} => Tree)) ({n} => ask n MembersP) = false
test (Pi Guard ShallowType ({T} => ShallowType)) ({T} => Cell (NormP T)) = false
test tree_eq (ask Nat GateP) (inj "Some" Nat.gate) = true
test tree_eq (ask (Eq Nat 2 2) UnderP) (inj "Some" Nat) = true
test tree_eq (ask (Eq Nat 2 2) EndsP) (inj "Some" (pair 2 2)) = true

// Space-typed hypotheses license the same property queries (the ask face
// admits both universes); the judge grants no subsumption between the
// universes (nominal, like Refine). Formation certifies today: the
// structure-building formers applied to an abstract type land in Space,
// from Space and ShallowType binders alike. Consuming a witness stays the
// boundary documented above.
test (Pi Guard Space ({T} => Cell (MembersP T))) ({T} => ask T MembersP) = true
test (Pi Guard Space ({T} => Cell (GateP T))) ({T} => ask T MembersP) = false
test (Pi Guard Space ({T} => ShallowType)) ({T} => T) = false
test (Pi Guard Space ({T} => Space)) ({T} => PiCode T ({_} => Bool)) = true
test (Pi Guard Space ({T} => Space)) ({T} => SigmaCode T ({_} => T)) = true
test (Pi Guard Space ({T} => Space)) ({T} => Pi Guard T ({_} => Bool)) = true
test (Pi Guard ShallowType ({T} => Space)) ({T} => PiCode T ({_} => Bool)) = true

// Judge-level transport: when tree identity fails, the judge consults the
// typed ledger at the finest grade, so an assumed Eq ShallowType A B
// converts A-hypotheses to B, including through constructor contexts by
// spine decomposition. Quotient-carried equations stay refused for
// conversion (the A7 grading). Pi-Guard-literal: Meta's judge has no
// conversion route yet.
test (Pi Guard ShallowType ({A} => Pi Guard ShallowType ({B} => Pi Guard (Eq ShallowType A B) ({_} => Pi Guard A ({a} => B))))) ({_A, _B, _p, a} => a) = true
test (Pi Guard ShallowType ({A} => Pi Guard ShallowType ({B} => Pi Guard A ({a} => B)))) ({_A, _B, a} => a) = false
test (Pi Guard ShallowType ({A} => Pi Guard ShallowType ({B} => Pi Guard (Eq ShallowType A B) ({_} => Pi Guard (Pi Guard A ({_} => Bool)) ({f} => Pi Guard B ({_} => Bool)))))) ({_A, _B, _p, f} => f) = true
test (Pi Guard Nat ({n} => Pi Guard Nat ({m} => Pi Guard (Eq (Quotient Nat succ) n m) ({_} => Pi Guard (Point n) ({v} => Point m))))) ({_n, _m, _p, v} => v) = false

tree_rec : {C : ShallowType} -> Tree -> C -> (arm 1 (Tree.gate Tree (const_fn C))) -> (arm 2 (Tree.gate Tree (const_fn C))) -> C
  := {C} => elim_of Tree ({_} => C)

test GoodGate Nat = true
test GoodGate Bool = true
test GoodGate Tree = true
test GoodGate (Eq Nat 2 3) = true
test GoodGate (Pred ({_v} => true)) = false
test GoodGate ShallowType = false

test Coherent Nat = true
test Coherent Bool = true
test Coherent Tree = true
test Coherent Unit = true
test Coherent (Pred ({_v} => true)) = true
test Coherent (Point 5) = true
test Coherent (Eq Nat 2 2) = true
test Coherent (Eq Nat 2 3) = true
test Coherent (Pi Guard Nat ({_} => Nat)) = true
test Coherent (Sigma Guard Nat ({_} => Bool)) = true
// The two rows slots differ in JUDGE semantics, not just in name: a type whose
// recognizer admits everything while its tele demands a Bool is refused at 5 by the
// judge and accepted by direct application. Coherent's rows_ok is what forbids
// stating such a type; the same rows under obs are descriptive and stay coherent.
liar_rows := perform (Observe (pair Self Bool)) ({_} => Pure t)
LiarTele := ({ #recognize := {_self, _v} => true, tele := liar_rows })
LiarObs := ({ #recognize := {_self, _v} => true, obs := const_fn liar_rows })
test LiarTele 5 = true
test Pi Guard Unit ({_} => LiarTele) ({_u} => 5) = false
test Pi Meta Unit ({_} => LiarTele) ({_u} => 5) = false
test Pi Guard Unit ({_} => LiarTele) ({_u} => true) = true
test Pi Guard Unit ({_} => LiarObs) ({_u} => 5) = true
test Coherent LiarTele = false
test Coherent LiarObs = true

// Space, the structured sub-universe: a member is a tag-form type (the wait
// and tag shape TypeFace keys on, so Space refines TypeFace) presenting
// declared structure: tele or obs rows, a registered eliminator, or a
// members enumeration. Bare predicates stay ShallowType-only. Shape, not
// provenance, like every recognizer here. Both universes carry the
// predicate obs row (apply to anything, land at Bool), so each is a member
// of itself and of the other, the same position ShallowType : ShallowType
// always held. Self-membership at recognizer strength is inert: neither
// universe carries gate or elim, so nothing can eliminate a universe
// hypothesis. Universe hierarchies become necessary exactly when a
// universe gains an eliminator; that is the door to re-examine, not the
// membership pins.
test Space Nat = true
test Space (Eq Nat 2 2) = true
test Space (Fn Nat ({_} => Bool)) = true
test Space (Sigma Guard Nat ({_} => Bool)) = true
test Space (Point 5) = true
test Space (Cell Nat) = true
test Space ShallowType = true
test Space Space = true
test Space (Pred ({_v} => true)) = false
test Space RawRecord = false
test Space Table = false
test Space node_like = false
test Space (Quotient Nat succ) = false
test Space (Named "cost" Nat) = false
test Space 5 = false
test Space (pair 5 (pair 1 (pair "recognize" ({ members := [t] })))) = false
test ShallowType Space = true
// Space-typed hypotheses ride the obs row as predicates, like ShallowType's.
test Fn Space ({_} => Bool) ({T} => T 5) = true
test Fn Space ({_} => Nat) ({T} => T 5) = false
// Space's check face refuses structure decided at a mint (a neutral name,
// spine node, or slot head in the meta record): a certificate must survive
// every instantiation, and only a literal skeleton makes the field reads
// stable. Mints below a literal slot head stay licensed (the formation
// certificates in the ask block ride exactly that).
test (Pi Guard Tree ({x} => Space)) ({x} => make_type ({ tele := x })) = false
test (Pi Guard Tree ({x} => Space)) ({x} => tag (pair "recognize" (pair [x, "tele"] [list_const t, list_const (pair 1 2)])) t) = false

list_len_t : Tree -> Nat
  := {xs} => tree_rec Nat xs zero ({_c, _ih} => zero) ({_l, _r, _il, ir} => succ ir)
list_snoc_t : Tree -> Tree -> Tree
  := {xs, x} => tree_rec Tree xs [x] ({_c, _ih} => t) ({l, _r, _il, ir} => cons Tree l ir)
list_map_t : (Tree -> Tree) -> Tree -> Tree
  := {f, xs} => tree_rec Tree xs [] ({_c, _ih} => t) ({l, _r, _il, ir} => cons Tree (f l) ir)
list_all_t : (Tree -> Bool) -> Tree -> Bool
  := {p, xs} => tree_rec Bool xs true ({_c, _ih} => false) ({l, _r, _il, ir} => bool_case Bool (p l) ir false)
test list_len_t [7, 7] = 2
test list_snoc_t [1] 2 = [1, 2]
test list_map_t succ [1, 2] = [2, 3]
test list_all_t is_leaf [t, t] = true
test list_all_t is_leaf [t, 2] = false
test Fn Tree ({_} => Bool) is_leaf = false

let list_mem := {ej, rj, A, v} => triage true ({_} => false) ({h, tl} => and (ej A h) (rj tl)) v
List : ShallowType -> Space := {A} => ({
  #recognize := {self, v} => list_mem ({ty, a} => ty a) self A v
  check := {jdg, T, v} => list_mem jdg ({a} => jdg T a) A v
  gate := {Ind, B} => [B [], PiCode A ({h} => PiCode Ind ({tl} => PiCode (B tl) ({_} => B (cons A h tl))))]
  elim := {self, xs, base, step} => triage base ({_} => base) ({h, tl} => step h tl (self tl base step)) xs
})
test Space (List Nat) = true

// A wrong-typed arm is refused. Type-variable hypotheses mint and apply to
// CONCRETES under both walkers; application to a NEUTRAL argument is refused
// by both -- a shared frontier (dependent application at abstract points),
// not a table gap.
test Fn ShallowType ({A} => Fn ShallowType ({B} => Fn (Fn A ({_} => B)) ({_} => Fn (List A) ({_} => List B)))) ({A, B, f, xs} => (elim_of (List A) ({_} => List B)) xs [] ({h, _tl, _ih} => h)) = false

// The public face: blessed over List's own eliminator, so application to a
// hypothesis stays inert (the kernel-internal list_rec stays raw for speed).
list_rec : {A : ShallowType} -> {C : ShallowType} -> List A -> C -> (arm 1 ((List A).gate (List A) (const_fn C))) -> C
  := {A, C} => elim_of (List A) ({_} => C)
// The Meta gap: abstract values cannot act as recognizers, so Meta refuses
// every type-polymorphic function, even the tautological one.
test Pi Meta ShallowType ({T} => Fn Tree ({_} => Bool)) ({T, v} => T v) = false
test Pi Guard ShallowType ({T} => Fn Tree ({_} => Bool)) ({T, v} => T v) = false
test Pi Meta ShallowType ({_} => Bool) ({T} => T 5) = true
list_samples : List Tree := [[], [1], [1, 2]]

let eff_mem := {ej, rj, Q, X, v} => (match v { Pure x => (ej X x); Op q k => (and (ej Q q) (rj (k t))); _ => false })
Eff : ShallowType -> ShallowType -> ShallowType -> Space
  := {Q, Ans, X} => ({
  #recognize := {self, v} => eff_mem ({ty, a} => ty a) self Q X v
  check := {jdg, T, v} => eff_mem jdg ({a} => jdg T a) Q X v
  gate := {Ind, B} => [PiCode X ({x} => B (Pure x)), PiCode Q ({q} => PiCode (PiCode Ans ({_} => Ind)) ({k} => PiCode (PiCode Ans ({r} => B (k r))) ({_} => B (Op (pair q k)))))]
  elim := {self, m, on_pure, on_op} => (match m { Pure x => (on_pure x); Op q k => (on_op q k ({r} => self (k r) on_pure on_op)) })
})
test Eff Row Tree Tree (PiCode Tree ({_} => Tree)).tele = true
test Eff Row Tree Tree (Sigma Guard Nat ({_} => Bool)).tele = true
test Eff Row Tree Tree (ShallowType.obs ShallowType) = true
test Eff Row Tree Tree 5 = false

// A telescope is just data: a free-monad program over Fresh/Observe rows.
// eff_bind is what the `x <- e` block sugar desugars to: graft k onto the
// Pure leaf. Junk (any non-Pure/non-Op tree) propagates unchanged, which is
// what makes `reject` abort a script from inside a computed branch.
eff_bind := fix ({self, m, k} =>
  if (has_sig "Pure" m) { k m.snd }
  else if (has_sig "Op" m) { Op (pair m.snd.fst ({r} => self (m.snd.snd r) k)) }
  else { m })
// One-observation program: project the subject with acc, judge against T,
// return the raw projection. `x <- see acc T` reads "observe it, call it x".
see : Tree -> ShallowType -> Eff Row Tree Tree
  := {acc, T} => perform (Observe (pair (Prj acc) T)) Pure
self_is : ShallowType -> Eff Row Tree Tree
  := {T} => perform (Observe (pair Self T)) Pure
done : Eff Row Tree Tree := Pure t
reject := t

add : Nat -> Nat -> Nat := {n, m} => nat_rec Nat n m ({k, ih} => succ ih)
not_bool : Bool -> Bool := {b} => bool_case Bool b false true
elim_id : Nat -> Nat := {n} => nat_rec Nat n zero ({k, ih} => succ ih)
test add 2 3 = 5
test add 0 4 = 4
test ShallowType Nat = true
test ShallowType (Nat -> Nat) = true

// 1. Lists: recursion at row-generation time, branching on the observed node.
list_rows : ShallowType -> Tree -> Eff Row Tree Tree
  := {A} => (fix ({self, get} => {
  node <- see get node_like
  if (is_leaf node) { done }
  else {
    _ <- see ({v} => (get v).fst) A
    self ({v} => (get v).snd)
  }
}))
ListR : ShallowType -> Space
  := {A} => Tele Guard (list_rows A ({v} => v))
test ListR Nat [] = true
test ListR Nat [1, 2] = true
test ListR Nat [1, t t] = false
test ListR Nat (t t) = false
// Structural pun, shared with the kernel's List: succ n = cons zero n, so a
// nat IS a list of zeros. Shallow types see trees, not intent.
test ListR Nat 5 = true
test List Nat 5 = true
test ListR (ListR Bool) [[true], []] = true
test ListR (ListR Bool) [[5]] = false

// 2. Vectors: same list, but the length is a parameter driving row generation.
vec_rows : ShallowType -> Nat -> Tree -> Eff Row Tree Tree
  := {A, n} => nat_rec (Fn Tree ({_} => Eff Row Tree Tree)) n
  ({get} => see get Unit)
  ({_k, ih, get} => {
    _ <- see get (Pred is_fork)
    _ <- see ({v} => (get v).fst) A
    ih ({v} => (get v).snd)
  })
Vec : Pi (Sampled [1]) Nat ({_} => Pi (Sampled [Bool]) ShallowType ({_} => Space))
  := {n, A} => Tele Guard (vec_rows A n ({v} => v))
test Vec 2 Bool [true, false] = true
test Vec 2 Bool [true] = false
test Vec 2 Bool [true, false, true] = false
test Vec 0 Bool [] = true

// Rows twin of RawRecord: observe the names list, then the payload spine at
// the observed length (vec_rows over a dependent parameter). Stricter than
// RawRecord on junk spines. Hypotheses answer the names projection only; the
// payload rows branch on the observed length, which stops at a mint. Conduct
// pins are Pi-Guard-literal: consuming a branching row program at a mint
// under Meta is the TreeOf simulator pathology.
raw_record_rows := {
  names <- see pair_fst (List Tree)
  vec_rows Tree (list_len Tree names) pair_snd
}
RawRecordRows : Space := Tele Guard raw_record_rows
test RawRecordRows ({ a := 1 }) = true
test RawRecordRows ({ a := 1, b := 2 }) = true
test RawRecordRows ({}) = true
test RawRecordRows (pair ["a"] t) = false
test RawRecordRows 5 = false
test (Pi Guard RawRecordRows ({_} => List Tree)) ({r} => r.fst) = true
test (Pi Guard RawRecordRows ({_} => Tree)) ({r} => r.snd) = false

// 3. Records with names: entries data -> one presence row + one field row each.
record_rows := fix ({self, entries} =>
  if (is_leaf entries) { done }
  else {
    let name := entries.fst.fst
    _ <- see ({r} => field_cell r name) (Pred is_fork)
    _ <- see ({r} => field r name) entries.fst.snd
    self entries.snd
  })
NamedRec : Pi (Sampled [[pair "x" Nat]]) (List Tree) ({_} => Space)
  := {entries} => Tele Guard (record_rows entries)
xy : List Tree := [pair "x" Nat, pair "y" Bool]
test NamedRec xy ({ x := 2, y := false }) = true
test NamedRec xy ({ x := 2 }) = false
test NamedRec xy ({ x := 2, y := 5 }) = false
test NamedRec xy ({ x := 2, y := false, z := 9 }) = true
test NamedRec [pair "step" (Nat -> Nat)] ({ step := succ }) = true
test NamedRec [pair "step" (Nat -> Nat)] ({ step := not_bool }) = false

// 4. Type-keyed records: keys are trees, so a type can be its own key.
TypeRec : Pi (Sampled [[Nat]]) (List Tree) ({_} => Space)
  := {tys} => NamedRec (list_map Tree Tree ({T} => pair T T) tys)
test TypeRec [Nat, Bool] ({ (Nat) := 7, (Bool) := false }) = true
test TypeRec [Nat, Bool] ({ (Nat) := false, (Bool) := false }) = false

// 5. Intersection: a list of predicates, all applied to the subject itself.
all_rows := fix ({self, tys} =>
  if (is_leaf tys) { done }
  else {
    _ <- self_is tys.fst
    self tys.snd
  })
AllOf : Pi (Sampled [[Nat]]) (List Tree) ({_} => Space)
  := {tys} => Tele Guard (all_rows tys)
test AllOf [Nat, Point 5] 5 = true
test AllOf [Nat, Point 5] 6 = false
test AllOf [] 5 = true

// 6. Unique application: each predicate must claim a distinct list element.
// The continuation searches for a bijection (untrusted), then emits one row
// per matched pair so every claim is re-judged by the checker.
splits := fix ({self, xs} =>
  if (is_leaf xs) { [] }
  else { cons Tree (pair xs.fst xs.snd)
              (list_map Tree Tree ({p} => pair p.fst (cons Tree xs.fst p.snd)) (self xs.snd)) })
bijection := fix ({self, tys, xs} =>
  if (is_leaf tys) { if (is_leaf xs) { [[]] } else { [] } }
  else { (fix ({try, cands} =>
    if (is_leaf cands) { [] }
    else {
      let c := cands.fst
      let rest := if (tys.fst c.fst) { self tys.snd c.snd } else { [] }
      if (is_leaf rest) { try cands.snd }
      else { [cons Tree (pair tys.fst c.fst) rest.fst] }
    })) (splits xs) })
unique_rows := {tys} => {
  v <- self_is (List Tree)
  let m := bijection tys v
  if (is_leaf m) { reject }
  else { (fix ({go, asg} =>
    if (is_leaf asg) { done }
    else {
      _ <- see ({_} => asg.fst.snd) asg.fst.fst
      go asg.snd
    })) m.fst }
}
UniqueOf : Pi (Sampled [[Point 5]]) (List Tree) ({_} => Space)
  := {tys} => Tele Guard (unique_rows tys)
test UniqueOf [Point 5, Point 6] [6, 5] = true
test UniqueOf [Point 5, Point 6] [5, 5] = false
test UniqueOf [Tree, Point 5] [5, 7] = true
test UniqueOf [Tree, Tree] [5] = false

// 7. Tree checkers: branch at each node, sequence the two child programs.
tree_rows : ShallowType -> Tree -> Eff Row Tree Tree
  := {LeafTy} => (fix ({self, get} => {
  node <- see get node_like
  if (is_fork node) {
    _ <- self ({v} => (get v).fst)
    self ({v} => (get v).snd)
  } else { see get LeafTy }
}))
TreeOf : Pi Guard ShallowType ({_} => Space)
  := {LeafTy} => Tele Guard (tree_rows LeafTy ({v} => v))
test TreeOf Unit (pair (pair t t) t) = true
test TreeOf Unit (pair (t t) t) = false

// 8. Trees with different kinds of sub-objects at tagged nodes.
MixedCode : List Tree := < Leaf : t, Node : t >
mixed_rows := fix ({self, get} => {
  node <- see get (Pred is_fork)
  if (tree_eq node.fst "Leaf") {
    see ({v} => (get v).snd) Bool
  } else if (tree_eq node.fst "Node") {
    _ <- see ({v} => ((get v).snd).fst) Nat
    _ <- self ({v} => (((get v).snd).snd).fst)
    self ({v} => (((get v).snd).snd).snd)
  } else { reject }
})
MixedTree : Space := Tele Guard (mixed_rows ({v} => v))
test MixedTree (Leaf false) = true
test MixedTree (Node (pair 2 (pair (Leaf false) (Leaf false)))) = true
test MixedTree (Node (pair false (pair (Leaf false) (Leaf false)))) = false
test MixedTree (Node (pair 2 (pair (Leaf 5) (Leaf false)))) = false
test MixedTree 5 = false

// 9. Perfect trees of depth n: no data branching at all, pure parameter recursion.
// Stays raw: the left child's program is sequenced mid-program, and eff_bind
// inspects its subject, so a neutral IH refuses there (the eff_bind class);
// only tail-position recursion certifies (vec_rows above).
perfect_rows := fix ({self, n, get} =>
  if (is_leaf n) { see get Unit }
  else {
    _ <- see get (Pred is_fork)
    _ <- self n.snd ({v} => (get v).fst)
    self n.snd ({v} => (get v).snd)
  })
Perfect : Pi (Sampled [1]) Nat ({_} => Space)
  := {n} => Tele Guard (perfect_rows n ({v} => v))
test Perfect 1 (pair t t) = true
test Perfect 2 (pair (pair t t) (pair t t)) = true
test Perfect 2 (pair (pair t t) t) = false

// 10. Balanced trees: observe a computed measure, constrain it with a type.
height : Pi (Sampled [pair t t]) Tree ({_} => Nat)
  := fix ({self, v} =>
  if (is_fork v) {
    let hl := self v.fst
    let hr := self v.snd
    succ (if (nat_le hl hr) { hr } else { hl })
  } else { zero })
near : ShallowType := Pred ({p} => and (nat_le p.fst (succ p.snd)) (nat_le p.snd (succ p.fst)))
bal_rows : Tree -> Eff Row Tree Tree
  := fix ({self, get} => {
  node <- see get node_like
  if (is_leaf node) { done }
  else {
    _ <- see ({v} => pair (height ((get v).fst)) (height ((get v).snd))) near
    _ <- self ({v} => (get v).fst)
    self ({v} => (get v).snd)
  }
})
Balanced : Space := Tele Guard (bal_rows ({v} => v))
test Balanced t = true
test Balanced (pair t t) = true
test Balanced (pair (pair t t) t) = true
test Balanced (pair (pair (pair t t) t) t) = false
test Balanced (pair (pair (pair t t) (pair t t)) (pair t t)) = true

// 11. Dependent record: the observed value of one field shapes another field's rows.
len_xs_rows := {
  _ <- see ({r} => field_cell r "len") (Pred is_fork)
  n <- see ({r} => field r "len") Nat
  vec_rows Bool n ({r} => field r "xs")
}
LenXs : Space := Tele Guard len_xs_rows
test LenXs ({ len := 2, xs := [true, false] }) = true
test LenXs ({ len := 1, xs := [true, false] }) = false
test LenXs ({ len := 3, xs := [true, false] }) = false
test LenXs ({ xs := [true] }) = false
