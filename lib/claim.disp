// Checked claims, lenses, and CEGIS library (`Option`-typed CEGIS, clean `Lens.*` / `Claim.*` names).
open use "std.disp"
open use "verdict.disp"
open use "stream.disp"
let CMod := use raw "core/claim.disp" {}

Claim : Type := Tree -> Tree -> Bool
Lens : Type := Pair(Tree -> Tree, Tree -> Tree -> Tree)
CallChallenge : Type := Pair(Tree, Tree)

let length_cert := certify(check_depth, check_fuel, "all", [], [
	pair("length_t", pair(List(Tree) -> Nat, length))
])
let stream_honest_cert := certify(check_depth, check_fuel, "all", [], [
	pair("items_filter", pair(AnyItemCoalg(Tree, Tree) -> (Tree -> Bool) -> ItemCoalg(Tree, Tree), Items.filter)),
	pair("items_bounded", pair(ItemCoalg(Tree, Tree) -> Nat -> ItemCoalg(Budget(Tree), Tree), Items.bounded)),
	pair("items_verdict", pair(PartialFn(ItemCoalg(Budget(Tree), Tree), Verdict), Items.verdict))
])
let stream_over_cert := certify(check_depth, check_fuel, "all", [length_cert], [
	pair("stopping_list", pair(List(Tree) -> AnyStoppingOf(List(Tree), Tree), Stopping.from_list)),
	pair("stopping_filter", pair(AnyStoppingOf(List(Tree), Tree) -> (Tree -> Bool) -> StoppingOf(List(Tree), Tree), Stopping.filter)),
	pair("stopping_settle", pair(StoppingOf(List(Tree), Tree) -> ItemCoalg(Budget(List(Tree)), Tree), Stopping.settle)),
	pair("items_verdict_l", pair(PartialFn(ItemCoalg(Budget(List(Tree)), Tree), Verdict), Items.verdict))
])
let verdict_lems := certify(check_depth, check_fuel, "all", [], [
	pair("is_refuted", pair(Verdict -> Bool, Verdict.is_refuted)),
	pair("counterexample", pair(Verdict -> Option(Tree), Verdict.counterexample))
])
honest_cert := certify(check_depth, check_fuel, "all", [stream_honest_cert], [
	pair("Claim.honest", pair(PartialFn(AnyItemCoalg(Tree, Tree), PartialFn(Claim, PartialFn(Tree, PartialFn(Nat, Verdict)))), CMod.honest))
])
over_cert := certify(check_depth, check_fuel, "all", [stream_over_cert], [
	pair("Claim.over", pair(PartialFn(Claim, PartialFn(Tree, PartialFn(List(Tree), Verdict))), CMod.over))
])
let check_module := check_with(check_depth, check_fuel, "fix", [stream_honest_cert, honest_cert, verdict_lems])

// Lenses & call challenges (all structurally total)
Lens.new : (Tree -> Tree) -> (Tree -> Tree -> Tree) -> Lens := CMod.lens
Lens.fwd : Lens -> Tree -> Tree := {l} => l.fst
Lens.back : Lens -> Tree -> Tree -> Tree := {l} => l.snd
Lens.holds : Claim -> Claim -> Lens -> Claim := CMod.lens_holds
Lens.then_lens : Lens -> Lens -> Lens := CMod.lens_then

CallChallenge.new : Tree -> Tree -> CallChallenge := CMod.call_with
CallChallenge.arg : CallChallenge -> Tree := {c} => c.fst
CallChallenge.on_result : CallChallenge -> Tree := {c} => c.snd

Claim.implies : Claim -> Claim -> Lens -> CallChallenge -> Bool := CMod.implies

// Bounded honest checking & finite-challenge checking (verified independently above)
Claim.honest := CMod.honest
Claim.over := CMod.over
honest_verified : The(Bool, true) := is_cert(honest_cert)
over_verified : The(Bool, true) := is_cert(over_cert)

// Counterexample-guided search returning `Pair(Option(Tree), List(Tree))` (`Some(cand)` or `None`)
rec Claim.cegis : AnyItemCoalg(Tree, Tree) -> Claim -> List(Tree) -> List(Tree) -> Nat -> Pair(Option(Tree), List(Tree)) := {source, claim, pool, kept, budget} =>
	if (pool.is_nil) { pair(None, kept) }
	else if (not(List.all(kept, {c} => claim(pool.head, c)))) { Claim.cegis(source, claim, pool.tail, kept, budget) }
	else {
		let v := CMod.honest(source, claim, pool.head, budget)
		let ce := Verdict.counterexample(v)
		if (ce.fst == "Some") { Claim.cegis(source, claim, pool.tail, cons(ce.snd, kept), budget) }
		else { pair(Some(pool.head), kept) }
	}
