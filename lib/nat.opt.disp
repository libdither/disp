// Verified single-triage optimization overlay for `lib/nat.disp`.
open use "kernel/prelude.disp"
open use "option.disp"
open use "nat.disp"

// Capture spec `Nat.add` before rebinding it so `Nat.dbl`'s spec lemma matches its exact closure.
let nat_add_old := Nat.add

// Single-triage 1-arg-fix Nat addition (4.35x fewer steps than recursive `if (is_zero(a))`)
let nat_add_fast : Nat -> Nat -> Nat := {a, b} =>
	fix({go, x} => triage(b, {_} => b, {_l, k} => succ(go(k)), x))(a)
let rec pf_nat_add := {a, b} =>
	if (is_zero(a)) { t } else { pf_nat_add(nat_pred(a), b) }
Nat.add := { new := nat_add_fast; proof := pf_nat_add }

// Direct single-triage doubling (4.23x fewer steps than `Nat.add(n, n)`)
let nat_dbl_fast : Nat -> Nat := fix({go, n} => triage(zero, {_} => zero, {_l, k} => succ(succ(go(k))), n))
let rec pf_add_succ_r := {a, b} =>
	if (is_zero(a)) { t } else { pf_add_succ_r(nat_pred(a), b) }
let add_succ_r_cert := certify(check_depth, check_fuel, "all", [], [
	pair("add_succ_r", pair({a : Nat} -> {b : Nat} -> Eq(nat_add_old(a, succ(b)), succ(nat_add_old(a, b))), pf_add_succ_r))
])
let rec pf_nat_dbl := {n} =>
	if (is_zero(n)) { t }
	else { seq(pf_nat_dbl(nat_pred(n)), pf_add_succ_r(nat_pred(n), nat_pred(n))) }
Nat.dbl := { new := nat_dbl_fast; proof := pf_nat_dbl; certs := [add_succ_r_cert] }

// Single-triage saturating subtraction (1 triage per arg per step instead of 3)
let nat_sat_sub_fast : Nat -> Nat -> Nat := fix({go, a, b} =>
	triage(a, {_} => a, {_l, bk} => triage(zero, {_} => zero, {_l2, ak} => go(ak, bk), a), b))
let rec pf_nat_sat_sub := {a, b} =>
	if (is_zero(a)) { if (is_zero(b)) { t } else { t } }
	else if (is_zero(b)) { t }
	else { pf_nat_sat_sub(nat_pred(a), nat_pred(b)) }
Nat.saturating_sub := { new := nat_sat_sub_fast; proof := pf_nat_sat_sub }

// Single-triage checked subtraction returning `Option(Nat)`
let nat_chk_sub_fast : Nat -> Nat -> Option(Nat) := fix({go, a, b} =>
	triage(Some(a), {_} => Some(a), {_l, bk} => triage(None, {_} => None, {_l2, ak} => go(ak, bk), a), b))
let rec pf_nat_chk_sub := {a, b} =>
	if (is_zero(a)) { if (is_zero(b)) { t } else { t } }
	else if (is_zero(b)) { t }
	else { pf_nat_chk_sub(nat_pred(a), nat_pred(b)) }
Nat.checked_sub := { new := nat_chk_sub_fast; proof := pf_nat_chk_sub }
