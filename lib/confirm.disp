// The confirmer behind TYPES.html: a symbolic checker for claims about functions,
// quotients and streams. A partly-known value is a tree with holes, each a named
// symbol ("some member, unnamed") or an application nobody can run; a symbolic
// evaluator over them reports answered / need / stuck; a search splits a needed
// symbol along its type's constructor table; induction is
// licensed only on a strictly smaller input-derived piece; equality compares
// normal forms at the codomain after judging membership; streams are compared by
// one bisimulation step. Verdicts are "Proved", `refuted w` (w re-run
// concretely), or "Open" with a reason. Every Proved is cross-checked in
// lib/tests/confirmer.test.disp against the enumeration refuter (IDEAS.disp's Arrow). The successor of
// the v1 confirmer (CHECK.disp, deleted after fe53c8a), whose known gaps it closes:
//   A  split tables are Option: no table => the search does NOT split (Open);
//      `some []` only for a declared empty grammar (False: vacuous Proved).
//      The search splits only a NEED of a positive input symbol.
//   B  a GRADE: a judge at an identity-fine position (Tree) refuses a value
//      with a free symbol of a coarser (arrow/quotient) code; the driver then
//      grounds it on a stored related-but-distinct pair and refutes concretely.
//   C  induction licenses only "In" symbols (never Out/Rec) strictly below the
//      root; a codomain-split symbol would be an Out symbol and is rejected.
//   D  quotient respect uses the NORMALIZER: f a ~ f (nf a); `nf k` on a
//      sub-symbol is a neutral term App nf [k] that the hypothesis' partner
//      clause consumes. The generator form is kept only as the reproduction.
//   E  equality judges BOTH outputs at the codomain before comparing terms.
//   F  an undeclared recognizer is judged by RUNNING it (fueled): a looping
//      recognizer makes membership Open there, never Proved or Refuted.
//   G  symbols carry a root id: a curried claim's two arguments are distinct.
//   H  fuel bounds DISPATCHES (state-passed), not depth.
//   I  a marker-shaped tree a program builds is escaped as an opaque Forged hole.
open use raw "prelude.disp" {}
open use raw "list.disp" {}
open use raw "verdict.disp" {}
open use raw "machine.disp" {}
open use raw "stream.disp" {}
open use raw "trees.disp" {}
open use raw "tests/fixtures.disp" {}

// ---------------------------------------------------------------- codes
// A code is a positive recognizer (a declared grammar: Nat, Tree, Bool, False)
// or a negative former (arrow, quotient). Only positive codes split, and only
// positive codes are identity-fine (their relation is tree_eq).
TreeR :: {v : Tree} -> Bool :=> true
FalseR :: {v : Tree} -> Bool :=> false
// (NatR, LoopR and the quotient normalizers come from fixtures.disp; Bool, the
// recognizer {t, t t}, from trees.disp)
ArrowC :: {Dom : Code, Cod : Code} -> Code :=> pair("Arrow", pair(Dom, Cod))
QuotC :: {Base : Code, nf : Tree} -> Code :=> pair("Quot", pair(Base, nf))
is_arrow_code :: Code -> Bool := {c} => c.fst == "Arrow"
is_quot_code :: Code -> Bool := {c} => c.fst == "Quot"
arrow_dom :: Code -> Code := {c} => c.snd.fst
arrow_cod :: Code -> Code := {c} => c.snd.snd
quot_base :: Code -> Code := {c} => c.snd.fst
quot_nf :: Code -> Tree := {c} => c.snd.snd
// the declared quotients: Parity (mod 2) and All (every Nat identified)
Parity := QuotC(NatR, parity)
All := QuotC(NatR, always_zero)
normalizers := [Parity, All].map(quot_nf)

some :: {x : Tree} -> Option(Tree) :=> pair("Some", x)
none :: Option(Tree) := "None"
is_none :: Option(Tree) -> Bool := {o} => o == none

// A code may also be a type given by its behaviour: the one extension point, so a new
// type former is a record and nothing below changes for it. Each behaviour receives the
// type's own code first, so a recursive type refers to itself without building itself.
// `admits` judges a partly-known value (a symbol of the type itself, a neutral term and
// an induction token are handled before it is asked); `cases` gives the shapes a member
// can take, for a type whose symbols may be split; `applied` makes it a function type, with
// the codomain a family over the argument's faces (what a program receives, and what a
// dependent type sees); `generic` is the argument a function over it receives at a
// position (a symbol of it, unless given); `static` is what a dependent type sees of a
// value (the value itself, unless given); `types` says its members are types.
record behaviour :: {admits : Code -> Val -> Res, cases : Option(Tree) := none, applied : Option(Pair(Code, Tree)) := none, generic : Option(Tree) := none, static : Option(Tree) := none, types : Bool := false} -> Behaviour
of_type :: {b : Behaviour} -> Code :=> pair("Type", b)
is_type_code :: Code -> Bool := {c} => c.fst == "Type"
// a code as a function type: some(pair(domain, family)), the family taking the argument's faces
fn_view :: Code -> Option(Pair(Code, Tree)) := {c} =>
	if (is_arrow_code(c)) { some(pair(arrow_dom(c), {_x} => arrow_cod(c))) }
	else if (is_type_code(c)) { c.snd.applied }
	else { none }
is_fn_code :: Code -> Bool := {c} => not(is_none(fn_view(c)))
static_of :: {T : Code, v : Val} -> Tree :=> if ((is_type_code(T)) && (not(is_none(T.snd.static)))) { T.snd.static.snd(T, v) } else { v }
// an argument's two faces: the value a program receives, and what dependent types see of it
faces_of :: {T : Code, v : Val} -> Pair(Val, Tree) :=> pair(v, static_of(T, v))

// ---------------------------------------------------------------- values
// A partly-known value is a plain tree with holes in it: a fully known value is itself,
// and equal values are equal trees. A hole is `wait(hole_marker, what)` (built like the
// kernel's hypotheses, lib/kernel/kernel.disp), and applying one natively gives the hole
// for that application. What a hole stands for:
//   Sym T name    an unknown member of T, named, so two occurrences of one unknown are one
//                 tree. Names are kind, root id, path: `In root path` is the argument `root`
//                 reached by `path` (destructor steps, newest first); `Rec root path` is the
//                 recursive call's value on that input; `Out` would be minted from a
//                 function's OUTPUT (a codomain split) and never licenses induction; `Var`
//                 is a pattern variable.
//   App head arg  an application nobody can run (a neutral term)
//   AssumedFn     the induction hypothesis: the recursive function, applicable ONLY below
//                 `root` (or to the `partner` of something below it: the quotient's hypothesis)
//   Forged        a marker-shaped tree a program built (below)
hole_marker := fix({self, what, arg} => wait(self, pair("App", pair(wait(self, what), arg))))
hole :: {what : Tree} -> Val :=> wait(hole_marker, what)
hole_sig := (hole(t)).fst
is_hole :: Val -> Bool := {v} => if (is_fork(v)) { v.fst == hole_sig } else { false }
hole_what :: Val -> Tree := {h} => h.snd.snd
// fully known: no hole anywhere inside
rec is_known :: {v : Val} -> Bool :=>
	if (is_hole(v)) { false }
	else if (is_leaf(v)) { true }
	else if (is_stem(v)) { is_known(stem_child(v)) }
	else if (is_known(v.fst)) { is_known(v.snd) }
	else { false }
// a fork that is not a hole (holes are forks; the leaf and stems are always shapes)
is_fork_shaped :: Val -> Bool := {v} => if (is_fork(v)) { not(is_hole(v)) } else { false }
// A program can build a marker-shaped tree on purpose. That tree is no hole of ours, so
// wherever a program's tree enters (a checked program, a native run's answer, a fork the
// stem rule builds) it is wrapped whole as a Forged hole, which every judge finds opaque.
forged :: {v : Tree} -> Val :=> hole(pair("Forged", v))
rec escape :: {v : Tree} -> Val :=>
	if (is_known(v)) { v }
	else if (is_hole(v)) { forged(v) }
	else if (is_stem(v)) { t(escape(stem_child(v))) }
	else { t(escape(v.fst), escape(v.snd)) }
mk_fork :: {a : Val, b : Val} -> Val :=> if (a == hole_sig) { forged(t(a, b)) } else { t(a, b) }

sym :: {T : Code, name : Tree} -> Val :=> hole(pair("Sym", pair(T, name)))
in_sym_at :: {T : Code, root : Nat, path : List(Tree)} -> Val :=> sym(T, pair("In", pair(root, path)))
in_sym :: {T : Code, path : List(Tree)} -> Val :=> in_sym_at(T, 0, path)
rec_sym :: {T : Code, path : List(Tree)} -> Val :=> sym(T, pair("Rec", pair(0, path)))
out_sym :: {T : Code, path : List(Tree)} -> Val :=> sym(T, pair("Out", pair(0, path)))
var_sym :: {name : Tree} -> Val :=> sym(t, pair("Var", pair(0, name)))
app_val :: {head : Val, arg : Val} -> Val :=> hole(pair("App", pair(head, arg)))
assumed_fn :: {Dom : Code, Cod : Code, root : List(Tree), partner : Val -> Val} -> Val :=> hole(pair("AssumedFn", pair(Dom, pair(Cod, pair(root, partner)))))

is_hole_of :: {kind : Tree, v : Val} -> Bool :=> if (is_hole(v)) { v.hole_what.fst == kind } else { false }
is_sym :: Val -> Bool := is_hole_of("Sym")
is_app :: Val -> Bool := is_hole_of("App")
is_token :: Val -> Bool := is_hole_of("AssumedFn")
sym_type :: Val -> Code := {s} => s.hole_what.snd.fst
sym_name :: Val -> Tree := {s} => s.hole_what.snd.snd
sym_kind :: Val -> Tree := {s} => s.sym_name.fst
sym_root :: Val -> Nat := {s} => s.sym_name.snd.fst
sym_path :: Val -> List(Tree) := {s} => s.sym_name.snd.snd
is_in_sym :: Val -> Bool := {v} => if (v.is_sym) { v.sym_kind == "In" } else { false }
is_var :: Val -> Bool := {v} => if (v.is_sym) { v.sym_kind == "Var" } else { false }
app_head :: Val -> Val := {a} => a.hole_what.snd.fst
app_arg :: Val -> Val := {a} => a.hole_what.snd.snd
token_dom := {tok} => tok.hole_what.snd.fst
token_cod := {tok} => tok.hole_what.snd.snd.fst
token_root := {tok} => tok.hole_what.snd.snd.snd.fst
token_partner := {tok} => tok.hole_what.snd.snd.snd.snd

// the split table of a code: `none` for codes without a declaration (arrows,
// quotients, unknown recognizers), `some []` only for a declared empty grammar
table :: {R : Code, child : Tree -> Val} -> Option(List(Val)) :=>
	if (R == NatR) { some([t, t(t, child("pred"))]) }
	else if (R == TreeR) { some([t, t(child("child")), t(child("left"), child("right"))]) }
	else if (R == Bool) { some([t, t(t)]) }
	else if (R == FalseR) { some([]) }
	else if ((is_type_code(R)) && (not(is_none(R.snd.cases)))) { some(R.snd.cases.snd(R, child)) }
	else { none }
is_positive :: Code -> Bool := {R} => not(is_none(table(R, {_} => t)))
// identity-fine (the relation is tree_eq): exactly the declared grammars
is_fine :: Code -> Bool := is_positive
// the search may split exactly the INPUT symbols of a positive code
is_splittable :: Val -> Bool := {v} => if (v.is_in_sym) { is_positive(v.sym_type) } else { false }

// ---------------------------------------------------------------- outcomes
// A run either answers, NEEDS the shape of a splittable symbol (a case split
// can resolve it), or is stuck: bare `stuck` for fuel or a missing license,
// `stuck_on (pair why value)` when an opaque value was inspected or judged —
// stuck is never a verdict and never split. Judgements reuse the vocabulary
// plus Yes/No and `coarse s`: the value is fine-shaped but carries the free
// symbol s of a coarser code (the grade rule). "No" is reserved for a GENUINE
// counterexample (on a ground input it refutes).
answered :: {v : Val} -> Res :=> pair("Answered", v)
need :: {s : Val} -> Res :=> pair("Need", s)
stuck :: Res := "Stuck"
stuck_on :: {reason : Tree} -> Res :=> pair("Stuck", reason)
coarse :: {s : Val} -> Res :=> pair("Coarse", s)
is_answered :: Res -> Bool := {r} => r.fst == "Answered"
is_need :: Res -> Bool := {r} => r.fst == "Need"
is_stuck :: Res -> Bool := {r} => (r == stuck) || (r.fst == "Stuck")
answer :: Res -> Val := pair_snd
and_then :: {r : Res, continue : Val -> Res} -> Res :=> if (r.is_answered) { continue(r.answer) } else { r }
and_yes :: {r : Res, continue : Tree -> Res} -> Res :=> if (r == "Yes") { continue(t) } else { r }
// inspecting a value: a splittable symbol is a Need; an input symbol without
// a table, a hypothesis value or a neutral term is opaque — Stuck with a reason
// the function at the bottom of a neutral term
rec spine_head :: {v : Val} -> Val :=> if (v.is_app) { spine_head(v.app_head) } else { v }
inspect :: Val -> Res := {v} =>
	if (v.is_splittable) { need(v) }
	else if (v.is_in_sym) { stuck_on(pair("no split table", v)) }
	// an application of a function symbol that can be split (a finite function type) waits on that split
	else if ((v.is_app) && (spine_head(v).is_splittable)) { need(spine_head(v)) }
	else { stuck_on(pair("opaque value", v)) }

// ---------------------------------------------------------------- matching
// First-order matching of a pattern (a value whose Var symbols bind) against a
// term: variables bind consistently, equal trees match, shapes match child by
// child, neutral terms match head by tree_eq then argument, a splittable symbol
// where the pattern has a shape is a Need. Answers the environment (a list of
// pair var value).
rec match_val :: {pattern : Val, term : Val, env : List(Pair(Val, Val))} -> Res :=>
	if (pattern.is_var) {
		let bound := env.filter({e} => e.fst == pattern)
		if (bound.is_nil) { answered(cons(pair(pattern, term), env)) }
		else if (bound.head.snd == term) { answered(env) } else { "Unrelated" }
	}
	else if (pattern == term) { answered(env) }
	else if (pattern.is_app) {
		if ((term.is_app) && (pattern.app_head == term.app_head)) { match_val(pattern.app_arg, term.app_arg, env) }
		else { "Unrelated" }
	}
	else if (is_hole(pattern)) { "Unrelated" }
	else if (term.is_splittable) { need(term) }
	else if (is_stem(pattern)) { if (is_stem(term)) { match_val(stem_child(pattern), stem_child(term), env) } else { "Unrelated" } }
	else if ((pattern.is_fork_shaped) && (term.is_fork_shaped)) {
		and_then(match_val(pattern.fst, term.fst, env), {env2} => match_val(pattern.snd, term.snd, env2))
	}
	else { "Unrelated" }

// ---------------------------------------------------------------- the licenses
// succ^k (in_sym q) IS the symbol q lost its last k "pred" steps to (it only
// exists in the branch where that symbol split as a succ) — fold it back so
// the induction license sees the symbol itself
rec canon :: {v : Val} -> Val :=>
	if ((v.is_fork_shaped) && (is_leaf(v.fst))) {
		let inner := canon(v.snd)
		if (((inner.is_in_sym) && (not(inner.sym_path.is_nil))) && (inner.sym_path.head == "pred")) {
			in_sym_at(inner.sym_type, inner.sym_root, inner.sym_path.tail)
		} else { v }
	} else { v }

// paths are newest-first, so `longer` strictly extends `shorter` when `shorter`
// is a proper suffix of it
rec is_strict_ext :: {longer : List(Tree), shorter : List(Tree)} -> Bool :=>
	if (longer.is_nil) { false }
	else if (longer.tail == shorter) { true }
	else { is_strict_ext(longer.tail, shorter) }

// the induction hypothesis may be assumed on a strict structural descendant of
// the root input — an INPUT symbol (never an Out or Rec one) of the domain
// code, of the induction root (root id 0), on a path strictly below the root's
// — or on that descendant's `partner` (for a quotient, the hypothesis says the
// two calls on a related pair below root AGREE, so both get the same name)
// a codomain may depend on the argument: `family_code(fam)` gives the hypothesis at c the type fam(c's faces)
family_code :: {fam : Tree} -> Code :=> pair("Family", fam)
cod_at :: {Cod : Code, c : Val} -> Code :=> if (Cod.fst == "Family") { Cod.snd(pair(c, c)) } else { Cod }
apply_ih_at :: {Dom : Code, Cod : Code, root : List(Tree), partner : Val -> Val, x : Val} -> Res :=> {
	let license := {c} =>
		if (((c.is_in_sym) && (c.sym_type == Dom)) && ((c.sym_root == 0) && (is_strict_ext(c.sym_path, root)))) { answered(rec_sym(cod_at(Cod, c), c.sym_path)) }
		else { stuck }
	let direct := license(canon(x))
	if (direct.is_answered) { direct }
	else {
		let peeled := match_val(partner(var_sym("a")), x, [])
		if ((peeled.is_answered) && (not(peeled.answer.is_nil))) { license(canon(peeled.answer.head.snd)) } else { stuck }
	}
}
apply_ih :: {C : Code, root : List(Tree), partner : Val -> Val, x : Val} -> Res :=> apply_ih_at(C, C, root, partner, x)
same :: Val -> Val := {a} => a

// ---------------------------------------------------------------- the evaluator
// The substrate's three rules over partly-known values. Fuel is a STEP budget
// threaded through every sub-run (each dispatch spends one), so an exponential
// sub-computation runs out of fuel instead of out of time; a fully known one runs
// on the native machine against the same budget. Only the triage
// rule and the function position inspect a value, so those are the only places
// a symbol can be needed — everything else copies symbols by name. A negative
// symbol or neutral term in function position makes a neutral term; a declared
// normalizer applied to a sub-symbol it would need makes one too (the quotient
// hypothesis consumes it).
rec nat_drop :: {k : Nat, n : Nat} -> Nat :=> if (is_zero(k)) { n } else { nat_drop(nat_pred(k), nat_pred(n)) }
/// a fully known run on the native machine, in chunks that double, each continuing where the last paused: at most twice its steps are charged
rec run_native :: {m : Machine, chunk : Nat, fuel : Nat} -> Pair(Res, Nat) :=>
	if (m_finished(m)) { pair(answered(escape(m_result(m))), fuel) }
	else if (is_zero(fuel)) { pair(stuck, 0) }
	else {
		let k := if (nat_le(chunk, fuel)) { chunk } else { fuel }
		run_native(m_advance(m, k), dbl(chunk), nat_drop(k, fuel))
	}
rec sapply_s :: {f : Val, x : Val, fuel : Nat} -> Pair(Res, Nat) :=> {
	let go := {a, b, left} => sapply_s(a, b, left)
	let bind := {rf, continue} => if (rf.fst.is_answered) { continue(rf.fst.answer, rf.snd) } else { rf }
	let stop := {r, left} => pair(r, left)
	let left0 := nat_pred(fuel)
	let rule_s := {w, y} => bind(go(w, x, left0), {wx, l1} => bind(go(y, x, l1), {yx, l2} => go(wx, yx, l2)))
	let rule_triage := {on_leaf, on_stem, on_fork} =>
		// the identity compiles to the triage that REBUILDS its argument (t, t, t):
		// that is x for every tree, so a symbol may pass through unseen
		if (((is_leaf(on_leaf)) && (is_leaf(on_stem))) && (is_leaf(on_fork))) { stop(answered(x), left0) }
		else if (is_leaf(x)) { stop(answered(on_leaf), left0) }
		else if (is_stem(x)) { go(on_stem, stem_child(x), left0) }
		else if (x.is_fork_shaped) { bind(go(on_fork, x.fst, left0), {r, l1} => go(r, x.snd, l1)) }
		else { stop(inspect(x), left0) }
	// f = fork(left, right): left's shape picks the rule
	let by_left := {left, right} =>
		if (is_leaf(left)) { stop(answered(right), left0) }
		else if (is_stem(left)) { rule_s(stem_child(left), right) }
		else if (left.is_fork_shaped) { rule_triage(left.fst, left.snd, right) }
		else { stop(inspect(left), left0) }
	if (is_zero(fuel)) { stop(stuck, 0) }
	else if (if (is_known(f)) { is_known(x) } else { false }) { run_native(m_start(f, x), 1, fuel) }
	else if (is_leaf(f)) { stop(answered(t(x)), left0) }
	else if (is_stem(f)) { stop(answered(mk_fork(stem_child(f), x)), left0) }
	else if (f.is_fork_shaped) {
		let ran := by_left(f.fst, f.snd)
		// a declared normalizer on a sub-symbol it needs: the neutral term `nf k`
		if (((x.is_in_sym) && (not(x.sym_path.is_nil))) && (((ran.fst == need(x)) || (ran.fst.is_stuck)) && (normalizers.member(f)))) { stop(answered(app_val(f, x)), ran.snd) }
		else { ran }
	}
	else if (f.is_token) { stop(apply_ih_at(f.token_dom, f.token_cod, f.token_root, f.token_partner, x), left0) }
	// a hole applied is the hole for that application
	else if (((f.is_sym) && (is_fn_code(f.sym_type))) || (f.is_app)) { stop(answered(f(x)), left0) }
	else { stop(inspect(f), left0) }
}
sapply :: {f : Val, x : Val, fuel : Nat} -> Res :=> (sapply_s(f, x, fuel)).fst
run_fuel := 4000
split_depth := 3

// ---------------------------------------------------------------- judging
// judge a partly-known value AT a code. A symbol of the code itself is a Yes;
// a splittable symbol of another code is a Need (a split tells); any other
// symbol is opaque. Neutral terms are judged by the ARROW rule: App h [x] at
// C when h's code is D -> C and x is judged at D. Data codes have hand-written
// shape judges; an undeclared recognizer is judged by RUNNING it, fueled.
// a neutral term's type: its head symbol's, through the codomain at each argument
rec neutral_type :: {v : Val} -> Option(Code) :=>
	if (v.is_sym) { some(v.sym_type) }
	else if (not(v.is_app)) { none }
	else {
		let head := neutral_type(v.app_head)
		let view := if (is_none(head)) { none } else { fn_view(head.snd) }
		if (is_none(view)) { none } else { some(view.snd.snd(faces_of(view.snd.fst, v.app_arg))) }
	}
// every argument along a neutral term's spine is in its domain; `at` judges
rec spine_args :: {at : Tree, v : Val} -> Res :=>
	if (not(v.is_app)) { "Yes" }
	else { and_yes(spine_args(at, v.app_head), {_y} => at(fn_view(neutral_type(v.app_head).snd).snd.fst, v.app_arg)) }
rec judge_as :: {R : Code, val : Val} -> Res :=> {
	let at := {R2, v} => judge_as(R2, v)
	let sym_rule := {v} => if (v.sym_type == R) { "Yes" } else { inspect(v) }
	// a neutral term is in R when its type is R and every argument along it is in its domain;
	// outside a domain the head's behaviour is unconstrained, so that is blamed on the head
	let app_rule := {v} =>
		if (neutral_type(v) == some(R)) {
			let args := spine_args(at, v)
			if (args == "No") { stuck_on(pair("argument outside the domain", v.app_head)) } else { args }
		}
		else { stuck_on(pair("opaque value", v)) }
	let opaque := {v} => stuck_on(pair("opaque value", v))
	let leaf := {v} =>
		if (is_leaf(v)) { "Yes" }
		else if (v.is_sym) { inspect(v) }
		else if (is_hole(v)) { opaque(v) }
		else { "No" }
	// Nat's shape certificate: leaf, or fork(leaf, Nat). A Nat-symbol on the left
	// may be zero = leaf, so only a split can tell: that is a Need, never a No.
	let nat := {v} =>
		if (v.is_known) { if (NatR(v)) { "Yes" } else { "No" } }
		else if (v.is_sym) { sym_rule(v) }
		else if (v.is_app) { app_rule(v) }
		else if (is_hole(v)) { opaque(v) }
		else if (is_stem(v)) { "No" }
		else if (is_leaf(v.fst)) { at(NatR, v.snd) }
		else if (v.fst.is_sym) { inspect(v.fst) }
		else if (is_hole(v.fst)) { opaque(v.fst) }
		else { "No" }
	// a Bool is the leaf or the stem of the leaf
	let bool := {v} =>
		if (v.is_known) { if (Bool(v)) { "Yes" } else { "No" } }
		else if (v.is_sym) { sym_rule(v) }
		else if (v.is_app) { app_rule(v) }
		else if (is_hole(v)) { opaque(v) }
		else if (is_stem(v)) { leaf(stem_child(v)) }
		else { "No" }
	// the GRADE rule: at Tree (relation tree_eq) a free symbol of a coarser code
	// is refused — it may map related inputs to unrelated trees. A neutral term
	// is judged at its codomain (f 0 at Nat -> Nat is a Nat whatever f is), so
	// the argument must be in the domain; any other neutral term is opaque.
	let tree := {v} =>
		if (v.is_known) { "Yes" }
		else if (v.is_sym) { if (is_fine(v.sym_type)) { "Yes" } else { coarse(v) } }
		else if (v.is_app) {
			let head := v.app_head
			let ty := neutral_type(v)
			if ((not(is_none(ty))) && (is_fine(ty.snd))) { at(ty.snd, v) }
			else if (head.is_sym) { coarse(head) }
			else { opaque(v) }
		}
		else if (is_hole(v)) { opaque(v) }
		else if (is_stem(v)) { at(TreeR, stem_child(v)) }
		else { and_yes(at(TreeR, v.fst), {_} => at(TreeR, v.snd)) }
	// nothing is a False; a symbol OF False ranges over nothing (vacuous Yes)
	let false_ := {v} => if (v.is_sym) { sym_rule(v) } else if (is_hole(v)) { opaque(v) } else { "No" }
	let by_running := {v} => and_then(sapply(R, v, run_fuel), {b} =>
		if (b == true) { "Yes" } else if (b == false) { "No" } else { stuck_on(pair("recognizer answered no Bool", b)) })
	if (val.is_token) { stuck }
	else if (R == NatR) { nat(val) }
	else if (R == Bool) { bool(val) }
	else if (R == TreeR) { tree(val) }
	else if (R == FalseR) { false_(val) }
	else if (is_type_code(R)) {
		if ((val.is_sym) && (val.sym_type == R)) { "Yes" }
		else if ((val.is_app) && (app_rule(val) == "Yes")) { "Yes" }
		else { R.snd.admits(R, val) }
	}
	else if (is_arrow_code(R)) { stuck_on(pair("arrow codomain: a curried claim (check_arrow2)", val)) }
	else if (is_quot_code(R)) { at(quot_base(R), val) }
	else { by_running(val) }
}
judge_nat :: Val -> Res := judge_as(NatR)
judge_bool :: Val -> Res := judge_as(Bool)
judge_tree :: Val -> Res := judge_as(TreeR)

same_val :: {a : Val, b : Val} -> Res :=> if (a == b) { "Yes" } else { "No" }
// equal AT a code: both sides members first, then the same term
member_same :: {Cod : Code, a : Val, b : Val} -> Res :=>
	and_yes(judge_as(Cod, a), {_} => and_yes(judge_as(Cod, b), {_} => same_val(a, b)))

// ---------------------------------------------------------------- the search
// Case analysis on demand: check the input; a Yes covers every instance of its
// symbols; on a ground input a No is its own confirmed witness; otherwise the
// symbol the run NEEDED (or, after a symbolic No — "the terms differ" — the
// first splittable symbol in the input) is split by its constructor table,
// substituting each alternative. Any refuted branch refutes; all branches
// Proved proves; else Open, carrying the reason the run stopped. A stuck run,
// a need of a symbol without a table, and a coarse symbol never split.
rec subst :: {target : Val, by : Val, v : Val} -> Val :=>
	if (v == target) { by }
	else if (v.is_app) { app_val(subst(target, by, v.app_head), subst(target, by, v.app_arg)) }
	else if ((is_hole(v)) || (is_leaf(v))) { v }
	else if (is_stem(v)) { t(subst(target, by, stem_child(v))) }
	else { t(subst(target, by, v.fst), subst(target, by, v.snd)) }
rec in_syms :: {v : Val} -> List(Val) :=>
	if (v.is_in_sym) { [v] }
	else if (v.is_app) { (in_syms(v.app_head)).append(in_syms(v.app_arg)) }
	else if ((is_hole(v)) || (is_leaf(v))) { [] }
	else if (is_stem(v)) { in_syms(stem_child(v)) }
	else { (in_syms(v.fst)).append(in_syms(v.snd)) }
split_target :: {r : Res, input : Val} -> Val :=>
	if ((r.is_need) && (r.snd.is_splittable)) { r.snd }
	else if (r == "No") { let found := (in_syms(input)).filter(is_splittable); if (found.is_nil) { "None" } else { found.head } }
	else { "None" }
// what stopped a run: the reason an Open reports
explain :: Res -> Tree := {r} =>
	if (r.is_need) { pair("no split table", r.snd) }
	else if (r.fst == "Stuck") { r.snd }
	else if (r.fst == "Coarse") { pair("coarse symbol at fine position", r.snd) }
	else { r }

why :: Verdict -> Tree := {v} => if (v.fst == "Open") { v.snd } else { "not open" }
combine :: {verdicts : List(Verdict)} -> Verdict :=> {
	let refutations := verdicts.filter(is_refuted)
	if (not(refutations.is_nil)) { refutations.head }
	else if (verdicts.all({v} => v == "Proved")) { "Proved" }
	else { verdicts.filter(is_open).head }
}
// `ground` reads an input as a concrete counterexample: some(tree), or none while unknowns that matter remain
rec search_g :: {check : Val -> Res, ground : Val -> Option(Tree), input : Val, depth : Nat} -> Verdict :=> {
	let r := check(input)
	if (r == "Yes") { "Proved" }
	else {
		let g := ground(input)
		if (not(is_none(g))) { if (r == "No") { refuted(g.snd) } else { open_on(explain(r)) } }
		else if (is_zero(depth)) { open_on("split depth exhausted") }
		else {
			let target := split_target(r, input)
			if (target == "None") { open_on(explain(r)) }
			else {
				let alts := table(target.sym_type, {step} => in_sym_at(target.sym_type, target.sym_root, cons(step, target.sym_path)))
				combine(alts.snd.map({alt} => search_g(check, ground, subst(target, alt, input), nat_pred(depth))))
			}
		}
	}
}
search_r :: {check : Val -> Res, input : Val, depth : Nat} -> Verdict :=> search_g(check, {v} => if (v.is_known) { some(v) } else { none }, input, depth)
search :: {check : Val -> Res, input : Val, depth : Nat} -> Verdict :=> flat(search_r(check, input, depth))

run :: {fn : Tree, input : Val} -> Res :=> sapply(escape(fn), input, run_fuel)
// the Nat input at level k of the split: succ^k of the symbol at pred^k (tests)
rec sym_at :: {k : Nat, path : List(Tree)} -> Val :=>
	if (is_zero(k)) { in_sym(NatR, path) } else { t(t, sym_at(nat_pred(k), cons("pred", path))) }

// ---------------------------------------------------------------- the store
// Certified pairs: related at a negative code, both members, distinct as
// trees. (id, shift) at Nat -> Nat is certified below by eq_arrow_at itself.
store_pairs := [pair(ArrowC(NatR, NatR), pair(id, shift))]
pairs_at :: Code -> List(Pair(Tree, Tree)) := {code} => store_pairs.filter({e} => e.fst == code).map(pair_snd)
// the negative input symbol an Open reason names, if any (every reason is
// pair tag value; grounding is sound whatever the tag)
reason_sym :: Tree -> Val := {reason} =>
	if ((reason.snd.is_in_sym) && (not(is_positive(reason.snd.sym_type)))) { reason.snd } else { "None" }
// GROUNDING: an Open blamed on a negative symbol is tried on every stored pair
// at its code, concretely: a non-member output refutes with that member; two
// outputs unrelated at a fine codomain refute with the pair; else it stays Open
ground :: {Cod : Code, left : Tree -> Res, right : Tree -> Res, verdict : Verdict} -> Verdict :=> {
	let s := if (verdict.fst == "Open") { reason_sym(verdict.snd) } else { "None" }
	let try := {p} => {
		let la := left(p.fst)
		let rb := right(p.snd)
		if (not(((la.is_answered) && (la.answer.is_known)) && ((rb.is_answered) && (rb.answer.is_known)))) { verdict }
		else if (judge_as(Cod, la.answer) == "No") { refuted(p.fst) }
		else if (judge_as(Cod, rb.answer) == "No") { refuted(p.snd) }
		else if ((is_fine(Cod)) && (not(la.answer == rb.answer))) { refuted(p) }
		else { verdict }
	}
	if (s == "None") { verdict } else { combine(cons(verdict, (pairs_at(s.sym_type)).map(try))) }
}

// ---------------------------------------------------------------- (C) quotient respect
// Membership at Quotient Nat nf is RESPECT: for every a, f a ~_Cod f (nf a),
// by induction on a. The hypothesis at a proper sub-symbol k names f k and
// f (nf k) by ONE symbol: running nf on k answers the neutral term App nf [k]
// (the evaluator's normalizer rule), and the token's partner clause peels it.
// The fixpoint on a neutral term is judged by the hypothesis alone (unrolling
// the step would inspect the neutral); on anything else one layer of the step
// runs. The witness pairs the class representative with the member: (nf a, a).
respects_nf :: {step_fn : Tree, nf : Tree, Cod : Code} -> Verdict :=> {
	let ih := assumed_fn(NatR, Cod, [], {a} => app_val(nf, a))
	let fix_apply := {with_ih, a} => if (a.is_app) { sapply(ih, a, run_fuel) } else { sapply(with_ih, a, run_fuel) }
	let both := {with_ih, a} =>
		and_then(fix_apply(with_ih, a), {r1} =>
			and_then(sapply(nf, a, run_fuel), {a2} =>
				and_then(fix_apply(with_ih, a2), {r2} => member_same(Cod, r1, r2))))
	let verdict := search({a} =>
		if (a.is_known) { both(escape(fix(step_fn)), a) }
		else { and_then(run(step_fn, ih), {with_ih} => both(with_ih, a)) }
	, in_sym(NatR, []), split_depth)
	if (verdict.is_refuted) { refuted(pair(nf(verdict.snd), verdict.snd)) } else { verdict }
}

// ---------------------------------------------------------------- the checks
check_arrow_r :: {Dom : Code, Cod : Code, fn : Tree} -> Verdict :=>
	ground(Cod, {a} => run(fn, a), {b} => run(fn, b),
		search_r({input} => and_then(run(fn, input), judge_as(Cod)), in_sym(Dom, []), split_depth))
// membership at a quotient domain IS respect (of the normalizer)
check_arrow :: {Dom : Code, Cod : Code, fn : Tree} -> Verdict :=>
	if (is_quot_code(Dom)) { respects_nf({_self, x} => fn(x), quot_nf(Dom), Cod) } else { flat(check_arrow_r(Dom, Cod, fn)) }
check_by_structure :: {fn : Tree} -> Verdict :=> check_arrow(NatR, NatR, fn)

// base = the ground inputs (the real fixpoint); step = ONE layer of the step
// function with its recursion bound to the induction token
plain_ih := assumed_fn(NatR, NatR, [], same)
step_with_ih :: {step_fn : Tree, input : Val} -> Res :=>
	and_then(run(step_fn, plain_ih), {with_ih} => sapply(with_ih, input, run_fuel))
check_by_induction :: {step_fn : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run(fix(step_fn), input), judge_nat) }
		else { and_then(step_with_ih(step_fn, input), judge_nat) }
	, in_sym(NatR, []), split_depth)

// equality by symbolic normal form: both run on the SAME named symbol, both
// outputs are judged at the codomain, and the result terms are compared;
// syntactically equal terms over symbols agree on every instantiation
eq_arrow_at :: {Dom : Code, Cod : Code, fn : Tree, gn : Tree} -> Verdict :=>
	flat(ground(Cod, {a} => run(fn, a), {b} => run(gn, b),
		search_r({input} => and_then(run(fn, input), {a} => and_then(run(gn, input), {b} => member_same(Cod, a, b))), in_sym(Dom, []), split_depth)))
eq_arrow :: {Dom : Code, fn : Tree, gn : Tree} -> Verdict :=> eq_arrow_at(Dom, Dom, fn, gn)
eq_by_symbol :: {fn : Tree, gn : Tree} -> Verdict :=> eq_arrow(NatR, fn, gn)
// the shared token names both recursive calls rec_sym: that IS the hypothesis
// "the recursive calls agree on the strict sub-symbol"
eq_by_induction :: {step_f : Tree, step_g : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run(fix(step_f), input), {a} => and_then(run(fix(step_g), input), {b} => member_same(NatR, a, b))) }
		else { and_then(step_with_ih(step_f, input), {a} => and_then(step_with_ih(step_g, input), {b} => member_same(NatR, a, b))) }
	, in_sym(NatR, []), split_depth)

// (G) a curried claim f : A -> B -> C: two roots (ids 0 and 1), the input is
// their pair — distinct names, so a split of one leaves the other alone
two_roots :: {A : Code, B : Code} -> Val :=> pair(in_sym_at(A, 0, []), in_sym_at(B, 1, []))
run2 :: {fn : Tree, input : Val} -> Res :=> and_then(run(fn, input.fst), {fa} => sapply(fa, input.snd, run_fuel))
check_arrow2 :: {A : Code, B : Code, Cod : Code, fn : Tree} -> Verdict :=>
	search({input} => and_then(run2(fn, input), judge_as(Cod)), two_roots(A, B), split_depth)
// induction on the FIRST root of a curried fix: the hypothesis at k below
// root 0 is the FUNCTION f k : B -> C; applied to the second root it is the
// neutral term App (f k) [b], judged at C by the arrow rule
curried_ih :: {B : Code, Cod : Code} -> Val :=> assumed_fn(NatR, ArrowC(B, Cod), [], same)
check_by_induction2 :: {B : Code, Cod : Code, step_fn : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run2(fix(step_fn), input), judge_as(Cod)) }
		else { and_then(run(step_fn, curried_ih(B, Cod)), {w} => and_then(sapply(w, input.fst, run_fuel), {wa} => and_then(sapply(wa, input.snd, run_fuel), judge_as(Cod)))) }
	, two_roots(NatR, B), split_depth)

// ---------------------------------------------------------------- (B) streams
// An item stream is a coalgebra (lib/stream.disp) whose stepper answers
// finished ending | running (emit drawn next), where drawn is `yield item` or
// `skip`. Bisimulation up to a user-supplied relation between
// the two state spaces, given as a PATTERN pair over one variable:
// R = { (l x, r x) } for rel := {x} => pair (l x) (r x); equal states is
// same_states. Strong: a skip is a step and must meet a skip. The coinductive
// hypothesis is `related` on the NEXT states — usable only after both sides
// took one step — and it is discharged by matching, never assumed on the
// current states beyond what sharing the symbol x gives.
related :: {rel : Val -> Pair(Val, Val), a : Val, b : Val} -> Res :=> {
	let pat := rel(var_sym("x"))
	and_then(match_val(pat.fst, a, []), {env} => and_then(match_val(pat.snd, b, env), {_env} => "Yes"))
}
same_states := {x} => pair(x, x)

tag_of :: {v : Val} -> Res :=>
	if (v.is_splittable) { need(v) }
	else if (not(v.is_fork_shaped)) { stuck }
	else if (v.fst.is_splittable) { need(v.fst) }
	else { answered(v.fst) }
step_shape :: {st : Val} -> Res :=> and_then(tag_of(st), {tag} =>
	if (tag == "Finished") { "done" }
	else if (not(tag == "Running")) { stuck }
	else { and_then(tag_of(st.step_draw), {draw_tag} =>
		if (draw_tag == "Yield") { "yield" } else if (draw_tag == "Skip") { "skip" } else { stuck }) })
is_shape :: Res -> Bool := {r} => ((r == "done") || (r == "yield")) || (r == "skip")
// one step of both streams: same shape, same item (as terms), next states related.
// "NotBisim" is NOT a counterexample (the relation may just be the wrong one)
bisim_step :: {rel : Val -> Pair(Val, Val), st1 : Val, st2 : Val} -> Res :=> {
	let sh1 := step_shape(st1)
	let sh2 := step_shape(st2)
	if (not(is_shape(sh1))) { sh1 }
	else if (not(is_shape(sh2))) { sh2 }
	else if (not(sh1 == sh2)) { "NotBisim" }
	else if (sh1 == "done") { if (st1.finished_result == st2.finished_result) { "Yes" } else { "NotBisim" } }
	else if (sh1 == "skip") { related(rel, st1.step_rest, st2.step_rest) }
	else if (st1.step_draw.yielded_item == st2.step_draw.yielded_item) { related(rel, st1.step_rest, st2.step_rest) }
	else { "NotBisim" }
}
// the first `draws` observations of a stream from a ground state, every step
// fueled; skips are observed too (strong), so differing prefixes are a
// genuine concrete difference — the only source of Refuted for streams
rec observe :: {stream : Tree, state : Val, draws : Nat} -> Res :=>
	if (is_zero(draws)) { answered([]) }
	else {
		and_then(run(stream.c_stepper, state), {step} => {
			let sh := step_shape(step)
			if (not(is_shape(sh))) { sh }
			else if (sh == "done") { answered(["done"]) }
			else {
				let seen := if (sh == "skip") { "skip" } else { step.step_draw.yielded_item }
				and_then(observe(stream, step.step_rest, nat_pred(draws)), {rest} => answered(cons(seen, rest)))
			}
		})
	}
observe_draws := 4
stream_eq :: {St : Code, rel : Val -> Pair(Val, Val), s1 : Tree, s2 : Tree} -> Verdict :=> {
	let o1 := observe(s1, escape(s1.c_state), observe_draws)
	let o2 := observe(s2, escape(s2.c_state), observe_draws)
	if (not((o1.is_answered) && (o2.is_answered))) { "Open" }
	else if (not(o1.answer == o2.answer)) { refuted(pair(o1.answer, o2.answer)) }
	else if (not(related(rel, escape(s1.c_state), escape(s2.c_state)) == "Yes")) { "Open" }
	else {
		search({x} => {
			let states := rel(x)
			and_then(run(s1.c_stepper, states.fst), {st1} => and_then(run(s2.c_stepper, states.snd), {st2} => bisim_step(rel, st1, st2)))
		}, in_sym(St, []), split_depth)
	}
}
