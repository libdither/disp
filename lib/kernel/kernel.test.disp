// Full core test suite for eval_types.disp: recreates all 93 tests from sealed.test.disp
// PLUS quotients, custom approved eliminators, bounded_pi (catching looping bogus proofs),
// transitivity & neutral-call congruence, binary forall_k(2), and token-free first-class types!
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "kernel.disp" {}

rec NatP :: {v : Tree} -> Bool :=> if (is_leaf(v)) { true } else if (is_fork(v)) { if (is_leaf(v.fst)) { NatP(v.snd) } else { false } } else { false }
BitP :: {v : Tree} -> Bool :=> if (is_leaf(v)) { true } else if (is_stem(v)) { is_leaf(stem_child(v)) } else { false }
OneP :: {v : Tree} -> Bool :=> v == t(t)
rec ListNP :: {v : Tree} -> Bool :=> if (is_leaf(v)) { true } else if (is_fork(v)) { if (NatP(v.fst)) { ListNP(v.snd) } else { false } } else { false }

Nat := data_t(NatP)
Bit := data_t(BitP)
One := data_t(OneP)
Empty := EmptyT
NN := fn_t(Nat, Nat)
H := fn_t(NN, Nat)
ListN := data_t(ListNP)
ListNN := ListT(NN)

rec dbl_n :: {n : Tree} -> Tree :=> if (is_zero(n)) { zero } else { succ(succ(dbl_n(nat_pred(n)))) }
rec add_n :: {a : Tree, b : Tree} -> Tree :=> if (is_zero(a)) { b } else { succ(add_n(nat_pred(a), b)) }
rec len_n :: {xs : Tree} -> Tree :=> if (is_leaf(xs)) { zero } else { succ(len_n(xs.snd)) }
rec map_n :: {xs : Tree, f : Tree} -> Tree :=> if (is_leaf(xs)) { [] } else { cons(f(xs.head), map_n(xs.tail, f)) }
rec copy_n :: {n : Tree} -> Tree :=> if (is_zero(n)) { zero } else { succ(copy_n(nat_pred(n))) }
rec is_even :: {n : Tree} -> Tree :=> if (is_zero(n)) { true } else { not(is_even(nat_pred(n))) }
rec spin :: {n : Tree} -> Tree :=> spin(n)
rec bad_base :: {n : Tree} -> Tree :=> if (is_zero(n)) { t(t) } else { bad_base(nat_pred(n)) }
rec bad_later :: {n : Tree, k : Tree} -> Tree :=> if (is_zero(k)) { t(t) } else { bad_later(k, nat_pred(k)) }
rec fold_n :: {xs : Tree, f : Tree, z : Tree} -> Tree :=> if (is_leaf(xs)) { z } else { f(xs.head, fold_n(xs.tail, f, z)) }
rec bot :: {x : Tree} -> Tree :=> bot(x)
dup := {n} => pair(n, n)
quad := {n} => dbl_n(dbl_n(n))

// ---- 0. First-class types are 100% token-free (`tok_sig` never leaks into types!)
test has_tok(Nat) = false
test has_tok(NN) = false
test has_tok(H) = false

// ---- 1. meaning refutes, checker accepts (first-order & partial correctness)
test is_found(refute_at(Nat, t(t), 16)) = true
test refute_at(Nat, 3, 16) = nothing
test accepts(Nat, 3) = true
test accepts(Nat, t(t)) = false
test unoptimized(NN)(dup) = pair(1, pair(1, 1))
test refute_at(NN, spin, 64) = nothing
test accepts(NN, spin) = false
test accepts(partial_fn(Nat, Nat), spin) = true

// ---- 2. functions, recursion, containers, lemmas
test accepts(NN, succ) = true
test accepts(NN, dbl_n) = true
test accepts(NN, dup) = false
test accepts(fn_t(Nat, NN), add_n) = true
test accepts(fn_t(ListN, Nat), len_n) = true
test accepts(fn_t(ListN, fn_t(NN, ListN)), map_n) = true
test accepts(ListNN, [succ, dbl_n]) = true
test accepts(ListNN, [succ, dup]) = false
test is_found(refute_at(ListNN, [succ, dup], 256)) = true
test accepts(NN, bad_base) = false
test accepts(NN, is_zero) = false
test accepts(fn_t(Nat, NN), bad_later) = false
test accepts(fn_t(Nat, Bit), is_zero) = true
test accepts(NN, quad) = false
test why([pair(dbl_n, NN)], NN, quad) = yes
test why([pair(dup, NN)], NN, quad) = "A lemma does not check"

// ---- 3. order-2/3 safety WITHOUT Seal op + token forgery blocked
test accepts(H, {g} => g(2)) = true
test refute_at(H, {g} => g(2), 256) = nothing
test accepts(H, {g} => g(t(t))) = false
test is_found(refute_at(H, {g} => g(t(t)), 256)) = true
spy_cb := {g} => if (g == succ) { t(t) } else { 0 }
test accepts(H, spy_cb) = false
test is_found(refute_with(NN, Nat, spy_cb, succ, 256)) = true
forger := {n} => pair(append("EvalHandl", if (is_zero(n)) { [101] } else { [101] }), pair("U", n))
test why([], NN, forger) = "Builds a token"
test accepts(NN, {n} => tok_unk(n)) = false
// order-3: steal_x cannot extract any Fault because Fault never exists as a tree!
test accepts(fn_t(H, Nat), {h} => h(succ)) = true
test accepts(fn_t(H, Nat), {h} => h(dup)) = false
test refute_at(fn_t(H, Nat), {h} => h(succ), 256) = nothing
steal_x := {w} => w.snd.snd.fst(0)
test refute_with(H, Nat, {h} => h(succ), steal_x, 512) = nothing
twice_ho := {f, m} => f(f(m))
test accepts(fn_t(NN, NN), twice_ho) = true
test accepts(fn_t(NN, NN), {f, m} => ({_} => 0)(f(0))) = true
comp3 := {f, g, x} => f(g(x))
test accepts(fn_t(H, fn_t(fn_t(Nat, NN), NN)), comp3) = true
test accepts(fn_t(ListN, fn_t(fn_t(Nat, NN), NN)), fold_n) = true

// ---- 4. K-skip laziness & diverging dependent families
test accepts(fn_t(Nat, Empty), bot) = false
test accepts(partial_fn(Nat, Empty), bot) = true
skips := {n, g} => n(is_leaf(bot(g)))
test accepts(fn_t(Nat, fn_t(Nat, Bit)), skips) = false
test why([pair(bot, partial_fn(Nat, Empty))], fn_t(Nat, fn_t(Nat, Bit)), skips).fst = "Fault"
test is_found(refute_at(fn_t(Nat, fn_t(Nat, Bit)), skips, 256)) = true
test accepts(fn_lazy_t(Empty, Nat), pair(t, t(t))) = false
test is_found(refute_at(fn_lazy_t(Empty, Nat), pair(t, t(t)), 64)) = true
test accepts(fn_lazy_t(Empty, Nat), pair(t, 0)) = true
NE := partial_fn(Nat, Empty)
famE := {f} => if (is_leaf(f(0))) { Bit } else { Bit }
Tg := pi_t(NE, famE)
app5 := {g, f} => if (is_leaf(g(f))) { 5 } else { 5 }
test accepts(Tg, t) = true
test accepts(fn_t(Tg, fn_t(NE, Bit)), app5) = false
test accepts(fn_t(NE, Bit), {f} => t(f)) = false

// ---- 5. dependent types, singleton induction, refinements, sigma
fam := {n} => if (is_zero(n)) { Bit } else { Nat }
test accepts(pi_t(Nat, fam), {n} => if (is_zero(n)) { t(t) } else { n }) = true
test accepts(pi_t(Nat, fam), {n} => if (is_zero(n)) { 3 } else { n }) = false
test is_found(refute_at(pi_t(Nat, fam), {n} => if (is_zero(n)) { 3 } else { n }, 64)) = true
Same := pi_t(Nat, {n} => the_t(Nat, n))
test accepts(Same, copy_n) = true
test accepts(Same, {n} => n) = true
test accepts(Same, dbl_n) = false
test accepts(pi_t(Nat, {n} => the_t(Nat, succ(n))), succ) = true
test accepts(pi_t(Nat, {n} => the_t(Nat, succ(n))), copy_n) = false
test is_found(refute_at(Same, dbl_n, 256)) = true

Even := refine_t(Nat, is_even)
test accepts(Even, 4) = true
test accepts(Even, 3) = false
test accepts(fn_t(Nat, Even), dbl_n) = true
test accepts(fn_t(Nat, Even), succ) = false
test accepts(fn_t(Even, Even), {n} => succ(succ(n))) = true
test accepts(fn_t(Even, Nat), {n} => n) = true
test accepts(fn_t(Nat, Even), {n} => n) = false
test is_found(refute_at(fn_t(Nat, Even), succ, 256)) = true

tag := {b} => if (is_leaf(b)) { Nat } else { Bit }
Tagged := sigma_t(Bit, tag)
test accepts(Tagged, pair(t, 3)) = true
test accepts(Tagged, pair(t(t), 3)) = false
test accepts(fn_t(Bit, Tagged), {b} => pair(b, if (is_leaf(b)) { 2 } else { t(t) })) = true
test accepts(fn_t(Tagged, Bit), {p} => p.fst) = true
test accepts(pi_t(Tagged, {p} => tag(p.fst)), {p} => p.snd) = true
test accepts(fn_t(Tagged, Nat), {p} => p.snd) = false
test accepts(fn_t(sigma_t(NE, famE), Bit), {p} => if (is_leaf(p)) { 5 } else { 5 }) = false

// ---- 6. polymorphism WITHOUT Brand tokens + arbitrary-arity `forall_k(2)`
IdT := forall_t({X} => fn_t(X, X))
Church := forall_t({X} => fn_t(fn_t(X, X), fn_t(X, X)))
test accepts(IdT, {X, x} => x) = true
test accepts(IdT, {X, x} => zero) = false
test is_found(refute_at(IdT, {X, x} => zero, 64)) = true
test accepts(IdT, {X, x} => X) = false
test accepts(IdT, {X, x} => if (is_leaf(x)) { x } else { x }) = false
test is_found(refute_at(IdT, {X, x} => if (is_leaf(x)) { x } else { x }, 64)) = true
test accepts(fn_t(IdT, Nat), {id} => id(Nat, 3)) = true
test accepts(fn_t(IdT, Nat), {id} => id(Nat, t(t))) = false
test accepts(fn_t(IdT, Nat), {id} => id(Bit, true)) = false
test is_found(refute_with(IdT, Nat, {id} => id(Nat, t(t)), {_X, x} => x, 512)) = true
test accepts(Church, {X, f, x} => f(f(x))) = true
test accepts(Church, {X, f, x} => f) = false
// Binary type operator polymorphism via `forall_k(2)`!
BinIdT := forall_k(2, {R} => forall_t({A} => forall_t({B} => fn_t(R(A, B), R(A, B)))))
test accepts(BinIdT, {R, A, B, v} => v) = true
test accepts(BinIdT, {R, A, B, v} => zero) = false

// ---- 7. step-bounded functions & `bounded_pi` closing the looping-proof loophole!
BNN := bounded_t(Nat, Nat, {_a} => 50)
test accepts(BNN, succ) = true
test accepts(BNN, spin) = false
test is_found(refute_at(BNN, spin, 16)) = true
test refute_at(BNN, succ, 16) = nothing
// Total `pi_t` rejects `spin` (structural termination!); `partial_pi` allows partial loops; `bounded_pi` also refutes it!
false_prop := {n} => eq_t(add_n(n, n), n)
test accepts(partial_pi(Nat, false_prop), spin) = true
test accepts(pi_t(Nat, false_prop), spin) = false
test accepts(bounded_pi(Nat, false_prop, {_a} => 50), spin) = false
test is_found(refute_at(bounded_pi(Nat, false_prop, {_a} => 50), spin, 16)) = true

// ---- 7b. Structural & lexicographic termination (`pi_t` / `fn_t`)
// Direct recursive Ackermann: lexicographic decrease on `(m, n)` passes total `fn_t(Nat, NN)`!
rec ack_rec :: {m : Tree, n : Tree} -> Tree :=>
	if (is_zero(m)) { succ(n) }
	else if (is_zero(n)) { ack_rec(nat_pred(m), 1) }
	else { ack_rec(nat_pred(m), ack_rec(m, nat_pred(n))) }
test accepts(fn_t(Nat, NN), ack_rec) = true
test ack_rec(2, 2) = 7
// Second-argument structural decrease (arg 1 stays equal, arg 2 shrinks)
rec add_right :: {a : Tree, b : Tree} -> Tree :=> if (is_zero(b)) { a } else { succ(add_right(a, nat_pred(b))) }
test accepts(fn_t(Nat, NN), add_right) = true
// Rejects growing recursion, same-size recursion, oscillating recursion, escaping partial recursive calls, and tok_call spoofing!
test accepts(NN, fix({r, n} => if (is_zero(n)) { 0 } else { r(succ(n)) })) = false
test accepts(NN, fix({r, n} => if (is_zero(n)) { 0 } else { r(n) })) = false
bad_osc := fix({r, m} => {n} => if (is_zero(m)) { if (is_zero(n)) { 0 } else { r(1, nat_pred(n)) } } else { r(nat_pred(m), succ(n)) })
test accepts(fn_t(Nat, NN), bad_osc) = false
test accepts(fn_t(Nat, NN), fix({r, a} => r(a))) = false
test accepts(fn_t(Nat, fn_t(Nat, NN)), fix({r, a} => {b} => r(a))) = false
test accepts(pi_t(Nat, {n} => fn_t(eq_t(n, dbl_n(n)), Empty)), fix({r, n} => {_e} => r(n, t))) = false

// ---- 8. NEW: quotients (`quot_t` / `quot_fn`), custom approved eliminators, eq transitivity + congruence
rec parity :: {n : Tree} -> Tree :=> if (is_zero(n)) { 0 } else if (is_zero(nat_pred(n))) { 1 } else { parity(nat_pred(nat_pred(n))) }
test accepts(NN, parity) = true
// Respects parity: eliminates only through `parity(q)`!
test accepts(quot_fn(Nat, parity, Bit), {q} => is_zero(parity(q))) = true
// Breaks parity: raw `is_zero(q)` distinguishes 0 from 2 — BOTH rejected AND refuted!
test accepts(quot_fn(Nat, parity, Bit), {q} => is_zero(q)) = false
test is_found(refute_at(quot_fn(Nat, parity, Bit), {q} => is_zero(q), 256)) = true
test refute_at(quot_fn(Nat, parity, Bit), {q} => is_zero(parity(q)), 64) = nothing

// Custom approved eliminator on an opaque Nat wrapper: ONLY `get_bit` is approved, raw triage fails!
get_bit := {n} => not(is_zero(n))
SecretNat := opaque_with_elim(Nat, get_bit, Bit)
test accepts(fn_t(SecretNat, Bit), {s} => get_bit(s)) = true
test accepts(fn_t(SecretNat, Bit), {s} => is_leaf(s)) = false

// Equality transitivity (`a == b` & `b == c` -> `a == c`) AND congruence (`a == b` -> `f(a) == f(b)`, incl. callbacks!)
test accepts(pi_t(Nat, {a} => pi_t(Nat, {b} => pi_t(Nat, {c} => fn_t(eq_t(a, b), fn_t(eq_t(b, c), eq_t(a, c)))))), {_a, _b, _c, _ab, _bc} => t) = true
test accepts(pi_t(Nat, {a} => pi_t(Nat, {b} => fn_t(eq_t(a, b), eq_t(dbl_n(a), dbl_n(b))))), {_a, _b, _ab} => t) = true
test accepts(pi_t(NN, {g} => pi_t(Nat, {a} => pi_t(Nat, {b} => fn_t(eq_t(a, b), eq_t(g(a), g(b)))))), {_g, _a, _b, _e} => t) = true
test accepts(pi_t(NN, {g} => pi_t(NN, {h} => pi_t(Nat, {a} => pi_t(Nat, {b} => fn_t(eq_t(h(a), h(b)), eq_t(g(h(a)), g(h(b)))))))), {_g, _h, _a, _b, _e} => t) = true

// ---- 9. Adversarial / soundness regression tests (all 5 stress-test fixes)
// 9a. `forall_t` parametricity: inspecting the type parameter `A` is rejected, without false refutation on valid members
evil_id := {A, x} => if (A == Nat) { t(t, t) } else { x }
test accepts(IdT, evil_id) = false
test accepts(IdT, {A, x} => if (is_fork(A)) { x } else { t }) = false
test accepts(IdT, {A, x} => if (A == Nat) { x } else { x }) = false
test refute_at(IdT, {A, x} => if (A == Nat) { x } else { x }, 32) = nothing

// 9b. Refuter handles diverging predicates and families without hanging
bad_p := fix({r, x} => if (is_zero(x)) { true } else { r(x) })
test refute_at(fn_t(data_t(bad_p), Nat), {x} => x, 16) = nothing
bad_fam := fix({r, n} => r(n))
test accepts(pi_t(Nat, bad_fam), {_n} => 0) = false

// 9c. Non-idempotent quotient normalizers (`inc2`, `mod2_plus1`): checker and refuter agree!
inc2 :: {n : Tree} -> Tree :=> succ(succ(n))
test accepts(quot_fn(Nat, inc2, Nat), {q} => inc2(q)) = true
test refute_at(quot_fn(Nat, inc2, Nat), {q} => inc2(q), 32) = nothing
mod2_plus1 :: {n : Tree} -> Tree :=> succ(parity(n))
test accepts(quot_fn(Nat, mod2_plus1, Bit), {q} => is_zero(mod2_plus1(q))) = true
test refute_at(quot_fn(Nat, mod2_plus1, Bit), {q} => is_zero(mod2_plus1(q)), 32) = nothing
test accepts(quot_fn(Nat, mod2_plus1, Bit), {q} => is_zero(q)) = false
test is_found(refute_at(quot_fn(Nat, mod2_plus1, Bit), {q} => is_zero(q), 256)) = true

// 9d. Order-2 `bounded_t`: oracle-step accounting agrees between checker and refuter!
test accepts(bounded_t(NN, Bit, {_g} => 50), {g} => is_zero(g(0))) = true
test refute_at(bounded_t(NN, Bit, {_g} => 50), {g} => is_zero(g(0)), 64) = nothing
test accepts(bounded_t(NN, Bit, {_g} => 50), {g} => spin(g(0))) = false
test is_found(refute_at(bounded_t(NN, Bit, {_g} => 50), {g} => spin(g(0)), 16)) = true
test accepts(bounded_t(Nat, Nat, {_n} => 50), dbl_n) = false

// 9e. `opaque_with_elim` verifies `elim_fn : fn_t(A, R)` — a lying spec is rejected!
LyingNat := opaque_with_elim(Nat, dup, Nat)
test accepts(fn_t(LyingNat, Nat), {s} => dup(s)) = false

// 9f. Cyclic eq, bad recursive calls, and lemma-vs-quotient barrier
test accepts(pi_t(Nat, {n} => fn_t(eq_t(n, succ(n)), eq_t(n, succ(n)))), {_n, _e} => t) = true
bad_rec := fix({r, n} => if (is_zero(n)) { 0 } else { r(t(t)) })
test accepts(NN, bad_rec) = false
test why([pair(is_zero, fn_t(Nat, Bit))], quot_fn(Nat, parity, Bit), {q} => is_zero(q)) == yes = false

// 9g. Right-to-left lexicographic termination, Scott-induction for `PartialFn` only, unforgeable certs, concrete `Nat` fast-path
rtl_step := fix({r, x, k} => if (is_zero(k)) { x } else { r(succ(x), nat_pred(k)) })
test accepts(fn_t(Nat, fn_t(Nat, Nat)), rtl_step) = true
bad_osc_rtl := fix({r, a, b} => if (is_zero(a)) { 0 } else if (is_zero(b)) { 0 } else { r(succ(a), nat_pred(b)) })
// `bad_osc_rtl` DOES decrease in RTL (`b` strictly decreases)! Contrast with true non-terminating swap-grow:
bad_swap := fix({r, a, b} => if (is_zero(a)) { 0 } else if (is_zero(b)) { 0 } else { r(b, a) })
test accepts(fn_t(Nat, fn_t(Nat, Nat)), bad_swap) = false
bad_osc2 := fix({r, a, b} => if (is_zero(a)) { 0 } else if (is_zero(b)) { 0 } else if (is_zero(nat_pred(a))) { r(succ(a), nat_pred(b)) } else { r(nat_pred(a), succ(b)) })
test accepts(fn_t(Nat, fn_t(Nat, Nat)), bad_osc2) = false

// First-class recursive self-reference (`c_fold` pattern): accepted in `partial_fn`, rejected in total `fn_t`!
ho_self := {alg} => fix({r, x} => alg(r, x))
test accepts(partial_fn(fn_t(partial_fn(Nat, Nat), fn_t(Nat, Nat)), partial_fn(Nat, Nat)), ho_self) = true
test accepts(fn_t(fn_t(fn_t(Nat, Nat), fn_t(Nat, Nat)), fn_t(Nat, Nat)), ho_self) = false

// Unforgeable certificates (`certify`, `cert_pick`, `check_certified`)
good_cert := certify(check_depth, check_fuel, "all", [], [pair("dbl", pair(NN, dbl_n))])
test is_cert(good_cert) = true
test is_cert(pair("Cert", [])) = false
test check_certified(check_depth, check_fuel, "fix", [good_cert], [pair("quad", pair(NN, {n} => dbl_n(dbl_n(n))))]) = true
test check_certified(check_depth, check_fuel, "fix", [pair("Cert", [pair("fake", pair(dup, NN))])], [pair("bad", pair(NN, dup))]) == true = false
test is_cert(cert_pick(good_cert, ["dbl"])) = true
test is_cert(cert_pick(pair("Cert", []), ["dbl"])) = false

// Concrete `data_t` fast-path handles large concrete Peano numerals instantly
test accepts(fn_t(Nat, Nat), {_n} => 64) = true

// ---- 10. soundness sweep (refuter checks checker over small programs)
BB := fn_t(Bit, Bit)
test sound_refuter(NN)(accepts(NN), 16) = nothing
test is_found(sound_refuter(NN)({_m} => true, 16)) = true
test sound_refuter(fn_t(Nat, Bit))(accepts(fn_t(Nat, Bit)), 128) = nothing
test sound_refuter(fn_t(BB, Bit))(accepts(fn_t(BB, Bit)), 256) = nothing
test sound_refuter(fn_t(BB, BB))(accepts(fn_t(BB, BB)), 64) = nothing
