// System F-omega: polymorphism and type operators, so data types can be defined inside the theory. A pair type as an operator, with its constructor run as a real program.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../machine.disp" {}
open use raw "../claim.disp" {}
open use raw "../stream.disp" {}
open use raw "../tests/fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}
open use raw "cube.disp" {}

theory := corner([poly, oper])
test power(theory) = [true, true, true, false, true, false, false, false]
pair_op := lam(star, lam(star, pi(star, arrow(arrow(tv(2), arrow(tv(1), tv(0))), tv(0)))))
test accepts(theory, arrow(star, arrow(star, star)), pair_op) = "Proved"
mk_pair := lam(star, lam(star, lam(tv(1), lam(tv(1), lam(star, lam(arrow(tv(4), arrow(tv(3), tv(0))), app(app(tv(0), tv(3)), tv(2))))))))
mk_pair_ty := pi(star, pi(star, pi(tv(1), pi(tv(1), app(app(pair_op, tv(3)), tv(2))))))
test accepts(theory, mk_pair_ty, mk_pair) = "Proved"
test erase(mk_pair, t, t, 3, 4, t, {a, _b} => a) = 3
test erase(mk_pair, t, t, 3, 4, t, {_a, b} => b) = 4
