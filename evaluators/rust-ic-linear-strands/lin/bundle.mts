// Bundles the player's compiler (player.ts) into ../player/lin-compiler.js, a script that opens from disk.
// `npx tsx evaluators/rust-ic-linear-strands/lin/bundle.mts`
import { writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { build } from 'esbuild'

const here = dirname(fileURLToPath(import.meta.url))
const out = await build({
  entryPoints: [join(here, 'player.ts')], bundle: true, write: false, format: 'iife', target: 'es2022', minify: true, legalComments: 'none',
  tsconfigRaw: { compilerOptions: { target: 'ES2022', strict: true } }
})
writeFileSync(join(here, '../player/lin-compiler.js'), '// generated by lin/bundle.mts from lin/player.ts; do not edit\n' + out.outputFiles[0].text)
console.log(`player/lin-compiler.js: ${out.outputFiles[0].text.length} bytes`)
