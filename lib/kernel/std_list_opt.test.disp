// End-to-end verification, value-agreement, and step-count speedup tests for `std_list.opt.disp`.
open use "prelude.disp"
open use raw "../growth.disp" {}

let Spec := use "std_list.disp"
let Opt := use "std_list.opt.disp"

let xs := [1, 2, 3, 4, 5, 6, 7, 8]
let ys := [9, 10]
let xss := [[1, 2], [3, 4], [5, 6], [7, 8]]

// 1. Value agreement across all 9 verified rewrites
test Opt.ck_append(xs, ys) = Spec.ck_append(xs, ys)
test Opt.ck_length(xs) = Spec.ck_length(xs)
test Opt.ck_map(xs, succ) = Spec.ck_map(xs, succ)
test Opt.ck_filter(xs, is_fork) = Spec.ck_filter(xs, is_fork)
test Opt.ck_all(xs, is_fork) = Spec.ck_all(xs, is_fork)
test Opt.ck_all([0, 1, 2], is_fork) = Spec.ck_all([0, 1, 2], is_fork)
test Opt.ck_any(xs, is_leaf) = Spec.ck_any(xs, is_leaf)
test Opt.ck_any([0, 1, 2], is_leaf) = Spec.ck_any([0, 1, 2], is_leaf)
test Opt.ck_member(xs, 5) = Spec.ck_member(xs, 5)
test Opt.ck_member(xs, 99) = Spec.ck_member(xs, 99)
test Opt.ck_concat(xss) = Spec.ck_concat(xss)
test Opt.ck_reverse(xs) = Spec.ck_reverse(xs)

// 2. Confirmed distinct trees (fast overlay actually replaced spec)
test (Opt.ck_reverse == Spec.ck_reverse) = false
test (Opt.ck_append == Spec.ck_append) = false
test (Opt.ck_length == Spec.ck_length) = false
test (Opt.ck_map == Spec.ck_map) = false

// 3. Strict runtime step-count speedups via `steps_of`
test nat_lt(steps_of(Opt.ck_reverse, xs, 20000), steps_of(Spec.ck_reverse, xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_append(l, ys), xs, 20000), steps_of({l} => Spec.ck_append(l, ys), xs, 20000)) = true
test nat_lt(steps_of(Opt.ck_length, xs, 20000), steps_of(Spec.ck_length, xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_map(l, succ), xs, 20000), steps_of({l} => Spec.ck_map(l, succ), xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_filter(l, is_fork), xs, 20000), steps_of({l} => Spec.ck_filter(l, is_fork), xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_all(l, is_fork), xs, 20000), steps_of({l} => Spec.ck_all(l, is_fork), xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_any(l, is_leaf), xs, 20000), steps_of({l} => Spec.ck_any(l, is_leaf), xs, 20000)) = true
test nat_lt(steps_of({l} => Opt.ck_member(l, 99), xs, 20000), steps_of({l} => Spec.ck_member(l, 99), xs, 20000)) = true
test nat_lt(steps_of(Opt.ck_concat, xss, 20000), steps_of(Spec.ck_concat, xss, 20000)) = true

// 4. Top-level open-splice reconciliation (reverse order pinned in `test/guards.test.ts`)
open use "std_list.disp"
open use "std_list.opt.disp"
test ck_reverse = Opt.ck_reverse
test ck_append = Opt.ck_append
test ck_length = Opt.ck_length
test ck_concat = Opt.ck_concat
