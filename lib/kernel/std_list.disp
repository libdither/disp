// Re-typechecked standard list library (`lib/list.disp`) verified by `lib/kernel/prelude.disp` via `:` syntax.
open use "prelude.disp"

let LT := List(Tree)
// Polymorphic list operations (verified on unmodified `lib/list.disp` definitions;
// hot ops carry pointwise-equivalence guards for verified `.opt.disp` overlays)
ck_nil : Implicit({A} => List(A)) := nil
ck_cons : Implicit({A} => A -> List(A) -> List(A)) := cons
ck_is_nil : Implicit({A} => List(A) -> Bool) := is_nil
ck_head : Implicit({A} => Pair(A, List(A)) -> A) := head
ck_tail : Implicit({A} => Pair(A, List(A)) -> List(A)) := tail
ck_reduce : Implicit({A} => Implicit({C} => (A -> C -> C) -> C -> List(A) -> C)) := reduce
guard(fn2_equiv_guard(LT, Tree -> Tree)) ck_map : Implicit({A} => Implicit({B} => List(A) -> (A -> B) -> List(B))) := map
guard(fn2_equiv_guard(LT, LT)) ck_append : Implicit({A} => List(A) -> List(A) -> List(A)) := append
guard(fn_equiv_guard(List(LT))) ck_concat : Implicit({A} => List(List(A)) -> List(A)) := concat
guard(fn_equiv_guard(LT)) ck_reverse : Implicit({A} => List(A) -> List(A)) := reverse
guard(fn_equiv_guard(LT)) ck_length : Implicit({A} => List(A) -> Nat) := length
guard(fn2_equiv_guard(LT, Tree -> Bool)) ck_filter : Implicit({A} => List(A) -> (A -> Bool) -> List(A)) := filter
guard(fn2_equiv_guard(LT, Tree -> Bool)) ck_all : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := all
guard(fn2_equiv_guard(LT, Tree -> Bool)) ck_any : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := any
ck_zip : Implicit({A} => Implicit({B} => List(A) -> List(B) -> List(Pair(A, B)))) := zip
// `concat_nat` supplies the cut lemma `List(List(Nat)) -> List(Nat)` so unmodified `cross` checks!
ck_concat_nat : List(List(Nat)) -> List(Nat) := concat
ck_cross_nat : List(Nat) -> List(Nat) -> (Nat -> Nat -> Nat) -> List(Nat) := cross
// Equality-based list ops require `Tree` (since abstract `A` forbids `==`)
guard(fn2_equiv_guard(LT, Tree)) ck_member : LT -> Tree -> Bool := member
ck_dedup : LT -> LT := dedup
