open use raw "lib/prelude.disp" {}
open use raw "lib/list.disp" {}
open use raw "lib/stream.disp" {}

next_level :: {levels : List (List Tree)} -> List Tree :=> {
  let stems := levels.head.map ({v} => t v)
  let splits := levels.reverse.zip levels.tail
  let forks := (splits.map ({p} => p.fst.cross p.snd pair)).concat
  stems.append forks
}
trees_step :: {state : Pair (List (List Tree)) (List Tree)} -> Step Tree (Pair (List (List Tree)) (List Tree)) :=> {
  let levels := state.fst
  let pending := state.snd
  if (pending.is_nil) {
    let grown := next_level levels
    yield grown.head (pair (cons grown levels) grown.tail)
  } else {
    yield pending.head (pair levels pending.tail)
  }
}
Trees :: Stream Tree := s_new trees_step (pair [[t]] [t])

test (Trees.s_take 10 4).s_items = [t, t t, t (t t), t t t]
test (Trees.s_take 40 38).s_items.length = 38
taken2 :: Pair (List Tree) (Stream Tree) := Trees.s_take 10 2
taken2more :: Pair (List Tree) (Stream Tree) := taken2.s_rest.s_take 10 2
test taken2.s_items.append taken2more.s_items = (Trees.s_take 10 4).s_items

BadBool :: {tree : Tree} -> Bool :=> triage true is_leaf false tree
Bool :: {tree : Tree} -> Bool :=> triage true is_leaf ({_l, _r} => false) tree
test BadBool (t t t) = true
test Bool (t t t) = false
test Bool t = true
test Bool (t t) = true
test Bool (t (t t)) = false

Bools :: List Tree := ((Trees.s_filter Bool).s_take 50 5).s_items
test Bools.length = 2
test Bools = [true, false]

Arrow :: {Dom : Tree -> Bool, Cod : Tree -> Bool, fuel : Nat, fn : Tree} -> Bool :=> {
  let members := Trees.s_filter Dom
  let outputs := members.s_map ({arg} => fn arg)
  outputs.s_all Cod fuel
}
BoolFn :: {fn : Tree} -> Bool :=> Arrow Bool Bool 25 fn
test BoolFn (t t t) = true
test BoolFn (t t (t t)) = true
test BoolFn t = false
test BoolFn (t t) = false
test Arrow Bool Bool 1 t = true

candidates :: List Tree := (Trees.s_take 60 40).s_items
boolfns :: List Tree := candidates.filter BoolFn
test boolfns.length = 7
test boolfns.all ({fn} => (Bool (fn true)) && (Bool (fn false))) = true
behaviors :: List (Pair Tree Tree) := (boolfns.map ({fn} => pair (fn true) (fn false))).dedup
test behaviors.length = 3
test behaviors = [pair true true, pair true false, pair false false]

idfns :: List Tree := boolfns.filter ({fn} => (fn true == true) && (fn false == false))
test idfns.length = 4
probe :: Tree := t (t t t) t
test Bool probe = false
test idfns.all ({fn} => not (Bool (fn probe))) = true
outputs_on_probe :: List Tree := (idfns.map ({fn} => fn probe)).dedup
test outputs_on_probe.length = 2
test outputs_on_probe = [probe, t t t]
