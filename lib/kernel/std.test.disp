// End-to-end auto-verification tests for `std_prelude.disp` (checked substrate primitives,
// dependent types, and Ackermann totality under `lib/kernel/prelude.disp`).
open use "prelude.disp"
open use "std_prelude.disp"

test ck_and(true, false) = false
test ck_select_lazy({_} => 1, {_} => 2, true) = 1
test ck_nat_le(2, 3) = true
test ck_tree_lt(0, 1) = true
test ident(Nat, 42) = 42
test pick(0) = t
test pick(3) = 3
test ack(2, 2) = 7
