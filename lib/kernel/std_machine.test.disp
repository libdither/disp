// End-to-end auto-verification tests for `std_machine.disp` and `std_growth.disp`.
open use "prelude.disp"
let SM := use "std_machine.disp"
let SG := use "std_growth.disp"

// `std_machine`: small-step machine runs K(42)(0) -> Done(42)
test SM.ck_m_finished(SM.ck_m_advance(SM.ck_m_start({x} => succ(x), 2), 20)) = true
test SM.ck_m_result(SM.ck_m_advance(SM.ck_m_start({x} => succ(x), 2), 20)) = 3
test is_cert(SM.machine_cert) = true

// `std_growth`: arithmetic, finite differences, polynomial evaluation, step counting
test SG.ck_add2(3, 4) = 7
test SG.ck_minus(5, 2) = 3
test SG.ck_minus(2, 5) = "Negative"
test SG.ck_diffs([1, 3, 6]) = [2, 3]
test SG.ck_newton([2, 4, 6, 8]) = [2, 2]
test SG.ck_newton_at([2, 2], 4) = 10
test SG.ck_steps_of({x} => succ(x), 2, 20) = SG.ck_steps_of({x} => succ(x), 2, 20)
