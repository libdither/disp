// Re-typechecked small-step tree-calculus machine (`lib/machine.disp`) verified by `lib/kernel/prelude.disp`.
open use "prelude.disp"
open use raw "../machine.disp" {}

let check_module := check_with(check_depth, check_fuel, "all", [])

// Exact dependent machine & frame shapes:
//   - `fr_s` carries `Pair(Tree, Tree)`; `fr_to`/`fr_res` carry `Tree`
//   - `Done(v)` carries `Tree`; `Run`/`Held` carry `Pair(Pair(Tree, Tree), List(MFrame))`
MFrame := Sigma(Tree, {tag} => if ((tag == "To") || (tag == "Res")) { Tree } else { Pair(Tree, Tree) })
RunPayload := Pair(Pair(Tree, Tree), List(MFrame))
RunMachine := Pair(Tree, RunPayload)
Machine := Sigma(Tree, {tag} => if (tag == "Done") { Tree } else { RunPayload })

// Core stepping chain checked first (minimizes `with_lemma` stack depth for `m_deliver`/`m_settle_by`/`m_rule`):
//   - `k_shaped` collapses 3-nested 9-way tree splits in `m_deliver`/`m_rule` into 2-way Bool splits
//   - `m_deliver` and `m_advance` are structurally total via right-to-left lexicographic termination
ck_k_shaped : Tree -> Bool := k_shaped
ck_m_deliver : Tree -> List(MFrame) -> Machine := m_deliver
ck_m_settle_by : PartialFn(Tree -> Tree -> Bool, PartialFn(Machine, Machine)) := m_settle_by
ck_m_settle : PartialFn(Machine, Machine) := m_settle
ck_m_rule : RunMachine -> Machine := m_rule
ck_m_step : PartialFn(Machine, Machine) := m_step
ck_m_advance : Machine -> Nat -> Machine := m_advance

// Constructors & accessors checked after the stepping loop (so `m_finished`/`m_fn`/`m_arg`/`m_stack` unfold cleanly inside it)
ck_m_start : Tree -> Tree -> Machine := m_start
ck_m_finished : Machine -> Bool := m_finished
ck_m_result : Machine -> Tree := m_result
ck_machine_done : Tree -> Machine := machine_done
ck_machine_run : Tree -> Tree -> List(MFrame) -> Machine := machine_run
ck_machine_held : Tree -> Tree -> List(MFrame) -> Machine := machine_held
ck_fr_to : Tree -> MFrame := fr_to
ck_fr_res : Tree -> MFrame := fr_res
ck_fr_s : Tree -> Tree -> MFrame := fr_s
ck_m_held : Machine -> Bool := m_held
ck_m_fn : RunMachine -> Tree := m_fn
ck_m_arg : RunMachine -> Tree := m_arg
ck_m_stack : RunMachine -> List(MFrame) := m_stack

// Unforgeable cross-module certificate for downstream libraries (`std_growth.disp`, `std_stream.disp`).
// Same prefix order as above, so every `why_trusted` call is a 0-step hash-cons memo hit!
machine_cert := certify(check_depth, check_fuel, "all", [], [
	pair("ck_k_shaped", pair(Tree -> Bool, k_shaped)),
	pair("ck_m_deliver", pair(Tree -> List(MFrame) -> Machine, m_deliver)),
	pair("ck_m_settle_by", pair(PartialFn(Tree -> Tree -> Bool, PartialFn(Machine, Machine)), m_settle_by)),
	pair("ck_m_settle", pair(PartialFn(Machine, Machine), m_settle)),
	pair("ck_m_rule", pair(RunMachine -> Machine, m_rule)),
	pair("ck_m_step", pair(PartialFn(Machine, Machine), m_step)),
	pair("ck_m_advance", pair(Machine -> Nat -> Machine, m_advance)),
	pair("ck_m_start", pair(Tree -> Tree -> Machine, m_start)),
	pair("ck_m_finished", pair(Machine -> Bool, m_finished)),
	pair("ck_m_result", pair(Machine -> Tree, m_result))
])
