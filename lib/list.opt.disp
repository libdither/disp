// Verified single-triage optimization overlay for `lib/list.disp`.
// Replaces `Foldable`- and `Monad`-derived list ops with single-triage 1-arg-`fix` loops
// and an O(n) reverse accumulator, each backed by a machine-checked pointwise proof.
open use "kernel/prelude.disp"
open use "list.disp"

let LT := List(Tree)

// Capture spec `List.append` before rebinding so `List.rev` / `List.flatten` proofs match their closures.
let app_spec := List.append

// 1. `List.is_empty`: O(1) leaf check instead of walking the list via `rfold`
let is_empty_fast : Implicit({A} => List(A) -> Bool) := is_leaf
let pf_is_empty := {xs} => if (xs.is_nil) { t } else { t }
List.is_empty := { new := is_empty_fast; proof := pf_is_empty }

// 2. `List.len`: single-triage 1-arg fix (4.5x fewer steps than `Foldable.len`)
let len_fast : Implicit({A} => List(A) -> Nat) :=
	fix({go, xs} => triage(zero, {_} => zero, {_h, tl} => succ(go(tl)), xs))
let rec pf_len := {xs} => if (xs.is_nil) { t } else { pf_len(xs.tail) }
List.len := { new := len_fast; proof := pf_len }

// 3. `List.append`: single-triage 1-arg fix (3.6x fewer steps)
let app_fast : Implicit({A} => List(A) -> List(A) -> List(A)) := {xs, ys} =>
	fix({go, l} => triage(ys, {_} => ys, {h, tl} => cons(h, go(tl)), l))(xs)
let rec pf_app := {xs, ys} => if (xs.is_nil) { t } else { pf_app(xs.tail, ys) }
List.append := { new := app_fast; proof := pf_app }

// 4. `List.map`: single-triage 1-arg fix proven pointwise-equal to `Monad`'s `flat_map(xs, {x} => [f(x)])`!
let map_fast : Implicit({A} => Implicit({B} => List(A) -> (A -> B) -> List(B))) := {xs, f} =>
	fix({go, l} => triage([], {_} => [], {h, tl} => cons(f(h), go(tl)), l))(xs)
let rec pf_map := {xs, f} => if (xs.is_nil) { t } else { pf_map(xs.tail, f) }
List.map := { new := map_fast; proof := pf_map }

// 5. `List.filter`: single-triage 1-arg fix
let filter_fast : Implicit({A} => List(A) -> (A -> Bool) -> List(A)) := {xs, pred} =>
	fix({go, l} => triage([], {_} => [], {h, tl} => if (pred(h)) { cons(h, go(tl)) } else { go(tl) }, l))(xs)
let rec pf_filter := {xs, pred} =>
	if (xs.is_nil) { t }
	else if (pred(xs.head)) { pf_filter(xs.tail, pred) }
	else { pf_filter(xs.tail, pred) }
List.filter := { new := filter_fast; proof := pf_filter }

// 6. `List.all` & `List.any`: single-triage short-circuiting 1-arg fix
let all_fast : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := {xs, pred} =>
	fix({go, l} => triage(true, {_} => true, {h, tl} => if (pred(h)) { go(tl) } else { false }, l))(xs)
let rec pf_all := {xs, pred} =>
	if (xs.is_nil) { t }
	else if (pred(xs.head)) { pf_all(xs.tail, pred) }
	else { t }
List.all := { new := all_fast; proof := pf_all }

let any_fast : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := {xs, pred} =>
	fix({go, l} => triage(false, {_} => false, {h, tl} => if (pred(h)) { true } else { go(tl) }, l))(xs)
let rec pf_any := {xs, pred} =>
	if (xs.is_nil) { t }
	else if (pred(xs.head)) { t }
	else { pf_any(xs.tail, pred) }
List.any := { new := any_fast; proof := pf_any }

// 7. `List.contains`: single-triage short-circuiting membership
let contains_fast : LT -> Tree -> Bool := {xs, target} =>
	fix({go, l} => triage(false, {_} => false, {h, tl} => if (target == h) { true } else { go(tl) }, l))(xs)
let rec pf_contains := {xs, target} =>
	if (xs.is_nil) { t }
	else if (target == xs.head) { t }
	else { pf_contains(xs.tail, target) }
List.contains := { new := contains_fast; proof := pf_contains }

// 8. `List.flatten`: single-triage using fast `app_fast`
let flatten_fast : Implicit({A} => List(List(A)) -> List(A)) :=
	fix({go, xss} => triage([], {_} => [], {h, tl} => app_fast(h, go(tl)), xss))
let c_app := certify(check_depth, check_fuel, "all", [], [
	pair("pf_app", pair({xs : LT} -> {ys : LT} -> Eq(app_fast(xs, ys), app_spec(xs, ys)), pf_app))
])
let rec pf_flatten := {xss} =>
	if (xss.is_nil) { t }
	else { seq(pf_flatten(xss.tail), pf_app(xss.head, flatten_fast(xss.tail))) }
List.flatten := { new := flatten_fast; proof := pf_flatten; certs := [c_app] }

// 9. `List.rev`: O(n) single-triage accumulator (8.5x fewer steps than O(n^2) `rfold` spec)
let rec rev_acc := {xs, acc} => triage(acc, {_} => acc, {h, tl} => rev_acc(tl, cons(h, acc)), xs)
let c_rev_acc := certify(check_depth, check_fuel, "fix", [], [
	pair("rev_acc", pair(Implicit({A} => List(A) -> List(A) -> List(A)), rev_acc))
])
let check_module := check_with(check_depth, check_fuel, "fix", [c_rev_acc])
let rev_fast : Implicit({A} => List(A) -> List(A)) := {xs} => rev_acc(xs, [])

let rev_spec := List.rev
let rec pf_app_nil := {xs} => if (xs.is_nil) { t } else { pf_app_nil(xs.tail) }
let c_app_nil := certify(check_depth, check_fuel, "all", [], [
	pair("app_nil", pair({xs : LT} -> Eq(app_spec(xs, []), xs), pf_app_nil))
])
let rec pf_app_assoc := {xs, ys, zs} => if (xs.is_nil) { t } else { pf_app_assoc(xs.tail, ys, zs) }
let c_app_assoc := certify(check_depth, check_fuel, "all", [], [
	pair("app_assoc", pair({xs : LT} -> {ys : LT} -> {zs : LT} -> Eq(app_spec(app_spec(xs, ys), zs), app_spec(xs, app_spec(ys, zs))), pf_app_assoc))
])
let rec pf_rev_acc := {xs, acc} =>
	if (xs.is_nil) { t }
	else { seq(pf_rev_acc(xs.tail, cons(xs.head, acc)), pf_app_assoc(rev_spec(xs.tail), [xs.head], acc)) }
let c_rev_inv := certify(check_depth, check_fuel, "all", [c_app_assoc], [
	pair("rev_inv", pair({xs : LT} -> {acc : LT} -> Eq(rev_acc(xs, acc), app_spec(rev_spec(xs), acc)), pf_rev_acc))
])
let pf_rev := {xs} => seq(pf_rev_acc(xs, []), pf_app_nil(rev_spec(xs)))
List.rev := { new := rev_fast; proof := pf_rev; certs := [c_rev_inv, c_app_nil] }
