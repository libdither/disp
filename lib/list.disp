// Simple list manipulation library
open use raw "prelude.disp" {}

nil :: List A := t
cons :: {item : A, rest : List A} -> List A :=> t item rest
is_nil :: List A -> Bool := is_leaf
head :: List A -> A := pair_fst
tail :: List A -> List A := pair_snd
rec reduce :: {step : A -> C -> C, base : C} -> {xs : List A} -> C :=>
	if (is_nil xs) { base }
	else { step (head xs) (reduce (tail xs)) }

map :: {transform : A -> B} -> List A -> List B :=> reduce ({item, mapped} => cons (transform item) mapped) []
append :: {xs : List A, ys : List A} -> List A :=> reduce cons ys xs
concat :: List (List A) -> List A := reduce append []
reverse :: List A -> List A := reduce ({item, reversed} => append reversed [item]) []
length :: List A -> Nat := reduce ({_item, count} => succ count) zero
filter :: {keep : A -> Bool} -> List A -> List A :=> reduce ({item, kept} => if (keep item) { cons item kept } else { kept }) []
all :: {holds : A -> Bool} -> List A -> Bool :=> reduce ({item, rest_ok} => (holds item) && rest_ok) true
any :: {holds : A -> Bool} -> List A -> Bool :=> reduce ({item, rest_any} => (holds item) || rest_any) false
member :: {target : A} -> List A -> Bool :=> any (tree_eq target)
dedup :: List A -> List A := reduce ({item, deduped} => if (member item deduped) { deduped } else { cons item deduped }) []
cross :: {combine : A -> B -> C, xs : List A, ys : List B} -> List C :=> concat (map ({left} => map (combine left) ys) xs)
rec zip :: {xs : List A, ys : List B} -> List (Pair A B) :=>
	if (is_nil xs || is_nil ys) { [] }
	else { cons (pair (head xs) (head ys)) (zip (tail xs) (tail ys)) }

test reduce cons [] [1, 2] = [1, 2]
test length [7, 8] = 2
test map succ [1, 2] = [2, 3]
test reverse [1, 2] = [2, 1]
test append [1] [2] = [1, 2]
test concat [[1], [2]] = [1, 2]
test zip [1, 2] [8, 9] = [pair 1 8, pair 2 9]
test filter is_leaf [t, 5, t] = [t, t]
test all is_leaf [t, t] = true
test all is_leaf [t, 5] = false
test any is_fork [t, 5] = true
test member 2 [1, 2] = true
test member 3 [1, 2] = false
test dedup [1, 1, 2] = [1, 2]
test cross pair [1, 2] [8] = [pair 1 8, pair 2 8]
