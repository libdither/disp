// Checked small-step tree-calculus machine (`Machine`, `MFrame`).
// Uses the exact canonical trees from `lib/core/machine.disp` so the native `m_advance`
// fast path fires automatically on `Machine.advance`.
open use "kernel/prelude.disp"
open use "option.disp"
open use raw "core/machine.disp" {}

let check_module := check_with(check_depth, check_fuel, "all", [])

// Exact dependent machine & frame shapes
MFrame : Type := Sigma(Tree, {tag} => if ((tag == "To") || (tag == "Res")) { Tree } else { Pair(Tree, Tree) })
RunPayload : Type := Pair(Pair(Tree, Tree), List(MFrame))
RunMachine : Type := Pair(Tree, RunPayload)
Machine : Type := Sigma(Tree, {tag} => if (tag == "Done") { Tree } else { RunPayload })

// Core stepping chain checked first (minimizes `with_lemma` stack depth)
Machine.k_shaped : Tree -> Bool := k_shaped
Machine.deliver : Tree -> List(MFrame) -> Machine := m_deliver
Machine.settle_by : PartialFn(Tree -> Tree -> Bool, PartialFn(Machine, Machine)) := m_settle_by
Machine.settle : PartialFn(Machine, Machine) := m_settle
Machine.rule : RunMachine -> Machine := m_rule
Machine.step : PartialFn(Machine, Machine) := m_step
Machine.advance : Machine -> Nat -> Machine := m_advance

// Constructors & accessors (checked after the stepping loop so accessors unfold cleanly inside it)
Machine.start : Tree -> Tree -> Machine := m_start
Machine.is_finished : Machine -> Bool := m_finished
Machine.unwrap_result : Machine -> Tree := m_result
Machine.result : Machine -> Option(Tree) := {m} => if (m_finished(m)) { Some(m_result(m)) } else { None }
Machine.done : Tree -> Machine := machine_done
Machine.run : Tree -> Tree -> List(MFrame) -> Machine := machine_run
Machine.held : Tree -> Tree -> List(MFrame) -> Machine := machine_held
Machine.is_held : Machine -> Bool := m_held
Machine.fn : RunMachine -> Tree := m_fn
Machine.arg : RunMachine -> Tree := m_arg
Machine.stack : RunMachine -> List(MFrame) := m_stack

MFrame.to : Tree -> MFrame := fr_to
MFrame.res : Tree -> MFrame := fr_res
MFrame.s : Tree -> Tree -> MFrame := fr_s

// Cross-module certificate for downstream libraries (`lib/growth.disp`, `lib/stream.disp`)
machine_cert := certify(check_depth, check_fuel, "all", [], [
	pair("Machine.k_shaped", pair(Tree -> Bool, k_shaped)),
	pair("Machine.deliver", pair(Tree -> List(MFrame) -> Machine, m_deliver)),
	pair("Machine.settle_by", pair(PartialFn(Tree -> Tree -> Bool, PartialFn(Machine, Machine)), m_settle_by)),
	pair("Machine.settle", pair(PartialFn(Machine, Machine), m_settle)),
	pair("Machine.rule", pair(RunMachine -> Machine, m_rule)),
	pair("Machine.step", pair(PartialFn(Machine, Machine), m_step)),
	pair("Machine.advance", pair(Machine -> Nat -> Machine, m_advance)),
	pair("Machine.start", pair(Tree -> Tree -> Machine, m_start)),
	pair("Machine.is_finished", pair(Machine -> Bool, m_finished)),
	pair("Machine.unwrap_result", pair(Machine -> Tree, m_result))
])
