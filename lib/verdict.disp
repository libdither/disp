// Checked verdict type (`Verdict`: `Proved`, `Refuted(w)`, `Open`, `OpenOn(reason)`)
// with Rust-style `PascalCase` constructors and safe `Option`-returning accessors.
open use "kernel/prelude.disp"
open use "option.disp"

let VerdictP := {v} =>
	if (v == "Proved") { true }
	else if (v == "Open") { true }
	else if (is_fork(v)) { (v.fst == "Refuted") || (v.fst == "Open") }
	else { false }

Verdict : Type := Refine(Tree, VerdictP)

Proved : Verdict := "Proved"
Open : Verdict := "Open"
Refuted : Tree -> Verdict := {witness} => pair("Refuted", witness)
OpenOn : Tree -> Verdict := {reason} => pair("Open", reason)

Verdict.is_proved : Verdict -> Bool := {v} => v == "Proved"
Verdict.is_refuted : Verdict -> Bool := {v} => (is_fork(v)) && (v.fst == "Refuted")
Verdict.is_open : Verdict -> Bool := {v} => (v == "Open") || ((is_fork(v)) && (v.fst == "Open"))

Verdict.counterexample : Verdict -> Option(Tree) := {v} =>
	if ((is_fork(v)) && (v.fst == "Refuted")) { Some(v.snd) } else { None }

Verdict.reason : Verdict -> Option(Tree) := {v} =>
	if ((is_fork(v)) && (v.fst == "Open")) { Some(v.snd) } else { None }

Verdict.flat : Verdict -> Verdict := {v} =>
	if (Verdict.is_open(v)) { Open } else { v }

Verdict.agrees_with : Verdict -> Bool -> Bool := {v, enumerated} =>
	if (Verdict.is_proved(v)) { enumerated }
	else if (Verdict.is_open(v)) { true }
	else { not(enumerated) }

Verdict.agrees : Verdict -> Verdict -> Bool := {a, b} =>
	if (Verdict.is_open(a)) { true }
	else if (Verdict.is_open(b)) { true }
	else { Verdict.is_proved(a) == Verdict.is_proved(b) }
