// End-to-end auto-verification tests for `std_stream_extra.disp` (machine tasks, worklists, fair merge).
open use "prelude.disp"
let SE := use "std_stream_extra.disp"
let SMod := use raw "../stream.disp" {}

test is_cert(SE.stopping_list_cert) = true
test is_cert(SE.worklist_cert) = true
test is_cert(SE.s_merge_with_cert) = true
test SMod.s_list(SE.ck_s_worklist({x} => SMod.yield(succ(x)), [1, 2])) = [2, 3]
test SMod.s_list(SMod.answers(SE.ck_task({x} => succ(x), 2, 10))) = [3]
test SMod.s_list(SMod.settle(SE.ck_stopping_list([4, 5]))) = [4, 5]
