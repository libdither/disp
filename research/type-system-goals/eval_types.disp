// Types as Maps on Evaluators: `(check, assume)` with composable `Eval -> Eval` layers.
//
// Core design:
//   - One minimal base evaluator `E_base` (pure K / S / Triage + `tree_eq`, zero custom ops).
//   - Every type `T` is a pair `(check, assume)`:
//       * `check(E, fuel, next, v, k)`  : verify `v : T` inside evaluator `E`
//       * `assume(u, backing, E) -> E'` : a map `Eval -> Eval` installing `u`'s approved
//         eliminators (splitting, application, projection, equality, quotient normalizer, etc.)
//   - Type formers (`data_t`, `pi_t`, `fn_t`, `sigma_t`, `refine_t`, `the_t`, `eq_t`, `ListT`,
//     `forall_k`, `quot_t`, `bounded_pi`, `opaque_with_elim`) build their `(check, assume)`
//     purely by composing their parts' `(check, assume)`s — with zero `Check`/`Refute`
//     branching and zero reference to `tok_sig` (so first-class types are 100% token-free).
//   - `E_check_base` and `E_refute_base(n)` are two base evaluators implementing the same `Kit`.
open use raw "../../lib/prelude.disp" {}
open use raw "../../lib/list.disp" {}
open use raw "../../lib/trees.disp" {}
open use raw "../../lib/machine.disp" {}

// ---------------------------------------------------------------- answers & helpers
yes := "Yes"
is_yes :: Tree -> Bool := {r} => if (is_fork(r)) { r.fst == yes } else { false }
done :: {fuel : Nat} -> Tree :=> pair(yes, fuel)
found :: {x : Tree} -> Tree :=> pair("Found", x)
nothing := "Nothing"
is_found :: Tree -> Bool := {o} => not(o == nothing)

and_then :: {r : Tree, next : Tree} -> Tree :=> if (is_yes(r)) { next(r.snd) } else { r }
rec each :: {xs : List(Tree), fuel : Nat, f : Tree} -> Tree :=>
	if (xs.is_nil) { done(fuel) } else { and_then(f(xs.head, fuel), {f2} => each(xs.tail, f2, f)) }
rec first_found :: {xs : List(Tree), try : Tree -> Tree} -> Tree :=>
	if (xs.is_nil) { nothing } else { let r := try(xs.head); if (is_found(r)) { r } else { first_found(xs.tail, try) } }
rec lookup :: {table : List(Tree), key : Tree} -> Tree :=>
	if (table.is_nil) { nothing } else if (table.head.fst == key) { found(table.head.snd) } else { lookup(table.tail, key) }

rec twice :: {n : Nat} -> Nat :=> if (is_zero(n)) { zero } else { succ(succ(twice(nat_pred(n)))) }
rec halve :: {n : Nat} -> Nat :=> if (is_zero(n)) { zero } else if (is_zero(nat_pred(n))) { zero } else { succ(halve(nat_pred(nat_pred(n)))) }
rec log2 :: {n : Nat} -> Nat :=> if (is_zero(n)) { zero } else if (is_zero(nat_pred(n))) { zero } else { succ(log2(halve(n))) }
rec size_levels :: {k : Nat} -> List(List(Tree)) :=> if (is_zero(k)) { [[t]] } else { let ls := size_levels(nat_pred(k)); cons(next_level(ls), ls) }
/// trees of at most log2(n) / 2 + 1 nodes, smallest first
tried :: {n : Nat} -> List(Tree) :=> size_levels(halve(log2(n))).reverse.concat

// ---------------------------------------------------------------- single unforgeable handle tag
// Private to the base evaluators (`E_check_base` / `E_refute_base`). Type formers never touch
// `tok_sig` directly; they access engine capabilities only through `E.kit`, so first-class
// types (`Nat`, `NN`, `IdT`, ...) contain ZERO `tok_sig` nodes.
tok_sig := "EvalHandle"
mk_tok :: {kind : Tree, val : Tree} -> Tree :=> pair(tok_sig, pair(kind, val))
is_tok :: Tree -> Bool := {v} => if (is_fork(v)) { v.fst == tok_sig } else { false }
tok_kind :: Tree -> Tree := {v} => v.snd.fst
tok_val :: Tree -> Tree := {v} => v.snd.snd
tok_unk :: {id : Tree} -> Tree :=> mk_tok("U", id)
tok_call :: {f : Tree, x : Tree} -> Tree :=> mk_tok("C", pair(f, x))
is_unk :: Tree -> Bool := {v} => if (is_tok(v)) { tok_kind(v) == "U" } else { false }
is_call :: Tree -> Bool := {v} => if (is_tok(v)) { tok_kind(v) == "C" } else { false }
teq_tag := "TeqP"
mk_teq :: {a : Tree} -> Tree :=> mk_tok(teq_tag, a)
is_teq :: Tree -> Bool := {v} => if (is_tok(v)) { tok_kind(v) == teq_tag } else { false }

rec has_tok :: {v : Tree} -> Bool :=>
	if (is_leaf(v)) { false } else if (is_stem(v)) { has_tok(stem_child(v)) }
	else if (v.fst == tok_sig) { true } else if (has_tok(v.fst)) { true } else { has_tok(v.snd) }

fix_sig := (fix({s, x} => s(x))).fst
is_fix_fn :: Tree -> Bool := {f} => if (is_fork(f)) { f.fst == fix_sig } else { false }
is_triage :: Tree -> Bool := {f} => if (is_fork(f)) { is_fork(f.fst) } else { false }
shape_identity := t(t(t, t), t)
is_if_triage :: Tree -> Bool := {f} =>
	if (is_triage(f)) {
		let st := f.fst.snd
		let fk := f.snd
		(k_shaped(st)) && ((k_shaped(fk)) && ((k_shaped(fk.snd)) && (st.snd == fk.snd.snd)))
	} else { false }

// ---------------------------------------------------------------- derived cases from predicates
derive_root := "DR"
d_unk :: {path : Tree} -> Tree :=> tok_unk(pair(derive_root, path))
is_d_unk :: Tree -> Bool := {v} => if (is_unk(v)) { if (is_fork(tok_val(v))) { tok_val(v).fst == derive_root } else { false } } else { false }
is_strict_d_unk :: Tree -> Bool := {v} => if (is_d_unk(v)) { not(tok_val(v).snd == t) } else { false }

rec d_subst :: {u : Tree, val : Tree, tree : Tree} -> Tree :=>
	if (tree == u) { val }
	else if (is_leaf(tree)) { tree }
	else if (is_stem(tree)) { t(d_subst(u, val, stem_child(tree))) }
	else if (tree.fst == tok_sig) {
		if (tok_kind(tree) == "C") { tok_call(d_subst(u, val, tok_val(tree).fst), d_subst(u, val, tok_val(tree).snd)) }
		else { tree }
	}
	else { pair(d_subst(u, val, tree.fst), d_subst(u, val, tree.snd)) }

d_alts :: {u : Tree} -> List(Tree) :=> {
	let pth := tok_val(u).snd
	[t, t(d_unk(pair("s", pth))), pair(d_unk(pair("l", pth)), d_unk(pair("r", pth)))]
}

rec d_deliver :: {v : Tree, stack : List(Tree)} -> Tree :=>
	if (stack.is_nil) { machine_done(v) }
	else {
		let fr := stack.head
		let rest := stack.tail
		if (fr.fst == "To") { machine_run(v, fr.snd, rest) }
		else if (fr.fst == "Res") { machine_run(fr.snd, v, rest) }
		else if (k_shaped(fr.snd.fst)) { machine_run(v, fr.snd.fst.snd, rest) }
		else if (not(is_fork(v))) { machine_run(fr.snd.fst, fr.snd.snd, cons(fr_res(v), rest)) }
		else if (is_leaf(v.fst)) { d_deliver(v.snd, rest) }
		else if (v.fst == tok_sig) { pair("DNeed", pair(v, stack)) }
		else { machine_run(fr.snd.fst, fr.snd.snd, cons(fr_res(v), rest)) }
	}
rec d_settle :: {m : Tree} -> Tree :=>
	if (m.fst == "Run") {
		let f := m.m_fn
		if (is_leaf(f)) { d_settle(d_deliver(t(m.m_arg), m.m_stack)) }
		else if (is_stem(f)) { d_settle(d_deliver(t(stem_child(f), m.m_arg), m.m_stack)) }
		else { m }
	} else { m }

d_teq_step :: {go : Tree, shape : Tree, facts : List(Tree), a : Tree, x : Tree, stack : List(Tree), f2 : Nat, depth : Nat} -> Tree :=>
	if ((not(has_tok(a))) && (not(has_tok(x)))) { go(shape, facts, d_deliver(tree_eq(a, x), stack), f2, depth) }
	else if (a == x) { go(shape, facts, d_deliver(true, stack), f2, depth) }
	else if (is_d_unk(a)) {
		if (is_zero(depth)) { nothing }
		else {
			let rs := d_alts(a).map({alt} => go(d_subst(a, alt, shape), facts, machine_run(mk_teq(alt), d_subst(a, alt, x), d_subst(a, alt, stack)), f2, nat_pred(depth)))
			if (rs.all(is_found)) { found(rs.map(pair_snd).concat) } else { nothing }
		}
	}
	else if (is_d_unk(x)) {
		if (is_zero(depth)) { nothing }
		else {
			let rs := d_alts(x).map({alt} => go(d_subst(x, alt, shape), facts, machine_run(mk_teq(d_subst(x, alt, a)), alt, d_subst(x, alt, stack)), f2, nat_pred(depth)))
			if (rs.all(is_found)) { found(rs.map(pair_snd).concat) } else { nothing }
		}
	}
	else if (is_leaf(a)) { go(shape, facts, d_deliver(is_leaf(x), stack), f2, depth) }
	else if (is_stem(a)) {
		if (is_stem(x)) { go(shape, facts, machine_run(mk_teq(stem_child(a)), stem_child(x), stack), f2, depth) }
		else { go(shape, facts, d_deliver(false, stack), f2, depth) }
	}
	else if (is_fork(x)) {
		go(shape, facts, machine_run(mk_teq(a.fst), x.fst, cons(fr_res(triage(mk_teq(a.snd), {_} => {_} => false, {_l, _r} => {_} => false)), cons(fr_to(x.snd), stack))), f2, depth)
	}
	else { go(shape, facts, d_deliver(false, stack), f2, depth) }

d_triage_tok :: {go : Tree, shape : Tree, facts : List(Tree), f : Tree, x : Tree, stack : List(Tree), f2 : Nat, depth : Nat} -> Tree :=>
	if (f == shape_identity) { go(shape, facts, d_deliver(x, stack), f2, depth) }
	else if (is_zero(depth)) { nothing }
	else if (is_d_unk(x)) {
		let rs := d_alts(x).map({alt} => go(d_subst(x, alt, shape), facts, machine_run(d_subst(x, alt, f), alt, d_subst(x, alt, stack)), f2, nat_pred(depth)))
		if (rs.all(is_found)) { found(rs.map(pair_snd).concat) } else { nothing }
	}
	else if (is_call(x)) {
		let r_t := go(shape, cons(tok_val(x), facts), d_deliver(f.fst.fst, stack), f2, nat_pred(depth))
		let r_f := go(shape, facts, machine_run(f.fst.snd, t, stack), f2, nat_pred(depth))
		if ((is_found(r_t)) && (is_found(r_f))) { found(r_t.snd.append(r_f.snd)) } else { nothing }
	}
	else { nothing }

rec d_go :: {shape : Tree, facts : List(Tree), mach0 : Tree, fuel : Nat, depth : Nat} -> Tree :=> {
	let mach := d_settle(mach0)
	if (m_finished(mach)) {
		let res := m_result(mach)
		if (res == true) { found([pair(shape, facts)]) }
		else if (is_call(res)) { found([pair(shape, cons(tok_val(res), facts))]) }
		else { found([]) }
	}
	else if (is_zero(fuel)) { nothing }
	else if (mach.fst == "Run") {
		let f := mach.m_fn
		let x := mach.m_arg
		let stack := mach.m_stack
		let f2 := nat_pred(fuel)
		if (is_leaf(f.fst)) { d_go(shape, facts, d_deliver(f.snd, stack), f2, depth) }
		else if (is_stem(f.fst)) {
			if ((f.fst == fix_sig) && (is_strict_d_unk(x))) {
				let r := lookup(facts, pair(f, x))
				if (is_found(r)) { d_go(shape, facts, d_deliver(r.snd, stack), f2, depth) }
				else { d_go(shape, facts, d_deliver(tok_call(f, x), stack), f2, depth) }
			}
			else if (f == tree_eq) { d_go(shape, facts, d_deliver(mk_teq(x), stack), f2, depth) }
			else {
				let c := stem_child(f.fst)
				if (k_shaped(c)) { d_go(shape, facts, d_deliver(c.snd, cons(fr_s(f.snd, x), stack)), f2, depth) }
				else { d_go(shape, facts, machine_run(c, x, cons(fr_s(f.snd, x), stack)), f2, depth) }
			}
		}
		else if (is_teq(f)) { d_teq_step(d_go, shape, facts, tok_val(f), x, stack, f2, depth) }
		else if ((f.fst == tok_sig) || ((is_fork(f.fst)) && (f.fst.fst == tok_sig))) { nothing }
		else if (is_leaf(x)) { d_go(shape, facts, d_deliver(f.fst.fst, stack), f2, depth) }
		else if (is_stem(x)) { d_go(shape, facts, machine_run(f.fst.snd, stem_child(x), stack), f2, depth) }
		else if (x.fst == tok_sig) { d_triage_tok(d_go, shape, facts, f, x, stack, f2, depth) }
		else { d_go(shape, facts, machine_run(f.snd, x.fst, cons(fr_to(x.snd), stack)), f2, depth) }
	}
	else { nothing }
}
derive_cases :: {pred : Tree} -> Tree :=> d_go(d_unk(t), [], m_start(pred, d_unk(t)), 2000, 12)
rec rename_d :: {u : Tree, v : Tree} -> Tree :=>
	if (is_d_unk(v)) { tok_unk(pair("p", pair(u, tok_val(v).snd))) }
	else if (is_leaf(v)) { v }
	else if (is_stem(v)) { t(rename_d(u, stem_child(v))) }
	else { pair(rename_d(u, v.fst), rename_d(u, v.snd)) }

// ================================================================ LAYERED EVALUATOR CORE
// Minimal 7-field `Kit` (`run`, `quantify` differ between checking & refuting; the other 5
// keep `tok_sig` private to the base evaluators so first-class types contain ZERO tokens).
record mk_kit :: {
	run : Tree,        // (E, fuel, next, m, k) -> Res  (accepts `m_start`, `machine_run`, `m_ret`)
	quantify : Tree,   // (E, fuel, next, A, rec_T, f, body, k) -> Res
	fresh : Tree,      // (label) -> unk
	deep_res : Tree,   // (E, v) -> Tree
	head_tok : Tree,   // (v) -> "U" (unk) | "T" (other handle) | "N" (plain tree)
	has_tok : Tree,    // (v) -> Bool
	cases : Tree       // (pred, u) -> Maybe(List(pair(shape, List(pair(sub_pred, sub_u)))))
} -> Kit

record ev :: {step : Tree, lazy : Tree, resolve : Tree, eq : Tree, has_tag : Tree, kit : Kit, meta : Tree} -> Eval

m_ret :: {v : Tree, stack : List(Tree)} -> Tree :=> pair("Deliver", pair(v, stack))

/// Run a concrete call `f(x)` with a step budget (never hangs on diverging predicates/families)
try_call :: {f : Tree, x : Tree, limit : Nat} -> Tree :=> {
	let m := m_advance(m_start(f, x), limit)
	if (m_finished(m)) { found(m_result(m)) } else { nothing }
}
refute_pred_fuel := 500

ev_depth :: Eval -> Nat := {E} => E.meta.fst
ev_sure :: Eval -> Bool := {E} => E.meta.snd.fst
ev_cap :: Eval -> Tree := {E} => E.meta.snd.snd.fst
ev_unbox :: Eval -> Tree := {E} => E.meta.snd.snd.snd.fst
ev_rec_ctx :: Eval -> Tree := {E} => E.meta.snd.snd.snd.snd
ev_set_meta :: {E : Eval, m : Tree} -> Eval :=> ev(E.step, E.lazy, E.resolve, E.eq, E.has_tag, E.kit, m)
ev_deeper :: {E : Eval} -> Eval :=> ev_set_meta(E, pair(nat_pred(ev_depth(E)), E.meta.snd))
ev_set_sure :: {E : Eval, s : Bool} -> Eval :=> ev_set_meta(E, pair(ev_depth(E), pair(s, E.meta.snd.snd)))
ev_set_cap :: {E : Eval, c : Tree} -> Eval :=> ev_set_meta(E, pair(ev_depth(E), pair(ev_sure(E), pair(c, E.meta.snd.snd.snd))))
ev_set_unbox :: {E : Eval, u : Tree} -> Eval :=> ev_set_meta(E, pair(ev_depth(E), pair(ev_sure(E), pair(ev_cap(E), pair(u, ev_rec_ctx(E))))))
ev_set_rec :: {E : Eval, rc : Tree} -> Eval :=> ev_set_meta(E, pair(ev_depth(E), pair(ev_sure(E), pair(ev_cap(E), pair(ev_unbox(E), rc)))))

rec unbox_tree :: {ub : Tree, v : Tree} -> Tree :=> {
	let r := ub(v)
	if (not(r == v)) { r }
	else if (is_leaf(v)) { v }
	else if (is_stem(v)) { t(unbox_tree(ub, stem_child(v))) }
	else { pair(unbox_tree(ub, v.fst), unbox_tree(ub, v.snd)) }
}

rec deliver_m :: {E : Eval, v0 : Tree, stack : List(Tree)} -> Tree :=>
	if (stack.is_nil) { machine_done(v0) }
	else {
		let fr := stack.head
		let rest := stack.tail
		if (fr.fst == "To") { machine_run(v0, fr.snd, rest) }
		else if (fr.fst == "Res") { machine_run(fr.snd, v0, rest) }
		else if (k_shaped(fr.snd.fst)) { machine_run(v0, fr.snd.fst.snd, rest) }
		else {
			let v := E.resolve(v0)
			if (not(is_fork(v))) { machine_run(fr.snd.fst, fr.snd.snd, cons(fr_res(v), rest)) }
			else if (is_leaf(v.fst)) { deliver_m(E, v.snd, rest) }
			else if (v.fst == tok_sig) { pair("Lazy", pair(v, stack)) }
			else { machine_run(fr.snd.fst, fr.snd.snd, cons(fr_res(v), rest)) }
		}
	}
rec settle_m :: {E : Eval, m : Tree} -> Tree :=>
	if (m.fst == "Run") {
		let f := m.m_fn
		if (is_leaf(f)) { settle_m(E, deliver_m(E, t(m.m_arg), m.m_stack)) }
		else if (is_stem(f)) {
			if (stem_child(f) == tok_sig) { pair("Forge", t) }
			else { settle_m(E, deliver_m(E, t(stem_child(f), m.m_arg), m.m_stack)) }
		}
		else { m }
	} else { m }

/// Core loop: free builds, forge guard, step cap if active, delegate to `E.step` / `E.lazy`
rec run_ev :: {E : Eval, fuel : Nat, next : Nat, m0 : Tree, k : Tree} -> Tree :=> {
	let m := if (m0.fst == "Deliver") { settle_m(E, deliver_m(E, m0.snd.fst, m0.snd.snd)) } else { settle_m(E, m0) }
	if (m_finished(m)) { k(E, fuel, next, m_result(m)) }
	else if (m.fst == "Forge") { "Builds a token" }
	else if (is_zero(fuel)) { "Out of fuel" }
	else if (m.fst == "Lazy") {
		let v := m.snd.fst
		let stack := m.snd.snd
		let fr := stack.head
		E.lazy(E, nat_pred(fuel), next, v, fr.snd.fst, fr.snd.snd, stack.tail, k)
	}
	else {
		let cap := ev_cap(E)
		if ((is_fork(cap)) && (cap.fst == "Cap")) {
			if (is_zero(cap.snd)) { pair("Fault", "slow") }
			else {
				let E1 := ev_set_cap(E, pair("Cap", nat_pred(cap.snd)))
				E1.step(E1, nat_pred(fuel), next, m.m_fn, m.m_arg, m.m_stack, k)
			}
		}
		else { E.step(E, nat_pred(fuel), next, m.m_fn, m.m_arg, m.m_stack, k) }
	}
}
deliver_ev :: {E : Eval, fuel : Nat, next : Nat, v : Tree, stack : List(Tree), k : Tree} -> Tree :=>
	run_ev(E, fuel, next, deliver_m(E, v, stack), k)

rec deep_resolve :: {E : Eval, v0 : Tree} -> Tree :=> {
	let v := E.resolve(v0)
	if (is_leaf(v)) { v }
	else if (is_stem(v)) { t(deep_resolve(E, stem_child(v))) }
	else if (v.fst == tok_sig) {
		if (tok_kind(v) == "C") { tok_call(deep_resolve(E, tok_val(v).fst), deep_resolve(E, tok_val(v).snd)) }
		else { v }
	}
	else { pair(deep_resolve(E, v.fst), deep_resolve(E, v.snd)) }
}
head_tok_of :: Tree -> Tree := {v} => if (is_tok(v)) { if (tok_kind(v) == "U") { "U" } else { "T" } } else { "N" }
derive_for :: {pred : Tree, u : Tree} -> Tree :=> {
	let cs := derive_cases(pred)
	if (is_found(cs)) {
		found(cs.snd.map({c} => pair(rename_d(u, c.fst), c.snd.map({fp} => pair(fp.fst, rename_d(u, fp.snd))))))
	} else { nothing }
}

rec occurs :: {u : Tree, v : Tree} -> Bool :=>
	if (v == u) { true }
	else if (is_leaf(v)) { false }
	else if (is_stem(v)) { occurs(u, stem_child(v)) }
	else { (occurs(u, v.fst)) || (occurs(u, v.snd)) }

prune_ev :: {E : Eval} -> Eval :=>
	ev({self, fl, _nx, _f, _x, _st, _kk} => if (ev_sure(self)) { "Family may not finish" } else { done(fl) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)

// ================================================================ EVALUATOR MAPS (Eval -> Eval)
// Every map below is 100% token-free (never touches `tok_sig` directly; uses only `E.kit`).

with_subst :: {u : Tree, val : Tree, E : Eval} -> Eval :=> {
	let prev_res := E.resolve
	ev(E.step, E.lazy, {v} => { let r := prev_res(v); if (r == u) { prev_res(val) } else { r } }, E.eq, E.has_tag, E.kit, E.meta)
}

with_fact :: {cf : Tree, cx : Tree, ans : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if ((f == cf) && (self.resolve(x) == self.resolve(cx))) { self.kit.run(self, fuel, next, m_ret(ans, stack), k) }
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

/// Equality assumption map: `a == b` (symmetric + acyclic downward transitivity)
with_eq :: {a : Tree, b : Tree, E : Eval} -> Eval :=> {
	let prev_eq := E.eq
	let E1 := ev(E.step, E.lazy, E.resolve, {self, x0, y0} => {
		let rx := self.kit.deep_res(self, x0)
		let ry := self.kit.deep_res(self, y0)
		let ra := self.kit.deep_res(self, a)
		let rb := self.kit.deep_res(self, b)
		if (((rx == ra) && (ry == rb)) || ((rx == rb) && (ry == ra))) { "True" }
		else if ((rx == ra) && (prev_eq(E, rb, ry) == "True")) { "True" }
		else if ((rx == rb) && (prev_eq(E, ra, ry) == "True")) { "True" }
		else if ((ry == ra) && (prev_eq(E, rx, rb) == "True")) { "True" }
		else if ((ry == rb) && (prev_eq(E, rx, ra) == "True")) { "True" }
		else { prev_eq(self, x0, y0) }
	}, E.has_tag, E.kit, E.meta)
	let ra := E.resolve(a)
	let rb := E.resolve(b)
	if ((E.kit.head_tok(ra) == "U") && (not(occurs(ra, E1.kit.deep_res(E1, rb))))) { with_subst(ra, rb, E1) }
	else if ((E.kit.head_tok(rb) == "U") && (not(occurs(rb, E1.kit.deep_res(E1, ra))))) { with_subst(rb, ra, E1) }
	else { E1 }
}

rec with_data :: {pred : Tree, u : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	let prev_lazy := E.lazy
	let split_it := {self, fuel, next, cont} =>
		if (is_zero(ev_depth(self))) { "Out of depth" }
		else {
			let cs := self.kit.cases(pred, u)
			if (not(is_found(cs))) { "Cannot derive cases" }
			else {
				let E_d := ev_deeper(self)
				each(cs.snd, fuel, {c, fl} => {
					let shape := c.fst
					let E1 := reduce({fp, acc} => with_data(fp.fst, fp.snd, acc), with_subst(u, shape, E_d), c.snd)
					cont(E1, fl, next, shape)
				})
			}
		}
	ev(
		{self, fuel, next, f, x, stack, k} => {
			let rx := self.resolve(x)
			if ((f == pred) && (rx == u)) { self.kit.run(self, fuel, next, m_ret(true, stack), k) }
			else if ((is_triage(f)) && ((not(f == shape_identity)) && ((self.kit.head_tok(f) == "N") && (rx == u)))) {
				split_it(self, fuel, next, {E1, fl, nx, sh} => E1.kit.run(E1, fl, nx, machine_run(f, sh, stack), k))
			}
			else { prev_step(self, fuel, next, f, x, stack, k) }
		},
		{self, fuel, next, v, b, x, rest, k} =>
			if (self.resolve(v) == u) {
				split_it(self, fuel, next, {E1, fl, nx, sh} => E1.kit.run(E1, fl, nx, m_ret(sh, cons(fr_s(b, x), rest)), k))
			}
			else { prev_lazy(self, fuel, next, v, b, x, rest, k) },
		E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_abstract :: {tag : Tree, u : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	let prev_tag := E.has_tag
	let prev_eq := E.eq
	ev(
		{self, fuel, next, f, x, stack, k} => {
			let rf := self.resolve(f)
			let rx := self.resolve(x)
			if (rf == u) { pair("Fault", "Applies abstract value") }
			else if ((is_triage(rf)) && ((not(rf == shape_identity)) && ((self.kit.head_tok(rf) == "N") && (rx == u)))) {
				pair("Fault", "Inspects abstract value")
			}
			else { prev_step(self, fuel, next, f, x, stack, k) }
		},
		E.lazy, E.resolve,
		{self, a, b} => if ((self.resolve(a) == u) || (self.resolve(b) == u)) { pair("Err", "Compares abstract value") } else { prev_eq(self, a, b) },
		{self, t0, v} =>
			if ((self.resolve(v) == u) && (self.eq(self, t0, tag) == "True")) { true }
			else { prev_tag(self, t0, v) },
		E.kit, E.meta)
}

/// Abstract type parameter layer for `forall_k`: blocks inspecting/comparing `X` without false refutations
with_abs_type :: {u : Tree, real : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	let prev_eq := E.eq
	let prev_ub := ev_unbox(E)
	let E1 := ev_set_unbox(E, {v} => if (v == u) { real } else { prev_ub(v) })
	ev(
		{self, fuel, next, f, x, stack, k} => {
			let rf := self.resolve(f)
			let rx := self.resolve(x)
			if (rf == u) { "Applies abstract type" }
			else if ((is_triage(rf)) && ((not(rf == shape_identity)) && ((self.kit.head_tok(rf) == "N") && (rx == u)))) {
				"Inspects abstract type"
			}
			else { prev_step(self, fuel, next, f, x, stack, k) }
		},
		E1.lazy, E1.resolve,
		{self, a, b} => if ((self.resolve(a) == u) || (self.resolve(b) == u)) { pair("Refuse", "Compares abstract type") } else { prev_eq(self, a, b) },
		E1.has_tag, E1.kit, E1.meta)
}

/// Custom approved eliminator layer: verifies `elim_fn : elim_ty` before approving `elim_fn(u)`
with_elim :: {elim_fn : Tree, elim_ty : Tree, R : Tree, u : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if ((self.resolve(f) == elim_fn) && (self.resolve(x) == u)) {
			and_then(elim_ty.fst(ev_set_rec(ev_set_cap(self, "None"), "None"), fuel, next, elim_fn, {_E0, fl0, _nx0, _ok} => done(fl0)), {fl1} => {
				let r := self.kit.fresh(pair("elim", pair(elim_fn, u)))
				let E1 := R.snd(r, "None", self)
				E1.kit.run(E1, fl1, next, m_ret(r, stack), k)
			})
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_sigma_sym :: {A : Tree, fam : Tree, p : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if ((is_triage(f)) && ((not(f == shape_identity)) && ((self.kit.head_tok(f) == "N") && (self.resolve(x) == p)))) {
			let a := self.kit.fresh(pair("fst", next))
			let b := self.kit.fresh(pair("snd", next))
			let E1 := A.snd(a, "None", with_subst(p, pair(a, b), self))
			E1.kit.run(ev_set_sure(E1, true), fuel, succ(next), m_start(fam, a), {E2, fl2, nx2, B} => {
				let E3 := B.snd(b, "None", ev_set_sure(E2, ev_sure(E1)))
				E3.kit.run(E3, fl2, nx2, machine_run(f, pair(a, b), stack), k)
			})
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_list_sym :: {A : Tree, L_thunk : Tree, xs : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if ((is_triage(f)) && ((not(f == shape_identity)) && ((self.kit.head_tok(f) == "N") && (self.resolve(x) == xs)))) {
			if (is_zero(ev_depth(self))) { "Out of depth" }
			else {
				let E_d := ev_deeper(self)
				let E_nil := with_subst(xs, t, E_d)
				and_then(E_nil.kit.run(E_nil, fuel, next, machine_run(f, t, stack), k), {f2} => {
					let hd := self.kit.fresh(pair("hd", next))
					let tl := self.kit.fresh(pair("tl", next))
					let E_cons := L_thunk(tl).snd(tl, "None", A.snd(hd, "None", with_subst(xs, pair(hd, tl), E_d)))
					E_cons.kit.run(E_cons, f2, succ(next), machine_run(f, pair(hd, tl), stack), k)
				})
			}
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_quot_sym :: {A : Tree, norm : Tree, q : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	let prev_eq := E.eq
	ev({self, fuel, next, f, x, stack, k} => {
		let rf := self.resolve(f)
		let rx := self.resolve(x)
		if ((rf == norm) && (rx == q)) {
			let r := self.kit.fresh(pair("qnorm", pair(norm, q)))
			let E1 := A.snd(r, "None", self)
			E1.kit.run(E1, fuel, next, m_ret(r, stack), k)
		}
		else if ((is_triage(rf)) && ((not(rf == shape_identity)) && ((self.kit.head_tok(rf) == "N") && (rx == q)))) {
			pair("Fault", "Breaks quotient abstraction")
		}
		else { prev_step(self, fuel, next, f, x, stack, k) }
	},
	E.lazy, E.resolve,
	{self, a, b} => if ((self.resolve(a) == q) || (self.resolve(b) == q)) { pair("Err", "Compares quotient directly") } else { prev_eq(self, a, b) },
	E.has_tag, E.kit, E.meta)
}

// ---------------------------------------------------------------- base evaluator (`E_base`)
/// Strict concrete subtree check: descends ONLY through real stem/fork constructors, never into `tok_sig`
rec is_subterm :: {needle : Tree, hay : Tree} -> Bool :=>
	if (needle == hay) { true }
	else if (is_leaf(hay)) { false }
	else if (is_stem(hay)) { is_subterm(needle, stem_child(hay)) }
	else if (hay.fst == tok_sig) { false }
	else { (is_subterm(needle, hay.fst)) || (is_subterm(needle, hay.snd)) }

strict_subterm :: {needle : Tree, hay : Tree} -> Bool :=>
	if (is_leaf(hay)) { false }
	else if (is_stem(hay)) { is_subterm(needle, stem_child(hay)) }
	else if (hay.fst == tok_sig) { false }
	else { (is_subterm(needle, hay.fst)) || (is_subterm(needle, hay.snd)) }

/// Guards a partially applied recursive call handle until a remaining lexicographic argument strictly decreases
rec with_lex_guard :: {h : Tree, rest_origs : List(Tree), E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if (self.resolve(f) == h) {
			let rx := deep_resolve(self, x)
			let ox := deep_resolve(self, rest_origs.head)
			if (strict_subterm(rx, ox)) { prev_step(self, fuel, next, f, x, stack, k) }
			else if ((rx == ox) && (not(rest_origs.tail.is_nil))) {
				prev_step(self, fuel, next, f, x, [], {E2, fl2, nx2, res_h} =>
					deliver_ev(with_lex_guard(res_h, rest_origs.tail, E2), fl2, nx2, res_h, stack, k))
			}
			else { "Non-decreasing recursive call" }
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_rec :: {subj : Tree, T_thunk : Tree, orig0 : Tree, is_total : Bool, E : Eval} -> Eval :=> {
	let prev_step := E.step
	let armed := ev({self, fuel, next, f, x, stack, k} =>
		if ((not(ev_sure(self))) && (self.resolve(f) == subj)) {
			let rx := deep_resolve(self, x)
			let u_r := tok_unk(pair("rec", pair(subj, rx)))
			let E1 := T_thunk(u_r).snd(u_r, "None", self)
			if (not(is_total)) { run_ev(E1, fuel, next, machine_run(u_r, x, stack), k) }
			else {
				let ctx := ev_rec_ctx(self)
				let origs := if ((is_fork(ctx)) && (ctx.fst == subj)) { ctx.snd } else { [orig0] }
				let ox := deep_resolve(self, origs.head)
				if (strict_subterm(rx, ox)) { run_ev(E1, fuel, next, machine_run(u_r, x, stack), k) }
				else if ((rx == ox) && (not(origs.tail.is_nil))) {
					run_ev(E1, fuel, next, machine_run(u_r, x, []), {E2, fl2, nx2, res_h} =>
						deliver_ev(with_lex_guard(res_h, origs.tail, E2), fl2, nx2, res_h, stack, k))
				}
				else { "Non-decreasing recursive call" }
			}
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
	ev({self, fuel, next, f, x, stack, k} =>
		if (self.resolve(f) == subj) {
			let c := stem_child(f.fst)
			let E_arm := ev_set_meta(armed, self.meta)
			if (k_shaped(c)) { deliver_ev(E_arm, fuel, next, c.snd, cons(fr_s(f.snd, x), stack), k) }
			else { run_ev(E_arm, fuel, next, machine_run(c, x, cons(fr_s(f.snd, x), stack)), k) }
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}

with_lemma :: {lem_fn : Tree, T : Tree, E : Eval} -> Eval :=> {
	let prev_step := E.step
	ev({self, fuel, next, f, x, stack, k} =>
		if ((not(ev_sure(self))) && ((self.resolve(f) == lem_fn) && (has_tok(deep_resolve(self, x))))) {
			let u_l := tok_unk(pair("lem", lem_fn))
			let E1 := T.snd(u_l, "None", self)
			run_ev(E1, fuel, next, machine_run(u_l, x, stack), k)
		}
		else { prev_step(self, fuel, next, f, x, stack, k) },
		E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
}
base_eq :: {self : Eval, a0 : Tree, b0 : Tree} -> Tree :=> {
	let a := self.resolve(a0)
	let b := self.resolve(b0)
	if (a == b) { "True" }
	else {
		let ra := deep_resolve(self, a)
		let rb := deep_resolve(self, b)
		if (ra == rb) { "True" }
		else if ((is_call(a)) && (is_call(b))) {
			let fa := tok_val(a).fst
			let fb := tok_val(b).fst
			let lf := if (fa == fb) { "True" } else { self.eq(self, fa, fb) }
			if (lf == "True") { self.eq(self, tok_val(a).snd, tok_val(b).snd) } else { "Stuck" }
		}
		else if ((is_tok(a)) || (is_tok(b))) { "Stuck" }
		else if (is_leaf(a)) { if (is_leaf(b)) { "True" } else { "False" } }
		else if (is_stem(a)) { if (is_stem(b)) { self.eq(self, stem_child(a), stem_child(b)) } else { "False" } }
		else if (is_fork(b)) {
			let l := self.eq(self, a.fst, b.fst)
			if (l == "True") { self.eq(self, a.snd, b.snd) } else { l }
		}
		else { "False" }
	}
}

base_fork_step :: {self : Eval, fuel : Nat, next : Nat, f : Tree, x : Tree, stack : List(Tree), k : Tree} -> Tree :=>
	if (f.fst == tok_sig) {
		if (is_teq(f)) {
			let r := self.eq(self, tok_val(f), x)
			if (r == "True") { deliver_ev(self, fuel, next, true, stack, k) }
			else if (r == "False") { deliver_ev(self, fuel, next, false, stack, k) }
			else if ((is_fork(r)) && (r.fst == "Err")) { pair("Fault", r.snd) }
			else if ((is_fork(r)) && (r.fst == "Refuse")) { r.snd }
			else { deliver_ev(self, fuel, next, tok_call(pair("Eq", tok_val(f)), x), stack, k) }
		}
		else if (is_call(f)) {
			let cf := tok_val(f).fst
			if ((is_fix_fn(cf)) || (is_call(cf))) { deliver_ev(self, fuel, next, tok_call(f, x), stack, k) }
			else { "Stuck applying unknown" }
		}
		else { "Stuck applying unknown" }
	}
	else if (f == shape_identity) { deliver_ev(self, fuel, next, x, stack, k) }
	else if (is_leaf(x)) { deliver_ev(self, fuel, next, f.fst.fst, stack, k) }
	else if (is_stem(x)) { run_ev(self, fuel, next, machine_run(f.fst.snd, stem_child(x), stack), k) }
	else if (x.fst == tok_sig) {
		if (is_call(x)) {
			let cf := tok_val(x).fst
			let cx := tok_val(x).snd
			if (is_if_triage(f)) {
				let E_t := if ((is_fork(cf)) && (cf.fst == "Eq")) { with_eq(cf.snd, cx, self) } else { with_fact(cf, cx, true, self) }
				and_then(deliver_ev(E_t, fuel, next, f.fst.fst, stack, k), {f2} => {
					let E_f := with_fact(cf, cx, false, self)
					run_ev(E_f, f2, next, machine_run(f.fst.snd, t, stack), k)
				})
			}
			else { "Stuck triaging call" }
		}
		else { "Cannot inspect abstract unknown" }
	}
	else { run_ev(self, fuel, next, machine_run(f.snd, x.fst, cons(fr_to(x.snd), stack)), k) }

base_step :: {self : Eval, fuel : Nat, next : Nat, f0 : Tree, x0 : Tree, stack : List(Tree), k : Tree} -> Tree :=> {
	let f := self.resolve(f0)
	if (not(f == f0)) { run_ev(self, succ(fuel), next, machine_run(f, x0, stack), k) }
	else if (is_leaf(f.fst)) { deliver_ev(self, fuel, next, f.snd, stack, k) }
	else if (is_stem(f.fst)) {
		let x := self.resolve(x0)
		if (f == tree_eq) { deliver_ev(self, fuel, next, mk_teq(x), stack, k) }
		else if ((is_fix_fn(f)) && (is_unk(x))) { deliver_ev(self, fuel, next, tok_call(f, x), stack, k) }
		else {
			let c := stem_child(f.fst)
			if (k_shaped(c)) { deliver_ev(self, fuel, next, c.snd, cons(fr_s(f.snd, x0), stack), k) }
			else { run_ev(self, fuel, next, machine_run(c, x0, cons(fr_s(f.snd, x0), stack)), k) }
		}
	}
	else { base_fork_step(self, fuel, next, f, self.resolve(x0), stack, k) }
}

base_lazy :: {self : Eval, fuel : Nat, next : Nat, v : Tree, b : Tree, x : Tree, rest : List(Tree), k : Tree} -> Tree :=>
	run_ev(self, fuel, next, machine_run(b, x, cons(fr_res(v), rest)), k)

// ---------------------------------------------------------------- checker & refuter kits
// Only `run` and `quantify` differ between `check_kit` and `refute_kit`!
// The other 5 fields (`fresh`, `deep_res`, `head_tok`, `has_tok`, `cases`) are identical
// and exist purely to keep `tok_sig` private to the base evaluators.
mk_fresh :: {label : Tree} -> Tree :=>
	if ((is_fork(label)) && (label.fst == "Call")) { tok_call(label.snd.fst, label.snd.snd) }
	else { tok_unk(label) }

check_kit :: Kit := mk_kit{
	run := run_ev,
	quantify := {E, fuel, next, A, rec_T, f, body, k} => {
		let u := tok_unk(pair("arg", next))
		let E1 := A.snd(u, "None", E)
		let E2 :=
			if ((is_fork(rec_T)) && ((rec_T.fst == "Rec") && (is_fix_fn(f)))) {
				with_rec(f, rec_T.snd, u, true, ev_set_rec(E1, pair(f, [u])))
			}
			else if ((is_fork(rec_T)) && ((rec_T.fst == "PartialRec") && (is_fix_fn(f)))) {
				with_rec(f, rec_T.snd, u, false, ev_set_rec(E1, "None"))
			}
			else if ((is_fork(rec_T)) && ((rec_T.fst == "Rec") && (is_fork(ev_rec_ctx(E1))))) {
				let ctx := ev_rec_ctx(E1)
				ev_set_rec(E1, pair(ctx.fst, ctx.snd.append([u])))
			}
			else { ev_set_rec(E1, "None") }
		body(E2, fuel, succ(next), u, "None", k)
	},
	fresh := mk_fresh,
	deep_res := deep_resolve,
	head_tok := head_tok_of,
	has_tok := has_tok,
	cases := derive_for
}

/// Native Rust fast-path for purely concrete top-level calls in `refute_kit` (no handles/tokens)
refute_run :: {E : Eval, fuel : Nat, next : Nat, m0 : Tree, k : Tree} -> Tree :=>
	if ((m0.fst == "Run") && (m0.m_stack.is_nil)) {
		let rf := deep_resolve(E, m0.m_fn)
		let rx := deep_resolve(E, m0.m_arg)
		if ((not(has_tok(rf))) && (not(has_tok(rx)))) {
			let cap := ev_cap(E)
			if ((is_fork(cap)) && (cap.fst == "Cap")) {
				let m_res := m_advance(m_start(rf, rx), cap.snd)
				if (m_finished(m_res)) { k(E, fuel, next, m_result(m_res)) }
				else { pair("Fault", "slow") }
			}
			else {
				let m_res := m_advance(m_start(rf, rx), fuel)
				if (m_finished(m_res)) { k(E, fuel, next, m_result(m_res)) }
				else { "Out of fuel" }
			}
		}
		else { run_ev(E, fuel, next, m0, k) }
	}
	else { run_ev(E, fuel, next, m0, k) }

refute_kit :: {n : Nat} -> Kit :=> mk_kit{
	run := refute_run,
	quantify := {E, fuel, next, A, _rec_T, f, body, k} => {
		let res := first_found(tried(n), {c} => {
			let h := tok_unk(pair("in", next))
			let E1 := A.snd(h, pair("Some", c), E)
			let out := body(E1, fuel, succ(next), h, pair("Some", c), {_E, fl, _nx, _r} => done(fl))
			if ((is_fork(out)) && (out.fst == "Fault")) { found(pair(c, out.snd)) } else { nothing }
		})
		if (is_found(res)) { pair("Fault", res.snd) } else { k(E, fuel, next, f) }
	},
	fresh := mk_fresh,
	deep_res := deep_resolve,
	head_tok := head_tok_of,
	has_tok := has_tok,
	cases := derive_for
}

check_depth := 4
base_meta := pair(check_depth, pair(false, pair("None", pair({v} => v, "None"))))
E_check_base :: Eval := ev(base_step, base_lazy, {v} => v, base_eq, {_s, _t, _v} => false, check_kit, base_meta)
E_refute_base :: {n : Nat} -> Eval :=> ev(base_step, base_lazy, {v} => v, base_eq, {_s, _t, _v} => false, refute_kit(n), base_meta)

// ================================================================ COMPOSABLE TYPE FORMERS
// Every type is `pair(check, assume)`. Zero `if (is_refute)` and zero `tok_sig` anywhere below!

AnyT :: Tree := pair(
	{E, fuel, next, v, k} => k(E, fuel, next, v),
	{_u, _backing, E} => E)

EmptyT :: Tree := pair(
	{E, _fuel, _next, v, _k} => pair("Fault", E.kit.deep_res(E, v)),
	{_u, _backing, E} => prune_ev(E))

data_t :: {p : Tree} -> Tree :=> pair(
	{E, fuel, next, v, k} => E.kit.run(E, fuel, next, m_start(p, v), {E1, fl, nx, ans} =>
		if (ans == true) { k(E1, fl, nx, v) } else { pair("Fault", E1.kit.deep_res(E1, v)) }),
	{u, backing, E} =>
		if (backing == "None") { with_data(p, u, E) }
		else {
			let c := backing.snd
			let r := try_call(p, c, refute_pred_fuel)
			if ((is_found(r)) && (r.snd == true)) { with_subst(u, c, E) } else { prune_ev(E) }
		})

UnitT :: Tree := data_t(is_leaf)

/// Dependent function type builder (`rec_tag`: `"Rec"` = total lexicographic, `"PartialRec"` = partial)
mk_pi :: {rec_tag : Tree, A : Tree, fam : Tree} -> Tree :=> {
	let mk := fix({T, _u} => pair(
		{E, fuel, next, f, k} =>
			E.kit.quantify(E, fuel, next, A, pair(rec_tag, T), f, {E1, fl0, nx0, arg, _b, k_in} =>
				E1.kit.run(E1, fl0, nx0, m_start(f, arg), {E2, fl1, nx1, r} =>
					E2.kit.run(E2, fl1, nx1, m_start(fam, arg), {E3, fl2, nx2, B} =>
						B.fst(E3, fl2, nx2, r, k_in))), k),
		{g, backing, E} => {
			let prev_step := E.step
			let prev_eq := E.eq
			ev(
				{self, fuel, next, f, x, stack, k} => {
					let rf := self.resolve(f)
					let rx := self.resolve(x)
					if (rf == g) {
						and_then(A.fst(ev_set_rec(ev_set_cap(self, "None"), "None"), fuel, next, rx, {_E0, fl0, _nx0, _ok} => done(fl0)), {fl1} =>
							self.kit.run(ev_set_rec(ev_set_cap(ev_set_sure(self, true), "None"), "None"), fl1, next, m_start(fam, rx), {E2, fl2, nx2, B} => {
								let E_s := ev_set_meta(E2, self.meta)
								if (backing == "None") {
									let r := E_s.kit.fresh(pair("Call", pair(g, E_s.kit.deep_res(E_s, rx))))
									let E3 := B.snd(r, "None", E_s)
									E3.kit.run(E3, fl2, nx2, m_ret(r, stack), k)
								}
								else {
									let c := backing.snd
									let saved_cap := ev_cap(E_s)
									let E_call := ev_set_cap(E_s, "None")
									E_call.kit.run(E_call, fl2, nx2, m_start(c, rx), {E3, fl3, nx3, raw_r} => {
										let rh := E3.kit.fresh(pair("ret", nx3))
										let E4 := B.snd(rh, pair("Some", raw_r), ev_set_cap(E3, saved_cap))
										E4.kit.run(E4, fl3, succ(nx3), m_ret(rh, stack), k)
									})
								}
							}))
					}
					else if ((is_triage(rf)) && ((not(rf == shape_identity)) && ((self.kit.head_tok(rf) == "N") && (rx == g)))) {
						if (backing == "None") { pair("Fault", "Inspects callback") }
						else { self.kit.run(self, fuel, next, machine_run(rf, backing.snd, stack), k) }
					}
					else { prev_step(self, fuel, next, f, x, stack, k) }
				},
				E.lazy, E.resolve,
				{self, a, b} =>
					if ((self.resolve(a) == g) || (self.resolve(b) == g)) {
						if (backing == "None") { pair("Err", "Compares callback") }
						else {
							let ra := if (self.resolve(a) == g) { backing.snd } else { a }
							let rb := if (self.resolve(b) == g) { backing.snd } else { b }
							prev_eq(self, ra, rb)
						}
					}
					else { prev_eq(self, a, b) },
				E.has_tag, E.kit, E.meta)
		}))
	mk(t)
}
pi_t :: {A : Tree, fam : Tree} -> Tree :=> mk_pi("Rec", A, fam)
fn_t :: {A : Tree, B : Tree} -> Tree :=> pi_t(A, {_x} => B)
partial_pi :: {A : Tree, fam : Tree} -> Tree :=> mk_pi("PartialRec", A, fam)
partial_fn :: {A : Tree, B : Tree} -> Tree :=> partial_pi(A, {_x} => B)

/// K-skip-preserving function type: checks K-shaped constants eagerly at `B`
fn_lazy_t :: {A : Tree, B : Tree} -> Tree :=> {
	let base := fn_t(A, B)
	pair(
		{E, fuel, next, f, k} =>
			if (k_shaped(f)) { B.fst(E, fuel, next, f.snd, k) }
			else { base.fst(E, fuel, next, f, k) },
		base.snd)
}

/// Dependent pair type `sigma_t(A, fam)`
sigma_t :: {A : Tree, fam : Tree} -> Tree :=> pair(
	{E0_in, fuel, next, p, k} => {
		let E := ev_set_rec(E0_in, "None")
		E.kit.run(E, fuel, next, m_start(is_fork, p), {E0, fl0, nx0, isf} =>
			if (isf == true) {
				E0.kit.run(E0, fl0, nx0, m_start(pair_fst, p), {E1, fl1, nx1, a} =>
					A.fst(E1, fl1, nx1, a, {E2, fl2, nx2, a1} =>
						E2.kit.run(E2, fl2, nx2, m_start(pair_snd, p), {E3, fl3, nx3, b} =>
							E3.kit.run(E3, fl3, nx3, m_start(fam, a1), {E4, fl4, nx4, B} =>
								B.fst(E4, fl4, nx4, b, k)))))
			}
			else { pair("Fault", E0.kit.deep_res(E0, p)) })
	},
	{p, backing, E} =>
		if (backing == "None") { with_sigma_sym(A, fam, p, E) }
		else {
			let c := backing.snd
			if (is_fork(c)) {
				let rB := try_call(fam, c.fst, refute_pred_fuel)
				if (is_found(rB)) {
					let h1 := E.kit.fresh(pair("sf", c))
					let h2 := E.kit.fresh(pair("ss", c))
					let E1 := A.snd(h1, pair("Some", c.fst), with_subst(p, pair(h1, h2), E))
					rB.snd.snd(h2, pair("Some", c.snd), E1)
				}
				else { prune_ev(E) }
			}
			else { prune_ev(E) }
		})

/// Refinement type `refine_t(A, p)`
refine_t :: {A : Tree, p : Tree} -> Tree :=> pair(
	{E, fuel, next, v, k} => A.fst(E, fuel, next, v, {E1, fl1, nx1, v1} =>
		E1.kit.run(E1, fl1, nx1, m_start(p, v1), {E2, fl2, nx2, ans} =>
			if (ans == true) { k(E2, fl2, nx2, v1) } else { pair("Fault", E2.kit.deep_res(E2, v1)) })),
	{u, backing, E} =>
		if (backing == "None") { with_fact(p, u, true, A.snd(u, "None", E)) }
		else {
			let r := try_call(p, backing.snd, refute_pred_fuel)
			if ((is_found(r)) && (r.snd == true)) { A.snd(u, backing, E) } else { prune_ev(E) }
		})

/// Singleton type `the_t(A, target)`
the_t :: {A : Tree, target : Tree} -> Tree :=> pair(
	{E, fuel, next, v, k} => A.fst(E, fuel, next, v, {E1, fl1, nx1, v1} => {
		let r := E1.eq(E1, v1, target)
		if (r == "True") { k(E1, fl1, nx1, v1) } else { pair("Fault", pair(E1.kit.deep_res(E1, v1), E1.kit.deep_res(E1, target))) }
	}),
	{u, backing, E} =>
		if (backing == "None") { with_eq(u, target, A.snd(u, "None", E)) }
		else { if (backing.snd == target) { A.snd(u, backing, E) } else { prune_ev(E) } })

/// Propositional equality type `eq_t(a, b)` (inhabited by `t` when `a == b`)
eq_t :: {a : Tree, b : Tree} -> Tree :=> pair(
	{E, fuel, next, v, k} => UnitT.fst(E, fuel, next, v, {E1, fl1, nx1, v1} => {
		let r := E1.eq(E1, a, b)
		if (r == "True") { k(E1, fl1, nx1, v1) } else { pair("Fault", pair(E1.kit.deep_res(E1, a), E1.kit.deep_res(E1, b))) }
	}),
	{u, backing, E} =>
		if (backing == "None") { with_eq(a, b, with_subst(u, t, E)) }
		else { if ((is_leaf(backing.snd)) && (a == b)) { with_subst(u, t, E) } else { prune_ev(E) } })

/// Container list type `ListT(A)` (works on lists of functions like `ListT(NN)`)
ListT :: {A : Tree} -> Tree :=> {
	let mk := fix({L, _u} => pair(
		{E_in, fuel, next, xs, k} => {
			let E := ev_set_rec(E_in, "None")
			E.kit.run(E, fuel, next, m_start(is_leaf, xs), {E0, fl0, nx0, isl} =>
				if (isl == true) { k(E0, fl0, nx0, xs) }
				else {
					E0.kit.run(E0, fl0, nx0, m_start(is_fork, xs), {E1, fl1, nx1, isf} =>
						if (isf == true) {
							E1.kit.run(E1, fl1, nx1, m_start(pair_fst, xs), {E2, fl2, nx2, hd} =>
								A.fst(E2, fl2, nx2, hd, {E3, fl3, nx3, _ok} =>
									E3.kit.run(E3, fl3, nx3, m_start(pair_snd, xs), {E4, fl4, nx4, tl} =>
										L(tl).fst(E4, fl4, nx4, tl, k))))
						}
						else { pair("Fault", E1.kit.deep_res(E1, xs)) })
				})
		},
		{xs, backing, E} =>
			if (backing == "None") { with_list_sym(A, L, xs, E) }
			else {
				let c := backing.snd
				if (is_leaf(c)) { with_subst(xs, t, E) }
				else if (is_fork(c)) {
					let h1 := E.kit.fresh(pair("lh", c))
					let h2 := E.kit.fresh(pair("lt", c))
					L(h2).snd(h2, pair("Some", c.snd), A.snd(h1, pair("Some", c.fst), with_subst(xs, pair(h1, h2), E)))
				}
				else { prune_ev(E) }
			}))
	mk(t)
}

/// Abstract type `abs_t(tag)` & arbitrary-arity polymorphism `forall_k(arity, F)`
abs_t :: {tag : Tree} -> Tree :=> pair(
	{E, fuel, next, v, k} => if (E.has_tag(E, tag, v)) { k(E, fuel, next, v) } else { pair("Fault", pair("Not abstract", tag)) },
	{u, _backing, E} => with_abstract(tag, u, E))

rec mk_abs_op :: {arity : Nat, key : Tree} -> Tree :=>
	if (is_zero(arity)) { abs_t(key) }
	else { {a} => mk_abs_op(nat_pred(arity), pair(key, a)) }

forall_k :: {arity : Nat, F : Tree} -> Tree :=> pair(
	{E, fuel, next, f, k} => {
		let X_real := mk_abs_op(arity, pair("Abs", next))
		let X_unk := E.kit.fresh(pair("TyAbs", next))
		let E0 := with_abs_type(X_unk, X_real, E)
		E0.kit.run(E0, fuel, succ(next), m_start(f, X_unk), {E1, fl1, nx1, body} =>
			F(X_real).fst(E1, fl1, nx1, body, k))
	},
	{g, _backing, E} => {
		let prev_step := E.step
		ev({self, fuel, next, f, x, stack, k} =>
			if (self.resolve(f) == g) {
				let r := self.kit.fresh(pair("inst", pair(g, next)))
				let ux := unbox_tree(ev_unbox(self), x)
				let E1 := F(ux).snd(r, "None", self)
				E1.kit.run(E1, fuel, succ(next), m_ret(r, stack), k)
			}
			else { prev_step(self, fuel, next, f, x, stack, k) },
			E.lazy, E.resolve, E.eq, E.has_tag, E.kit, E.meta)
	})
forall_t :: {F : Tree} -> Tree :=> forall_k(0, F)
forall_fam_t :: {F : Tree} -> Tree :=> forall_k(1, F)

/// Quotient type `quot_t(A, norm)`: members of `A` modulo `norm`, eliminating only via `norm`
quot_t :: {A : Tree, norm : Tree} -> Tree :=> pair(
	A.fst,
	{q, backing, E} =>
		if (backing == "None") { with_quot_sym(A, norm, q, E) }
		else { A.snd(q, backing, E) })

quot_pi :: {A : Tree, norm : Tree, fam : Tree} -> Tree :=> pair(
	{E, fuel, next, f, k} =>
		E.kit.quantify(E, fuel, next, quot_t(A, norm), "NoRec", f, {E1, fl0, nx0, q, backing, k_in} =>
			E1.kit.run(E1, fl0, nx0, m_start(f, q), {E2, fl1, nx1, r1} =>
				E2.kit.run(E2, fl1, nx1, m_start(fam, q), {E3, fl2, nx2, B} =>
					B.fst(E3, fl2, nx2, r1, {E4, fl3, nx3, _ok} =>
						if (backing == "None") { k_in(E4, fl3, nx3, r1) }
						else {
							E4.kit.run(E4, fl3, nx3, m_start(norm, q), {E5, fl4, nx4, nc} =>
								E5.kit.run(E5, fl4, nx4, m_start(norm, nc), {E6, fl5, nx5, nnc} =>
									if (E6.eq(E6, nc, nnc) == "True") {
										E6.kit.run(E6, fl5, nx5, m_start(f, nc), {E7, fl6, nx6, r2} =>
											if (E7.eq(E7, r1, r2) == "True") { k_in(E7, fl6, nx6, r1) }
											else { pair("Fault", pair("Quotient violation", pair(E7.kit.deep_res(E7, r1), E7.kit.deep_res(E7, r2)))) })
									}
									else {
										E6.kit.quantify(E6, fl5, nx5, A, "NoRec", f, {E7, fl6, nx6, q2, _b2, k2} =>
											E7.kit.run(E7, fl6, nx6, m_start(norm, q2), {E8, fl7, nx7, nc2} =>
												if (E8.eq(E8, nc, nc2) == "True") {
													E8.kit.run(E8, fl7, nx7, m_start(f, q2), {E9, fl8, nx8, r2} =>
														if (E9.eq(E9, r1, r2) == "True") { k2(E9, fl8, nx8, r1) }
														else { pair("Fault", pair("Quotient violation", pair(E9.kit.deep_res(E9, r1), E9.kit.deep_res(E9, r2)))) })
												}
												else { k2(E8, fl7, nx7, r1) }), k_in)
									}))
						}))), k),
	pi_t(quot_t(A, norm), fam).snd)

quot_fn :: {A : Tree, norm : Tree, B : Tree} -> Tree :=> quot_pi(A, norm, {_q} => B)

/// Opaque type with a verified custom approved eliminator (`elim_fn : fn_t(A, R)`)
opaque_with_elim :: {A : Tree, elim_fn : Tree, R : Tree} -> Tree :=> pair(
	A.fst,
	{u, backing, E} =>
		if (backing == "None") { with_elim(elim_fn, fn_t(A, R), R, u, with_abstract(pair("Opaque", elim_fn), u, E)) }
		else { A.snd(u, backing, E) })

/// Step-bounded dependent function type `bounded_pi(A, fam, bound)` (no `with_rec`, so looping proofs fail!)
bounded_pi :: {A : Tree, fam : Tree, bound : Tree} -> Tree :=> pair(
	{E, fuel, next, f, k} =>
		E.kit.quantify(E, fuel, next, A, "NoRec", f, {E1, fl0, nx0, arg, _b, k_in} =>
			E1.kit.run(E1, fl0, nx0, m_start(bound, arg), {E_b, fl_b, nx_b, lim} =>
				if (E_b.kit.has_tok(lim)) { "Step bound not concrete" }
				else {
					let E_bnd := ev_set_cap(E_b, pair("Cap", lim))
					E_bnd.kit.run(E_bnd, fl_b, nx_b, m_start(f, arg), {E2, fl1, nx1, r} => {
						let E_uncap := ev_set_cap(E2, ev_cap(E_b))
						E_uncap.kit.run(E_uncap, fl1, nx1, m_start(fam, arg), {E3, fl2, nx2, B} =>
							B.fst(E3, fl2, nx2, r, k_in))
					})
				}), k),
	pi_t(A, fam).snd)

bounded_t :: {A : Tree, B : Tree, bound : Tree} -> Tree :=> bounded_pi(A, {_x} => B, bound)

// ================================================================ ENTRYPOINTS
check_fuel := 15000

why :: {lemmas : List(Tree), T : Tree, v : Tree} -> Tree :=>
	if (has_tok(v)) { "Contains a token" }
	else if (has_tok(lemmas)) { "Contains a token" }
	else if (not(lemmas.all({l} => is_yes(l.snd.fst(E_check_base, check_fuel, 0, l.fst, {_E, fl, _nx, _r} => done(fl)))))) { "A lemma does not check" }
	else {
		let E0 := reduce({l, acc} => with_lemma(l.fst, l.snd, acc), E_check_base, lemmas)
		let r := T.fst(E0, check_fuel, 0, v, {_E, fl, _nx, _res} => done(fl))
		if (is_yes(r)) { yes } else { r }
	}
accepts :: {T : Tree, v : Tree} -> Bool :=> why([], T, v) == yes

refute_at :: {T : Tree, v : Tree, n : Nat} -> Tree :=>
	if (has_tok(v)) { found("Contains a token") }
	else {
		let steps := twice(twice(twice(twice(n))))
		let r := T.fst(E_refute_base(n), steps, 0, v, {_E, fl, _nx, _res} => done(fl))
		if ((is_fork(r)) && (r.fst == "Fault")) { found(r.snd) } else { nothing }
	}

refute_with :: {A : Tree, B : Tree, f : Tree, x : Tree, steps : Nat} -> Tree :=>
	if ((has_tok(f)) || (has_tok(x))) { found("Contains a token") }
	else {
		let E0 := E_refute_base(16)
		let h := tok_unk("target")
		let E1 := A.snd(h, pair("Some", x), E0)
		let r := run_ev(E1, steps, 0, m_start(f, h), {E2, fl, nx, res} => B.fst(E2, fl, nx, res, {_E, fl2, _n, _v} => done(fl2)))
		if ((is_fork(r)) && (r.fst == "Fault")) { found(r.snd) } else { nothing }
	}

rec search_from :: {T : Tree, m : Tree, n : Nat} -> Tree :=> {
	let r := refute_at(T, m, n)
	if (is_found(r)) { r.snd } else { search_from(T, m, twice(n)) }
}
unoptimized :: {T : Tree} -> Tree :=> {m} => search_from(T, m, 1)

sound_refuter :: {T : Tree} -> Tree :=> {O, n} =>
	first_found(tried(n), {m} => if (O(m)) { let c := refute_at(T, m, n); if (is_found(c)) { found(pair(m, c.snd)) } else { nothing } } else { nothing })
