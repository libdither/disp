// Checked tree enumeration stream (`Trees.all`, smallest trees first) and `Trees.is_bool`.
open use "kernel/prelude.disp"
let TMod := use raw "core/trees.disp" {}

let tree_lems := certify(check_depth, check_fuel, "all", [], [
	pair("rev_ll", pair(List(List(Tree)) -> List(List(Tree)), reverse)),
	pair("zip_ll", pair(List(List(Tree)) -> List(List(Tree)) -> List(Pair(List(Tree), List(Tree))), zip)),
	pair("concat_t", pair(List(List(Tree)) -> List(Tree), concat)),
	pair("cross_t", pair(List(Tree) -> List(Tree) -> (Tree -> Tree -> Tree) -> List(Tree), cross)),
	pair("append_t", pair(List(Tree) -> List(Tree) -> List(Tree), append))
])
let check_module := check_with(check_depth, check_fuel, "all", [tree_lems])

Trees.is_bool : Tree -> Bool := TMod.Bool
Trees.next_level : List(List(Tree)) -> List(Tree) := TMod.next_level
Trees.step : Pair(List(List(Tree)), List(Tree)) -> Pair(Tree, Pair(List(List(Tree)), List(Tree))) := TMod.trees_step
Trees.all : Tree := TMod.Trees
