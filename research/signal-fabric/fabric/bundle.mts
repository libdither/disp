// Bundles the player (ui.ts) into ../fabric.js, which fabric.html loads. `npx --prefix website tsx research/signal-fabric/fabric/bundle.mts`
import { writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { build } from 'esbuild'

const here = dirname(fileURLToPath(import.meta.url))
const out = await build({
  entryPoints: [join(here, 'ui.ts')], bundle: true, write: false, format: 'iife', target: 'es2022', minify: true, legalComments: 'none',
  tsconfigRaw: { compilerOptions: { target: 'ES2022', strict: true } }
})
writeFileSync(join(here, '../fabric.js'), '// generated by fabric/bundle.mts from fabric/ui.ts; do not edit\n' + out.outputFiles[0].text)
console.log(`fabric.js: ${out.outputFiles[0].text.length} bytes`)
