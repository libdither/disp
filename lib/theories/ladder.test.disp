// The lambda cube is a lattice: allowing more function spaces never loses a term. A theory's power is the set of examples its checker accepts.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../machine.disp" {}
open use raw "../claim.disp" {}
open use raw "../stream.disp" {}
open use raw "../tests/fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}
open use raw "cube.disp" {}

corners := [[], [poly], [oper], [depd], [poly, oper], [poly, depd], [depd, oper], [poly, oper, depd]]
powers := corners.map({extra} => power(corner(extra)))
at_most_as := {a, b} => a.zip(b).all({p} => if (p.fst) { p.snd } else { true })
// every corner with a subset of another's rules accepts a subset of its examples
subset_of := {a, b} => a.all(b.member)
test corners.cross(corners, pair).all({p} => if (subset_of(p.fst, p.snd)) { at_most_as(power(corner(p.fst)), power(corner(p.snd))) } else { true }) = true
// the eight powers are all different: each corner earns its place
test powers.dedup.length = 8
