// End-to-end verification, value-agreement, and growth-curve speedup tests for `std_growth.opt.disp`.
open use "prelude.disp"
open use raw "../growth.disp" {}

let Spec := use "std_growth.disp"
let Opt := use "std_growth.opt.disp"

// 1. Value agreement
test Opt.ck_add2(7, 8) = Spec.ck_add2(7, 8)
test Opt.ck_all_zero([0, 0, 0, 0]) = Spec.ck_all_zero([0, 0, 0, 0])
test Opt.ck_all_zero([0, 0, 1, 0]) = Spec.ck_all_zero([0, 0, 1, 0])
test Opt.ck_sizes_upto(8) = Spec.ck_sizes_upto(8)
test Opt.ck_degree([1, 2, 3, 4, 5]) = Spec.ck_degree([1, 2, 3, 4, 5])

// 2. Confirmed distinct trees
test (Opt.ck_sizes_upto == Spec.ck_sizes_upto) = false
test (Opt.ck_add2 == Spec.ck_add2) = false
test (Opt.ck_degree == Spec.ck_degree) = false

// 3. Strict runtime step-count & asymptotic degree speedups via `steps_of`, `fit`, and `cheaper`
test nat_lt(steps_of({a} => Opt.ck_add2(a, 8), 8, 20000), steps_of({a} => Spec.ck_add2(a, 8), 8, 20000)) = true
test nat_lt(steps_of(Opt.ck_all_zero, [0, 0, 0, 0, 0, 0], 20000), steps_of(Spec.ck_all_zero, [0, 0, 0, 0, 0, 0], 20000)) = true
test nat_lt(steps_of(Opt.ck_degree, [1, 2, 3, 4, 5, 6], 20000), steps_of(Spec.ck_degree, [1, 2, 3, 4, 5, 6], 20000)) = true
test nat_lt(steps_of(Opt.ck_sizes_upto, 8, 20000), steps_of(Spec.ck_sizes_upto, 8, 20000)) = true

// Asymptotic growth drop: `sizes_upto` goes from degree 2 (quadratic) to degree 1 (linear)!
let spec_sz_fit := fit(Spec.ck_sizes_upto, 6, 20000)
let opt_sz_fit := fit(Opt.ck_sizes_upto, 6, 20000)
test degree(spec_sz_fit) = 2
test degree(opt_sz_fit) = 1
test cheaper(opt_sz_fit, spec_sz_fit) = true

// 4. Open-splice reconciliation
open use "std_growth.disp"
open use "std_growth.opt.disp"
test ck_sizes_upto = Opt.ck_sizes_upto
test ck_add2 = Opt.ck_add2
test ck_degree = Opt.ck_degree
test ck_all_zero = Opt.ck_all_zero
