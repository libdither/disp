// The Calculus of Constructions: all three together. Equality over every type is a definition, and its symmetry is a checked term.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../machine.disp" {}
open use raw "../claim.disp" {}
open use raw "../stream.disp" {}
open use raw "../tests/fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}
open use raw "cube.disp" {}

theory := corner([poly, oper, depd])
test power(theory) = [true, true, true, true, true, true, true, true]
eq_of := {a, x, y} => app(app(app(leibniz, a), x), y)
refl_any := lam(star, lam(tv(0), lam(arrow(tv(1), star), lam(app(tv(0), tv(1)), tv(0)))))
test accepts(theory, pi(star, pi(tv(0), eq_of(tv(1), tv(0), tv(0)))), refl_any) = "Proved"
sym_any := lam(star, lam(tv(0), lam(tv(1), lam(eq_of(tv(2), tv(1), tv(0)),
	app(app(tv(0), lam(tv(3), eq_of(tv(4), tv(0), tv(3)))), app(app(refl_any, tv(3)), tv(2)))))))
test accepts(theory, pi(star, pi(tv(0), pi(tv(1), arrow(eq_of(tv(2), tv(1), tv(0)), eq_of(tv(2), tv(0), tv(1)))))), sym_any) = "Proved"
// the converse direction is the same term at a type it does not have
test accepts(theory, pi(star, pi(tv(0), pi(tv(1), arrow(eq_of(tv(2), tv(1), tv(0)), eq_of(tv(2), tv(1), tv(1)))))), sym_any).is_refuted = true
