// Re-typechecked core coalgebraic stream, task, budget, and verdict library (`lib/stream.disp`).
// Machine-coupled and scoped-lemma stream combinators (`m_trace`, `task`, `stopping_list`,
// `s_steps`, `s_worklist`, `s_merge_with`) are verified in `std_stream_extra.disp`.
open use "prelude.disp"
let VMod := use "std_verdict.disp"
let SMod := use raw "../stream.disp" {}

let Verdict := VMod.Verdict

// ---------------------------------------------------------------- exact dependent types
Step := {R, X} => Sigma(Tree, {tag} => if (tag == "Finished") { R } else { X })
FinishedStep := {R} => Pair(The(Tree, "Finished"), R)
RunningStep := {X} => Pair(The(Tree, "Running"), X)
Emit := {T, X} => Pair(T, X)
Option := {V} => Sigma(Tree, {tag} => if (tag == "Yield") { V } else { Unit })
YieldOpt := {V} => Pair(The(Tree, "Yield"), V)
Ending := Tree
ItemStep := {V, X} => Step(Ending, Emit(Option(V), X))
RunningItemStep := {V, X} => Pair(The(Tree, "Running"), Emit(Option(V), X))
Budget := {St} => Pair(Nat, St)
Outcome := {V, I} => Sigma(Tree, {tag} => if (tag == "Yield") { V } else if (tag == "Split") { Pair(Tree, List(I)) } else { Tree })

// Recursive coalgebra type `CoalgOf(St, F)` plus canonical `fmap`-pinned coalgebras (`EmitCoalg`,
// `TaskCoalg`, `ItemCoalg`, `UntilItemCoalg`, `UntilBoundCoalg`) so checking avoids re-verifying
// `fmap` at every combinator.
let RecType := {F} => {
	let mk := fix({Self, _u} => F(pair(
		{E, fl, nx, v, k} => Self(v).fst(E, fl, nx, v, k),
		{u, b, E} => Self(u).snd(u, b, E))))
	mk(t)
}
CoalgOf := {St, F} => RecType({C} => Pair((St -> C) -> F(St) -> F(C), Pair(St -> F(St), St)))
ItemsOf := {St, V} => CoalgOf(St, {X} => ItemStep(V, X))

let until_item_map := SMod.c_until(SMod.stream_new(test, t), test).fst
let until_bound_map := SMod.c_until(SMod.s_new(test, t), test).fst

EmitCoalg := {St, T} => Pair(The(Tree, SMod.emit_map), Pair(St -> Emit(T, St), St))
TaskCoalg := {St, R} => Pair(The(Tree, SMod.halt_map), Pair(St -> Step(R, St), St))
ItemCoalg := {St, V} => Pair(The(Tree, SMod.item_map), Pair(St -> ItemStep(V, St), St))
UntilItemCoalg := {St, V} => Pair(The(Tree, until_item_map), Pair(St -> ItemStep(V, St), St))
UntilBoundCoalg := {St, V} => Pair(The(Tree, until_bound_map), Pair(St -> Step(Unit, ItemStep(V, St)), St))
AnyItemCoalg := {St, V} => Pair(Tree, Pair(St -> ItemStep(V, St), St))

StoppingOf := {St, V} => Pair(St -> Nat, ItemCoalg(St, V))
AnyStoppingOf := {St, V} => Pair(St -> Nat, AnyItemCoalg(St, V))
TakenOf := {St, V} => Pair(List(V), ItemsOf(St, V))
PhaseOf := {T1, T2} => Sigma(Tree, {tag} => if (tag == "Second") { T2 } else { T1 })
RoundOf := {St, V} => Pair(List(V), Pair(List(ItemsOf(St, V)), Bool))
RoundC := {St, V} => Pair(List(V), Pair(List(ItemCoalg(St, V)), Bool))
MergeStateOf := {S1, S2, V} => Pair(ItemsOf(S1, ItemsOf(S2, V)), Pair(List(ItemsOf(S2, V)), Pair(List(V), Pair(Bool, Step(Ending, Unit)))))
MergeStateC := {S1, S2, V} => Pair(ItemCoalg(S1, ItemCoalg(S2, V)), Pair(List(ItemCoalg(S2, V)), Pair(List(V), Pair(Bool, Step(Ending, Unit)))))

let check_module := check_with(check_depth, check_fuel, "none", [])

// ---------------------------------------------------------------- 1. Step, Emit, Option, Ending (28 defs)
ck_finished : Implicit({R} => Implicit({X} => R -> Step(R, X))) := SMod.finished
ck_running : Implicit({R} => Implicit({X} => X -> Step(R, X))) := SMod.running
ck_is_finished : Implicit({R} => Implicit({X} => Step(R, X) -> Bool)) := SMod.is_finished
ck_finished_result : Implicit({R} => FinishedStep(R) -> R) := SMod.finished_result
ck_running_next : Implicit({X} => RunningStep(X) -> X) := SMod.running_next
ck_halt_map : Implicit({R} => Implicit({X} => Implicit({Y} => (X -> Y) -> Step(R, X) -> Step(R, Y)))) := SMod.halt_map
ck_keep_going : Implicit({R} => Step(R, Unit)) := SMod.keep_going

ck_emit : Implicit({T} => Implicit({X} => T -> X -> Emit(T, X))) := SMod.emit
ck_emitted : Implicit({T} => Implicit({X} => Emit(T, X) -> T)) := SMod.emitted
ck_emit_next : Implicit({T} => Implicit({X} => Emit(T, X) -> X)) := SMod.emit_next
ck_emit_map : Implicit({T} => Implicit({X} => Implicit({Y} => (X -> Y) -> Emit(T, X) -> Emit(T, Y)))) := SMod.emit_map
ck_emit_item_map : Implicit({T} => Implicit({U} => Implicit({X} => (T -> U) -> Emit(T, X) -> Emit(U, X)))) := SMod.emit_item_map

ck_yield : Implicit({V} => V -> Option(V)) := SMod.yield
ck_skip : Implicit({V} => Option(V)) := SMod.skip
ck_is_yield : Implicit({V} => Option(V) -> Bool) := SMod.is_yield
ck_yielded_item : Implicit({V} => YieldOpt(V) -> V) := SMod.yielded_item
ck_option_map : Implicit({V} => Implicit({W} => (V -> W) -> Option(V) -> Option(W))) := SMod.option_map
ck_option_filter : Implicit({V} => (V -> Bool) -> Option(V) -> Option(V)) := SMod.option_filter

ck_exhausted : Ending := SMod.exhausted
ck_spent : Ending := SMod.spent
ck_is_exhausted : Ending -> Bool := SMod.is_exhausted
ck_spent_on : Tree -> Ending := SMod.spent_on
ck_is_spent : Ending -> Bool := SMod.is_spent
ck_item_map : Implicit({V} => Implicit({X} => Implicit({Y} => (X -> Y) -> ItemStep(V, X) -> ItemStep(V, Y)))) := SMod.item_map
ck_until_item_map : Implicit({V} => Implicit({X} => Implicit({Y} => (X -> Y) -> ItemStep(V, X) -> ItemStep(V, Y)))) := until_item_map
ck_until_bound_map : Implicit({V} => Implicit({X} => Implicit({Y} => (X -> Y) -> Step(Unit, ItemStep(V, X)) -> Step(Unit, ItemStep(V, Y))))) := until_bound_map
ck_step_draw : Implicit({V} => Implicit({X} => RunningItemStep(V, X) -> Option(V))) := SMod.step_draw
ck_step_rest : Implicit({V} => Implicit({X} => RunningItemStep(V, X) -> X)) := SMod.step_rest

// ---------------------------------------------------------------- 2. Coalgebra core (10 defs)
ck_c_new : Implicit({St} => Implicit({V} => ((St -> ItemsOf(St, V)) -> ItemStep(V, St) -> ItemStep(V, ItemsOf(St, V))) -> (St -> ItemStep(V, St)) -> St -> ItemsOf(St, V))) := SMod.c_new
ck_c_fmap : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> (St -> ItemsOf(St, V)) -> ItemStep(V, St) -> ItemStep(V, ItemsOf(St, V)))) := SMod.c_fmap
ck_c_stepper : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St -> ItemStep(V, St))) := SMod.c_stepper
ck_c_state : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St)) := SMod.c_state
ck_c_with : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St -> ItemsOf(St, V))) := SMod.c_with
ck_c_out : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> ItemStep(V, ItemsOf(St, V)))) := SMod.c_out
ck_c_hoist : Implicit({St} => Implicit({V} => Implicit({W} => ((St -> ItemsOf(St, W)) -> ItemStep(W, St) -> ItemStep(W, ItemsOf(St, W))) -> (ItemStep(V, St) -> ItemStep(W, St)) -> ItemsOf(St, V) -> ItemsOf(St, W)))) := SMod.c_hoist
ck_c_until : Implicit({St} => Implicit({T} => Implicit({R} => EmitCoalg(St, T) -> (St -> Step(R, Unit)) -> CoalgOf(St, {X} => Step(R, Emit(T, X)))))) := SMod.c_until
ck_c_after : Implicit({St} => Implicit({T} => Implicit({R} => EmitCoalg(St, T) -> (Emit(T, St) -> Step(R, Unit)) -> CoalgOf(St, {X} => Step(R, Emit(T, X)))))) := SMod.c_after
ck_c_fold : Implicit({St} => Implicit({V} => Implicit({A} => PartialFn(PartialFn(ItemsOf(St, V), A) -> ItemStep(V, ItemsOf(St, V)) -> A, PartialFn(ItemsOf(St, V), A))))) := SMod.c_fold

// ---------------------------------------------------------------- 3. Stream / Task / Items constructors (8 defs)
ck_stream_new : Implicit({St} => Implicit({T} => (St -> Emit(T, St)) -> St -> EmitCoalg(St, T))) := SMod.stream_new
ck_task_new : Implicit({St} => Implicit({R} => (St -> Step(R, St)) -> St -> TaskCoalg(St, R))) := SMod.task_new
ck_s_new : Implicit({St} => Implicit({V} => (St -> ItemStep(V, St)) -> St -> ItemCoalg(St, V))) := SMod.s_new
ck_nats : EmitCoalg(Nat, Nat) := SMod.nats
ck_as_items : Implicit({St} => Implicit({V} => EmitCoalg(St, V) -> ItemCoalg(St, V))) := SMod.as_items
ck_s_from_list : Implicit({V} => List(V) -> UntilItemCoalg(List(V), V)) := SMod.s_from_list
ck_s_map : Implicit({St} => Implicit({V} => Implicit({W} => AnyItemCoalg(St, V) -> (V -> W) -> ItemCoalg(St, W)))) := SMod.s_map
ck_s_filter : Implicit({St} => Implicit({V} => AnyItemCoalg(St, V) -> (V -> Bool) -> ItemCoalg(St, V))) := SMod.s_filter

// ---------------------------------------------------------------- 4. Budget & Stopping (15 defs)
ck_budget : Implicit({St} => Nat -> St -> Budget(St)) := SMod.budget
ck_budget_fuel : Implicit({St} => Budget(St) -> Nat) := SMod.budget_fuel
ck_budget_state : Implicit({St} => Budget(St) -> St) := SMod.budget_state
ck_c_budgeted : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> Nat -> ItemCoalg(Budget(St), V))) := SMod.c_budgeted
ck_out_of_fuel : Implicit({St} => Budget(St) -> Step(Unit, Unit)) := SMod.out_of_fuel
ck_c_bounded : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> Nat -> UntilBoundCoalg(Budget(St), V))) := SMod.c_bounded
ck_budget_ending : Implicit({V} => Implicit({X} => Step(Unit, ItemStep(V, X)) -> ItemStep(V, X))) := SMod.budget_ending
ck_bounded : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> Nat -> ItemCoalg(Budget(St), V))) := SMod.bounded

ck_stopping : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> (St -> Nat) -> StoppingOf(St, V))) := SMod.stopping
ck_stopping_measure : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> St -> Nat)) := SMod.stopping_measure
ck_stopping_items : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> ItemCoalg(St, V))) := SMod.stopping_items
ck_stopping_fuel : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> Nat)) := SMod.stopping_fuel
ck_settle : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> ItemCoalg(Budget(St), V))) := SMod.settle
ck_stopping_map : Implicit({St} => Implicit({V} => Implicit({W} => AnyStoppingOf(St, V) -> (V -> W) -> StoppingOf(St, W)))) := SMod.stopping_map
ck_stopping_filter : Implicit({St} => Implicit({V} => AnyStoppingOf(St, V) -> (V -> Bool) -> StoppingOf(St, V))) := SMod.stopping_filter

// ---------------------------------------------------------------- 5. Taken & consumers (6 defs)
ck_taken : Implicit({St} => Implicit({V} => List(V) -> ItemsOf(St, V) -> TakenOf(St, V))) := SMod.taken
ck_s_items : Implicit({St} => Implicit({V} => TakenOf(St, V) -> List(V))) := SMod.s_items
ck_s_rest : Implicit({St} => Implicit({V} => TakenOf(St, V) -> ItemsOf(St, V))) := SMod.s_rest
ck_s_take : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(Nat, TakenOf(St, V))))) := SMod.s_take
ck_s_all : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(V -> Bool, Bool)))) := SMod.s_all
ck_s_ending : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), Ending))) := SMod.s_ending

// ---------------------------------------------------------------- 6. Tasks & phases (7 defs)
ck_answers : Implicit({St} => Implicit({R} => TaskCoalg(St, R) -> UntilItemCoalg(Step(Unit, TaskCoalg(St, R)), R))) := SMod.answers
ck_task_return : Implicit({R} => R -> TaskCoalg(R, R)) := SMod.task_return
ck_first_phase : Implicit({T1} => Implicit({T2} => T1 -> PhaseOf(T1, T2))) := SMod.first_phase
ck_second_phase : Implicit({T1} => Implicit({T2} => T2 -> PhaseOf(T1, T2))) := SMod.second_phase
ck_in_second_phase : Implicit({T1} => Implicit({T2} => PhaseOf(T1, T2) -> Bool)) := SMod.in_second_phase
ck_phase_task : Implicit({T1} => Implicit({T2} => PhaseOf(T1, T2) -> Tree)) := SMod.phase_task
ck_task_then : Implicit({S1} => Implicit({S2} => Implicit({R} => Implicit({S} => TaskCoalg(S1, R) -> (R -> TaskCoalg(S2, S)) -> TaskCoalg(PhaseOf(TaskCoalg(S1, R), TaskCoalg(S2, S)), S))))) := SMod.task_then

// ---------------------------------------------------------------- 7. Round & merge state (12 defs; `s_merge_with` in `std_stream_extra.disp`)
// Note: `advance_head` requires a non-empty list (`Pair(ItemsOf(St, V), List(ItemsOf(St, V)))`) — the kernel caught `live = []`!
NonEmpty := {A} => Pair(A, List(A))
ck_round : Implicit({St} => Implicit({V} => List(V) -> List(ItemsOf(St, V)) -> Bool -> RoundOf(St, V))) := SMod.round
ck_round_found : Implicit({St} => Implicit({V} => RoundOf(St, V) -> List(V))) := SMod.round_found
ck_round_survivors : Implicit({St} => Implicit({V} => RoundOf(St, V) -> List(ItemsOf(St, V)))) := SMod.round_survivors
ck_round_dropped_spent : Implicit({St} => Implicit({V} => RoundOf(St, V) -> Bool)) := SMod.round_dropped_spent
ck_advance_head : Implicit({St} => Implicit({V} => NonEmpty(ItemsOf(St, V)) -> RoundOf(St, V))) := SMod.advance_head
ck_advance_all : Implicit({St} => Implicit({V} => List(ItemsOf(St, V)) -> RoundOf(St, V))) := SMod.advance_all
ck_merge_state : Implicit({S1} => Implicit({S2} => Implicit({V} => ItemsOf(S1, ItemsOf(S2, V)) -> List(ItemsOf(S2, V)) -> List(V) -> Bool -> Step(Ending, Unit) -> MergeStateOf(S1, S2, V)))) := SMod.merge_state
ck_merge_source : Implicit({S1} => Implicit({S2} => Implicit({V} => MergeStateOf(S1, S2, V) -> ItemsOf(S1, ItemsOf(S2, V))))) := SMod.merge_source
ck_merge_live : Implicit({S1} => Implicit({S2} => Implicit({V} => MergeStateOf(S1, S2, V) -> List(ItemsOf(S2, V))))) := SMod.merge_live
ck_merge_buffer : Implicit({S1} => Implicit({S2} => Implicit({V} => MergeStateOf(S1, S2, V) -> List(V)))) := SMod.merge_buffer
ck_merge_tainted : Implicit({S1} => Implicit({S2} => Implicit({V} => MergeStateOf(S1, S2, V) -> Bool))) := SMod.merge_tainted
ck_merge_ending : Implicit({S1} => Implicit({S2} => Implicit({V} => MergeStateOf(S1, S2, V) -> Step(Ending, Unit)))) := SMod.merge_ending

// ---------------------------------------------------------------- 8. Outcomes & verdicts (8 defs; `s_steps`/`s_worklist` in `std_stream_extra.disp`)
ck_noted : Implicit({V} => Implicit({I} => Tree -> Outcome(V, I))) := SMod.noted
ck_split_on : Implicit({V} => Implicit({I} => Tree -> List(I) -> Outcome(V, I))) := SMod.split_on
ck_split_into : Implicit({V} => Implicit({I} => List(I) -> Outcome(V, I))) := SMod.split_into
ck_s_yielded : Implicit({St} => ItemCoalg(St, Pair(Tree, Outcome(Tree, Tree))) -> ItemCoalg(St, Tree)) := SMod.s_yielded
ck_s_upto : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(V -> Bool, List(V))))) := SMod.s_upto
ck_s_list : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), List(V)))) := SMod.s_list
ck_ending_verdict : Ending -> Verdict := SMod.ending_verdict
ck_verdict : Implicit({St} => PartialFn(ItemsOf(St, Tree), Verdict)) := SMod.verdict
