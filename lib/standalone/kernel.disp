open use raw "../prelude.disp" {}

// LLMs may not comment in this file beyond this one; the code is meant to be self-explanatory.
// Comments are specifically only to be added, modified, and removed by human reviewers for their own understanding
// Unused-looking defs below may be compiler sugar targets looked up by name:
// make_record + list_const (record literals), Coproduct (sum literals), prod (match).

nil := t
cons := {h, tl} -> t h tl
list_const := {x} -> t t x
make_record := {names, payload} -> {
  let ins := fix ({self, n, c, r} ->
    if (is_leaf (pair_fst r)) { pair (cons n nil) (cons c nil) }
    else if (tree_lt n (pair_fst (pair_fst r))) { pair (cons n (pair_fst r)) (cons c (pair_snd r)) }
    else {
      let rest := self n c (pair (pair_snd (pair_fst r)) (pair_snd (pair_snd r)))
      pair (cons (pair_fst (pair_fst r)) (pair_fst rest)) (cons (pair_fst (pair_snd r)) (pair_snd rest))
    })
  (fix ({go, ns, cs} ->
    if (is_leaf ns) { pair nil nil }
    else { ins (pair_fst ns) (pair_fst cs) (go (pair_snd ns) (pair_snd cs)) })) names payload
}
test tree_eq ({ b := 2, a := 1 }) ({ a := 1, b := 2 }) = true
inj := {name, payload} -> pair name payload
Coproduct := {variants} -> variants
/// prod eliminator
prod := {table} -> (fix ({go, names, arms, v} ->
  if (is_leaf names) {
    if (is_leaf arms) { t } else { (pair_fst arms) (pair_snd v) }
  } else if (tree_eq (pair_fst names) (pair_fst v)) {
    (pair_fst arms) (pair_snd v)
  } else {
    go (pair_snd names) (pair_snd arms) v
  })) (pair_fst table) (pair_snd table)

wait_payload := {w} -> pair_snd (pair_snd w)
sig_of := {marker} -> pair_fst (wait marker t)
has_sig := {sig, v} -> and (is_fork v) (tree_eq (pair_fst v) sig)
tree_eq_sig := sig_of tree_eq

invalid_marker := {a, b} -> b
invalid := {reason} -> wait invalid_marker reason
invalid_sig := sig_of invalid_marker
is_invalid := has_sig invalid_sig

member := fix ({self, node, xs} ->
  if (is_leaf xs) { false } else if (tree_eq node (pair_fst xs)) { true } else { self node (pair_snd xs) })
list_all := fix ({self, p, xs} ->
  if (is_leaf xs) { true } else { and (p (pair_fst xs)) (self p (pair_snd xs)) })
list_map := fix ({self, f, xs} ->
  if (is_leaf xs) { nil } else { cons (f (pair_fst xs)) (self f (pair_snd xs)) })
list_len := fix ({self, xs} ->
  if (is_leaf xs) { zero } else { succ (self (pair_snd xs)) })
list_snoc := fix ({self, xs, x} ->
  if (is_leaf xs) { cons x nil } else { cons (pair_fst xs) (self (pair_snd xs) x) })
list_zip := fix ({self, xs, ys} ->
  if (is_leaf xs) { nil } else { cons (pair (pair_fst xs) (pair_fst ys)) (self (pair_snd xs) (pair_snd ys)) })
list_apply := fix ({self, f, xs} ->
  if (is_leaf xs) { f } else { self (f (pair_fst xs)) (pair_snd xs) })
list_cat := fix ({self, xs, ys} ->
  if (is_leaf xs) { ys } else { cons (pair_fst xs) (self (pair_snd xs) ys) })
list_filter := fix ({self, p, xs} ->
  if (is_leaf xs) { nil }
  else if (p (pair_fst xs)) { cons (pair_fst xs) (self p (pair_snd xs)) }
  else { self p (pair_snd xs) })

field_cell := fix ({self, r, name} -> {
  let names := pair_fst r
  let payloads := pair_snd r
  if (is_leaf names) { t }
  else if (tree_eq (pair_fst names) name) { pair_fst payloads }
  else { self (pair (pair_snd names) (pair_snd payloads)) name }
})
field := {r, name} -> pair_snd (field_cell r name)
field_or := {r, name, dflt} -> {
  let c := field_cell r name
  if (is_leaf c) { dflt } else { pair_snd c }
}
test field_or ({ x := t }) "x" 5 = t
test field_or ({ x := t }) "y" 5 = 5
test is_leaf (field_cell ({ x := t }) "y") = true
field_put := {r, name, v} -> {
  let drop := fix ({self, ns, cs} ->
    if (is_leaf ns) { pair nil nil }
    else {
      let rest := self (pair_snd ns) (pair_snd cs)
      if (tree_eq (pair_fst ns) name) { rest }
      else { pair (cons (pair_fst ns) (pair_fst rest)) (cons (pair_fst cs) (pair_snd rest)) }
    })
  let d := drop (pair_fst r) (pair_snd r)
  make_record (cons name (pair_fst d)) (cons (list_const v) (pair_snd d))
}
test field (field_put ({ a := 1, b := 2 }) "b" 9) "b" = 9
test tree_eq (field_put ({ a := 1 }) "b" 2) ({ a := 1, b := 2 }) = true

tag := {meta, behavior} -> {
  let s := {a, b, c} -> (a c) (b c)
  let k := {a, b} -> a
  s (s (k k) behavior) (k meta)
}
tagged_meta := {v} -> pair_snd (pair_snd v)
faced := {name, r} -> tag (pair name r) (fix (field r name))
is_type := {v} -> and (is_fork v) (and (is_fork (pair_snd v)) (and (is_fork (tagged_meta v)) (tree_eq (pair_fst (tagged_meta v)) "recognize")))
dot := {name, target} -> if (is_type target) { field (pair_snd (tagged_meta target)) name } else { field target name }
make_type := faced "recognize"

EffCode := < Pure : t, Op : t >
perform := {q, k} -> Op (pair q k)
handle := {h, m} -> {
  let ret := field h "return"
  let on_op := field h "op"
  (fix ({go, m2} -> match m2 {
    Pure x => (ret x)
    Op q k => (on_op q ({x} -> go (k x)))
    _ => (invalid m2)
  })) m
}

Frame := < Acc : t, Elim : t >
is_acc := has_sig "Acc"
is_elim_frame := has_sig "Elim"

ObsCode := < App, Self, Prj : t >
RowCode := < Fresh : t, Observe : t >
Pred := {p} -> ({ #recognize := {_self, v} -> p v })
Bool := ({
  #recognize := {_self, v} -> triage true ({c} -> tree_eq c t) ({l, r} -> false) v
  gate := {_Ind, B} -> cons (B true) (cons (B false) nil)
  members := cons true (cons false nil)
  elim := {_self, b, true_case, false_case} -> triage true_case ({_} -> false_case) ({_l, _r} -> true_case) b
})
ShallowType := ({ #recognize := {_self, v} -> is_type v, obs := perform (Fresh (Pred ({_v} -> true))) ({_} -> perform (Observe (pair App Bool)) ({_} -> Pure t)) })
test ShallowType ({ #recognize := {_self, _v} -> true }) = true
test ({ #recognize := {_self, v} -> is_leaf v }) zero = true
test ({ #recognize := {_self, v} -> is_leaf v }) 5 = false
PiCode := {A, B} -> make_type ({ tele := perform (Fresh A) ({x} -> perform (Observe (pair App (B x))) ({_} -> Pure t)) })
SigmaCode := {A, B} -> make_type ({ tele := perform (Observe (pair Self (Pred is_fork))) ({_} ->
  perform (Observe (pair (Prj pair_fst) A)) ({a} ->
  perform (Observe (pair (Prj pair_snd) (B a))) ({_} -> Pure t))) })
IsectCode := {A, P} -> make_type ({ tele := perform (Fresh A) ({x} -> perform (Observe (pair Self (P x))) ({_} -> Pure t)) })
AnyTree : ShallowType := Pred ({_v} -> true)

hyp_marker := fix ({self, payload, frame} ->
  wait self ({ (AnyTree) := pair "Ob" (pair frame (wait self payload)) }))
make_mark := {meta} -> wait hyp_marker meta
make_hyp := {ty, history} -> make_mark ({ (ShallowType) := ty, (AnyTree) := history })
hyp_sig := sig_of hyp_marker
is_neutral := has_sig hyp_sig
neutral_history := {v} -> field (wait_payload v) AnyTree
elim_raw := {E} -> pair_fst (wait_payload E)
elim_ind := {E} -> pair_fst (pair_snd (wait_payload E))
elim_motive := {E} -> pair_snd (pair_snd (wait_payload E))
elim_arity := {E} -> {
  let Ind := elim_ind E
  let g := Ind.gate
  if (is_leaf g) { invalid E } else { list_len (g Ind (elim_motive E)) }
}
elim_stuck := fix ({sm, st, arg} -> {
  let E := pair_fst st
  let scr := pair_fst (pair_snd st)
  let args := list_snoc (pair_snd (pair_snd st)) arg
  if (tree_eq (list_len args) (elim_arity E)) { scr (Elim (pair E args)) }
  else { wait sm (pair E (pair scr args)) }
})
elim_stuck_sig := sig_of elim_stuck
elim_marker := fix ({self, payload, arg} ->
  if (is_neutral arg) {
    let E := wait self payload
    if (tree_eq (elim_arity E) zero) { arg (Elim (pair E nil)) } else { wait elim_stuck (pair E (pair arg nil)) }
  } else { (pair_fst payload) (wait self payload) arg })
elim_of := {Ind, B} ->
  if (or (is_leaf Ind.elim) (is_leaf Ind.gate)) { invalid Ind }
  else { wait elim_marker (pair Ind.elim (pair Ind B)) }
elim_sig := sig_of elim_marker
is_elim_head := has_sig elim_sig
test tree_eq (field (wait_payload (make_hyp Bool t)) AnyTree) t = true
Unit := ({ #recognize := {_self, v} -> is_leaf v, members := cons t nil })
test Unit t = true
test Unit 5 = false
Rec := inj "Rec" t
Sum := {variants} -> {
  let tags := list_map pair_fst variants
  let spec_of := fix ({self, vs, tag} ->
    if (is_leaf vs) { nil }
    else if (tree_eq (pair_fst (pair_fst vs)) tag) {
      let s := pair_snd (pair_fst vs)
      if (is_leaf s) { cons Unit nil } else { s }
    } else { self (pair_snd vs) tag })
  let payload_of := fix ({self, args} ->
    if (is_leaf (pair_snd args)) { pair_fst args } else { pair (pair_fst args) (self (pair_snd args)) })
  let args_of := fix ({self, spec, p} ->
    if (is_leaf (pair_snd spec)) { cons p nil } else { cons (pair_fst p) (self (pair_snd spec) (pair_snd p)) })
  let walk := {elemj, recj} -> fix ({self, spec, p} -> {
    let last := is_leaf (pair_snd spec)
    if (or last (is_fork p)) {
      let a := if last { p } else { pair_fst p }
      let ty := pair_fst spec
      let ok := if (is_leaf ty) { true } else if (tree_eq ty Rec) { recj a } else { elemj ty a }
      if ok { if last { true } else { self (pair_snd spec) (pair_snd p) } } else { false }
    } else { false }
  })
  let accept := {elemj, recj, v} ->
    and (is_fork v) (if (member (pair_fst v) tags) { walk elemj recj (spec_of variants (pair_fst v)) (pair_snd v) } else { false })
  let gate_arm := {Ind, B, var} -> {
    let spec0 := spec_of variants (pair_fst var)
    (fix ({go, spec, args} ->
      if (is_leaf spec) {
        (fix ({ih, spec2, args2} ->
          if (is_leaf spec2) { B (inj (pair_fst var) (payload_of args)) }
          else if (tree_eq (pair_fst spec2) Rec) { PiCode (B (pair_fst args2)) ({_} -> ih (pair_snd spec2) (pair_snd args2)) }
          else { ih (pair_snd spec2) (pair_snd args2) })) spec0 args
      } else {
        let ty := pair_fst spec
        let dom := if (is_leaf ty) { AnyTree } else if (tree_eq ty Rec) { Ind } else { ty }
        PiCode dom ({a} -> go (pair_snd spec) (list_snoc args a))
      })) spec0 nil
  }
  let co := fix ({go, st, arg} -> {
    let cases := list_snoc (pair_snd st) arg
    if (tree_eq (list_len cases) (list_len variants)) {
      let v := pair_fst st
      let spec := spec_of variants (pair_fst v)
      let case := (fix ({pick, vs, cs} ->
        if (is_leaf vs) { t }
        else if (tree_eq (pair_fst (pair_fst vs)) (pair_fst v)) { pair_fst cs }
        else { pick (pair_snd vs) (pair_snd cs) })) variants cases
      let args := args_of spec (pair_snd v)
      let rec := {a} -> list_apply (wait go (pair a nil)) cases
      list_apply (list_apply case args) ((fix ({ihs, spec2, args2} ->
        if (is_leaf spec2) { nil }
        else if (tree_eq (pair_fst spec2) Rec) { cons (rec (pair_fst args2)) (ihs (pair_snd spec2) (pair_snd args2)) }
        else { ihs (pair_snd spec2) (pair_snd args2) })) spec args)
    } else { wait go (pair (pair_fst st) cases) }
  })
  let pos_members := {ty} -> if (is_leaf ty) { nil } else if (tree_eq ty Rec) { nil } else { ty.members }
  let payloads := fix ({self, sp} -> {
    let ms := pos_members (pair_fst sp)
    if (is_leaf ms) { nil }
    else if (is_leaf (pair_snd sp)) { ms }
    else {
      let rest := self (pair_snd sp)
      if (is_leaf rest) { nil }
      else { (fix ({go, l} -> if (is_leaf l) { nil } else { list_cat (list_map ({r} -> pair (pair_fst l) r) rest) (go (pair_snd l)) })) ms }
    }
  })
  let mall := fix ({self, vs} ->
    if (is_leaf vs) { nil }
    else {
      let tag := pair_fst (pair_fst vs)
      let ps := payloads (spec_of variants tag)
      if (is_leaf ps) { nil }
      else {
        let here := list_map ({p} -> inj tag p) ps
        if (is_leaf (pair_snd vs)) { here }
        else {
          let rest := self (pair_snd vs)
          if (is_leaf rest) { nil } else { list_cat here rest }
        }
      }
    })
  ({
    #recognize := {self, v} -> accept ({ty, a} -> ty a) self v
    check := {jdg, T, v} -> accept jdg ({a} -> jdg T a) v
    gate := {Ind, B} -> list_map (gate_arm Ind B) variants
    elim := {_self, v} -> wait co (pair v nil)
    members := mall variants
    code := variants
  })
}
case_of := {T, B, arms} -> {
  let tags := list_map pair_fst T.code
  let dflt := field arms "_"
  let pick := {tg} -> {
    let a := field arms tg
    if (is_leaf a) { dflt } else { a }
  }
  let pad := {slot, arm} -> if (is_leaf slot) { arm } else {
    (fix ({self, sp, f} ->
      if (is_leaf sp) {
        (fix ({ab, sp2, r} ->
          if (is_leaf sp2) { r }
          else if (tree_eq (pair_fst sp2) Rec) { ab (pair_snd sp2) (list_const r) }
          else { ab (pair_snd sp2) r })) slot f
      } else { {a} -> self (pair_snd sp) (f a) })) slot arm
  }
  if (and (list_all ({tg} -> not (is_leaf (pick tg))) tags)
          (list_all ({n} -> or (tree_eq n "_") (member n tags)) (pair_fst arms))) {
    let ordered := list_map ({var} -> pad (pair_snd var) (pick (pair_fst var))) T.code
    {scr} -> list_apply ((elim_of T B) scr) ordered
  } else {
    {_scr} -> invalid arms
  }
}
children := {T, v} -> (fix ({self, sp, p} ->
  if (is_leaf sp) { nil }
  else {
    let last := is_leaf (pair_snd sp)
    let a := if last { p } else { pair_fst p }
    let rest := if last { nil } else { self (pair_snd sp) (pair_snd p) }
    if (tree_eq (pair_fst sp) Rec) { cons a rest } else { rest }
  })) ((fix ({find, vs} ->
    if (is_leaf vs) { nil }
    else if (tree_eq (pair_fst (pair_fst vs)) (pair_fst v)) { pair_snd (pair_fst vs) }
    else { find (pair_snd vs) })) T.code) (pair_snd v)
Row : ShallowType := Sum RowCode
Obs : ShallowType := Sum ObsCode

respond_face_at := {nt, frame, self} -> {
  let T := nt self
  let rows := {
    let vrows := T.tele
    if (is_fork vrows) { vrows } else { T.obs }
  }
  if (is_fork rows) {
    fix ({go, rows2} ->
      match rows2 {
        Op row tail => (match row : (case_of Row ({_} -> AnyTree)) {
          Fresh ty => (if (is_acc frame) { invalid frame } else {
            match (tail frame) {
              Op peeked _k => (match peeked {
                Observe ob cod => (match ob { App _ => (pair (cons (pair ty frame) nil) cod); _ => (invalid frame) })
                _ => (invalid frame)
              })
              _ => (invalid frame)
            }
          })
          Observe ob ty => (match ob : (case_of Obs ({_} -> AnyTree)) {
            Prj a => (match frame {
              Acc fa => (if (tree_eq a fa) { pair nil ty } else { go (tail (self (Acc a))) })
              _ => (invalid frame)
            })
            Self _ => (go (tail t))
            App _ => (invalid frame)
          })
        })
        _ => (invalid frame)
      }) rows
  } else {
    match frame {
      Elim E arms => {
        let g := T.gate
        let raw := T.elim
        if (or (is_leaf g) (is_leaf raw)) { invalid frame }
        else if (and (tree_eq (elim_ind E) T) (tree_eq (elim_raw E) raw)) {
          let tys := g T (elim_motive E)
          if (tree_eq (list_len tys) (list_len arms)) {
            let land := T.land
            pair (list_zip tys arms) (if (is_leaf land) { (elim_motive E) self } else { land (elim_motive E) self })
          } else { invalid frame }
        } else { invalid frame }
      }
      _ => (invalid frame)
    }
  }
}
neutral_type := fix ({self, v} -> {
  let c := field_cell (wait_payload v) ShallowType
  if (is_leaf c) {
    let hist := neutral_history v
    let r := respond_face_at self (pair_fst (pair_snd hist)) (pair_snd (pair_snd hist))
    if (is_invalid r) { r } else { pair_snd r }
  } else { pair_snd c }
})
respond_face := respond_face_at neutral_type
test tree_eq (neutral_type (make_hyp Bool t)) Bool = true

Ask := < Mint : t, Call : t, Judge : t, Read : t, Lift : t >
check := fix ({self, rows, f, prior} ->
  match rows {
    Pure _ => (Pure true)
    Op row tail => (match row : (case_of Row ({_} -> AnyTree)) {
      Fresh ty => (perform (Mint (pair ty tail)) ({x} ->
        perform (Read x) ({xr} -> self (tail xr) f x)))
      Observe ob ty => (match ob : (case_of Obs ({_} -> AnyTree)) {
        App _ => (perform (Call (pair f prior)) ({r} ->
          perform (Judge (pair ty r)) ({ok} ->
            if ok { perform (Read r) ({rr} -> self (tail rr) f prior) } else { Pure false })))
        Self _ => (perform (Judge (pair ty f)) ({ok} ->
          if ok { perform (Read f) ({fr} -> self (tail fr) f prior) } else { Pure false }))
        Prj a => (perform (Read f) ({fr} -> {
          let o := a fr
          perform (Lift o) ({lo} ->
            perform (Judge (pair ty lo)) ({ok} ->
              if ok { self (tail o) f prior } else { Pure false }))
        }))
      })
    })
    _ => (Pure false)
  })

Tele := {table, C} -> {
  let tele := if (is_type C) { C.tele } else { C }
  let admit := field_or table "admit" ({_f} -> true)
  let lift := field_or table "lift" ({v} -> v)
  let fresh := field table "fresh"
  let apply := field_or table "apply" ({_chk, _st, f, a} -> f a)
  let read := field_or table "read" ({v} -> v)
  let judge := field_or table "judge" ({_chk, _st, T, r} -> T r)
  let run := fix ({chk, st, rows, fV, prior} ->
    handle ({
      return := {b} -> {_s} -> b
      op := {q, resume} -> {s} -> (match q {
        Mint ty tail => {
          let points := fresh s ty tail
          if (is_leaf points) { false } else { list_all ({p} -> resume (pair_fst p) (pair_snd p)) points }
        }
        Call g x => (resume (apply chk s g x) s)
        Judge ty v => (resume (judge chk s ty v) s)
        Read v => (resume (read v) s)
        Lift v => (resume (lift v) s)
      })
    }) (check rows fV prior) st)
  ({ #recognize := {_self, f} -> if (admit f) { run t tele (lift f) t } else { false }, tele })
}

Pi := {table, A, B} -> Tele table (PiCode A B)
Sigma := {table, A, B} -> Tele table (SigmaCode A B)
Isect := {table, A, P} -> Tele table (IsectCode A P)
Table : ShallowType := Pred ({r} -> not (is_leaf (field_cell r "fresh")))
Enum : Table := ({ fresh := {st, ty, _tail} -> list_map ({a} -> pair a st) ty.members })
Sampled := {samples} -> ({ fresh := {st, _ty, _tail} -> list_map ({a} -> pair a st) samples })

neutral_free := fix ({self, v} ->
  if (is_neutral v) { false } else { triage true ({c} -> self c) ({l, r} -> and (self l) (self r)) v })
teq_one := {open2, h, c} -> {
  let T := neutral_type h
  let ms := T.members
  if (is_fork ms) {
    let r := tree_eq (pair_fst ms) c
    if (list_all ({m} -> tree_eq (tree_eq m c) r) ms) { r } else { open2 h c }
  } else if (T c) { open2 h c } else { false }
}
teq_decide := {open2, a, x} ->
  if (tree_eq a x) { true }
  else if (and (neutral_free a) (neutral_free x)) { false }
  else if (and (is_neutral a) (neutral_free x)) { teq_one open2 a x }
  else if (and (is_neutral x) (neutral_free a)) { teq_one open2 x a }
  else { open2 a x }
eq_pairs := fix ({self, hs} ->
  if (is_leaf hs) { nil }
  else {
    let e := (neutral_type (pair_fst hs)).ends
    if (is_fork e) { cons e (self (pair_snd hs)) } else { self (pair_snd hs) }
  })
eq_reach := {pairs, a, x} -> (fix ({go, known, fuel} ->
  if (member x known) { true }
  else if (is_leaf fuel) { false }
  else {
    let next := (fix ({add, ps, acc} ->
      if (is_leaf ps) { acc }
      else {
        let p := pair_fst ps
        let acc2 :=
          if (and (member (pair_fst p) acc) (not (member (pair_snd p) acc))) { cons (pair_snd p) acc }
          else if (and (member (pair_snd p) acc) (not (member (pair_fst p) acc))) { cons (pair_fst p) acc }
          else { acc }
        add (pair_snd ps) acc2
      })) pairs known
    if (tree_eq (list_len next) (list_len known)) { false } else { go next (pair_snd fuel) }
  })) (cons a nil) pairs
eq_congr := {pairs} -> fix ({self, a, x} ->
  if (tree_eq a x) { true }
  else if (eq_reach pairs a x) { true }
  else if (and (is_neutral a) (is_neutral x)) {
    let ha := neutral_history a
    let hx := neutral_history x
    if (and (tree_eq (pair_fst ha) "Ob") (tree_eq (pair_fst hx) "Ob")) {
      and (self (pair_snd (pair_snd ha)) (pair_snd (pair_snd hx)))
          (self (pair_fst (pair_snd ha)) (pair_fst (pair_snd hx)))
    } else { false }
  }
  else if (or (is_neutral a) (is_neutral x)) { false }
  else {
    triage
      false
      ({ac} -> triage false ({xc} -> self ac xc) ({_l, _r} -> false) x)
      ({al, ar} -> triage false ({_c} -> false) ({xl, xr} -> and (self al xl) (self ar xr)) x)
      a
  })
eq_holds := {st, a, x} -> teq_decide ({a2, x2} -> eq_congr (eq_pairs st) a2 x2) a x
test eq_holds t 2 2 = true
test eq_holds t 2 3 = false

Meta : Table := ({
  let Value := < Conc : t, Neu : t, Stem : t, Fork : t, Poison : t, Chain : t >
  let vstem := {V} -> if let Conc c = V { Conc (t c) } else { Stem V }
  let vfork := {L, R} -> if let Conc lc = L { if let Conc rc = R { Conc (t lc rc) } else { Fork (pair L R) } } else { Fork (pair L R) }
  let readback := (fix ({rb, V} ->
    match V {
      Conc tr => tr
      Neu m => (make_mark m)
      Stem c => (t (rb c))
      Fork l r => (t (rb l) (rb r))
      Poison r => (invalid r)
      Chain e scr args => (invalid (pair e (pair scr args)))
    }))
  let collect := (fix ({co, V, acc} ->
    match V {
      Conc tr => acc
      Neu m => (cons (make_mark m) acc)
      Stem c => (co c acc)
      Fork l r => (co l (co r acc))
      Poison r => acc
      Chain e scr args => acc
    }))
  let verify_inband := (fix ({vf, minted, T, v} ->
    if (is_invalid v) {
      false
    } else if (is_neutral v) {
      and (tree_eq (neutral_type v) T)
          ((fix ({rooted, w} ->
             if (member w minted) { true }
             else {
               let h := neutral_history w
               if (tree_eq (pair_fst h) "Ob") { rooted (pair_snd (pair_snd h)) } else { false }
             })) v)
    } else {
      let ck := T.check
      if (is_leaf ck) { T.recognize (wait (wait vf minted) T) v } else { ck (wait vf minted) T v }
    }))
  let meta_pairs := fix ({self, hs} ->
    if (is_leaf hs) { nil }
    else {
      let s := pair_fst hs
      let rest := self (pair_snd hs)
      if (tree_eq (pair_fst s) "Neu") {
        let e := (field (pair_snd s) ShallowType).ends
        if (is_fork e) { cons e rest } else { rest }
      } else { rest }
    })
  let vcheck := ({chk, st, T, V} ->
    match V {
      Poison r => false
      Neu m => (tree_eq (neutral_type (make_mark m)) T)
      _ => {
        let rows := T.tele
        if (is_fork rows) { chk st rows V t }
        else {
          let e := T.ends
          if (is_fork e) { and (is_leaf (readback V)) (teq_decide ({a2, x2} -> eq_congr (meta_pairs st) a2 x2) (pair_fst e) (pair_snd e)) }
          else if let Conc tr = V { T tr }
          else { verify_inband (list_cat (collect V nil) (list_map readback st)) T (readback V) }
        }
      }
    })
  let s_rule := ({self, chk, C, TB, X} -> self chk (self chk C X) (self chk TB X))
  let triage_case := ({self, chk, TC, TD, TB, X} ->
    match X {
      Conc xt => (triage TC ({u} -> self chk TD (Conc u)) ({l, r} -> self chk (self chk TB (Conc l)) (Conc r)) xt)
      Neu m => (if (and (tree_eq TC (Conc t)) (and (tree_eq TD (Conc t)) (tree_eq TB (Conc t)))) { Neu m } else { Poison (Neu m) })
      Stem c => (self chk TD c)
      Fork l r => (self chk (self chk TB l) r)
      Poison r => (Poison r)
      Chain e scr args => (Poison (Chain (pair e (pair scr args))))
    })
  let apply_fork := ({self, chk, A, TB, X} ->
    match A {
      Conc at => (if (is_leaf at) {
        TB
      } else if (is_stem at) {
        s_rule self chk (Conc (stem_child at)) TB X
      } else {
        triage_case self chk (Conc (pair_fst at)) (Conc (pair_snd at)) TB X
      })
      Stem c => (s_rule self chk c TB X)
      Fork tc td => (triage_case self chk tc td TB X)
      Neu m => (Poison (Neu m))
      Poison r => (Poison r)
      Chain e scr args => (Poison (Chain (pair e (pair scr args))))
    })
  let mwalk := {st} -> (fix ({self, chk, F, X} ->
    if let Poison _ = X {
      X
    } else {
      match F {
        Conc tr => (if (tree_eq tr is_neutral) {
          Conc false
        } else if (tree_eq tr tree_eq) {
          match X {
            Poison r => (Poison r)
            Chain e scr args => (Poison (Chain (pair e (pair scr args))))
            _ => (Conc (wait tree_eq (if let Conc xt = X { xt } else { readback X })))
          }
        } else if (has_sig tree_eq_sig tr) {
          match X {
            Poison r => (Poison r)
            Chain e scr args => (Poison (Chain (pair e (pair scr args))))
            _ => {
              let a := wait_payload tr
              let xr := if let Conc xt = X { xt } else { readback X }
              if (and (neutral_free a) (neutral_free xr)) { Conc (tr xr) }
              else {
                let d := teq_decide ({a2, x2} -> Neu ({ (ShallowType) := Bool, (AnyTree) := pair "Teq" (pair a2 x2) })) a xr
                if (or (tree_eq d true) (tree_eq d false)) { Conc d } else { d }
              }
            }
          }
        } else if (is_neutral tr) {
          if ((fix ({rt, w} ->
                if (member w (list_map readback st)) { true }
                else {
                  let h := field (wait_payload w) AnyTree
                  if (tree_eq (pair_fst h) "Ob") { rt (pair_snd (pair_snd h)) } else { false }
                })) tr) { self chk (Neu (wait_payload tr)) X } else { Poison X }
        } else if let Conc xt = X {
          Conc (tr xt)
        } else if (or (tree_eq tr pair_fst) (tree_eq tr pair_snd)) {
          if let Neu m2 = X { self chk X (Conc (Acc tr)) } else { Poison X }
        } else if (is_elim_head tr) {
          if let Neu m = X {
            if (tree_eq (elim_arity tr) zero) { self chk X (Conc (Elim (pair tr nil))) } else { Chain (pair tr (pair X nil)) }
          } else { self chk (Conc ((elim_raw tr) tr)) X }
        } else {
          triage (vstem X) ({a} -> vfork (Conc a) X) ({a, b} -> apply_fork self chk (Conc a) (Conc b) X) tr
        })
        Neu m => {
          let fr := readback X
          let vlift := {tr} -> if (is_neutral tr) { Neu (wait_payload tr) } else { Conc tr }
          let r := respond_face fr (make_mark m)
          if (is_invalid r) { Poison (Neu m) }
          else if (list_all ({ob} -> vcheck chk st (pair_fst ob) (if (is_elim_frame fr) { vlift (pair_snd ob) } else { X })) (pair_fst r)) {
            Neu ({ (ShallowType) := pair_snd r, (AnyTree) := pair "Ob" (pair fr (make_mark m)) })
          } else { Poison (Neu m) }
        }
        Poison r => (Poison r)
        Chain e scr args => {
          let args2 := list_snoc args X
          if (tree_eq (list_len args2) (elim_arity e)) {
            self chk scr (Conc (Elim (pair e (list_map readback args2))))
          } else { Chain (pair e (pair scr args2)) }
        }
        Stem c => (vfork c X)
        Fork a b => (apply_fork self chk a b X)
      }
    }))
  fresh := {st, ty, tail} -> {
    let x := Neu ({ (ShallowType) := ty, (AnyTree) := tail })
    cons (pair x (cons x st)) nil
  }
  lift := {f} -> Conc f
  apply := {chk, st, F, X} -> mwalk st chk F X
  read := readback
  judge := {chk, st, T, r} -> vcheck chk st T r
})

GuardAt := {on_is_neutral, on_teq_open} -> {
  let w_stem := {a, x} -> {
    let r := t a x
    if (is_neutral r) { invalid r } else { r }
  }
  let w_s := {self, c, b, x} -> {
    let cx := self c x
    if (is_invalid cx) { cx } else {
      let bx := self b x
      if (is_invalid bx) { bx } else { self cx bx }
    }
  }
  let w_tfk := {self, b, l, r} -> {
    let bl := self b l
    if (is_invalid bl) { bl } else { self bl r }
  }
  let w_fork := {self, a, b, x} ->
    (triage
      b
      ({c} -> w_s self c b x)
      ({tc, td} ->
        if (is_neutral x) { invalid x }
        else { triage tc ({ci} -> self td ci) ({l, r} -> w_tfk self b l r) x })
      a)
  let walk := {st} -> fix ({self, f, x} ->
    if (is_invalid f) { f }
    else if (tree_eq f tree_eq) { wait tree_eq x }
    else if (has_sig tree_eq_sig f) {
      let a := wait_payload f
      if (and (neutral_free a) (neutral_free x)) { f x } else { teq_decide (on_teq_open st) a x }
    }
    else if (tree_eq f is_neutral) { on_is_neutral ({_} -> is_neutral x) x }
    else if (is_neutral f) { let r := f x; if (is_invalid (neutral_type r)) { invalid f } else { r } }
    else if (or (is_elim_head f) (has_sig elim_stuck_sig f)) { f x }
    else if (tree_eq f ({x} -> x)) { x }
    else if (and (is_neutral x) (or (tree_eq f pair_fst) (tree_eq f pair_snd))) { self x (Acc f) }
    else { triage (t x) ({a} -> w_stem a x) ({a, b} -> w_fork self a b x) f })
  let hyp_ok := (fix ({ok, vch, legit, v} ->
    if (member v legit) {
      true
    } else {
      let hist := field (wait_payload v) AnyTree
      if (tree_eq (pair_fst hist) "Ob") {
        let frame := pair_fst (pair_snd hist)
        let parent := pair_snd (pair_snd hist)
        let r := respond_face frame parent
        if (is_invalid r) { false }
        else {
          let obs := {
            let phist := field (wait_payload parent) AnyTree
            if (and (tree_eq (pair_fst phist) "Teq") (is_elim_frame frame)) {
              if (eq_holds legit (pair_fst (pair_snd phist)) (pair_snd (pair_snd phist))) { cons (pair_fst (pair_fst r)) nil } else { pair_fst r }
            } else { pair_fst r }
          }
          and (ok vch legit parent)
          (and (tree_eq (neutral_type v) (pair_snd r))
               (list_all ({ob} -> vch (pair_fst ob) (pair_snd ob)) obs))
        }
      } else if (tree_eq (pair_fst hist) "Teq") {
        (fix ({so, w} ->
          if (is_neutral w) { ok vch legit w }
          else { triage true ({c} -> so c) ({l, r} -> and (so l) (so r)) w })) (pair_snd hist)
      } else { false }
    }))
  let fresh := {st, ty, tail} -> {
    let x := make_hyp ty tail
    cons (pair x (cons x st)) nil
  }
  let judge := {chk, st, T, v} ->
    (fix ({vf, T2, v2} ->
      if (is_invalid v2) {
        false
      } else if (is_neutral v2) {
        and (tree_eq (neutral_type v2) T2) (hyp_ok vf st v2)
      } else {
        let rows := T2.tele
        if (is_leaf rows) {
          let e := T2.ends
          if (is_fork e) { and (is_leaf v2) (eq_holds st (pair_fst e) (pair_snd e)) }
          else {
            let ck := T2.check
            if (is_leaf ck) { T2.recognize (wait vf T2) v2 } else { ck vf T2 v2 }
          }
        } else { chk st rows v2 t }
      })) T v
  ({ fresh := fresh, admit := neutral_free, apply := {_chk, st, f, x} -> walk st f x, judge })
}
Guard : Table := GuardAt
  ({_resume, _x} -> false)
  ({st, a, x} -> if (eq_congr (eq_pairs st) a x) { true } else { make_hyp Bool (pair "Teq" (pair a x)) })
Ambient : Table := GuardAt
  ({resume, _x} -> resume t)
  ({_st, a, x} -> tree_eq a x)

given GenericWalker : AnyTree := Guard
Fn := Pi GenericWalker

False := Sum nil
Not := {P} -> Fn P ({_} -> False)
Refine := {A, p} -> ({
  #recognize := {_self, v} -> and (A v) (p v)
  check := {jdg, _T, v} -> and (jdg A v) (p v)
})
test False t = false
test False 5 = false
test Not False ({p} -> p) = true

Quotient := {A, nf} -> ({
  #recognize := {_self, v} -> A v
  check := {jdg, _T, v} -> jdg A v
  norm := nf
  under := A
})
canon := {A, v} -> {
  let nf := A.norm
  if (or (is_leaf nf) (not (neutral_free v))) { v } else { nf v }
}
Named := {name, T} -> ({
  #recognize := {_self, v} -> T v
  check := {jdg, _T2, v} -> jdg T v
  name := name
  under := T
})
key_insert := fix ({self, k, ks} ->
  if (is_leaf ks) { cons k nil }
  else if (tree_eq k (pair_fst ks)) { ks }
  else if (tree_lt k (pair_fst ks)) { cons k ks }
  else { cons (pair_fst ks) (self k (pair_snd ks)) })
key_sort := fix ({self, ks} -> if (is_leaf ks) { nil } else { key_insert (pair_fst ks) (self (pair_snd ks)) })
Tuple := {keys} -> {
  let ks := key_sort keys
  if (not (tree_eq (list_len ks) (list_len keys))) { invalid keys }
  else { (fix ({self, ks2} ->
    if (is_leaf (pair_snd ks2)) { pair_fst ks2 } else { Sigma GenericWalker (pair_fst ks2) ({_} -> self (pair_snd ks2)) })) ks }
}
at := {K, keys, s} -> (fix ({self, ks, v} ->
  if (is_leaf ks) { invalid K }
  else if (tree_eq K (pair_fst ks)) { if (is_leaf (pair_snd ks)) { v } else { pair_fst v } }
  else { self (pair_snd ks) (pair_snd v) })) (key_sort keys) s

probes := cons t (cons 5 (cons true (cons false (cons (pair 5 5) (cons (cons 1 nil) (cons (inj "zz" t) (cons (succ (succ zero)) nil)))))))
with_trials := {base} -> field_put base "fresh" ({st, ty, tail} -> {
  let ms := ty.members
  if (is_leaf ms) { (field base "fresh") st ty tail } else { list_map ({a} -> pair a st) ms }
})
Trials : Table := with_trials Guard
with_probes := {base} -> field_put base "fresh" ({st, ty, tail} ->
  list_cat ((field base "fresh") st ty tail) (list_map ({a} -> pair a st) (list_filter ty probes)))
TwoFace : Table := with_probes Guard

Nat : ShallowType := ({
  #recognize := {self, v} -> triage true ({_} -> false) ({l, r} -> and (tree_eq l t) (self r)) v
  gate := {Ind, B} -> cons (B zero) (cons (PiCode Ind ({k} -> PiCode (B k) ({_} -> B (succ k)))) nil)
  elim := {self, n, base, step} -> triage base ({_} -> base) ({_l, k} -> step k (self k base step)) n
})
test Nat zero = true
test Nat (succ (succ zero)) = true
test is_leaf Nat.tele = true
test tree_eq Row.code RowCode = true
test Nat (t t) = false
test Nat (make_hyp Nat Nat) = false
test Nat (succ (make_hyp Nat Nat)) = false
nat_step_ty : ShallowType := pair_fst (pair_snd (Nat.gate Nat ({_} -> Nat)))
nat_rec : Fn Nat ({_} -> Fn Nat ({_} -> Fn nat_step_ty ({_} -> Nat))) := elim_of Nat ({_} -> Nat)

bool_rec : Fn Bool ({_} -> Fn Bool ({_} -> Fn Bool ({_} -> Bool))) := elim_of Bool ({_} -> Bool)
test ShallowType Bool = true
test tree_eq (Tuple (cons Nat (cons Bool nil))) (Tuple (cons Bool (cons Nat nil))) = true
test Tuple (cons Nat (cons Bool nil)) (pair true 2) = true
test Tuple (cons Nat (cons Bool nil)) (pair 2 true) = false
test (Named "cost" Nat) 3 = true
test (Named "cost" Nat).name = "cost"
test tree_eq (Named "cost" Nat).under Nat = true
test tree_eq (Named "cost" Nat) (Named "price" Nat) = false
test field (make_record (cons Nat nil) (cons (list_const 7) nil)) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Bool = true
test tree_eq ({ (Nat) := 7, (Bool) := true }) ({ (Bool) := true, (Nat) := 7 }) = true
test field ({ label := "flip", ((Named "cost" Nat)) := 3 }) (Named "cost" Nat) = 3
test Fn ShallowType ({_} -> Bool) ({T} -> T 5) = true
test Fn ShallowType ({_} -> Bool) ({T} -> bool_rec (T 5) false true) = true
test Fn ShallowType ({_} -> Nat) ({T} -> T 5) = false

Point := {c} -> ({ #recognize := {_self, v} -> tree_eq c v, members := cons c nil })

refl := t
Eq := {A, x, y} -> {
  let nx := canon A x
  let ny := canon A y
  ({
    #recognize := {_self, v} -> and (is_leaf v) (tree_eq nx ny)
    gate := {_Ind, B} -> cons (B nx) nil
    elim := {_self, _p, base} -> base
    land := {B, _self} -> B ny
    ends := pair nx ny
  })
}
eq_subst := {A, x, y, B, p, base} -> elim_of (Eq A x y) B p base
eq_sym := {A, x, y, p} -> eq_subst A x y ({_} -> Eq A y x) p refl
eq_trans := {A, x, y, z, p, q} -> eq_subst A y z ({_} -> Eq A x z) q p
eq_cong := {A, f, x, y, p} -> eq_subst A x y ({_} -> Eq A (f x) (f y)) p refl
test Eq Nat 2 2 refl = true
test Eq Nat 2 3 refl = false
test Eq Nat 2 2 (t t) = false
test eq_subst Nat 2 2 ({_} -> Nat) refl 7 = 7
test eq_sym Nat 2 2 refl = refl
test eq_trans Nat 2 2 2 refl refl = refl
test eq_cong Nat succ 2 2 refl = refl

Tree : ShallowType := ({
  #recognize := {_self, _v} -> true
  gate := {Ind, B} -> cons (B t) (cons (PiCode Ind ({c} -> PiCode (B c) ({_} -> B (t c)))) (cons (PiCode Ind ({l} -> PiCode Ind ({r} -> PiCode (B l) ({_} -> PiCode (B r) ({_} -> B (t l r)))))) nil))
  elim := {self, v, on_leaf, on_stem, on_fork} -> triage on_leaf ({c} -> on_stem c (self c on_leaf on_stem on_fork)) ({l, r} -> on_fork l r (self l on_leaf on_stem on_fork) (self r on_leaf on_stem on_fork)) v
})
tree_rec := {B} -> elim_of Tree B

GoodGate := {T} -> {
  let g := T.gate
  if (is_leaf g) { false } else {
    let B := {_} -> inj "@GoodGate" T
    let tys := g T B
    let pis := fix ({self, l, end} -> if (is_leaf l) { end } else { Pi Guard (pair_fst l) ({_} -> self (pair_snd l) end) })
    and (Pi Guard T ({x} -> pis tys (B x)) (elim_of T B))
        (list_all ({ty} -> not (Pi Guard AnyTree ({_} -> ty) ({j} -> j))) tys)
  }
}
test GoodGate Nat = true
test GoodGate Bool = true
test GoodGate Tree = true
test GoodGate (Eq Nat 2 3) = true
test GoodGate AnyTree = false
test GoodGate ShallowType = false

Coherent := {T} -> {
  let e := T.ends
  let ck := T.check
  and (and
    (if (is_fork e) { or (tree_eq (pair_fst e) (pair_snd e)) (list_all ({v} -> not (T v)) probes) } else { true })
    (if (is_leaf ck) { true } else { list_all ({v} -> tree_eq (T v) (ck ({ty, a} -> ty a) T v)) probes }))
    (and (and (and (list_all T T.members)
                   (if (is_leaf T.members) { true } else { list_all ({v} -> or (not (T v)) (member v T.members)) probes }))
              (if (is_leaf T.gate) { true } else { GoodGate T }))
         (if (is_leaf T.norm) { true } else {
           list_all ({v} -> if (T v) { and (T (T.norm v)) (tree_eq (T.norm (T.norm v)) (T.norm v)) } else { true }) probes
         }))
}
test Coherent Nat = true
test Coherent Bool = true
test Coherent Tree = true
test Coherent Unit = true
test Coherent AnyTree = true
test Coherent (Point 5) = true
test Coherent (Eq Nat 2 2) = true
test Coherent (Eq Nat 2 3) = true

list_len_t : Fn Tree ({_} -> Nat) := {xs} -> tree_rec ({_} -> Nat) xs zero ({_c, _ih} -> zero) ({_l, _r, _il, ir} -> succ ir)
list_snoc_t : Fn Tree ({_} -> Fn Tree ({_} -> Tree)) := {xs, x} -> tree_rec ({_} -> Tree) xs (cons x nil) ({_c, _ih} -> t) ({l, _r, _il, ir} -> cons l ir)
list_map_t : Fn (Fn Tree ({_} -> Tree)) ({_} -> Fn Tree ({_} -> Tree)) := {f, xs} -> tree_rec ({_} -> Tree) xs nil ({_c, _ih} -> t) ({l, _r, _il, ir} -> cons (f l) ir)
list_all_t : Fn (Fn Tree ({_} -> Bool)) ({_} -> Fn Tree ({_} -> Bool)) := {p, xs} -> tree_rec ({_} -> Bool) xs true ({_c, _ih} -> false) ({l, _r, _il, ir} -> bool_rec (p l) ir false)
test list_len_t (cons 7 (cons 7 nil)) = 2
test list_snoc_t (cons 1 nil) 2 = cons 1 (cons 2 nil)
test list_map_t succ (cons 1 (cons 2 nil)) = cons 2 (cons 3 nil)
test list_all_t is_leaf (cons t (cons t nil)) = true
test list_all_t is_leaf (cons t (cons 2 nil)) = false
test Fn Tree ({_} -> Bool) is_leaf = false

let list_mem := {ej, rj, A, v} -> triage true ({_} -> false) ({h, tl} -> and (ej A h) (rj tl)) v
List : Pi Guard ShallowType ({_} -> ShallowType) := {A} -> ({
  #recognize := {self, v} -> list_mem ({ty, a} -> ty a) self A v
  check := {jdg, T, v} -> list_mem jdg ({a} -> jdg T a) A v
  gate := {Ind, B} -> cons (B nil) (cons (PiCode A ({h} -> PiCode Ind ({tl} -> PiCode (B tl) ({_} -> B (cons h tl))))) nil)
  elim := {self, xs, base, step} -> triage base ({_} -> base) ({h, tl} -> step h tl (self tl base step)) xs
})

let record_mem := {ej, entries, r} -> list_all ({e} -> {
  let c := field_cell r (pair_fst e)
  if (is_leaf c) { false } else { ej (pair_snd e) (pair_snd c) }
}) entries
Record : Pi Guard AnyTree ({_} -> ShallowType) := {entries} -> ({
  #recognize := {_self, r} -> record_mem ({ty, a} -> ty a) entries r
  check := {jdg, _T, r} -> record_mem jdg entries r
})
check_module := Record
test tree_eq check_module Record = true

GuardActionCode := < Bind : t, Install : t, Both : t >
GuardAction := Sum GuardActionCode
CheckerResultCode := < Ok : t, Err >
CheckerResult := Sum CheckerResultCode
Request : ShallowType := Record (cons (pair "value" AnyTree) (cons (pair "ty" AnyTree) (cons (pair "guard" AnyTree) (cons (pair "private" Bool) (cons (pair "param" Bool) nil)))))
base := {v} -> ({ value := t v, ty := t, guard := t, private := false, param := false })
let := {req} -> field_put req "private" true
sig := {T} -> ({ value := t, ty := t T, guard := t, private := false, param := false })
guard := {g, req} -> field_put req "guard" (t g)
given := {req} -> field_put (field_put req "private" true) "param" true
default_guard := {_old, req} ->
  if (is_stem (field req "guard")) {
    if (is_stem (field req "value")) { Ok (Both (pair (stem_child (field req "value")) (stem_child (field req "guard")))) }
    else { Ok (Install (stem_child (field req "guard"))) }
  } else if (is_stem (field req "value")) { Ok (Bind (stem_child (field req "value"))) } else { Err }
test Request (base 5) = true
test GuardAction (Bind 5) = true
test CheckerResult Err = true
test field (base 5) "value" = t 5
test default_guard t (base 5) = Ok (Bind 5)
test default_guard t (guard succ (base 5)) = Ok (Both (pair 5 succ))
test default_guard t (guard succ (sig Nat)) = Ok (Install succ)
test default_guard t (sig Nat) = Err

let eff_mem := {ej, rj, Q, X, v} -> (match v { Pure x => (ej X x); Op q k => (and (ej Q q) (rj (k t))); _ => false })
Eff : Pi Guard ShallowType ({_} -> Pi Guard ShallowType ({_} -> Pi Guard ShallowType ({_} -> ShallowType))) := {Q, Ans, X} -> ({
  #recognize := {self, v} -> eff_mem ({ty, a} -> ty a) self Q X v
  check := {jdg, T, v} -> eff_mem jdg ({a} -> jdg T a) Q X v
  gate := {Ind, B} -> cons (PiCode X ({x} -> B (Pure x))) (cons (PiCode Q ({q} -> PiCode (PiCode Ans ({_} -> Ind)) ({k} -> PiCode (PiCode Ans ({r} -> B (k r))) ({_} -> B (Op (pair q k)))))) nil)
  elim := {self, m, on_pure, on_op} -> (match m { Pure x => (on_pure x); Op q k => (on_op q k ({r} -> self (k r) on_pure on_op)) })
})
test Eff Row AnyTree AnyTree (PiCode AnyTree ({_} -> AnyTree)).tele = true
test Eff Row AnyTree AnyTree (Sigma Guard Nat ({_} -> Bool)).tele = true
test Eff Row AnyTree AnyTree ShallowType.obs = true
test Eff Row AnyTree AnyTree 5 = false

GuardNatToNat : ShallowType := Pi Guard Nat ({_} -> Nat)

add : Fn Nat ({_} -> Fn Nat ({_} -> Nat)) := {n, m} -> nat_rec n m ({k, ih} -> succ ih)
not_bool : Fn Bool ({_} -> Bool) := {b} -> bool_rec b false true
elim_id : Fn Nat ({_} -> Nat) := {n} -> nat_rec n zero ({k, ih} -> succ ih)
test add 2 3 = 5
test add 0 4 = 4
test ShallowType Nat = true
test ShallowType GuardNatToNat = true
test ShallowType ShallowType = true
test ShallowType 5 = false
test ShallowType EffCode = false
