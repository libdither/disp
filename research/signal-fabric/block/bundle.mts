// Bundles the viewer (ui.ts) into ../block.js, which block.html loads. view.sh runs it.
import { writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { build } from 'esbuild'

const here = dirname(fileURLToPath(import.meta.url))
const out = await build({
  entryPoints: [join(here, 'ui.ts')], bundle: true, write: false, format: 'esm', target: 'es2022', minify: true, legalComments: 'none',
  tsconfigRaw: { compilerOptions: { target: 'ES2022', strict: true } }
})
writeFileSync(join(here, '../block.js'), '// generated by block/bundle.mts from block/ui.ts; do not edit\n' + out.outputFiles[0].text)
console.log(`block.js: ${out.outputFiles[0].text.length} bytes`)
