// The confirmer behind TYPES.html: a symbolic checker for claims about functions,
// quotients and streams. A partly-known value is a tree with holes, each a named
// piece of the challenge ("some member, unnamed") or an application nobody can run; a symbolic
// evaluator over them reports answered / need / stuck; a search splits a needed
// piece along its type's cases, derived for a recognizer by running it; induction is
// licensed only on a strictly smaller input-derived piece; equality compares
// normal forms at the codomain after judging membership; streams are compared by
// one bisimulation step. Verdicts are "Proved", `refuted w` (w re-run
// concretely), or "Open" with a reason. Every Proved is cross-checked in
// lib/tests/confirmer.test.disp against the enumeration refuter (IDEAS.disp's Arrow).
open use raw "prelude.disp" {}
open use raw "list.disp" {}
open use raw "verdict.disp" {}
open use raw "machine.disp" {}
open use raw "stream.disp" {}
open use raw "trees.disp" {}
open use raw "tests/fixtures.disp" {}

// ---------------------------------------------------------------- codes
// A code is Tree (the atom), a recognizer (any program saying true to its members: Nat,
// Bool, False), or a type given by its behaviour: functions, quotients and every other
// former. Recognizers split and are identity-fine (their relation is tree_eq).
TreeR :: {v : Tree} -> Bool :=> true
FalseR :: {v : Tree} -> Bool :=> false
// (NatR, LoopR and the quotient normalizers come from fixtures.disp; Bool, the
// recognizer {t, t t}, from trees.disp)

some :: {x : Tree} -> Option(Tree) :=> pair("Some", x)
none :: Option(Tree) := "None"
is_none :: Option(Tree) -> Bool := {o} => o == none

// A type given by its behaviour: the one extension point, so a new type former is a record
// and nothing below changes for it. `admits` judges a partly-known value (a piece of the type
// itself and a neutral term of it are handled before it is asked); it receives the judge, then
// the type's own code, so a type needs nothing but what it is handed and a recursive type
// refers to itself without building itself. `cases` gives the shapes a member
// can take, for a type whose pieces may be split; `applied` makes it a function type, with
// the codomain a family over the argument's faces (what a program receives, and what a
// dependent type sees); `generic` is the argument a function over it receives at a
// position (a piece of it, unless given); `static` is what a dependent type sees of a
// value (the value itself, unless given); `program` is what a program receives of a value
// (the value itself, unless given); `types` says its members are types; `sample` is a
// concrete stand-in for a piece of it (the k-th of two), to re-run a claim on real values.
// A type built from values, types or families of types lists them as its `parts`, each
// tagged "Value", "Type" or "Family" (anything else is left alone), with `remake`, which
// builds the type from parts: putting one value for another goes through the parts
// (type_subst), so no type writes its own substitution. `normal` is what a type computes
// to, and two types are the same type when their normal forms are one tree. `elim` is an
// eliminator the type brings, with what its other arguments must be (elim_type): a type
// with cases needs none, since both are derived from the cases.
record behaviour :: {admits : (Code -> Val -> Res) -> Code -> Val -> Res, cases : Option(Tree) := none, applied : Option(Pair(Code, Tree)) := none, generic : Option(Tree) := none, static : Option(Tree) := none, program : Option(Tree) := none, types : Bool := false, sample : Option(Tree) := none, parts : List(Pair(Tree, Tree)) := [], remake : Tree := t, normal : Option(Tree) := none, elim : Option(Pair(Tree, Tree)) := none} -> Behaviour
of_type :: {b : Behaviour} -> Code :=> pair("Type", b)
is_type_code :: Code -> Bool := {c} => c.fst == "Type"
// a code as a function type: some(pair(domain, family)), the family taking the argument's faces
fn_view :: Code -> Option(Pair(Code, Tree)) := {c} => if (is_type_code(c)) { c.snd.applied } else { none }
is_fn_code :: Code -> Bool := {c} => not(is_none(fn_view(c)))
static_of :: {T : Code, v : Val} -> Tree :=> if ((is_type_code(T)) && (not(is_none(T.snd.static)))) { T.snd.static.snd(T, v) } else { v }
program_of :: {T : Code, v : Val} -> Val :=> if ((is_type_code(T)) && (not(is_none(T.snd.program)))) { T.snd.program.snd(T, v) } else { v }
is_types :: Code -> Bool := {c} => (is_type_code(c)) && (c.snd.types)
normal_of :: {T : Code} -> Code :=> if ((is_type_code(T)) && (not(is_none(T.snd.normal)))) { T.snd.normal.snd(T) } else { T }
same_type :: {A : Code, B : Code} -> Bool :=> if (A == B) { true } else { normal_of(A) == normal_of(B) }
// what a type is built from: a function type's domain and family, then the parts it lists
parts_of :: {T : Code} -> List(Pair(Tree, Tree)) :=>
	if (is_none(T.snd.applied)) { T.snd.parts } else { cons(pair("Type", T.snd.applied.snd.fst), cons(pair("Family", T.snd.applied.snd.snd), T.snd.parts)) }
// a type nothing is known to be in, with the reason
no_type :: {why : Tree} -> Code :=> of_type(behaviour{admits := {_at, _self, _v} => pair("Stuck", why)})
// A quotient: the members of its base, with a coarser sameness, given by a normalizer.
quot_admits := {at, self, v} => at(self.snd.parts.head.snd, v)
QuotC :: {Base : Code, nf : Tree} -> Code :=> of_type(behaviour{admits := quot_admits, parts := [pair("Type", Base), pair("Datum", nf)]})
is_quot_code :: Code -> Bool := {c} => if (is_type_code(c)) { c.snd.admits == quot_admits } else { false }
quot_base :: Code -> Code := {c} => c.snd.parts.head.snd
quot_nf :: Code -> Tree := {c} => c.snd.parts.tail.head.snd
// the declared quotients: Parity (mod 2) and All (every Nat identified)
Parity := QuotC(NatR, parity)
All := QuotC(NatR, always_zero)
normalizers := [Parity, All].map(quot_nf)

// ---------------------------------------------------------------- values
// A partly-known value is a plain tree with holes in it: a fully known value is itself,
// and equal values are equal trees. A hole is `wait(hole_marker, what)` (built like the
// kernel's hypotheses, lib/kernel/kernel.disp), and applying one natively gives the hole
// for that application. A hole is one of four things:
//   Piece T root path  a piece of the challenge: the argument `root` reached by `path`
//                 (destructor steps, newest first), unknown but for being a member of T.
//                 The lenses make every unknown one: the case split's cases have pieces, the
//                 induction hypothesis is a piece of a function type, a pattern's variables
//                 are pieces of the pattern, and a type's eliminator where it cannot run is a
//                 piece too (below). Two occurrences of one piece are one tree.
//   App head arg  an application nobody can run yet: of a function piece, or of a function
//                 whose answer waits on a piece (tree_eq, is_a, a type's eliminator)
//   Forged v      a marker-shaped tree a program built (below)
//   Lemma f T     a definition already Proved at T, inside a program judged with lemmas
hole_marker := fix({self, what, arg} => wait(self, pair("App", pair(wait(self, what), arg))))
hole :: {what : Tree} -> Val :=> wait(hole_marker, what)
hole_sig := (hole(t)).fst
is_hole :: Val -> Bool := {v} => if (is_fork(v)) { v.fst == hole_sig } else { false }
hole_what :: Val -> Tree := {h} => h.snd.snd
// fully known: no hole anywhere inside
rec is_known :: {v : Val} -> Bool :=>
	if (is_hole(v)) { false }
	else if (is_leaf(v)) { true }
	else if (is_stem(v)) { is_known(stem_child(v)) }
	else if (is_known(v.fst)) { is_known(v.snd) }
	else { false }
// a fork that is not a hole (holes are forks; the leaf and stems are always shapes)
is_fork_shaped :: Val -> Bool := {v} => if (is_fork(v)) { not(is_hole(v)) } else { false }
// A program can build a marker-shaped tree on purpose. That tree is no hole of ours, so
// wherever a program's tree enters (a checked program, a native run's answer, a fork the
// stem rule builds) it is wrapped whole as a Forged hole, which every judge finds opaque.
forged :: {v : Tree} -> Val :=> hole(pair("Forged", v))
rec escape :: {v : Tree} -> Val :=>
	if (is_known(v)) { v }
	else if (is_hole(v)) { forged(v) }
	else if (is_stem(v)) { t(escape(stem_child(v))) }
	else { t(escape(v.fst), escape(v.snd)) }

piece_named :: {T : Code, name : Pair(Tree, List(Tree))} -> Val :=> hole(pair("Piece", pair(T, name)))
piece_at :: {T : Code, root : Tree, path : List(Tree)} -> Val :=> piece_named(T, pair(root, path))
piece :: {T : Code, path : List(Tree)} -> Val :=> piece_at(T, 0, path)
// a variable of a pattern, which matching binds
pattern_piece :: {name : Tree} -> Val :=> piece_at(TreeR, "pattern", [name])
app_val :: {head : Val, arg : Val} -> Val :=> hole(pair("App", pair(head, arg)))
is_hole_of :: {kind : Tree, v : Val} -> Bool :=> if (is_hole(v)) { v.hole_what.fst == kind } else { false }
is_piece :: Val -> Bool := is_hole_of("Piece")
is_app :: Val -> Bool := is_hole_of("App")
// A lemma: a definition already Proved at T, standing for itself inside a program judged with
// lemmas (lib/rules.disp). Applied, it runs as itself; where that run does not answer, or answers
// a value that is itself stuck, it answers as a piece of T applied to its arguments, which its own
// verdict licenses once each argument is in its domain. A run that answers a function stays a
// lemma at the rest of the type.
lemma_at :: {fn : Tree, T : Code, spine : Val} -> Val :=> hole(pair("Lemma", pair(fn, pair(T, spine))))
lemma_val :: {fn : Tree, T : Code} -> Val :=> lemma_at(fn, T, piece_at(T, "lemma", [fn]))
is_lemma :: Val -> Bool := is_hole_of("Lemma")
// A type's eliminator is a program made from the type (`fold_of`, below), and its tree says so:
// `fold_with(T, layer)` runs one layer of it, with itself for the answers below. On a hole it
// cannot run, so that application is a neutral term: a piece standing for the eliminator,
// applied to what is eliminated and then to the handlers. Its type is read off the goal it is
// judged at (elim_type), so until then nothing is known to be in it.
fold_marker := fix({self, w, x} => w.snd(wait(self, w), x))
fold_with :: {T : Code, layer : Tree} -> Tree :=> wait(fold_marker, pair(T, layer))
fold_sig := (fold_with(t, t)).fst
is_fold :: Val -> Bool := {f} => if (is_fork(f)) { f.fst == fold_sig } else { false }
fold_type :: Val -> Code := {f} => f.snd.snd.fst
piece_type :: Val -> Code := {s} => s.hole_what.snd.fst
piece_name :: Val -> Tree := {s} => s.hole_what.snd.snd
piece_root :: Val -> Tree := {s} => s.piece_name.fst
piece_path :: Val -> List(Tree) := {s} => s.piece_name.snd
is_var :: Val -> Bool := {v} => if (v.is_piece) { v.piece_root == "pattern" } else { false }
elim_piece :: {f : Tree} -> Val :=> piece_at(no_type("an eliminator with no goal to read"), "elim", [f])
is_elim :: Val -> Bool := {v} => if (v.is_piece) { v.piece_root == "elim" } else { false }
elim_fold :: Val -> Tree := {v} => v.piece_path.head
app_head :: Val -> Val := {a} => a.hole_what.snd.fst
app_arg :: Val -> Val := {a} => a.hole_what.snd.snd
// an argument's two faces: what a program receives, and what dependent types see of it
faces_of :: {T : Code, v : Val} -> Pair(Val, Tree) :=> pair(program_of(T, v), static_of(T, v))
// the argument a function over T receives at position i: a piece of T, unless the type gives its own
arg_sym :: {T : Code, i : Nat} -> Val :=> piece(T, [pair("arg", i)])
generic_of :: {T : Code, i : Nat} -> Val :=> if ((is_type_code(T)) && (not(is_none(T.snd.generic)))) { T.snd.generic.snd(T, i) } else { arg_sym(T, i) }

// Membership as a program: is_a(T)(x) runs T's recognizer on x. The evaluator reads it as
// the question "x : T": a piece of T is a member, and while T's own cases or another
// recognizer's are derived, a piece not yet given a type makes the question open.
// (a fully known value is judged by membership alone: a recognizer is run, a type given by its behaviour is asked)
rec member_judge :: {R : Code, v : Tree} -> Res :=> if (is_type_code(R)) { R.snd.admits(member_judge, R, v) } else if (R(v) == true) { "Yes" } else { "No" }
member_marker := {T, x} => member_judge(T, x) == "Yes"
is_a :: {T : Code} -> Tree :=> wait(member_marker, T)
is_a_sig := (is_a(t)).fst
is_member_q :: Val -> Bool := {f} => if (is_fork(f)) { f.fst == is_a_sig } else { false }
// the trees a recognizer says no to, as a recognizer
not_a :: {T : Code} -> Code :=> {y} => not(is_a(T)(y))

// A recognizer is a type: its members are the trees it says true to. Tree is the one atom.
is_recognizer :: Code -> Bool := {R} => not((R == TreeR) || (is_type_code(R)))
// a code whose pieces may split: Tree, a recognizer (its cases are derived, below), a type with cases.
// These are also the identity-fine codes: their relation is tree_eq
has_cases :: Code -> Bool := {R} => if ((R == TreeR) || (is_recognizer(R))) { true } else if (is_type_code(R)) { not(is_none(R.snd.cases)) } else { false }
is_fine :: Code -> Bool := has_cases
// the search may split exactly the INPUT pieces of such a code
is_splittable :: Val -> Bool := {v} => if (v.is_piece) { has_cases(v.piece_type) } else { false }

// ---------------------------------------------------------------- outcomes
// A run either answers, NEEDS the shape of a splittable piece (a case split
// can resolve it), or is stuck: bare `stuck` for fuel or a missing license,
// `stuck_on (pair why value)` when an opaque value was inspected or judged —
// stuck is never a verdict and never split. Judgements reuse the vocabulary
// plus Yes/No and `coarse s`: the value is fine-shaped but carries the free
// piece s of a coarser code (the grade rule). "No" is reserved for a GENUINE
// counterexample (on a ground input it refutes).
answered :: {v : Val} -> Res :=> pair("Answered", v)
need :: {s : Val} -> Res :=> pair("Need", s)
stuck :: Res := "Stuck"
stuck_on :: {reason : Tree} -> Res :=> pair("Stuck", reason)
coarse :: {s : Val} -> Res :=> pair("Coarse", s)
is_answered :: Res -> Bool := {r} => r.fst == "Answered"
is_need :: Res -> Bool := {r} => r.fst == "Need"
is_stuck :: Res -> Bool := {r} => (r == stuck) || (r.fst == "Stuck")
answer :: Res -> Val := pair_snd
and_then :: {r : Res, continue : Val -> Res} -> Res :=> if (r.is_answered) { continue(r.answer) } else { r }
and_yes :: {r : Res, continue : Tree -> Res} -> Res :=> if (r == "Yes") { continue(t) } else { r }
// inspecting a value: a splittable piece is a Need; an input piece without
// a table, a hypothesis value or a neutral term is opaque — Stuck with a reason
// the function at the bottom of a neutral term
rec spine_head :: {v : Val} -> Val :=> if (v.is_app) { spine_head(v.app_head) } else { v }
// what a stuck value waits on: a neutral term on the function at its bottom, a stuck elimination on what it eliminates
rec waits_on :: {v : Val} -> Val :=>
	if (not(v.is_app)) { v }
	else if (v.app_head.is_elim) { waits_on(v.app_arg) }
	else { waits_on(v.app_head) }
inspect :: Val -> Res := {v} =>
	// a piece that can be split, or a neutral term waiting on one (a function piece of a finite type, or what a stuck elimination eliminates)
	if (waits_on(v).is_splittable) { need(waits_on(v)) }
	else if (v.is_piece) { stuck_on(pair("no split table", v)) }
	else { stuck_on(pair("opaque value", v)) }

// ---------------------------------------------------------------- matching
// First-order matching of a pattern (a value whose pattern pieces bind) against a
// term: variables bind consistently, equal trees match, shapes match child by
// child, neutral terms match head by tree_eq then argument, a splittable piece
// where the pattern has a shape is a Need. Answers the environment (a list of
// pair var value).
rec match_val :: {pattern : Val, term : Val, env : List(Pair(Val, Val))} -> Res :=>
	if (pattern.is_var) {
		let bound := env.filter({e} => e.fst == pattern)
		if (bound.is_nil) { answered(cons(pair(pattern, term), env)) }
		else if (bound.head.snd == term) { answered(env) } else { "Unrelated" }
	}
	else if (pattern == term) { answered(env) }
	else if (pattern.is_app) {
		if ((term.is_app) && (pattern.app_head == term.app_head)) { match_val(pattern.app_arg, term.app_arg, env) }
		else { "Unrelated" }
	}
	else if (is_hole(pattern)) { "Unrelated" }
	else if (term.is_splittable) { need(term) }
	else if (is_stem(pattern)) { if (is_stem(term)) { match_val(stem_child(pattern), stem_child(term), env) } else { "Unrelated" } }
	else if ((pattern.is_fork_shaped) && (term.is_fork_shaped)) {
		and_then(match_val(pattern.fst, term.fst, env), {env2} => match_val(pattern.snd, term.snd, env2))
	}
	else { "Unrelated" }

// ---------------------------------------------------------------- the licenses
// succ^k (piece q) IS the piece q lost its last k steps to, when succ of the
// child is one of the cases q split into (it only exists in that branch) — fold
// it back so the induction license sees the piece itself. `tbl` is `table`.
rec canon_with :: {tbl : Tree, v : Val} -> Val :=>
	if ((v.is_fork_shaped) && (is_leaf(v.fst))) {
		let inner := canon_with(tbl, v.snd)
		if ((inner.is_piece) && (not(inner.piece_path.is_nil))) {
			let cases := tbl(inner.piece_type, {step} => piece_at(inner.piece_type, inner.piece_root, cons(step, inner.piece_path.tail)))
			if ((not(is_none(cases))) && (cases.snd.member(t(t, inner)))) { piece_at(inner.piece_type, inner.piece_root, inner.piece_path.tail) } else { v }
		} else { v }
	} else { v }

// paths are newest-first, so `longer` strictly extends `shorter` when `shorter`
// is a proper suffix of it
rec is_strict_ext :: {longer : List(Tree), shorter : List(Tree)} -> Bool :=>
	if (longer.is_nil) { false }
	else if (longer.tail == shorter) { true }
	else { is_strict_ext(longer.tail, shorter) }

// the piece an argument of the hypothesis stands for, or "None": a strict descendant of the
// root input, an input piece of the domain (after folding succ^k back), or the partner of one
licensed_with :: {tbl : Tree, B : Code, x : Val} -> Val :=> {
	let Dom := B.snd.parts.head.snd
	let root := B.snd.parts.tail.head.snd
	let partner := B.snd.parts.tail.tail.head.snd
	let ok := {c} => if (c.is_piece) { ((c.piece_type == Dom) && (c.piece_root == 0)) && (is_strict_ext(c.piece_path, root)) } else { false }
	let direct := canon_with(tbl, x)
	if (ok(direct)) { direct }
	else {
		let peeled := match_val(partner(pattern_piece("a")), x, [])
		let found := if ((peeled.is_answered) && (not(peeled.answer.is_nil))) { canon_with(tbl, peeled.answer.head.snd) } else { none }
		if (ok(found)) { found } else { "None" }
	}
}
same :: Val -> Val := {a} => a

// ---------------------------------------------------------------- derived cases
// A recognizer's cases come from running it once on an unknown tree: where it looks,
// the tree splits into its pieces' cases (Tree's three shapes at first), and a branch
// that answers true is a case. Asking whether a strictly smaller piece is a member
// (its own recursion, or another type's is_a) opens a question; a branch whose answer
// is the question is the case with the piece typed, and a branch that looks at the
// answer splits in two. Nothing about a type is written by hand: Tree's shapes, the
// generic run and induction on smaller pieces are all it takes. `run` is `sapply`.
rec subst :: {target : Val, by : Val, v : Val} -> Val :=>
	if (v == target) { by }
	else if (v.is_known) { v }
	else if (v.is_app) { app_val(subst(target, by, v.app_head), subst(target, by, v.app_arg)) }
	else if ((is_hole(v)) || (is_leaf(v))) { v }
	else if (is_stem(v)) { t(subst(target, by, stem_child(v))) }
	else { t(subst(target, by, v.fst), subst(target, by, v.snd)) }
retype :: {s : Val, code : Code} -> Val :=> piece_named(code, s.piece_name)
tree_cases :: {child : Tree -> Val} -> List(Val) :=> [t, t(child("child")), t(child("left"), child("right"))]
fix_shape := fix(pattern_piece("step"))
step_of :: {f : Val} -> Tree :=> {
	let m := match_val(fix_shape, f, [])
	if ((m.is_answered) && (not(m.answer.is_nil))) { m.answer.head.snd } else { none }
}
rec all_some :: {xs : List(Option(List(Val)))} -> Option(List(Val)) :=>
	if (xs.is_nil) { some([]) }
	else if (is_none(xs.head)) { none }
	else { let rest := all_some(xs.tail); if (is_none(rest)) { none } else { some(xs.head.snd.append(rest.snd)) } }
derive_depth := 16
// a branch of one layer that runs longer than this gives no cases (recursion that is not
// on a smaller piece stops at once, so the budget only bounds the layer's own work)
derive_fuel := 300000
// the root id of the tree being derived, which no search uses
derive_root := 7
// a piece of that tree not yet given a type: asking whether it is a member opens a question
is_open_piece :: Val -> Bool := {x} => if (x.is_piece) { ((x.piece_type == TreeR) && (x.piece_root == derive_root)) && (not(x.piece_path.is_nil)) } else { false }
// a value built around such pieces: asking about it is recursion that is not on a smaller piece
rec has_open_piece :: {x : Val} -> Bool :=>
	if (is_open_piece(x)) { true }
	else if (x.is_app) { (has_open_piece(x.app_head)) || (has_open_piece(x.app_arg)) }
	else if ((is_hole(x)) || (is_leaf(x))) { false }
	else if (is_stem(x)) { has_open_piece(stem_child(x)) }
	else if (has_open_piece(x.fst)) { true }
	else { has_open_piece(x.snd) }
rec explore :: {run : Tree, tbl : Tree, R : Code, v : Val, depth : Nat} -> Option(List(Val)) :=> {
	let step := step_of(R)
	let r := if (step == none) { run(R, v) } else { and_then(run(step, is_a(R)), {layer} => run(layer, v)) }
	let typed := {q, T} => subst(q.app_arg, retype(q.app_arg, T), v)
	let asks := {q} => if (q.is_app) { q.app_head.is_member_q } else { false }
	let question := if (r.is_answered) { r.answer } else if (r.fst == "Stuck") { r.snd.snd } else { t }
	if (r == answered(true)) { some([v]) }
	else if (r == answered(false)) { some([]) }
	// the answer is the question itself: a case exactly when the piece is a member
	else if (if (r.is_answered) { asks(question) } else { false }) { some([typed(question, question.app_head.snd.snd)]) }
	else if (is_zero(depth)) { none }
	// the run looked at the question's answer: one branch where the piece is a member, one where it is not
	else if (asks(question)) {
		all_some([explore(run, tbl, R, typed(question, question.app_head.snd.snd), nat_pred(depth)), explore(run, tbl, R, typed(question, not_a(question.app_head.snd.snd)), nat_pred(depth))])
	}
	// the run looked at a piece: split it by its type's cases
	else if (if (r.is_need) { if (r.snd.is_piece) { r.snd.piece_root == derive_root } else { false } } else { false }) {
		let s := r.snd
		let child := {step} => piece_at(s.piece_type, derive_root, cons(step, s.piece_path))
		let alts := tbl(s.piece_type, child)
		if (is_none(alts)) { none } else { all_some(alts.snd.map({alt} => explore(run, tbl, R, subst(s, alt, v), nat_pred(depth)))) }
	}
	else { none }
}
// a derived case names its pieces by their path in the tree; a one-step path by the step
rec name_pieces :: {child : Tree -> Val, v : Val} -> Val :=>
	if (v.is_piece) { retype(child(if (v.piece_path.is_nil) { "tree" } else if (v.piece_path.tail.is_nil) { v.piece_path.head } else { v.piece_path }), v.piece_type) }
	else if ((is_hole(v)) || (is_leaf(v))) { v }
	else if (is_stem(v)) { t(name_pieces(child, stem_child(v))) }
	else { t(name_pieces(child, v.fst), name_pieces(child, v.snd)) }
// The split table of a code: Tree's shapes, a recognizer's derived cases, a type's own;
// `none` for a type that gives none (functions, quotients), and a recognizer whose cases could not be derived.
// An empty list is a type with no members: a claim over it holds vacuously.
rec table_via :: {run : Tree, R : Code, child : Tree -> Val} -> Option(List(Val)) :=>
	if (R == TreeR) { some(tree_cases(child)) }
	else if (is_type_code(R)) { if (is_none(R.snd.cases)) { none } else { some(R.snd.cases.snd(R, child)) } }
	else if (not(is_recognizer(R))) { none }
	else {
		let found := explore(run, {T, c} => table_via(run, T, c), R, piece_at(TreeR, derive_root, []), derive_depth)
		if (is_none(found)) { none } else { some(found.snd.map({c} => name_pieces(child, c))) }
	}
// tree_eq on partly-known values: identical values are equal in every instance, shapes
// that differ where both are known are unequal, and otherwise the first hole decides
rec eq_val :: {a : Val, b : Val} -> Res :=>
	if (a == b) { answered(true) }
	else if (is_hole(a)) { inspect(a) }
	else if (is_hole(b)) { inspect(b) }
	else if (is_stem(a)) { if (is_stem(b)) { eq_val(stem_child(a), stem_child(b)) } else { answered(false) } }
	else if (if (is_fork(a)) { is_fork(b) } else { false }) { and_then(eq_val(a.fst, b.fst), {same_l} => if (same_l == true) { eq_val(a.snd, b.snd) } else { answered(false) }) }
	else { answered(false) }

// ---------------------------------------------------------------- a type's eliminator, derived
// A type with cases has an eliminator, derived from the cases as they were derived from the
// type: it takes a member and one handler per case, finds the member's case by shape, and
// answers what that handler answers, given the case's pieces and then, for each piece of the
// type itself, the answer below it. It exists only when no tree fits two cases by shape.
// The handlers come one at a time, so a layer works with functions of all n of them, each
// built for the n at hand: the one that gives g of the j-th handler, and one applied to another.
rec consts :: {n : Nat} -> Tree :=> if (is_zero(n)) { {x} => x } else { let inner := consts(nat_pred(n)); {x, _h} => inner(x) }
rec selects :: {n : Nat, j : Nat} -> Tree :=>
	if (is_zero(j)) { let rest := consts(nat_pred(n)); {g, h} => rest(g(h)) } else { let inner := selects(nat_pred(n), nat_pred(j)); {g, _h} => inner(g) }
rec lifts :: {n : Nat} -> Tree :=> if (is_zero(n)) { {f, r} => f(r) } else { let inner := lifts(nat_pred(n)); {f, r, h} => inner(f(h), r(h)) }
rec apart :: {a : Val, b : Val} -> Bool :=>
	if ((is_hole(a)) || (is_hole(b))) { false }
	else if (is_leaf(a)) { not(is_leaf(b)) }
	else if (is_stem(a)) { if (is_stem(b)) { apart(stem_child(a), stem_child(b)) } else { true } }
	else if (is_fork(b)) { (apart(a.fst, b.fst)) || (apart(a.snd, b.snd)) }
	else { true }
rec all_apart :: {cases : List(Val)} -> Bool :=> if (cases.is_nil) { true } else if (cases.tail.all({c} => apart(cases.head, c))) { all_apart(cases.tail) } else { false }
// Each of these is a program built once from a case, so running it walks no case.
// whether a tree has the case's shape (none: every tree has)
rec shape_test :: {c : Val} -> Option(Tree) :=>
	if (c.is_piece) { none }
	else if (is_leaf(c)) { some(is_leaf) }
	else if (is_stem(c)) {
		let inner := shape_test(stem_child(c))
		some(if (is_none(inner)) { is_stem } else { let g := inner.snd; {v} => if (is_stem(v)) { g(stem_child(v)) } else { false } })
	}
	else {
		let l := shape_test(c.fst)
		let r := shape_test(c.snd)
		some(if (is_none(l)) { if (is_none(r)) { is_fork } else { let g := r.snd; {v} => if (is_fork(v)) { g(v.snd) } else { false } } }
			else if (is_none(r)) { let g := l.snd; {v} => if (is_fork(v)) { g(v.fst) } else { false } }
			else { let g := l.snd; let k := r.snd; {v} => if (is_fork(v)) { if (g(v.fst)) { k(v.snd) } else { false } } else { false } })
	}
// a function applied to a tree's subtrees at the case's pieces, left to right (none: the case has no piece)
rec feeds :: {c : Val} -> Option(Tree) :=>
	if (c.is_piece) { some({f, v} => f(v)) }
	else if ((is_hole(c)) || (is_leaf(c))) { none }
	else if (is_stem(c)) { let inner := feeds(stem_child(c)); if (is_none(inner)) { none } else { let g := inner.snd; some({f, v} => g(f, stem_child(v))) } }
	else {
		let l := feeds(c.fst)
		let r := feeds(c.snd)
		if (is_none(l)) { if (is_none(r)) { none } else { let g := r.snd; some({f, v} => g(f, v.snd)) } }
		else if (is_none(r)) { let g := l.snd; some({f, v} => g(f, v.fst)) }
		else { let g := l.snd; let k := r.snd; some({f, v} => k(g(f, v.fst), v.snd)) }
	}
// the subtree of a tree at each piece of the case that is of the type T, left to right
rec paths_to :: {T : Code, c : Val} -> List(Tree) :=>
	if (c.is_piece) { if (c.piece_type == T) { [{v} => v] } else { [] } }
	else if ((is_hole(c)) || (is_leaf(c))) { [] }
	else if (is_stem(c)) { paths_to(T, stem_child(c)).map({g} => {v} => g(stem_child(v))) }
	else { paths_to(T, c.fst).map({g} => {v} => g(v.fst)).append(paths_to(T, c.snd).map({g} => {v} => g(v.snd))) }
// the case's answer so far, applied to the answer below each of those subtrees
rec fold_below :: {lift : Tree, sofar : Tree, below : List(Tree)} -> Tree :=>
	if (below.is_nil) { sofar } else { let at := below.head; fold_below(lift, {me, v} => lift(sofar(me, v), me(at(v))), below.tail) }
rec fold_cases :: {T : Code, n : Nat, cases : List(Val), j : Nat} -> Tree :=>
	if (cases.is_nil) { {_me, _v} => t }
	else {
		let feed := feeds(cases.head)
		let sel := selects(n, j)
		let first := if (is_none(feed)) { let s := sel({h} => h); {_me, _v} => s } else { let g := feed.snd; {_me, v} => sel({h} => g(h, v)) }
		let run := fold_below(lifts(n), first, paths_to(T, cases.head))
		let test := shape_test(cases.head)
		let rest := fold_cases(T, n, cases.tail, succ(j))
		if (is_none(test)) { run } else { let fits := test.snd; {me, v} => if (fits(v)) { run(me, v) } else { rest(me, v) } }
	}
// a type's cases as its eliminator sees them, and one layer of the eliminator (none: no table, or cases not apart); `tbl` is `table`
fold_table_via :: {tbl : Tree, T : Code} -> Option(List(Val)) :=> tbl(T, {step} => piece_at(T, "case", [step]))
fold_layer_via :: {tbl : Tree, T : Code} -> Option(Tree) :=> {
	let cases := fold_table_via(tbl, T)
	if (if (is_none(cases)) { true } else { not(all_apart(cases.snd)) }) { none } else { some(fold_cases(T, cases.snd.length, cases.snd, 0)) }
}

// ---------------------------------------------------------------- the evaluator
// The machine of lib/machine.disp, run on partly-known values. Its rules copy pieces by
// name, so a step that reads no hole is the same step on every tree the holes stand for.
// A value's shape is read in two places only: the function position, and the argument of
// a triage. An application that would read a hole there is held back from the rules and
// answered here. So are the programs that read a value whole (tree_eq, a membership
// question, a declared normalizer), a fork the stem rule would build in a hole's shape, and
// a fully known application, which runs on the native machine. Fuel is a STEP budget: each
// rule and each held application spends one, so an exponential sub-computation runs out of
// fuel instead of out of time. A negative piece or neutral term in function position makes
// a neutral term; a declared normalizer applied to a smaller piece it would need makes one
// too (the quotient hypothesis consumes it).
run_fuel := 4000
rec nat_drop :: {k : Nat, n : Nat} -> Nat :=> if (is_zero(k)) { n } else { nat_drop(nat_pred(k), nat_pred(n)) }
/// a fully known run on the native machine, in chunks that double, each continuing where the last paused: at most twice its steps are charged
rec run_native :: {m : Machine, chunk : Nat, fuel : Nat} -> Pair(Res, Nat) :=>
	if (m_finished(m)) { pair(answered(escape(m_result(m))), fuel) }
	else if (is_zero(fuel)) { pair(stuck, 0) }
	else {
		let k := if (nat_le(chunk, fuel)) { chunk } else { fuel }
		run_native(m_advance(m, k), dbl(chunk), nat_drop(k, fuel))
	}
// a membership answer as the evaluator's: Yes is true, No is false, anything else as it is
answer_of :: Res -> Res := {r} => if (r == "Yes") { answered(true) } else if (r == "No") { answered(false) } else { r }
// A type given by its behaviour, asked about a partly-known value inside a run: it is handed a
// judge made of membership questions, each run by `go`.
rec ask_with :: {go : Tree, R : Code, v : Val} -> Res :=>
	if (is_type_code(R)) { R.snd.admits({R2, v2} => ask_with(go, R2, v2), R, v) }
	else { let r := go(is_a(R), v); if (r == answered(true)) { "Yes" } else if (r == answered(false)) { "No" } else { r } }
// A lemma applied runs as itself; a run that does not answer (stuck, or asking for a split)
// answers as its piece applied, and a function answer stays a lemma at the rest of the type.
// `go` is the evaluator below.
lemma_apply :: {go : Tree, f : Val, x : Val, left : Nat} -> Pair(Res, Nat) :=> {
	let lem := f.hole_what.snd
	let spine := app_val(lem.snd.snd, x)
	let ran := go(lem.fst, x, left)
	let view := fn_view(lem.snd.fst)
	let rest := view.snd.snd(faces_of(view.snd.fst, x))
	// an answer that is itself stuck says less than the lemma's type does
	if (if (ran.fst.is_answered) { (is_hole(ran.fst.answer)) && (not(is_fn_code(rest))) } else { true }) { pair(answered(spine), ran.snd) }
	else if (if (ran.fst.is_answered) { (is_fn_code(rest)) && (not(is_hole(ran.fst.answer))) } else { false }) { pair(answered(lemma_at(ran.fst.answer, rest, spine)), ran.snd) }
	else { ran }
}
// A hole in function position: tree_eq's answer waiting on a hole (the first hole decides,
// eq_val); the induction hypothesis, which applies only to what its domain licenses, the
// piece named canonically; any other function piece or application, which makes the hole for
// that application; a lemma. Anything else is inspected. `go` runs an application.
apply_hole :: {go : Tree, f : Val, x : Val, left : Nat} -> Pair(Res, Nat) :=>
	if (if (f.is_app) { f.app_head == tree_eq } else { false }) { pair(eq_val(f.app_arg, x), left) }
	else if (if (f.is_piece) { f.piece_root == "hypothesis" } else { false }) {
		let tbl := {R, child} => table_via({g, y} => (go(g, y, derive_fuel)).fst, R, child)
		let c := licensed_with(tbl, fn_view(f.piece_type).snd.fst, x)
		if (c == "None") { pair(stuck, left) } else { pair(answered(app_val(f, c)), left) }
	}
	else if ((if (f.is_piece) { is_fn_code(f.piece_type) } else { false }) || (f.is_app)) { pair(answered(f(x)), left) }
	else if (f.is_lemma) { lemma_apply(go, f, x, left) }
	else { pair(inspect(f), left) }
// a triage reads its argument's shape: the one rule that does
is_triage :: Val -> Bool := {f} => if (is_fork(f)) { is_fork(f.fst) } else { false }
// the identity compiles to the triage that REBUILDS its argument (t, t, t): that is x for
// every tree, so a piece may pass through unseen
identity_triage := t(t(t, t), t)
is_normalizer_call :: {f : Val, x : Val} -> Bool :=> if (x.is_piece) { if (x.piece_path.is_nil) { false } else { normalizers.member(f) } } else { false }
// the applications the rules do not take as they are
held :: {f : Val, x : Val} -> Bool :=>
	if (f == tree_eq) { true }
	else if (is_leaf(f)) { false }
	else if (is_stem(f)) { stem_child(f) == hole_sig }
	else if ((f.fst == hole_sig) || (f.fst == is_a_sig)) { true }
	else if ((f.fst == fold_sig) && (is_hole(x))) { true }
	else if (if (is_fork(f.fst)) { (f.fst.fst == hole_sig) || (is_hole(x)) } else { false }) { true }
	else if (is_normalizer_call(f, x)) { true }
	else if (is_known(x)) { is_known(f) }
	else { false }
// the machine to go on with, where a held application is answered by running another
go_on :: {m : Machine} -> Res :=> pair("Go", m)
// What a held application answers. `from` runs a machine (the loop below).
answer_held :: {from : Tree, f : Val, x : Val, stack : List(MFrame), left : Nat} -> Pair(Res, Nat) :=> {
	let go := {a, b, fuel} => from(m_start(a, b), fuel)
	let stop := {r} => pair(r, left)
	// the eliminator derived from its type, or one a type brings itself (its type is then where it is used)
	let genuine := {e} => if (is_leaf(fold_type(e))) { true } else { fold_layer_via({R, child} => table_via({g, y} => (go(g, y, derive_fuel)).fst, R, child), fold_type(e)) == some(e.snd.snd.snd) }
	if (f == tree_eq) { stop(answered(app_val(tree_eq, x))) }
	else if (is_stem(f)) { stop(answered(forged(t(stem_child(f), x)))) }
	else if (if (is_known(x)) { is_known(f) } else { false }) { run_native(m_start(f, x), 1, left) }
	// a type's eliminator on a hole: the stuck elimination. A tree that only says it is one runs as the program it is
	else if (if ((is_fold(f)) && (is_hole(x))) { genuine(f) } else { false }) { stop(answered(app_val(elim_piece(f), x))) }
	// is_a(T)(x): the question "x : T" (above); otherwise one layer of T runs
	else if (f.is_member_q) {
		let T := f.snd.snd
		let step := step_of(T)
		if (if (x.is_piece) { x.piece_type == T } else { false }) { stop(answered(true)) }
		else if (if (x.is_piece) { x.piece_type == not_a(T) } else { false }) { stop(answered(false)) }
		else if (is_open_piece(x)) { stop(answered(app_val(f, x))) }
		else if (has_open_piece(x)) { stop(stuck_on(pair("membership asked of a value that is not a smaller piece", x))) }
		else if (is_type_code(T)) { stop(answer_of(ask_with({a, b} => (go(a, b, left)).fst, T, x))) }
		else if (step == none) { stop(go_on(machine_run(T, x, stack))) }
		else { stop(go_on(machine_run(step, f, cons(fr_to(x), stack)))) }
	}
	else if (is_hole(f)) { apply_hole(go, f, x, left) }
	else if (is_hole(f.fst)) { stop(inspect(f.fst)) }
	else {
		// a triage whose argument is a hole needs the hole's shape, unless it is the identity
		let ran := if (not((is_triage(f)) && (is_hole(x)))) { from(m_rule(machine_run(f, x, [])), left) }
			else if (f == identity_triage) { stop(answered(x)) }
			else { stop(inspect(x)) }
		// a declared normalizer on a smaller piece it needs: the neutral term `nf k`
		if ((is_normalizer_call(f, x)) && ((ran.fst == need(x)) || (ran.fst.is_stuck))) { pair(answered(app_val(f, x)), ran.snd) }
		else { ran }
	}
}
// run a machine: the rules, and at each held application its answer
rec sapply_from :: {m : Machine, fuel : Nat} -> Pair(Res, Nat) :=> {
	let s := m_settle_by(held, m)
	if (m_finished(s)) { pair(answered(m_result(s)), fuel) }
	else if (is_zero(fuel)) { pair(stuck, 0) }
	else if (not(m_held(s))) { sapply_from(m_rule(s), nat_pred(fuel)) }
	else {
		let out := answer_held({n, left} => sapply_from(n, left), s.m_fn, s.m_arg, s.m_stack, nat_pred(fuel))
		if (out.fst.fst == "Go") { sapply_from(out.fst.snd, out.snd) }
		else if (out.fst.is_answered) { sapply_from(m_deliver(out.fst.answer, s.m_stack), out.snd) }
		else { out }
	}
}
sapply_s :: {f : Val, x : Val, fuel : Nat} -> Pair(Res, Nat) :=> sapply_from(m_start(f, x), fuel)
sapply :: {f : Val, x : Val, fuel : Nat} -> Res :=> (sapply_s(f, x, fuel)).fst
table :: {R : Code, child : Tree -> Val} -> Option(List(Val)) :=> table_via({f, x} => sapply(f, x, derive_fuel), R, child)
is_positive :: Code -> Bool := {R} => not(is_none(table(R, {_} => t)))
canon :: Val -> Val := canon_with(table)
split_depth := 3

// the pieces a value holds
rec pieces_in :: {v : Val} -> List(Val) :=>
	if (v.is_piece) { [v] }
	else if (v.is_app) { (pieces_in(v.app_head)).append(pieces_in(v.app_arg)) }
	else if (v.is_lemma) { pieces_in(v.hole_what.snd.snd.snd) }
	else if ((is_hole(v)) || (is_leaf(v))) { [] }
	else if (is_stem(v)) { pieces_in(stem_child(v)) }
	else { (pieces_in(v.fst)).append(pieces_in(v.snd)) }

// ---------------------------------------------------------------- function types
// a value fits a case when its known shape is the case's and each piece of the case
// takes the subtree there as a member of the piece's type (`at` judges)
rec fits_with :: {at : Tree, c : Val, v : Val} -> Res :=>
	if (c.is_piece) { at(c.piece_type, v) }
	else if (c == v) { "Yes" }
	else if (is_hole(v)) { inspect(v) }
	else if (is_stem(c)) { if (is_stem(v)) { fits_with(at, stem_child(c), stem_child(v)) } else { "No" } }
	else if (if (c.is_fork_shaped) { v.is_fork_shaped } else { false }) { and_yes(fits_with(at, c.fst, v.fst), {_} => fits_with(at, c.snd, v.snd)) }
	else { "No" }
// one Yes is a Yes, all No is a No, otherwise the first that is neither
rec any_fit :: {rs : List(Res)} -> Res :=>
	if (rs.is_nil) { "No" }
	else if (rs.head == "Yes") { "Yes" }
	else {
		let rest := any_fit(rs.tail)
		if (rest == "Yes") { "Yes" } else if (rs.head == "No") { rest } else { rs.head }
	}
// a case split, as the cases it leaves: each alternative of the piece's type in the piece's place (none: no table)
alternatives :: {case : Val, piece : Val} -> Option(List(Val)) :=> {
	let alts := table(piece.piece_type, {step} => piece_at(piece.piece_type, piece.piece_root, cons(step, piece.piece_path)))
	if (is_none(alts)) { none } else { some(alts.snd.map({alt} => subst(piece, alt, case))) }
}
// one that is not a Yes decides: the first of them
all_yes :: {results : List(Res)} -> Res :=> reduce({r, rest} => and_yes(r, {_y} => rest), "Yes", results)
// A program where a function is expected is a member when its run on a fresh piece of the
// domain is a member of the codomain: the loop's generic run and case split, nested. A piece of
// its own that the run needs is split. A need of any other piece is the caller's to split. A No
// counts only with nothing unknown left; while a piece of its own is, that piece is split.
inner_piece :: {dom : Code, f : Val} -> Val :=> piece_at(dom, pair("inner", f), [])
rec fn_member :: {at : Tree, R : Code, f : Val, x : Val, depth : Nat} -> Res :=> {
	let view := fn_view(R).snd
	let face := faces_of(view.fst, x)
	let r := and_then(sapply(f, face.fst, run_fuel), {out} => at(view.snd(face), out))
	let own := pieces_in(x)
	let target := if (r.is_need) { if (own.member(r.snd)) { r.snd } else { "None" } }
		else if (r == "No") { let found := own.filter(is_splittable); if (found.is_nil) { "None" } else { found.head } }
		else { "None" }
	let cases := if ((target == "None") || (is_zero(depth))) { none } else { alternatives(x, target) }
	if ((r == "Yes") || ((r.is_need) && (target == "None"))) { r }
	else if ((r == "No") && ((f.is_known) && (x.is_known))) { "No" }
	else if (is_none(cases)) { stuck_on(pair("a function not settled", f)) }
	else { all_yes(cases.snd.map({c} => fn_member(at, R, f, c, nat_pred(depth)))) }
}
// One former serves plain functions, polymorphism (over a type of types) and dependent types:
// the family takes the argument's faces. A family of types is itself a type-level argument:
// dependent types see it as a function giving a fresh abstract type for each argument, named
// by the stuck application. A family that ignores its argument compiles to K(B), so a plain
// arrow is one code however it was built, which is how stored pairs find it.
fn_admits := {at, self, v} => fn_member(at, self, v, inner_piece(self.snd.applied.snd.fst, v), split_depth)
rec fn_c :: {Dom : Code, fam : Tree} -> Code :=> {
	let level := is_types(fam(faces_of(Dom, generic_of(Dom, "probe"))))
	of_type(behaviour{
		admits := fn_admits,
		applied := some(pair(Dom, fam)),
		remake := {ps} => fn_c(ps.head, ps.tail.head),
		static := if (level) { some({_self, f} => {xs} => static_of(fam(pair(xs, xs)), app_val(f, xs))) } else { none },
		types := level})
}
ArrowC :: {Dom : Code, Cod : Code} -> Code :=> fn_c(Dom, {_face} => Cod)
// The strictly smaller pieces of the input `root` of type Dom, and a partner of one: the
// induction hypothesis's domain.
below_c :: {Dom : Code, root : List(Tree), partner : Tree} -> Code :=> of_type(behaviour{
	parts := [pair("Type", Dom), pair("Datum", root), pair("Datum", partner)],
	admits := {_at, self, v} => if (licensed_with(table, self, v) == "None") { "No" } else { "Yes" }})
// The induction hypothesis: a piece of the function type from the strictly smaller pieces of
// the input `root` (or the `partner` of one: a quotient's hypothesis) to the codomain, which
// may depend on the argument. Its license is the function rule: an argument must be in its domain.
hypothesis_over :: {Dom : Code, fam : Tree, root : List(Tree), partner : Val -> Val} -> Val :=>
	piece_at(fn_c(below_c(Dom, root, partner), fam), "hypothesis", root)
hypothesis :: {Dom : Code, Cod : Code, root : List(Tree), partner : Val -> Val} -> Val :=> hypothesis_over(Dom, {_face} => Cod, root, partner)
apply_ih_at :: {Dom : Code, Cod : Code, root : List(Tree), partner : Val -> Val, x : Val} -> Res :=> sapply(hypothesis(Dom, Cod, root, partner), x, run_fuel)
apply_ih :: {C : Code, root : List(Tree), partner : Val -> Val, x : Val} -> Res :=> apply_ih_at(C, C, root, partner, x)

// ---------------------------------------------------------------- a type's eliminator, used
// `fold_of(T)` is the eliminator of a type with cases. Where it cannot run it is a neutral term
// like any call nobody can run, and it is read by its type like one: the type is the
// eliminator's own statement, with the result type read off the goal.
rec nth :: {xs : List(A), i : Nat} -> A :=> if (is_zero(i)) { xs.head } else { nth(xs.tail, nat_pred(i)) }
fold_table :: {T : Code} -> Option(List(Val)) :=> fold_table_via(table, T)
fold_layer :: {T : Code} -> Option(Tree) :=> fold_layer_via(table, T)
fold_of :: {T : Code} -> Tree :=> fold_with(T, fold_layer(T).snd)
// A type with one value in place of another. A type stuck on values is those values. A type
// built from parts is rebuilt from them: each value with the one in place of the other, each
// type likewise, each family once its argument is in. A type that lists no parts holds no values.
rec type_subst :: {x : Val, y : Val, T : Code} -> Code :=>
	if (is_hole(T)) { subst(x, y, T) }
	else if (if (is_type_code(T)) { is_leaf(T.snd.remake) } else { true }) { T }
	else { T.snd.remake(parts_of(T).map({p} =>
		if (p.fst == "Value") { subst(x, y, p.snd) }
		else if (p.fst == "Type") { type_subst(x, y, p.snd) }
		else if (p.fst == "Family") { let fam := p.snd; {face} => type_subst(x, y, fam(face)) }
		else { p.snd })) }
// A value run again, after one of its holes was given a shape: each application nobody could
// run is tried once more, and stays as it was where it still cannot run.
rec rerun :: {v : Val} -> Val :=>
	if (v.is_known) { v }
	else if (v.is_app) {
		let f := rerun(v.app_head)
		let x := rerun(v.app_arg)
		let r := sapply(if (f.is_elim) { f.elim_fold } else { f }, x, run_fuel)
		if (r.is_answered) { r.answer } else { app_val(f, x) }
	}
	else if ((is_hole(v)) || (is_leaf(v))) { v }
	else if (is_stem(v)) { t(rerun(stem_child(v))) }
	else { t(rerun(v.fst), rerun(v.snd)) }
// What a handler must be, for a case and the result type as a function of what is eliminated:
// a function of the case's pieces, then of one answer per piece of the type itself, each at the
// result type there, into the result type at the case.
rec answers_type :: {P : Val -> Code, below : List(Val), whole : Val} -> Code :=>
	if (below.is_nil) { P(whole) } else { ArrowC(P(below.head), answers_type(P, below.tail, whole)) }
rec handler_type :: {T : Code, P : Val -> Code, whole : Val, todo : List(Val), below : List(Val)} -> Code :=>
	if (todo.is_nil) { answers_type(P, below, whole) }
	else { fn_c(todo.head.piece_type, {face} =>
		handler_type(T, P, subst(todo.head, face.fst, whole), todo.tail, if (todo.head.piece_type == T) { below.append([face.fst]) } else { below })) }
handlers_of :: {T : Code, P : Val -> Code} -> List(Code) :=> fold_table(T).snd.map({c} => handler_type(T, P, c, pieces_in(c), []))
// the rest of an eliminator's type after what is eliminated: one handler per case, then the result
fold_rest :: {T : Code, P : Val -> Code, result : Code} -> Code :=> reduce({h, rest} => ArrowC(h, rest), result, handlers_of(T, P))
// The type an eliminator is read at, for the goal R. One derived from a type T with cases takes a
// member x of T, and then what its statement says (fold_statement, lib/theories/types.disp), with
// the result type at a value being R with that value in place of x: so R may depend on x. One a
// type brings itself (an equation's) takes a value whose own type, which the claim gave, brings
// it, and then what that type says. `typed` gives a neutral term's type.
bringer :: {typed : Val -> Option(Code), f : Tree, e : Val} -> Option(Code) :=> {
	let had := if (e.is_piece) { some(e.piece_type) } else { typed(e) }
	let brings := {T} => if (is_type_code(T)) { if (is_none(T.snd.elim)) { false } else { T.snd.elim.snd.fst == f } } else { false }
	// the type as it stands, or what it computes to
	if (is_none(had)) { none } else if (brings(had.snd)) { had } else if (brings(normal_of(had.snd))) { some(normal_of(had.snd)) } else { none }
}
elim_type :: {typed : Val -> Option(Code), f : Tree, R : Code} -> Code :=>
	if (is_leaf(fold_type(f))) {
		let own := of_type(behaviour{admits := {at, _self, v} =>
			if (is_none(bringer(typed, f, v))) { stuck_on(pair("nothing brings this eliminator", v)) }
			else { at(if (v.is_piece) { v.piece_type } else { typed(v).snd }, v) }})
		fn_c(own, {face} => {
			let S := bringer(typed, f, face.fst)
			if (is_none(S)) { no_type(pair("nothing brings this eliminator", face.fst)) } else { S.snd.snd.elim.snd.snd(normal_of(S.snd), R) }
		})
	}
	else { let T := fold_type(f); fn_c(T, {face} => fold_rest(T, {y} => type_subst(face.fst, y, R), R)) }

// ---------------------------------------------------------------- judging
// Judging a partly-known value at a code. A piece of the code itself is a member. A neutral
// term is a member by the function rule: its head's type leads to the code, and each argument
// is a member of its domain. Tree asks only that nothing coarse is in a fine position. A type
// given by its behaviour is asked. A recognizer takes a value that fits one of its derived
// cases, or is run on it.
// What a dependent type sees of an argument along a neutral term. A type argument is erased:
// a program passes the leaf whatever the type, so a function over types applied to the leaf is
// a member at every type. The leaf is read as `inst`, the type the reader wants (none: as any type).
arg_faces :: {inst : Option(Code), dom : Code, x : Val} -> Pair(Val, Tree) :=>
	if (((is_leaf(x)) && (not(is_none(inst)))) && ((is_types(dom)) && (not(is_fn_code(dom))))) { pair(x, inst.snd) } else { faces_of(dom, x) }
// a neutral term's type: its head piece's, through the codomain at each argument. An eliminator's
// is read off the goal `inst`, so without one it has none.
rec neutral_type :: {inst : Option(Code), v : Val} -> Option(Code) :=>
	if (v.is_elim) { if (is_none(inst)) { none } else { some(elim_type({e} => neutral_type(none, e), v.elim_fold, inst.snd)) } }
	else if (v.is_piece) { some(v.piece_type) }
	else if (not(v.is_app)) { none }
	else {
		let head := neutral_type(inst, v.app_head)
		let view := if (is_none(head)) { none } else { fn_view(head.snd) }
		if (is_none(view)) { none } else { some(view.snd.snd(arg_faces(inst, view.snd.fst, v.app_arg))) }
	}
// every argument along a neutral term's spine is in its domain; `at` judges
rec spine_args :: {inst : Option(Code), at : Tree, v : Val} -> Res :=>
	if (not(v.is_app)) { "Yes" }
	else { and_yes(spine_args(inst, at, v.app_head), {_y} => at(fn_view(neutral_type(inst, v.app_head).snd).snd.fst, v.app_arg)) }
rec judge_as :: {R : Code, val : Val} -> Res :=> {
	let at := {R2, v} => judge_as(R2, v)
	// A neutral term is in R when its type is R and every argument along it is in its domain;
	// outside a domain the head's behaviour is unconstrained, so that is blamed on the head.
	// Where its type is R only with R for an erased type argument, or for an eliminator's
	// result, it is read so. "None": its type is not R. A stuck elimination that is not a
	// member this way waits on what it eliminates: split, the elimination runs one layer on each case.
	let is_R := {ty} => if (is_none(ty)) { false } else { same_type(ty.snd, R) }
	let app_rule := {v} => {
		let inst := if (is_R(neutral_type(none, v))) { none } else { some(R) }
		if (not(is_R(neutral_type(inst, v)))) { "None" }
		else {
			let args := spine_args(inst, at, v)
			if ((args == "Yes") || (args.is_need)) { args }
			else if (if (spine_head(v).is_elim) { waits_on(v).is_splittable } else { false }) { need(waits_on(v)) }
			else if (args == "No") { stuck_on(pair("argument outside the domain", v.app_head)) }
			else { args }
		}
	}
	let neutral := if (val.is_app) { app_rule(val) } else { "None" }
	let opaque := {v} => stuck_on(pair("opaque value", v))
	// the GRADE rule: at Tree (relation tree_eq) a free piece of a coarser code
	// is refused — it may map related inputs to unrelated trees. A neutral term
	// is judged at its codomain (f 0 at Nat -> Nat is a Nat whatever f is), so
	// the argument must be in the domain; any other neutral term is opaque.
	let tree := {v} =>
		if (v.is_known) { "Yes" }
		else if (v.is_piece) { if (is_fine(v.piece_type)) { "Yes" } else { coarse(v) } }
		else if (v.is_app) {
			let head := v.app_head
			let ty := neutral_type(none, v)
			if ((not(is_none(ty))) && (is_fine(ty.snd))) { at(ty.snd, v) }
			else if (head.is_piece) { coarse(head) }
			else { opaque(v) }
		}
		else if (is_hole(v)) { opaque(v) }
		else if (is_stem(v)) { at(TreeR, stem_child(v)) }
		else { and_yes(at(TreeR, v.fst), {_} => at(TreeR, v.snd)) }
	// A recognizer: a value must fit one of its derived cases, each piece a member of its type.
	// Deriving the cases showed the recognizer stops on every tree, so a known tree runs it
	// directly. Without cases it runs on the value, fueled.
	let ran := {v} => and_then(sapply(R, v, run_fuel), {b} =>
		if (b == true) { "Yes" } else if (b == false) { "No" } else { stuck_on(pair("recognizer answered no Bool", b)) })
	let recognized := {v} => {
		let cases := table(R, {step} => piece(TreeR, [step]))
		if (v.is_app) { if (neutral == "None") { opaque(v) } else { neutral } }
		else if (is_none(cases)) { and_yes(tree(v), {_} => ran(v)) }
		else if (v.is_known) { if (R(v) == true) { "Yes" } else { "No" } }
		else { any_fit(cases.snd.map({c} => fits_with(at, c, v))) }
	}
	if (if (val.is_piece) { same_type(val.piece_type, R) } else { false }) { "Yes" }
	else if (neutral == "Yes") { "Yes" }
	else if (if (neutral == "None") { false } else { spine_head(val).is_elim }) { neutral }
	else if (R == TreeR) { tree(val) }
	else if (is_type_code(R)) { R.snd.admits(at, R, val) }
	else { recognized(val) }
}
judge_nat :: Val -> Res := judge_as(NatR)
judge_bool :: Val -> Res := judge_as(Bool)
judge_tree :: Val -> Res := judge_as(TreeR)

same_val :: {a : Val, b : Val} -> Res :=> if (a == b) { "Yes" } else { "No" }
// equal AT a code: both sides members first, then the same term
member_same :: {Cod : Code, a : Val, b : Val} -> Res :=>
	and_yes(judge_as(Cod, a), {_} => and_yes(judge_as(Cod, b), {_} => same_val(a, b)))

// ---------------------------------------------------------------- the loop
// One loop settles every claim, case by case. A case is a partly-known input, and the work
// list starts from cases that between them cover every input. Each case is settled by the
// first of these that applies:
//   generic run  the check answers Yes on the case: one run answers for every tree the case
//                covers. The Yes says what it rests on besides the run: the hypothesis where
//                the run applied it (induction), a lemma where it read a call by its type.
//   refutation   a known case that fails is a counterexample; when unknowns remain,
//                `instances` are fully concrete inputs the case stands for, re-run for one.
//   lemmas       a later check answers Yes: the same run with more of the program read by its
//                type. A later check never refutes, and where it needs a piece that is the
//                piece to split.
//   case split   the run needed a piece's shape (or, after a symbolic No, "the terms differ",
//                the first splittable piece): the case splits along the piece's cases.
// A case none settles is noted with the reason its run stopped, and the claim stays Open. A
// stuck run, a need of a piece without a table, and a coarse piece never split.
// a Yes that says what it rests on
yes_on :: {grounds : List(Tree)} -> Res :=> pair("Yes", grounds)
is_yes :: Res -> Bool := {r} => (r == "Yes") || (r.fst == "Yes")
grounds_of :: Res -> List(Tree) := {r} => if (r == "Yes") { [] } else { r.snd }
// what an answer rests on besides the run: induction where it applies the hypothesis, a lemma where it applies one's type, elimination where it applies an eliminator's
cited :: {out : Val} -> List(Tree) :=> {
	let roots := pieces_in(out).map(piece_root)
	[pair("hypothesis", "induction"), pair("lemma", "lemma"), pair("elim", "elimination")].filter({rule} => roots.member(rule.fst)).map(pair_snd)
}
// a case is done, resting on these
settled_on :: {grounds : List(Tree)} -> Outcome(Tree, Pair(Val, Nat)) :=> pair("Skip", grounds)
split_target :: {r : Res, input : Val} -> Val :=>
	if ((r.is_need) && (r.snd.is_splittable)) { r.snd }
	else if (r == "No") { let found := (pieces_in(input)).filter(is_splittable); if (found.is_nil) { "None" } else { found.head } }
	else { "None" }
// what stopped a run: the reason an Open reports
explain :: Res -> Tree := {r} =>
	if (r.is_need) { pair("no split table", r.snd) }
	else if (r.fst == "Stuck") { r.snd }
	else if (r.fst == "Coarse") { pair("coarse symbol at fine position", r.snd) }
	else { r }
why :: Verdict -> Tree := {v} => if (v.fst == "Open") { v.snd } else { "not open" }
// what the later checks add to the first run's answer: a Yes, or a better piece to split
rec weigh :: {later : List(Val -> Res), input : Val, r : Res} -> Res :=>
	if (later.is_nil) { r }
	else {
		let r2 := later.head(input)
		if (is_yes(r2)) { r2 } else { weigh(later.tail, input, if (r2.is_need) { r2 } else { r }) }
	}
// `checks` are the exact check, then any that read more by type. `ground` reads a case as a
// concrete counterexample: some(tree), or none while unknowns that matter remain. An item is
// a case and the splits left for it; a Step is an item with what settled it.
settle_case :: {checks : List(Val -> Res), ground : Val -> Option(Tree), instances : Val -> List(Val), item : Pair(Val, Nat)} -> Outcome(Tree, Pair(Val, Nat)) :=> {
	let input := item.fst
	let exact := checks.head
	let r := exact(input)
	if (is_yes(r)) { settled_on(grounds_of(r)) }
	else {
		let g := ground(input)
		let bad := if (if (is_none(g)) { true } else { not(r == "No") }) { instances(input).filter({i} => exact(i) == "No") } else { [] }
		if (if (is_none(g)) { false } else { r == "No" }) { yield(g.snd) }
		else if (not(bad.is_nil)) { yield(ground(bad.head).snd) }
		else {
			let r2 := weigh(checks.tail, input, r)
			let target := if (is_none(g)) { split_target(r2, input) } else { "None" }
			if (is_yes(r2)) { settled_on(grounds_of(r2)) }
			else if (target == "None") { noted(explain(r2)) }
			else if (is_zero(item.snd)) { noted("split depth exhausted") }
			else {
				let cases := alternatives(input, target)
				if (is_none(cases)) { noted(pair("no split table", target)) }
				else { split_on(target, cases.snd.map({c} => pair(c, nat_pred(item.snd)))) }
			}
		}
	}
}
// the work list of a claim: every case with what settled it
search_steps :: {checks : List(Val -> Res), ground : Val -> Option(Tree), instances : Val -> List(Val), start : List(Pair(Val, Nat))} -> Items(Step) :=>
	s_steps(settle_case(checks, ground, instances), start)
// the verdict of a work list: the first counterexample refutes; every case settled proves; else Open on the first note
steps_verdict :: {steps : Items(Step)} -> Verdict :=>
	verdict(s_yielded(steps))
search_g :: {checks : List(Val -> Res), ground : Val -> Option(Tree), instances : Val -> List(Val), input : Val, depth : Nat} -> Verdict :=>
	steps_verdict(search_steps(checks, ground, instances, [pair(input, depth)]))
known_ground :: Val -> Option(Tree) := {v} => if (v.is_known) { some(v) } else { none }
search_r :: {check : Val -> Res, input : Val, depth : Nat} -> Verdict :=> search_g([check], known_ground, {_} => [], input, depth)
search :: {check : Val -> Res, input : Val, depth : Nat} -> Verdict :=> flat(search_r(check, input, depth))

run :: {fn : Tree, input : Val} -> Res :=> sapply(escape(fn), input, run_fuel)
// the Nat input at level k of the split: succ^k of the piece k predecessor steps down (tests)
rec sym_at :: {k : Nat, path : List(Tree)} -> Val :=>
	if (is_zero(k)) { piece(NatR, path) } else { t(t, sym_at(nat_pred(k), cons("right", path))) }

// ---------------------------------------------------------------- the store
// Certified pairs: related at a negative code, both members, distinct as
// trees. (id, shift) at Nat -> Nat is certified below by eq_arrow_at itself.
store_pairs := [pair(ArrowC(NatR, NatR), pair(id, shift))]
pairs_at :: Code -> List(Pair(Tree, Tree)) := {code} => store_pairs.filter({e} => e.fst == code).map(pair_snd)
// the negative input piece an Open reason names, if any (every reason is
// pair tag value; grounding is sound whatever the tag)
reason_sym :: Tree -> Val := {reason} =>
	if ((reason.snd.is_piece) && (not(is_positive(reason.snd.piece_type)))) { reason.snd } else { "None" }
// GROUNDING: an Open blamed on a negative piece is tried on every stored pair
// at its code, concretely: a non-member output refutes with that member; two
// outputs unrelated at a fine codomain refute with the pair; else it stays Open
ground :: {Cod : Code, left : Tree -> Res, right : Tree -> Res, verdict : Verdict} -> Verdict :=> {
	let s := if (verdict.fst == "Open") { reason_sym(verdict.snd) } else { "None" }
	let try := {p} => {
		let la := left(p.fst)
		let rb := right(p.snd)
		if (not(((la.is_answered) && (la.answer.is_known)) && ((rb.is_answered) && (rb.answer.is_known)))) { verdict }
		else if (judge_as(Cod, la.answer) == "No") { refuted(p.fst) }
		else if (judge_as(Cod, rb.answer) == "No") { refuted(p.snd) }
		else if ((is_fine(Cod)) && (not(la.answer == rb.answer))) { refuted(p) }
		else { verdict }
	}
	let refutations := if (s == "None") { [] } else { (pairs_at(s.piece_type)).map(try).filter(is_refuted) }
	if (refutations.is_nil) { verdict } else { refutations.head }
}

// ---------------------------------------------------------------- quotient respect
// Membership at Quotient Nat nf is RESPECT: for every a, f a ~_Cod f (nf a),
// by induction on a. The hypothesis at a strictly smaller piece k names f k and
// f (nf k) by ONE application: running nf on k answers the neutral term App nf [k]
// (the evaluator's normalizer rule), and the hypothesis's partner peels it.
// The fixpoint on a neutral term is judged by the hypothesis alone (unrolling
// the step would inspect the neutral); on anything else one layer of the step
// runs. The witness pairs the class representative with the member: (nf a, a).
respects_nf :: {step_fn : Tree, nf : Tree, Cod : Code} -> Verdict :=> {
	let ih := hypothesis(NatR, Cod, [], {a} => app_val(nf, a))
	let fix_apply := {with_ih, a} => if (a.is_app) { sapply(ih, a, run_fuel) } else { sapply(with_ih, a, run_fuel) }
	let both := {with_ih, a} =>
		and_then(fix_apply(with_ih, a), {r1} =>
			and_then(sapply(nf, a, run_fuel), {a2} =>
				and_then(fix_apply(with_ih, a2), {r2} => member_same(Cod, r1, r2))))
	let verdict := search({a} =>
		if (a.is_known) { both(escape(fix(step_fn)), a) }
		else { and_then(run(step_fn, ih), {with_ih} => both(with_ih, a)) }
	, piece(NatR, []), split_depth)
	if (verdict.is_refuted) { refuted(pair(nf(verdict.snd), verdict.snd)) } else { verdict }
}

// ---------------------------------------------------------------- the checks
check_arrow_r :: {Dom : Code, Cod : Code, fn : Tree} -> Verdict :=>
	ground(Cod, {a} => run(fn, a), {b} => run(fn, b),
		search_r({input} => and_then(run(fn, input), judge_as(Cod)), piece(Dom, []), split_depth))
// membership at a quotient domain IS respect (of the normalizer)
check_arrow :: {Dom : Code, Cod : Code, fn : Tree} -> Verdict :=>
	if (is_quot_code(Dom)) { respects_nf({_self, x} => fn(x), quot_nf(Dom), Cod) } else { flat(check_arrow_r(Dom, Cod, fn)) }
check_by_structure :: {fn : Tree} -> Verdict :=> check_arrow(NatR, NatR, fn)

// base = the ground inputs (the real fixpoint); step = ONE layer of the step
// function with its recursion bound to the induction hypothesis
plain_ih := hypothesis(NatR, NatR, [], same)
step_with_ih :: {step_fn : Tree, input : Val} -> Res :=>
	and_then(run(step_fn, plain_ih), {with_ih} => sapply(with_ih, input, run_fuel))
check_by_induction :: {step_fn : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run(fix(step_fn), input), judge_nat) }
		else { and_then(step_with_ih(step_fn, input), judge_nat) }
	, piece(NatR, []), split_depth)

// equality by symbolic normal form: both run on the SAME named piece, both
// outputs are judged at the codomain, and the result terms are compared;
// syntactically equal terms over pieces agree on every instantiation
eq_arrow_at :: {Dom : Code, Cod : Code, fn : Tree, gn : Tree} -> Verdict :=>
	flat(ground(Cod, {a} => run(fn, a), {b} => run(gn, b),
		search_r({input} => and_then(run(fn, input), {a} => and_then(run(gn, input), {b} => member_same(Cod, a, b))), piece(Dom, []), split_depth)))
eq_arrow :: {Dom : Code, fn : Tree, gn : Tree} -> Verdict :=> eq_arrow_at(Dom, Dom, fn, gn)
eq_by_symbol :: {fn : Tree, gn : Tree} -> Verdict :=> eq_arrow(NatR, fn, gn)
// the shared hypothesis names both recursive calls by one application: that IS the claim
// "the recursive calls agree on the strict smaller piece"
eq_by_induction :: {step_f : Tree, step_g : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run(fix(step_f), input), {a} => and_then(run(fix(step_g), input), {b} => member_same(NatR, a, b))) }
		else { and_then(step_with_ih(step_f, input), {a} => and_then(step_with_ih(step_g, input), {b} => member_same(NatR, a, b))) }
	, piece(NatR, []), split_depth)

// a curried claim f : A -> B -> C: two roots (ids 0 and 1), the input is
// their pair — distinct names, so a split of one leaves the other alone
two_roots :: {A : Code, B : Code} -> Val :=> pair(piece_at(A, 0, []), piece_at(B, 1, []))
run2 :: {fn : Tree, input : Val} -> Res :=> and_then(run(fn, input.fst), {fa} => sapply(fa, input.snd, run_fuel))
check_arrow2 :: {A : Code, B : Code, Cod : Code, fn : Tree} -> Verdict :=>
	search({input} => and_then(run2(fn, input), judge_as(Cod)), two_roots(A, B), split_depth)
// induction on the FIRST root of a curried fix: the hypothesis at k below
// root 0 is the FUNCTION f k : B -> C; applied to the second root it is the
// neutral term App (f k) [b], judged at C by the arrow rule
curried_ih :: {B : Code, Cod : Code} -> Val :=> hypothesis(NatR, ArrowC(B, Cod), [], same)
check_by_induction2 :: {B : Code, Cod : Code, step_fn : Tree} -> Verdict :=>
	search({input} =>
		if (input.is_known) { and_then(run2(fix(step_fn), input), judge_as(Cod)) }
		else { and_then(run(step_fn, curried_ih(B, Cod)), {w} => and_then(sapply(w, input.fst, run_fuel), {wa} => and_then(sapply(wa, input.snd, run_fuel), judge_as(Cod)))) }
	, two_roots(NatR, B), split_depth)

// ---------------------------------------------------------------- streams
// An item stream is a coalgebra (lib/stream.disp) whose stepper answers
// finished ending | running (emit drawn next), where drawn is `yield item` or
// `skip`. Bisimulation up to a user-supplied relation between
// the two state spaces, given as a PATTERN pair over one variable:
// R = { (l x, r x) } for rel := {x} => pair (l x) (r x); equal states is
// same_states. Strong: a skip is a step and must meet a skip. The coinductive
// hypothesis is `related` on the NEXT states — usable only after both sides
// took one step — and it is discharged by matching, never assumed on the
// current states beyond what sharing the piece x gives.
related :: {rel : Val -> Pair(Val, Val), a : Val, b : Val} -> Res :=> {
	let pat := rel(pattern_piece("x"))
	and_then(match_val(pat.fst, a, []), {env} => and_then(match_val(pat.snd, b, env), {_env} => "Yes"))
}
same_states := {x} => pair(x, x)

tag_of :: {v : Val} -> Res :=>
	if (v.is_splittable) { need(v) }
	else if (not(v.is_fork_shaped)) { stuck }
	else if (v.fst.is_splittable) { need(v.fst) }
	else { answered(v.fst) }
step_shape :: {st : Val} -> Res :=> and_then(tag_of(st), {tag} =>
	if (tag == "Finished") { "done" }
	else if (not(tag == "Running")) { stuck }
	else { and_then(tag_of(st.step_draw), {draw_tag} =>
		if (draw_tag == "Yield") { "yield" } else if (draw_tag == "Skip") { "skip" } else { stuck }) })
is_shape :: Res -> Bool := {r} => ((r == "done") || (r == "yield")) || (r == "skip")
// one step of both streams: same shape, same item (as terms), next states related.
// "NotBisim" is NOT a counterexample (the relation may just be the wrong one)
bisim_step :: {rel : Val -> Pair(Val, Val), st1 : Val, st2 : Val} -> Res :=> {
	let sh1 := step_shape(st1)
	let sh2 := step_shape(st2)
	if (not(is_shape(sh1))) { sh1 }
	else if (not(is_shape(sh2))) { sh2 }
	else if (not(sh1 == sh2)) { "NotBisim" }
	else if (sh1 == "done") { if (st1.finished_result == st2.finished_result) { "Yes" } else { "NotBisim" } }
	else if (sh1 == "skip") { related(rel, st1.step_rest, st2.step_rest) }
	else if (st1.step_draw.yielded_item == st2.step_draw.yielded_item) { related(rel, st1.step_rest, st2.step_rest) }
	else { "NotBisim" }
}
// the first `draws` observations of a stream from a ground state, every step
// fueled; skips are observed too (strong), so differing prefixes are a
// genuine concrete difference — the only source of Refuted for streams
rec observe :: {stream : Tree, state : Val, draws : Nat} -> Res :=>
	if (is_zero(draws)) { answered([]) }
	else {
		and_then(run(stream.c_stepper, state), {step} => {
			let sh := step_shape(step)
			if (not(is_shape(sh))) { sh }
			else if (sh == "done") { answered(["done"]) }
			else {
				let seen := if (sh == "skip") { "skip" } else { step.step_draw.yielded_item }
				and_then(observe(stream, step.step_rest, nat_pred(draws)), {rest} => answered(cons(seen, rest)))
			}
		})
	}
observe_draws := 4
stream_eq :: {St : Code, rel : Val -> Pair(Val, Val), s1 : Tree, s2 : Tree} -> Verdict :=> {
	let o1 := observe(s1, escape(s1.c_state), observe_draws)
	let o2 := observe(s2, escape(s2.c_state), observe_draws)
	if (not((o1.is_answered) && (o2.is_answered))) { "Open" }
	else if (not(o1.answer == o2.answer)) { refuted(pair(o1.answer, o2.answer)) }
	else if (not(related(rel, escape(s1.c_state), escape(s2.c_state)) == "Yes")) { "Open" }
	else {
		search({x} => {
			let states := rel(x)
			and_then(run(s1.c_stepper, states.fst), {st1} => and_then(run(s2.c_stepper, states.snd), {st2} => bisim_step(rel, st1, st2)))
		}, piece(St, []), split_depth)
	}
}
