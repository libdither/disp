// End-to-end auto-verification tests for `std_stream.disp` (core coalgebras, budgets, consumers, verdicts).
open use "prelude.disp"
let SS := use "std_stream.disp"

let s1 := SS.ck_s_from_list([1, 2, 3])
test SS.ck_s_items(SS.ck_s_take(s1, 2)) = [1, 2]
test SS.ck_s_list(SS.ck_s_map(s1, succ)) = [2, 3, 4]
test SS.ck_s_all(s1, is_succ) = true
test SS.ck_s_ending(s1) = SS.ck_exhausted
test SS.ck_verdict(SS.ck_s_from_list([])) = "Proved"
test SS.ck_verdict(SS.ck_s_from_list([9])) = pair("Refuted", 9)
test SS.ck_s_items(SS.ck_s_take(SS.ck_as_items(SS.ck_nats), 3)) = [0, 1, 2]
