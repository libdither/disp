// Types for the theories. A first-order type (numbers, data, lists, anything a program can
// test) is a recognizer, and its cases are derived by running it, so it adds no trusted
// code. The formers that are not first-order are behaviour records (lib/confirm.disp), each
// proved by hand once: the universe and its abstract types, functions (fn_c, there), dependent
// pairs and equality. Judging a value at a type is `judge` (lib/rules.disp). A type has two faces as
// an argument: programs receive the leaf for a type, dependent types receive the type itself.
open use raw "base.disp" {}

rec positions_from :: {i : Nat, xs : List(A)} -> List(Nat) :=> if (xs.is_nil) { [] } else { cons(i, positions_from(succ(i), xs.tail)) }
positions :: {xs : List(A)} -> List(Nat) :=> positions_from(zero, xs)

nat_t := NatR
bool_t := Bool
tree_t := TreeR
empty_t := FalseR
anything_t := of_type(behaviour{admits := {_at, _self, _v} => "Yes"})
// a known value is in or out; anything else is a piece to split, or opaque
known_or := {v, answer} => if (v.is_known) { answer(v) } else { inspect(v) }
// a value whose shape is settled and wrong is out; a piece or a neutral term is not yet known
not_pair := {v} => if ((v.is_piece) || (v.is_app)) { inspect(v) } else { "No" }

// the abstract type with this name: its members are pieces no program can make up or look
// inside, so a program that answers at it with a value of its own is caught. Re-run on real
// values, a member stands in as one fixed tree.
abstract_t :: {name : Tree} -> Code :=> of_type(behaviour{
	admits := {_at, _self, v} => known_or(v, {_x} => "No"),
	sample := some({_self, _p, k} => nth(stand_ins, k))})
// the type whose one member is c: a recognizer, so its case is derived
singleton_t :: {c : Tree} -> Code :=> {y} => y == c
// A universe: its lens sends a type to two faces. A program receives the leaf; dependent types
// receive the type. A piece of it is a type argument: a program that looks at it cannot be
// settled, and dependent types see a fresh abstract type named by it, so a stuck application
// carrying it still knows its type. Re-run on real values, it stands in as a type of one member.
universe_t :: Code := of_type(behaviour{
	admits := {_at, _self, v} => if (is_leaf(v)) { "Yes" } else { not_pair(v) },
	static := some({_self, v} => if (v.is_piece) { abstract_t(v.piece_name) } else if (is_leaf(v)) { anything_t } else { v }),
	program := some({_self, v} => if (v.is_piece) { v } else { t }),
	types := true,
	sample := some({_self, _p, k} => singleton_t(nth(stand_ins, k)))})

// A dependent function type is fn_c (lib/confirm.disp): one former for plain functions,
// polymorphism (over a universe) and dependent types.
pi_t := fn_c
arrow_t :: {a : Code, b : Code} -> Code :=> pi_t(a, {_x} => b)
forall_t :: {fam : Tree} -> Code :=> pi_t(universe_t, fam)

// a dependent pair: the first half at the first type, the second at the type it picks
rec sigma_t :: {a : Code, fam : Tree} -> Code :=> of_type(behaviour{
	parts := [pair("Type", a), pair("Family", fam)],
	remake := {ps} => sigma_t(ps.head, ps.tail.head),
	admits := {at, _self, v} =>
		if (not(v.is_fork_shaped)) { not_pair(v) }
		else { and_yes(at(a, v.fst), {_y} => at(fam(pair(v.fst, v.fst)), v.snd)) }})

// ---- equality
// An equation is at a type, and the type says what equal means there. At a function type the
// two sides are equal on every argument, so the equation is a function type itself. At a
// quotient their normal forms are equal. At any other type they are the same tree, so the
// equation computes by shape. Where both sides are known they must agree. What is left is the
// places where a side is unknown, each a pair of subtrees that must be equal: none left is
// true, a clash is false, and otherwise the equation is stuck on those places, and its only
// members are the pieces of an equation stuck on the same places (a hypothesis). So equal
// successors are equal numbers by computing, with no rule about numbers. The witness does not
// matter. An equation holds its two sides as programs of the variables they mention, the
// newest first, and runs them when it is asked.
rec places :: {a : Val, b : Val} -> Option(List(Pair(Val, Val))) :=>
	if (a == b) { some([]) }
	else if ((is_hole(a)) || (is_hole(b))) { some([pair(a, b)]) }
	else if (is_leaf(a)) { none }
	else if (is_stem(a)) { if (is_stem(b)) { places(stem_child(a), stem_child(b)) } else { none } }
	else if (is_fork(b)) {
		let l := places(a.fst, b.fst)
		let r := places(a.snd, b.snd)
		if ((is_none(l)) || (is_none(r))) { none } else { some(l.snd.append(r.snd)) }
	}
	else { none }
// a value applied to its variables, the outermost first
run_on :: {env : List(Pair(Val, Tree)), f : Val} -> Res :=> reduce({face, r} => and_then(r, {g} => sapply(g, face.fst, run_fuel)), answered(f), env)
// An equation's eliminator: `cast(e, d)` is d, used at a type where the equation e has been
// applied. With e known it runs. With e unknown (a hypothesis, or a call read by its type) it
// is a call read by its type like any other (elim_type, lib/confirm.disp), and the equation
// says what d must be: a member of the goal rewritten by e.
cast := fold_with(t, {_me, _e, d} => d)
stuck_waits := {_at, self, _v} => {
	let waits := self.snd.parts.head.snd.map({p} => inspect(if (is_hole(p.fst)) { p.fst } else { p.snd }))
	if (waits.filter(is_need).is_nil) { waits.head } else { waits.filter(is_need).head }
}
places_of :: {T : Code} -> Option(List(Pair(Val, Val))) :=> if ((is_type_code(T)) && (T.snd.admits == stuck_waits)) { some(T.snd.parts.head.snd) } else { none }
rec all_places :: {found : List(Option(List(Pair(Val, Val))))} -> Option(List(Pair(Val, Val))) :=>
	if (found.is_nil) { some([]) }
	else if (is_none(found.head)) { none }
	else { let rest := all_places(found.tail); if (is_none(rest)) { none } else { some(found.head.snd.append(rest.snd)) } }
// The rest of cast's type, for the equation S of what it is given and the goal R: d at R
// rewritten by S, into R. Rewriting puts the second side of each place of S for the first, in
// the goal as it computes. The first is put for the second instead where that finishes the
// goal, or where the other way changes nothing. A false equation asks nothing of d, and a true
// one changes nothing.
eq_rest := {S, R} => {
	let have := places_of(S)
	let by := {turn} => reduce({p, G} => type_subst(turn(p).fst, turn(p).snd, G), normal_of(R), have.snd)
	let back := {p} => pair(p.snd, p.fst)
	ArrowC(if (S == empty_t) { anything_t }
		else if (is_none(have)) { R }
		else if (normal_of(by(back)) == anything_t) { anything_t }
		else if (by(same) == normal_of(R)) { by(back) }
		else { by(same) }, R)
}
// an equation stuck on places; with a value put for another, each side runs again and the places are compared again
rec stuck_eq :: {ps : List(Pair(Val, Val))} -> Code :=> of_type(behaviour{parts := [pair("Value", ps)], admits := stuck_waits, elim := some(pair(cast, eq_rest)),
	remake := {parts} => {
		let now := all_places(parts.head.map({p} => places(rerun(p.fst), rerun(p.snd))))
		if (is_none(now)) { empty_t } else if (now.snd.is_nil) { anything_t } else { stuck_eq(now.snd) }
	}})
// an equation's two sides: each program run on the variables, then through the normalizers of the quotients it is at, the outermost first
eq_sides :: {self : Code} -> Res :=> {
	let ps := self.snd.parts.map(pair_snd)
	let side := {f} => reduce({nf, r} => and_then(r, {a} => sapply(nf, a, run_fuel)), run_on(ps.head, f), ps.tail.tail.tail.head)
	and_then(side(ps.tail.head), {a} => and_then(side(ps.tail.tail.head), {b} => answered(pair(a, b))))
}
eq_normal :: {self : Code} -> Code :=> {
	let s := eq_sides(self)
	let ps := if (s.is_answered) { places(s.answer.fst, s.answer.snd) } else { none }
	if (not(s.is_answered)) { self } else if (is_none(ps)) { empty_t } else if (ps.snd.is_nil) { anything_t } else { stuck_eq(ps.snd) }
}
// the same tree, after the normalizers `via`
rec eq_tree :: {env : List(Pair(Val, Tree)), left : Val, right : Val, via : List(Tree)} -> Code :=> of_type(behaviour{
	parts := [pair("Value", env), pair("Value", left), pair("Value", right), pair("Datum", via)],
	remake := {ps} => eq_tree(ps.head, ps.tail.head, ps.tail.tail.head, ps.tail.tail.tail.head),
	normal := some(eq_normal),
	elim := some(pair(cast, eq_rest)),
	admits := {at, self, v} => { let s := eq_sides(self); if (s.is_answered) { at(eq_normal(self), v) } else { s } }})
rec eq_over :: {A : Code, env : List(Pair(Val, Tree)), left : Val, right : Val, via : List(Tree)} -> Code :=> {
	let N := normal_of(A)
	if (if (is_fn_code(N)) { via.is_nil } else { false }) { let view := fn_view(N).snd; fn_c(view.fst, {face} => eq_over(view.snd(face), cons(face, env), left, right, via)) }
	else if (is_quot_code(N)) { eq_over(quot_base(N), env, left, right, cons(quot_nf(N), via)) }
	else { eq_tree(env, left, right, via) }
}
eq_at :: {A : Code, env : List(Pair(Val, Tree)), left : Val, right : Val} -> Code :=> eq_over(A, env, left, right, [])
eq_t :: {env : List(Pair(Val, Tree)), left : Val, right : Val} -> Code :=> eq_tree(env, left, right, [])
eq_of :: {x : Val, y : Val} -> Code :=> eq_t([], x, y)
// A family that looks at its argument runs on it like any program. A type it picks without
// looking is that type. Otherwise the type holds the argument and picks when it is asked, and
// where it cannot pick it waits, asking for the piece it needed to be split.
picked :: {self : Code} -> Res :=> sapply(self.snd.parts.tail.head.snd, self.snd.parts.head.snd.snd, run_fuel)
rec by_value :: {face : Pair(Val, Tree), pick : Tree -> Code} -> Code :=> {
	let r := sapply(pick, face.snd, run_fuel)
	if ((r.is_answered) && (r.answer.is_known)) { r.answer }
	else { of_type(behaviour{parts := [pair("Value", face), pair("Datum", pick)],
		remake := {ps} => by_value(ps.head, ps.tail.head),
		normal := some({self} => { let now := picked(self); if ((now.is_answered) && (not(is_hole(now.answer)))) { normal_of(now.answer) } else { self } }),
		admits := {at, self, v} => {
			let now := picked(self)
			if (not(now.is_answered)) { now } else if (is_hole(now.answer)) { stuck_on(pair("family answered no type", now.answer)) } else { at(now.answer, v) }
		}}) }
}

// Data are first-order: a data type is a recognizer, written as a program, and its cases
// are derived from it like any recognizer's. Data may also hold a type whose members are
// stood in for, an abstract type or the universe: no known tree is a member of an abstract
// type, and a derived case holds a piece of it. Any other type inside data is opaque: nothing
// is judged a member.
first_order :: Code -> Bool := {c} => (c == TreeR) || (is_recognizer(c))
holdable :: Code -> Bool := {c} => (first_order(c)) || (has_sample(c))
opaque_t := of_type(behaviour{admits := {_at, _self, v} => stuck_on(pair("a type that is not first-order inside data", v))})
// a data type: a member is a constructor's index paired with its arguments' list; "Rec" stands
// for the type itself. The recognizer is built once from the description, a test per argument
// and per constructor, so running it walks no description.
rec args_test :: {kinds : List(Tree)} -> Tree :=>
	if (kinds.is_nil) { {_self, v} => is_leaf(v) }
	else {
		let here := if (kinds.head == "Rec") { {self} => self } else { {_self} => is_a(kinds.head) }
		let rest := args_test(kinds.tail)
		{self, v} => if (is_fork(v)) { if (here(self)(v.fst)) { rest(self, v.snd) } else { false } } else { false }
	}
// the tag is a number below the constructor count, read off as the tests are walked
rec ctor_test :: {shapes : List(List(Tree))} -> Tree :=>
	if (shapes.is_nil) { {_self, _tag, _args} => false }
	else {
		let here := args_test(shapes.head)
		let rest := ctor_test(shapes.tail)
		{self, tag, args} => if (is_leaf(tag)) { here(self, args) } else if (is_fork(tag)) { if (is_leaf(tag.fst)) { rest(self, tag.snd, args) } else { false } } else { false }
	}
data_t :: {shapes : List(List(Tree))} -> Code :=>
	if (not(shapes.all({kinds} => kinds.all({k} => (k == "Rec") || (holdable(k)))))) { opaque_t }
	else { let test := ctor_test(shapes); fix({self, v} => if (is_fork(v)) { test(self, v.fst, v.snd) } else { false }) }
// lists as lib/list.disp builds them: the leaf, or a pair of an item and a list
list_t :: {a : Code} -> Code :=>
	if (not(holdable(a))) { opaque_t }
	else { fix({self, v} => if (is_leaf(v)) { true } else if (is_fork(v)) { if (is_a(a)(v.fst)) { self(v.snd) } else { false } } else { false }) }

// ---- eliminators
// A type with cases comes with its eliminator, `fold_of(T)` (lib/confirm.disp): it is derived
// from the type's cases, so nothing is given beside the type, and `judge` reads a use of it by
// the eliminator's own type, at a result type that may depend on what is eliminated. The same
// layer run as an ordinary recursive program is Proved at that type by case split and
// induction alone (types.test.disp), which is the check that it says no more than those two
// steps do.
nat_fold := fold_of(nat_t)
plain_fold :: {T : Code} -> Tree :=> fix(fold_layer(T).snd)
// The statement of a type's eliminator: for a result type p over the type and a member x, one
// handler per case and then a member of p at x. A stuck elimination is read at this type with
// p read off the goal (elim_type, lib/confirm.disp).
fold_statement :: {T : Code} -> Code :=> pi_t(arrow_t(T, universe_t), {p} => pi_t(T, {x} => fold_rest(T, p.snd, p.snd(x.snd))))

run_budget := 4000
returns := {f, x} => m_advance(m_start(f, x), run_budget)
