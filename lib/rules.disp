// The floor: the rule lenses every certified verdict stands on. A symbolic claim answers
// on cases (partly-known values, lib/confirm.disp), an honest claim on trees, and each rule
// is a lens from the first into the second. A rule's law is a claim over every tree: search
// can refute a wrong one but never prove a right one, so the three atoms are proved by hand
// once (research/LOB_AND_CURRY.md §5.4), and a verdict built from them is sound by composition.
//   case split     (atom) a tree is a leaf, a stem or a fork; a member goes back to its case
//   generic run    (atom) a run on a case answers for every tree the case covers
//   induction      (atom) the hypothesis is asked only at the strictly smaller pieces of a member
//   finite cover   `over` (lib/claim.disp): a claim checked on every listed challenge
//   composition    `lens_then` (lib/claim.disp)
// A first-order type is a recognizer, and is itself such a lens: its cases are derived by
// running it (lib/confirm.disp), so its laws follow from the atoms and no type adds trusted
// code. `judge` decides a value at a type with these alone.
open use raw "prelude.disp" {}
open use raw "list.disp" {}
open use raw "verdict.disp" {}
open use raw "stream.disp" {}
open use raw "claim.disp" {}
open use raw "trees.disp" {}
open use raw "tests/fixtures.disp" {}
open use raw "confirm.disp" {}

// search every tree, smallest first: the honest claim's challenges
by_search := honest(Trees.as_items)

// ---- case split
// a case covers a tree when its shape is the tree's and each piece's type admits the subtree there
rec covers :: {case : Val, x : Tree} -> Bool :=>
	if (case == x) { true }
	else if (case.is_piece) { judge_as(case.piece_type, x) == "Yes" }
	else if ((is_hole(case)) || (is_leaf(case))) { false }
	else if (is_stem(case)) { if (is_stem(x)) { covers(stem_child(case), stem_child(x)) } else { false } }
	else if (is_fork(x)) { if (covers(case.fst, x.fst)) { covers(case.snd, x.snd) } else { false } }
	else { false }
// a type's cases, each piece named by the step that reaches it
cases_of :: {T : Code} -> List(Val) :=> table(T, {step} => piece(T, [step])).snd
// a member goes back to its case; a non-member to none, and nothing is asked of it
case_of :: {T : Code, x : Tree} -> Val :=> {
	let found := cases_of(T).filter({c} => covers(c, x))
	if (found.is_nil) { none } else { found.head }
}
split_lens :: {T : Code} -> Lens :=> lens({w} => w, {_w, x} => case_of(T, x))
// each type with cases owes this law: its cases cover every member
cover_law :: {T : Code} -> Claim :=> {_w, x} => if (judge_as(T, escape(x)) == "Yes") { not(case_of(T, escape(x)) == none) } else { true }
// and a recognizer's derived cases owe the converse: a tree a case covers is a member
exact_law :: {R : Code} -> Claim :=> {_w, x} => if (case_of(R, escape(x)) == none) { true } else { R(x) == true }

// ---- generic run
// a check answers on partly-known values; its symbolic claim reads a case, its honest claim a member of the type
symbolic :: {check : Tree -> Val -> Res} -> Claim :=> {w, c} => check(w, c) == "Yes"
honest_at :: {T : Code, check : Tree -> Val -> Res} -> Claim :=> {w, x} => if (judge_as(T, escape(x)) == "Yes") { check(w, escape(x)) == "Yes" } else { true }
// the generic-run law for a check at a type: a Yes on a member's case is a Yes on the member
run_law :: {T : Code, check : Tree -> Val -> Res} -> Claim :=> lens_holds(symbolic(check), honest_at(T, check), split_lens(T))

// ---- induction
// a member's strictly smaller pieces: its subtrees where its case has a piece of the same type
rec pieces :: {T : Code, case : Val, x : Tree} -> List(Tree) :=>
	if ((case.is_piece) && (case.piece_type == T)) { [x] }
	else if ((is_hole(case)) || (is_leaf(case))) { [] }
	else if (is_stem(case)) { pieces(T, stem_child(case), stem_child(x)) }
	else { pieces(T, case.fst, x.fst).append(pieces(T, case.snd, x.snd)) }
// the induction law: `to` holds at a member when `from` holds at its case and `to` at every piece; nothing else can be asked
ind_holds :: {T : Code, from : Claim, to : Claim} -> Claim :=> {w, x} => {
	let c := case_of(T, x)
	if (c == none) { true }
	else if ((from(w, c)) && (pieces(T, c, x).all({p} => to(w, p)))) { to(w, x) }
	else { true }
}

// ---- finite cover, as a verdict
// a claim checked on a type's cases: a known case that fails is a counterexample, a symbolic one leaves the claim open
certify :: {claim : Claim, cases : List(Val)} -> Verdict :=> verdict(s_worklist({c} =>
	if (claim(t, c)) { skip } else if (c.is_known) { yield(c) } else { noted(pair("case not settled", c)) }, cases))

// ---- judging a value at a type, by the rules alone
// A function type's arguments, curried, are generic: a piece of the domain (its faces, for
// types whose arguments are not pieces), each named by its position. The search splits them
// on demand (case split), runs the value on them (generic run), and for a recursive value,
// fix(step), runs the step with the hypothesis in place of itself (induction).
max_args := 8
is_types :: Code -> Bool := {c} => (is_type_code(c)) && (c.snd.types)
arg_sym :: {T : Code, i : Nat} -> Val :=> piece(T, [pair("arg", i)])
generic_of :: {T : Code, i : Nat} -> Val :=> if ((is_type_code(T)) && (not(is_none(T.snd.generic)))) { T.snd.generic.snd(T, i) } else { arg_sym(T, i) }
rec generic_args :: {T : Code, i : Nat} -> Val :=> {
	let view := fn_view(T)
	if ((is_none(view)) || (nat_le(max_args, i))) { t }
	else {
		let v := generic_of(view.snd.fst, i)
		pair(v, generic_args(view.snd.snd(faces_of(view.snd.fst, v)), succ(i)))
	}
}
// the value to apply at argument i: a recursive value meeting an unsplit or split piece is its step with the hypothesis
induct :: {f : Val, arg : Val, dom : Code, rest : Tree, i : Nat} -> Res :=> {
	let step := step_of(f)
	if ((step == none) || ((arg.is_known) || (not(is_positive(dom))))) { answered(f) }
	else { sapply(step, hypothesis(dom, family_code(rest), [pair("arg", i)], same), run_fuel) }
}
rec run_at :: {T : Code, f : Val, args : Val, i : Nat} -> Res :=>
	if (is_leaf(args)) { judge_as(T, f) }
	else {
		let view := fn_view(T)
		let dom := view.snd.fst
		let face := faces_of(dom, args.fst)
		and_then(induct(f, face.fst, dom, view.snd.snd, i), {g} =>
			and_then(sapply(g, face.fst, run_fuel), {out} => run_at(view.snd.snd(face), out, args.snd, succ(i))))
	}
// what a program really receives for an argument whose members are types: types erase to the leaf
rec erased_of :: {T : Code} -> Tree :=> {
	let view := fn_view(T)
	if (is_none(view)) { t } else { {_x} => erased_of(view.snd.snd(faces_of(view.snd.fst, generic_of(view.snd.fst, "probe")))) }
}
// Arguments are ground once only pieces of types of types remain: a program that looked at
// one would have been stuck, so the run is the run on what it really receives (the generic-run
// law), and the counterexample names those values.
rec ground_args :: {v : Val} -> Option(Tree) :=>
	if ((v.is_piece) && (is_types(v.piece_type))) { some(erased_of(v.piece_type)) }
	else if (is_hole(v)) { none }
	else if (is_leaf(v)) { some(t) }
	else if (is_stem(v)) { let a := ground_args(stem_child(v)); if (is_none(a)) { none } else { some(t(a.snd)) } }
	else {
		let a := ground_args(v.fst)
		let b := ground_args(v.snd)
		if ((is_none(a)) || (is_none(b))) { none } else { some(t(a.snd, b.snd)) }
	}
// A value of an abstract type is a piece no program can inspect, so a claim whose only unknowns
// are type arguments, their values and functions is re-run on two concrete stand-ins: every type
// argument a type with one member, every value of it that member, and every function one of a
// stored pair of members of its type. A constant cannot be both members, so any program that is
// not parametric is caught; and a program that fails on a real function fails on a stored one.
rec nth :: {xs : List(A), i : Nat} -> A :=> if (is_zero(i)) { xs.head } else { nth(xs.tail, nat_pred(i)) }
stand_ins := [t(t(t), t), t(t(t), t(t))]
has_sample :: Code -> Bool := {c} => if (is_type_code(c)) { not(is_none(c.snd.sample)) } else { false }
is_stored :: Code -> Bool := {c} => not(pairs_at(c).is_nil)
rec all_pieces :: {v : Val} -> List(Val) :=>
	if (v.is_piece) { [v] }
	else if ((is_hole(v)) || (is_leaf(v))) { [] }
	else if (is_stem(v)) { all_pieces(stem_child(v)) }
	else { all_pieces(v.fst).append(all_pieces(v.snd)) }
rec stand_in :: {k : Nat, v : Val} -> Val :=>
	if (if (v.is_piece) { has_sample(v.piece_type) } else { false }) { v.piece_type.snd.sample.snd(v.piece_type, v, k) }
	else if (if (v.is_piece) { is_stored(v.piece_type) } else { false }) { let p := pairs_at(v.piece_type).head; if (is_zero(k)) { p.fst } else { p.snd } }
	else if ((is_hole(v)) || (is_leaf(v))) { v }
	else if (is_stem(v)) { t(stand_in(k, stem_child(v))) }
	else { t(stand_in(k, v.fst), stand_in(k, v.snd)) }
// only when every piece has a stand-in, and every abstract type is one a type argument gives
instances :: {v : Val} -> List(Val) :=> {
	let ps := all_pieces(v)
	let type_args := ps.filter({p} => is_types(p.piece_type))
	let stood := {p} => if ((is_types(p.piece_type)) || (is_stored(p.piece_type))) { true } else { type_args.any({u} => static_of(u.piece_type, u) == p.piece_type) }
	if (ps.is_nil) { [] }
	else if (not(ps.all({p} => ((has_sample(p.piece_type)) || (is_stored(p.piece_type))) && (stood(p))))) { [] }
	else { [0, 1].map({k} => stand_in(k, v)) }
}
// Proved: every argument is covered and every run answers Yes; Refuted with the arguments that break it; else Open with the reason
judge :: {T : Code, w : Tree} -> Verdict :=>
	if (is_fn_code(T)) { search_g({args} => run_at(T, escape(w), args, 0), ground_args, instances, generic_args(T, 0), split_depth) }
	else {
		let r := judge_as(T, escape(w))
		if (r == "Yes") { "Proved" } else if (r == "No") { refuted(w) } else { open_on(explain(r)) }
	}
holds :: {T : Code, w : Tree} -> Bool :=> judge(T, w) == "Proved"
// the law judge stands on, at one type: a Proved run answers for every argument tuple
judge_claim :: {T : Code} -> Claim :=> {w, _c} => not(judge(T, w).is_refuted)
