// Checked growth-curve / polynomial step-bound library (`Option`-typed, zero string sentinels).
// Hot list/arithmetic helpers carry pointwise-equivalence guards for `lib/growth.opt.disp`.
open use "std.disp"
open use "machine.disp"

let machine_lems := cert_pick(machine_cert, ["Machine.start", "Machine.is_finished", "Machine.advance"])
let rec all_some_nat := {xs} =>
	if (xs.is_nil) { Some([]) }
	else if (xs.head.fst == "Some") {
		let rest := all_some_nat(xs.tail)
		if (rest.fst == "Some") { Some(cons(xs.head.snd, rest.snd)) } else { None }
	} else { None }

let helper_cert := certify(check_depth, check_fuel, "all", [], [
	pair("nat_le", pair(Nat -> Nat -> Bool, nat_le)),
	pair("nat_lt", pair(Nat -> Nat -> Bool, nat_lt)),
	pair("nat_add", pair(Nat -> Nat -> Nat, Nat.add)),
	pair("nat_chk_sub", pair(Nat -> Nat -> Option(Nat), Nat.checked_sub)),
	pair("append_n", pair(List(Nat) -> List(Nat) -> List(Nat), List.append)),
	pair("length_n", pair(List(Nat) -> Nat, List.len)),
	pair("all_n", pair(List(Nat) -> (Nat -> Bool) -> Bool, List.all)),
	pair("all_some_nat", pair(List(Option(Nat)) -> Option(List(Nat)), all_some_nat))
])
let map_cert := certify(check_depth, check_fuel, "all", [], [
	pair("map_n", pair(List(Nat) -> (Nat -> Option(Nat)) -> List(Option(Nat)), List.map))
])
let check_module := check_with(check_depth, check_fuel, "all", [machine_lems, helper_cert, map_cert])

// Step counting returning `Option(Nat)` (`Some(n)` when finished within `cap`, `None` on timeout)
rec count_steps : Machine -> Nat -> Nat -> Option(Nat) := {m, n, cap} =>
	if (Machine.is_finished(m)) { Some(n) }
	else if (is_zero(cap)) { None }
	else { count_steps(Machine.advance(m, 1), succ(n), nat_pred(cap)) }

steps_of : Tree -> Tree -> Nat -> Option(Nat) := {f, x, cap} =>
	count_steps(Machine.start(f, x), zero, cap)

// Sizes 1..k (readable O(k^2) spec, guarded for O(k) rewrite in `lib/growth.opt.disp`)
let rec sizes_upto_spec := {k} =>
	if (is_zero(k)) { [] } else { List.append(sizes_upto_spec(nat_pred(k)), [k]) }
guard(fn_equiv_guard(Nat)) sizes_upto : Nat -> List(Nat) := sizes_upto_spec

curve : Tree -> Nat -> Nat -> List(Option(Nat)) := {f, k, cap} =>
	sizes_upto(k).map({n} => steps_of(f, n, cap))

// Finite differences via `Nat.checked_sub`: returns `None` if the curve dips
rec diffs : List(Nat) -> Option(List(Nat)) := {xs} =>
	if (xs.is_nil || xs.tail.is_nil) { Some([]) }
	else {
		let d := Nat.checked_sub(xs.tail.head, xs.head)
		if (d.fst == "Some") {
			let rest := diffs(xs.tail)
			if (rest.fst == "Some") { Some(cons(d.snd, rest.snd)) } else { None }
		} else { None }
	}

guard(fn_equiv_guard(List(Nat))) all_zero : List(Nat) -> Bool := {xs} => List.all(xs, is_zero)

// Newton polynomial coefficients until a difference row is all zero (`Option(List(Nat))`)
rec newton : PartialFn(List(Nat), Option(List(Nat))) := {xs} =>
	if (xs.is_nil) { None }
	else if (all_zero(xs)) { Some([]) }
	else if (xs.tail.is_nil) { None }
	else {
		let ds := diffs(xs)
		if (ds.fst == "Some") {
			let rest := newton(ds.snd)
			if (rest.fst == "Some") { Some(cons(xs.head, rest.snd)) } else { None }
		} else { None }
	}

guard(fn_equiv_guard(List(Nat))) degree : List(Nat) -> Nat := {coeffs} => nat_pred(List.len(coeffs))

rec newton_step : List(Nat) -> List(Nat) := {row} =>
	if (row.is_nil || row.tail.is_nil) { row }
	else { cons(Nat.add(row.head, row.tail.head), newton_step(row.tail)) }

rec newton_at : List(Nat) -> Nat -> Nat := {row, n} =>
	if (is_zero(n)) { if (row.is_nil) { zero } else { row.head } }
	else { newton_at(newton_step(row), nat_pred(n)) }

fit : PartialFn(Tree, PartialFn(Nat, PartialFn(Nat, Option(List(Nat))))) := {f, k, cap} => {
	let samples := all_some_nat(curve(f, k, cap))
	if (samples.fst == "Some") { newton(samples.snd) } else { None }
}

bound_of : List(Nat) -> Nat -> Nat := {coeffs, n} => newton_at(coeffs, nat_pred(n))

cheaper : List(Nat) -> List(Nat) -> Bool := {a, b} =>
	if (not(List.len(a) == List.len(b))) { nat_lt(List.len(a), List.len(b)) }
	else { nat_le(newton_at(a, 64), newton_at(b, 64)) }
