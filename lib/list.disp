// Standard polymorphic list library (`List(A)`): Rust-style receiver-first methods,
// derived from `Foldable` and `Monad` trait modules and guarded for verified `list.opt.disp` overlays.
open use "kernel/prelude.disp"
open use "option.disp"

let LT := List(Tree)
NonEmpty : Type -> Type := {A} => Pair(A, List(A))

// Typed constructors (tree-identical to bootstrap `nil`/`cons`; carry surface `List(A)` type metadata)
nil : Implicit({A} => List(A)) := nil
cons : Implicit({A} => A -> List(A) -> List(A)) := cons

// Core folds (receiver-first: `xs.fold(init, f)` is left fold, `xs.rfold(init, f)` is right fold)
let list_rfold : Implicit({A} => Implicit({B} => List(A) -> B -> (A -> B -> B) -> B)) := {xs, init, f} =>
	fix({go, l} => if (l.is_nil) { init } else { f(l.head, go(l.tail)) })(xs)
let rec list_fold : Implicit({A} => Implicit({B} => List(A) -> B -> (B -> A -> B) -> B)) := {xs, acc, f} =>
	if (xs.is_nil) { acc } else { list_fold(xs.tail, f(acc, xs.head), f) }

List.rfold : Implicit({A} => Implicit({B} => List(A) -> B -> (A -> B -> B) -> B)) := list_rfold
List.fold : Implicit({A} => Implicit({B} => List(A) -> B -> (B -> A -> B) -> B)) := list_fold

// Derived from `Foldable` (`len`, `is_empty`, `all`, `any`, `contains`) — guarded for `.opt.disp`
let ListFoldable := use "traits/foldable.disp" { F := List, rfold := list_rfold }
guard(fn_equiv_guard(LT)) List.len : Implicit({A} => List(A) -> Nat) := ListFoldable.len
guard(fn_equiv_guard(LT)) List.is_empty : Implicit({A} => List(A) -> Bool) := ListFoldable.is_empty
guard(fn2_equiv_guard(LT, Tree -> Bool)) List.all : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := ListFoldable.all
guard(fn2_equiv_guard(LT, Tree -> Bool)) List.any : Implicit({A} => List(A) -> (A -> Bool) -> Bool) := ListFoldable.any
guard(fn2_equiv_guard(LT, Tree)) List.contains : LT -> Tree -> Bool := ListFoldable.contains

// Structural builders & Monad primitives
let list_append : Implicit({A} => List(A) -> List(A) -> List(A)) := {xs, ys} => list_rfold(xs, ys, cons)
guard(fn2_equiv_guard(LT, LT)) List.append : Implicit({A} => List(A) -> List(A) -> List(A)) := list_append

let list_pure : Implicit({A} => A -> List(A)) := {x} => [x]
let list_flat_map : Implicit({A} => Implicit({B} => List(A) -> (A -> List(B)) -> List(B))) := {xs, f} =>
	list_rfold(xs, [], {x, acc} => list_append(f(x), acc))
guard(fn2_equiv_guard(LT, Tree -> LT)) List.flat_map : Implicit({A} => Implicit({B} => List(A) -> (A -> List(B)) -> List(B))) := list_flat_map

// Derived from `Monad` (`map`, `flatten`, `ap`, `traverse`, `sequence`) — guarded for `.opt.disp`
let ListMonad := use "traits/monad.disp" { M := List, pure := list_pure, flat_map := list_flat_map }
guard(fn2_equiv_guard(LT, Tree -> Tree)) List.map : Implicit({A} => Implicit({B} => List(A) -> (A -> B) -> List(B))) := ListMonad.map
guard(fn_equiv_guard(List(LT))) List.flatten : Implicit({A} => List(List(A)) -> List(A)) := ListMonad.flatten
guard(fn2_equiv_guard(List(Tree -> Tree), LT)) List.ap :: List(Tree -> Tree) -> LT -> LT := ListMonad.ap
guard(fn2_equiv_guard(LT, Tree -> LT)) List.traverse :: LT -> (Tree -> LT) -> List(LT) := ListMonad.traverse
guard(fn_equiv_guard(List(LT))) List.sequence :: List(LT) -> List(LT) := ListMonad.sequence

// Safe Rust-style accessors (returning `Option`) plus total `NonEmpty` projections
List.head : Implicit({A} => NonEmpty(A) -> A) := head
List.tail : Implicit({A} => NonEmpty(A) -> List(A)) := tail
List.push_front : Implicit({A} => List(A) -> A -> List(A)) := {xs, x} => cons(x, xs)

List.first : Implicit({A} => List(A) -> Option(A)) := {xs} =>
	if (xs.is_nil) { None } else { Some(xs.head) }

List.split_first : Implicit({A} => List(A) -> Option(Pair(A, List(A)))) := {xs} =>
	if (xs.is_nil) { None } else { Some(pair(xs.head, xs.tail)) }

List.last : Implicit({A} => List(A) -> Option(A)) := fix({go, xs} =>
	if (xs.is_nil) { None }
	else if (xs.tail.is_nil) { Some(xs.head) }
	else { go(xs.tail) })

List.get : Implicit({A} => List(A) -> Nat -> Option(A)) := fix({go, xs, i} =>
	if (xs.is_nil) { None }
	else if (is_zero(i)) { Some(xs.head) }
	else { go(xs.tail, nat_pred(i)) })

// Readable specs for reverse, filter, filter_map, find, take, skip, zip, enumerate, dedup
guard(fn_equiv_guard(LT)) List.rev : Implicit({A} => List(A) -> List(A)) := {xs} =>
	list_rfold(xs, [], {x, acc} => list_append(acc, [x]))

guard(fn2_equiv_guard(LT, Tree -> Bool)) List.filter : Implicit({A} => List(A) -> (A -> Bool) -> List(A)) := {xs, pred} =>
	list_rfold(xs, [], {x, acc} => if (pred(x)) { cons(x, acc) } else { acc })

List.filter_map : Implicit({A} => Implicit({B} => List(A) -> (A -> Option(B)) -> List(B))) := {xs, f} =>
	list_rfold(xs, [], {x, acc} => {
		let r := f(x)
		if (r.fst == "Some") { cons(r.snd, acc) } else { acc }
	})

List.find : Implicit({A} => List(A) -> (A -> Bool) -> Option(A)) := {xs, pred} =>
	fix({go, l} =>
		if (l.is_nil) { None }
		else if (pred(l.head)) { Some(l.head) }
		else { go(l.tail) }
	)(xs)

List.take : Implicit({A} => List(A) -> Nat -> List(A)) := fix({go, xs, n} =>
	if (is_zero(n)) { [] }
	else if (xs.is_nil) { [] }
	else { cons(xs.head, go(xs.tail, nat_pred(n))) })

List.skip : Implicit({A} => List(A) -> Nat -> List(A)) := fix({go, xs, n} =>
	if (is_zero(n)) { xs }
	else if (xs.is_nil) { [] }
	else { go(xs.tail, nat_pred(n)) })

List.zip : Implicit({A} => Implicit({B} => List(A) -> List(B) -> List(Pair(A, B)))) := zip

let rec bump_idx : Implicit({A} => List(Pair(Nat, A)) -> List(Pair(Nat, A))) := {xs} =>
	if (xs.is_nil) { [] } else { cons(pair(succ(xs.head.fst), xs.head.snd), bump_idx(xs.tail)) }

let rec list_enum_spec := {xs} =>
	if (xs.is_nil) { [] } else { cons(pair(zero, xs.head), bump_idx(list_enum_spec(xs.tail))) }
guard(fn_equiv_guard(LT)) List.enumerate : Implicit({A} => List(A) -> List(Pair(Nat, A))) := list_enum_spec

List.dedup : LT -> LT := {xs} =>
	list_rfold(xs, [], {x, acc} => if (List.contains(acc, x)) { acc } else { cons(x, acc) })
