// System F: functions from types to terms, so one identity serves every type, and numbers and booleans become programs (Church encodings). Every member still terminates.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "../verdict.disp" {}
open use raw "../machine.disp" {}
open use raw "../claim.disp" {}
open use raw "../stream.disp" {}
open use raw "../tests/fixtures.disp" {}
open use raw "../../IDEAS.disp" {}
open use raw "types.disp" {}
open use raw "pts.disp" {}
open use raw "cube.disp" {}

theory := corner([poly])
test power(theory) = [true, true, false, false, false, false, false, false]
church_nat := pi(star, arrow(arrow(tv(0), tv(0)), arrow(tv(0), tv(0))))
church_two := lam(star, lam(arrow(tv(0), tv(0)), lam(tv(1), app(tv(1), app(tv(1), tv(0))))))
church_plus := lam(church_nat, lam(church_nat, lam(star, lam(arrow(tv(0), tv(0)), lam(tv(1), app(app(app(tv(4), tv(2)), tv(1)), app(app(app(tv(3), tv(2)), tv(1)), tv(0))))))))
test accepts(theory, church_nat, church_two) = "Proved"
test accepts(theory, arrow(church_nat, arrow(church_nat, church_nat)), church_plus) = "Proved"
test erase(church_plus, erase(church_two), erase(church_two), t, succ, zero) = 4
// what a Church boolean means: at every type it answers one of the two it was given. An abstract
// type's token is what catches a program that answers with something it made up
church_bool := pi(star, arrow(tv(0), arrow(tv(0), tv(0))))
yes_term := lam(star, lam(tv(0), lam(tv(1), tv(1))))
stray := lam(star, lam(tv(0), lam(tv(1), other)))
bool_challenges := challenges_at(theory, church_bool)
test over(sound_at(theory, accepted(theory), church_bool), yes_term, bool_challenges) = "Proved"
test holds(meaning(theory, church_bool), erase(yes_term)) = true
test holds(meaning(theory, church_bool), erase(stray)) = false
// the checker refuses the stray program, so the law holds; a checker that accepts everything is refuted by it
test over(sound_at(theory, accepted(theory), church_bool), stray, bool_challenges) = "Proved"
test over(sound_at(theory, {_a, _term} => true, church_bool), stray, bool_challenges).is_refuted = true
test holds(meaning(theory, church_nat), erase(church_two)) = true
