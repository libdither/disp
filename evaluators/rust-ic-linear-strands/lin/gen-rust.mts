// Writes the linear net's rules (rules.ts) as Rust for the copied tree-net (../tree-net/src/lin.rs), the
// tag list into its rules.rs `Tag` enum, and the player's names for them (../player/lin-kinds.js).
// `npx tsx evaluators/rust-ic-linear-strands/lin/gen-rust.mts`
import { readFileSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { ARITY, DESC, FLIP, PRODUCERS, RULES, type End } from './rules.ts'
import { CURSOR } from './compile.ts'

const here = dirname(fileURLToPath(import.meta.url))
const EXISTING = new Set(['L', 'S', 'F', 'Out'])
const TAGS = Object.keys(ARITY).filter((t) => !EXISTING.has(t))

const end = (e: End) => ('c' in e ? `End::CAux(${e.c})` : 'p' in e ? `End::PAux(${e.p})` : `End::Fresh(${e.x}, ${e.q})`)
const T = (t: string) => `Tag::${t}`

const rs: string[] = []
rs.push(`//! The linear two-way net's rules, generated by lin/gen-rust.mts from lin/rules.ts; do not edit.`)
rs.push(`//! The website's two-way programs compiled into agents of at most 4 ports: the value's top is the run,`)
rs.push(`//! every program node faces it, and nothing copies or erases.`)
rs.push(`use crate::rules::{End, Rule, Tag, When};`)
rs.push(``)
rs.push(`/// The linear net's tags, numbered after two-way programs' where the strand lattice runs them.`)
rs.push(`pub const LIN_TAGS: [Tag; ${TAGS.length}] = [${TAGS.map(T).join(', ')}];`)
rs.push(``)
rs.push(`pub fn arity(t: Tag) -> Option<usize> {`)
rs.push(`    Some(match t {`)
for (const n of [1, 2, 3, 4]) {
  const ts = TAGS.filter((t) => ARITY[t] === n)
  if (ts.length) rs.push(`        ${ts.map(T).join(' | ')} => ${n},`)
}
rs.push(`        _ => return None,`)
rs.push(`    })`)
rs.push(`}`)
rs.push(``)
rs.push(`pub fn name(t: Tag) -> Option<&'static str> {`)
rs.push(`    Some(match t {`)
for (const t of TAGS) rs.push(`        ${T(t)} => ${JSON.stringify(t)},`)
rs.push(`        _ => return None,`)
rs.push(`    })`)
rs.push(`}`)
rs.push(``)
rs.push(`/// The roots: the value's top carrying the run. Every other linear tag consumes.`)
rs.push(`pub const fn producer(t: Tag) -> bool { matches!(t, ${TAGS.filter((t) => PRODUCERS.has(t)).map(T).join(' | ')}) }`)
rs.push(``)
rs.push(`/// Agents carrying a run (compile.ts \`CURSOR\`): roots, heads, readers, tris reading, a map turned round.`)
rs.push(`pub const fn runs(t: Tag) -> bool { matches!(t, ${TAGS.filter((t) => CURSOR.test(t)).map(T).join(' | ')}) }`)
rs.push(``)
rs.push(`/// Flip, agent by agent: the tag it becomes, and for each of its new ports the old port there.`)
rs.push(`pub fn flip(t: Tag) -> Option<(Tag, [u8; 4])> {`)
rs.push(`    Some(match t {`)
for (const [t, f] of Object.entries(FLIP)) {
  const perm = [...f.perm, ...[0, 1, 2, 3].slice(f.perm.length)]
  rs.push(`        ${T(t)} => (${T(f.to)}, [${perm.join(', ')}]),`)
}
rs.push(`        _ => return None,`)
rs.push(`    })`)
rs.push(`}`)
rs.push(``)
rs.push(`pub static LIN_RULES: &[Rule] = &[`)
for (const r of RULES)
  rs.push(
    `    Rule { consumer: ${T(r.consumer)}, producer: ${T(r.producer)}, when: When::Any, fresh: &[${r.fresh.map(T).join(', ')}], labels: &[], wires: &[${r.wires
      .map(([a, b]) => `(${end(a)}, ${end(b)})`)
      .join(', ')}] },`
  )
rs.push(`];`)
writeFileSync(join(here, '../tree-net/src/lin.rs'), rs.join('\n') + '\n')

// the tags into the enum, between the markers
const rulesRs = join(here, '../tree-net/src/rules.rs')
const src = readFileSync(rulesRs, 'utf-8')
const begin = '    // ---- the linear net (lin.rs, generated by lin/gen-rust.mts) ----\n'
const stop = '    // ---- end of the linear net ----\n'
const i = src.indexOf(begin)
const j = src.indexOf(stop)
if (i < 0 || j < 0) throw new Error('rules.rs has no markers for the linear tags')
const lines: string[] = []
for (let k = 0; k < TAGS.length; k += 12) lines.push('    ' + TAGS.slice(k, k + 12).join(', ') + ',\n')
writeFileSync(rulesRs, src.slice(0, i + begin.length) + lines.join('') + src.slice(j))

// the player's names, descriptions and ports for the new tags, in code order after TWO_TAGS
const js = [
  '// generated by lin/gen-rust.mts from lin/rules.ts; do not edit',
  `const LIN_TAGS = ${JSON.stringify(TAGS)};`,
  `const LIN_ARITY = ${JSON.stringify(TAGS.map((t) => ARITY[t]))};`,
  `const LIN_DESC = ${JSON.stringify(Object.fromEntries(TAGS.map((t) => [t, DESC[t]])))};`,
  `const LIN_PRODUCER = ${JSON.stringify(TAGS.filter((t) => PRODUCERS.has(t)))};`
]
writeFileSync(join(here, '../player/lin-kinds.js'), js.join('\n') + '\n')
console.log(`${TAGS.length} tags, ${RULES.length} rules`)
