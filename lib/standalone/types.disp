open use raw "../prelude.disp" {}
open use raw "kernel.disp" {}

// The standalone library types, split out of kernel.disp: everything the
// checker itself does not need to exist. kernel.disp keeps the machinery and
// its constitutive types (Bool, Unit, AnyTree, Pred, ShallowType, Row/Obs,
// Sum, the Pi/Tele formers, the tables, Record + the declaration protocol).
// prelude.disp is the double-pass barrel that loads both raw, then checked.
// The ambient-walker parameter lives here with the annotated surface it
// governs (givens do not cross opens); filling it with another table
// re-verifies every Fn-annotated definition below under that walker.
given GenericWalker : AnyTree := Guard
Fn := Pi GenericWalker

// A telescope is just data: a free-monad program over Fresh/Observe rows.
// eff_bind is what the `x <- e` block sugar desugars to: graft k onto the
// Pure leaf. Junk (any non-Pure/non-Op tree) propagates unchanged, which is
// what makes `reject` abort a script from inside a computed branch.
eff_bind := fix ({self, m, k} ->
  if (has_sig "Pure" m) { k (pair_snd m) }
  else if (has_sig "Op" m) { Op (pair (pair_fst (pair_snd m)) ({r} -> self ((pair_snd (pair_snd m)) r) k)) }
  else { m })
// One-observation program: project the subject with acc, judge against T,
// return the raw projection. `x <- see acc T` reads "observe it, call it x".
see := {acc, T} -> perform (Observe (pair (Prj acc) T)) Pure
self_is := {T} -> perform (Observe (pair Self T)) Pure
done := Pure t
reject := t

node_like := Pred ({n} -> or (is_leaf n) (is_fork n))

False := Sum nil
Not := {P} -> Fn P ({_} -> False)
Refine := {A, p} -> ({
  #recognize := {_self, v} -> and (A v) (p v)
  check := {jdg, _T, v} -> and (jdg A v) (p v)
})
test False t = false
test False 5 = false
test Not False ({p} -> p) = true

Quotient := {A, nf} -> ({
  #recognize := {_self, v} -> A v
  check := {jdg, _T, v} -> jdg A v
  norm := nf
  under := A
})
canon := {A, v} -> {
  let nf := A.norm
  if (or (is_leaf nf) (not (neutral_free v))) { v } else { nf v }
}
Named := {name, T} -> ({
  #recognize := {_self, v} -> T v
  check := {jdg, _T2, v} -> jdg T v
  name := name
  under := T
})

key_insert := fix ({self, k, ks} ->
  if (is_leaf ks) { cons k nil }
  else if (tree_eq k (pair_fst ks)) { ks }
  else if (tree_lt k (pair_fst ks)) { cons k ks }
  else { cons (pair_fst ks) (self k (pair_snd ks)) })
key_sort := fix ({self, ks} -> if (is_leaf ks) { nil } else { key_insert (pair_fst ks) (self (pair_snd ks)) })
Tuple := {keys} -> {
  let ks := key_sort keys
  if (not (tree_eq (list_len ks) (list_len keys))) { invalid keys }
  else { (fix ({self, ks2} ->
    if (is_leaf (pair_snd ks2)) { pair_fst ks2 } else { Sigma GenericWalker (pair_fst ks2) ({_} -> self (pair_snd ks2)) })) ks }
}
at := {K, keys, s} -> (fix ({self, ks, v} ->
  if (is_leaf ks) { invalid K }
  else if (tree_eq K (pair_fst ks)) { if (is_leaf (pair_snd ks)) { v } else { pair_fst v } }
  else { self (pair_snd ks) (pair_snd v) })) (key_sort keys) s

Nat : ShallowType := ({
  #recognize := {self, v} -> triage true ({_} -> false) ({l, r} -> and (tree_eq l t) (self r)) v
  gate := {Ind, B} -> cons (B zero) (cons (PiCode Ind ({k} -> PiCode (B k) ({_} -> B (succ k)))) nil)
  elim := {self, n, base, step} -> triage base ({_} -> base) ({_l, k} -> step k (self k base step)) n
})
test Nat zero = true
test Nat (succ (succ zero)) = true
test is_leaf Nat.tele = true
test Nat (t t) = false
test Nat (make_hyp Nat Nat) = false
test Nat (succ (make_hyp Nat Nat)) = false
nat_step_ty : ShallowType := pair_fst (pair_snd (Nat.gate Nat ({_} -> Nat)))
nat_rec : Fn Nat ({_} -> Fn Nat ({_} -> Fn nat_step_ty ({_} -> Nat))) := elim_of Nat ({_} -> Nat)

bool_rec : Fn Bool ({_} -> Fn Bool ({_} -> Fn Bool ({_} -> Bool))) := elim_of Bool ({_} -> Bool)
test ShallowType Bool = true
test tree_eq (Tuple (cons Nat (cons Bool nil))) (Tuple (cons Bool (cons Nat nil))) = true
test Tuple (cons Nat (cons Bool nil)) (pair true 2) = true
test Tuple (cons Nat (cons Bool nil)) (pair 2 true) = false
test (Named "cost" Nat) 3 = true
test (Named "cost" Nat).name = "cost"
test tree_eq (Named "cost" Nat).under Nat = true
test tree_eq (Named "cost" Nat) (Named "price" Nat) = false
test field (make_record (cons Nat nil) (cons (list_const 7) nil)) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Nat = 7
test field ({ (Nat) := 7, (Bool) := true }) Bool = true
test tree_eq ({ (Nat) := 7, (Bool) := true }) ({ (Bool) := true, (Nat) := 7 }) = true
test field ({ label := "flip", ((Named "cost" Nat)) := 3 }) (Named "cost" Nat) = 3
test Fn ShallowType ({_} -> Bool) ({T} -> T 5) = true
test Fn ShallowType ({_} -> Bool) ({T} -> bool_rec (T 5) false true) = true
test Fn ShallowType ({_} -> Nat) ({T} -> T 5) = false

Point := {c} -> ({ #recognize := {_self, v} -> tree_eq c v, members := cons c nil })

refl := t
Eq := {A, x, y} -> {
  let nx := canon A x
  let ny := canon A y
  ({
    #recognize := {_self, v} -> and (is_leaf v) (tree_eq nx ny)
    gate := {_Ind, B} -> cons (B nx) nil
    elim := {_self, _p, base} -> base
    land := {B, _self} -> B ny
    ends := pair nx ny
  })
}
eq_subst := {A, x, y, B, p, base} -> elim_of (Eq A x y) B p base
eq_sym := {A, x, y, p} -> eq_subst A x y ({_} -> Eq A y x) p refl
eq_trans := {A, x, y, z, p, q} -> eq_subst A y z ({_} -> Eq A x z) q p
eq_cong := {A, f, x, y, p} -> eq_subst A x y ({_} -> Eq A (f x) (f y)) p refl
test Eq Nat 2 2 refl = true
test Eq Nat 2 3 refl = false
test Eq Nat 2 2 (t t) = false
test eq_subst Nat 2 2 ({_} -> Nat) refl 7 = 7
test eq_sym Nat 2 2 refl = refl
test eq_trans Nat 2 2 2 refl refl = refl
test eq_cong Nat succ 2 2 refl = refl

Tree : ShallowType := ({
  #recognize := {_self, _v} -> true
  gate := {Ind, B} -> cons (B t) (cons (PiCode Ind ({c} -> PiCode (B c) ({_} -> B (t c)))) (cons (PiCode Ind ({l} -> PiCode Ind ({r} -> PiCode (B l) ({_} -> PiCode (B r) ({_} -> B (t l r)))))) nil))
  elim := {self, v, on_leaf, on_stem, on_fork} -> triage on_leaf ({c} -> on_stem c (self c on_leaf on_stem on_fork)) ({l, r} -> on_fork l r (self l on_leaf on_stem on_fork) (self r on_leaf on_stem on_fork)) v
})
tree_rec := {B} -> elim_of Tree B

GoodGate := {T} -> {
  let g := T.gate
  if (is_leaf g) { false } else {
    let B := {_} -> inj "@GoodGate" T
    let tys := g T B
    let pis := fix ({self, l, end} -> if (is_leaf l) { end } else { Pi Guard (pair_fst l) ({_} -> self (pair_snd l) end) })
    and (Pi Guard T ({x} -> pis tys (B x)) (elim_of T B))
        (list_all ({ty} -> not (Pi Guard AnyTree ({_} -> ty) ({j} -> j))) tys)
  }
}
test GoodGate Nat = true
test GoodGate Bool = true
test GoodGate Tree = true
test GoodGate (Eq Nat 2 3) = true
test GoodGate AnyTree = false
test GoodGate ShallowType = false

Coherent := {T} -> {
  let e := T.ends
  let ck := T.check
  let ends_ok := if (is_fork e) { or (tree_eq (pair_fst e) (pair_snd e)) (list_all ({v} -> not (T v)) probes) } else { true }
  let check_ok := if (is_leaf ck) { true } else { list_all ({v} -> tree_eq (T v) (ck ({ty, a} -> ty a) T v)) probes }
  let members_ok := and (list_all T T.members) (if (is_leaf T.members) { true } else { list_all ({v} -> or (not (T v)) (member v T.members)) probes })
  let gate_ok := if (is_leaf T.gate) { true } else { GoodGate T }
  let norm_ok := if (is_leaf T.norm) { true } else {
    list_all ({v} -> if (T v) { and (T (T.norm v)) (tree_eq (T.norm (T.norm v)) (T.norm v)) } else { true }) probes
  }
  and ends_ok (and check_ok (and members_ok (and gate_ok norm_ok)))
}
test Coherent Nat = true
test Coherent Bool = true
test Coherent Tree = true
test Coherent Unit = true
test Coherent AnyTree = true
test Coherent (Point 5) = true
test Coherent (Eq Nat 2 2) = true
test Coherent (Eq Nat 2 3) = true

list_len_t : Fn Tree ({_} -> Nat)
  := {xs} -> tree_rec ({_} -> Nat) xs zero ({_c, _ih} -> zero) ({_l, _r, _il, ir} -> succ ir)
list_snoc_t : Fn Tree ({_} -> Fn Tree ({_} -> Tree))
  := {xs, x} -> tree_rec ({_} -> Tree) xs (cons x nil) ({_c, _ih} -> t) ({l, _r, _il, ir} -> cons l ir)
list_map_t : Fn (Fn Tree ({_} -> Tree)) ({_} -> Fn Tree ({_} -> Tree))
  := {f, xs} -> tree_rec ({_} -> Tree) xs nil ({_c, _ih} -> t) ({l, _r, _il, ir} -> cons (f l) ir)
list_all_t : Fn (Fn Tree ({_} -> Bool)) ({_} -> Fn Tree ({_} -> Bool))
  := {p, xs} -> tree_rec ({_} -> Bool) xs true ({_c, _ih} -> false) ({l, _r, _il, ir} -> bool_rec (p l) ir false)
test list_len_t (cons 7 (cons 7 nil)) = 2
test list_snoc_t (cons 1 nil) 2 = cons 1 (cons 2 nil)
test list_map_t succ (cons 1 (cons 2 nil)) = cons 2 (cons 3 nil)
test list_all_t is_leaf (cons t (cons t nil)) = true
test list_all_t is_leaf (cons t (cons 2 nil)) = false
test Fn Tree ({_} -> Bool) is_leaf = false

let list_mem := {ej, rj, A, v} -> triage true ({_} -> false) ({h, tl} -> and (ej A h) (rj tl)) v
List : Pi Guard ShallowType ({_} -> ShallowType) := {A} -> ({
  #recognize := {self, v} -> list_mem ({ty, a} -> ty a) self A v
  check := {jdg, T, v} -> list_mem jdg ({a} -> jdg T a) A v
  gate := {Ind, B} -> cons (B nil) (cons (PiCode A ({h} -> PiCode Ind ({tl} -> PiCode (B tl) ({_} -> B (cons h tl))))) nil)
  elim := list_elim_raw
})

// Eliminator-routed typed twins of the kernel's raw list functions. The raw
// forms case-split their argument, which the walker refuses on a hypothesis;
// these route through elim_of, so they carry full polymorphic types. The type
// quantifier is pinned to Guard: the Meta walker cannot mint type-variable
// hypotheses at all (pinned below), so only the value-level arrows (Fn)
// participate in the differential instantiation.
list_len_l : Pi Guard ShallowType ({A} -> Fn (List A) ({_} -> Nat)) := list_len_p
list_map_l : Pi Guard ShallowType ({A} -> Pi Guard ShallowType ({B} -> Fn (Fn A ({_} -> B)) ({_} -> Fn (List A) ({_} -> List B))))
  := list_map_p
list_all_l : Pi Guard ShallowType ({A} -> Fn (Fn A ({_} -> Bool)) ({_} -> Fn (List A) ({_} -> Bool)))
  := list_all_p
list_snoc_l : Pi Guard ShallowType ({A} -> Fn (List A) ({_} -> Fn A ({_} -> List A))) := list_snoc_p
list_cat_l : Pi Guard ShallowType ({A} -> Fn (List A) ({_} -> Fn (List A) ({_} -> List A)))
  := list_cat_p
list_filter_l : Pi Guard ShallowType ({A} -> Fn (Fn A ({_} -> Bool)) ({_} -> Fn (List A) ({_} -> List A)))
  := list_filter_p
// A wrong-typed arm is refused. (List A -> List B does not pin length, so an
// element-dropping map still inhabits the map type; the pin below is the
// wrong-TYPE case, which is what the checker owns.)
test Fn ShallowType ({A} -> Fn ShallowType ({B} -> Fn (Fn A ({_} -> B)) ({_} -> Fn (List A) ({_} -> List B)))) ({A, B, f, xs} -> (elim_of (List A) ({_} -> List B)) xs nil ({h, _tl, _ih} -> h)) = false
// The Meta gap: abstract values cannot act as recognizers, so Meta refuses
// every type-polymorphic function, even the tautological one.
test Pi Meta ShallowType ({T} -> Fn AnyTree ({_} -> Bool)) ({T, v} -> T v) = false
// Agreement with the raw forms: pointwise on the sample corpus.
list_samples := cons nil (cons (cons 1 nil) (cons (cons 1 (cons 2 nil)) nil))
test list_all_l AnyTree ({s} -> tree_eq (list_len_l AnyTree s) (list_len s)) list_samples = true
test list_all_l AnyTree ({s} -> tree_eq (list_map_l AnyTree AnyTree succ s) (list_map succ s)) list_samples = true
test list_all_l AnyTree ({s} -> tree_eq (list_filter_l AnyTree is_leaf s) (list_filter is_leaf s)) list_samples = true
test tree_eq (list_cat_l AnyTree (cons 1 nil) (cons 2 nil)) (list_cat (cons 1 nil) (cons 2 nil)) = true
test tree_eq (list_snoc_l AnyTree (cons 1 nil) 2) (list_snoc (cons 1 nil) 2) = true

let eff_mem := {ej, rj, Q, X, v} -> (match v { Pure x => (ej X x); Op q k => (and (ej Q q) (rj (k t))); _ => false })
Eff : Pi Guard ShallowType ({_} -> Pi Guard ShallowType ({_} -> Pi Guard ShallowType ({_} -> ShallowType)))
  := {Q, Ans, X} -> ({
  #recognize := {self, v} -> eff_mem ({ty, a} -> ty a) self Q X v
  check := {jdg, T, v} -> eff_mem jdg ({a} -> jdg T a) Q X v
  gate := {Ind, B} -> cons (PiCode X ({x} -> B (Pure x))) (cons (PiCode Q ({q} -> PiCode (PiCode Ans ({_} -> Ind)) ({k} -> PiCode (PiCode Ans ({r} -> B (k r))) ({_} -> B (Op (pair q k)))))) nil)
  elim := {self, m, on_pure, on_op} -> (match m { Pure x => (on_pure x); Op q k => (on_op q k ({r} -> self (k r) on_pure on_op)) })
})
test Eff Row AnyTree AnyTree (PiCode AnyTree ({_} -> AnyTree)).tele = true
test Eff Row AnyTree AnyTree (Sigma Guard Nat ({_} -> Bool)).tele = true
test Eff Row AnyTree AnyTree ShallowType.obs = true
test Eff Row AnyTree AnyTree 5 = false

GuardNatToNat : ShallowType := Pi Guard Nat ({_} -> Nat)

add : Fn Nat ({_} -> Fn Nat ({_} -> Nat)) := {n, m} -> nat_rec n m ({k, ih} -> succ ih)
not_bool : Fn Bool ({_} -> Bool) := {b} -> bool_rec b false true
elim_id : Fn Nat ({_} -> Nat) := {n} -> nat_rec n zero ({k, ih} -> succ ih)
test add 2 3 = 5
test add 0 4 = 4
test ShallowType Nat = true
test ShallowType GuardNatToNat = true

// 1. Lists: recursion at row-generation time, branching on the observed node.
list_rows := {A} -> (fix ({self, get} -> {
  node <- see get node_like
  if (is_leaf node) { done }
  else {
    _ <- see ({v} -> pair_fst (get v)) A
    self ({v} -> pair_snd (get v))
  }
}))
ListR := {A} -> Tele Guard (list_rows A ({v} -> v))
test ListR Nat nil = true
test ListR Nat (cons 1 (cons 2 nil)) = true
test ListR Nat (cons 1 (cons (t t) nil)) = false
test ListR Nat (t t) = false
// Structural pun, shared with the kernel's List: succ n = cons zero n, so a
// nat IS a list of zeros. Shallow types see trees, not intent.
test ListR Nat 5 = true
test List Nat 5 = true
test ListR (ListR Bool) (cons (cons true nil) (cons nil nil)) = true
test ListR (ListR Bool) (cons (cons 5 nil) nil) = false

// 2. Vectors: same list, but the length is a parameter driving row generation.
vec_rows := {A} -> fix ({self, n, get} ->
  if (is_leaf n) { see get Unit }
  else {
    _ <- see get (Pred is_fork)
    _ <- see ({v} -> pair_fst (get v)) A
    self (pair_snd n) ({v} -> pair_snd (get v))
  })
Vec := {n, A} -> Tele Guard (vec_rows A n ({v} -> v))
test Vec 2 Bool (cons true (cons false nil)) = true
test Vec 2 Bool (cons true nil) = false
test Vec 2 Bool (cons true (cons false (cons true nil))) = false
test Vec 0 Bool nil = true

// 3. Records with names: entries data -> one presence row + one field row each.
record_rows := fix ({self, entries} ->
  if (is_leaf entries) { done }
  else {
    let name := pair_fst (pair_fst entries)
    _ <- see ({r} -> field_cell r name) (Pred is_fork)
    _ <- see ({r} -> field r name) (pair_snd (pair_fst entries))
    self (pair_snd entries)
  })
NamedRec := {entries} -> Tele Guard (record_rows entries)
xy := cons (pair "x" Nat) (cons (pair "y" Bool) nil)
test NamedRec xy ({ x := 2, y := false }) = true
test NamedRec xy ({ x := 2 }) = false
test NamedRec xy ({ x := 2, y := 5 }) = false
test NamedRec xy ({ x := 2, y := false, z := 9 }) = true
test NamedRec (cons (pair "step" GuardNatToNat) nil) ({ step := succ }) = true
test NamedRec (cons (pair "step" GuardNatToNat) nil) ({ step := not_bool }) = false

// 4. Type-keyed records: keys are trees, so a type can be its own key.
TypeRec := {tys} -> NamedRec (list_map ({T} -> pair T T) tys)
test TypeRec (cons Nat (cons Bool nil)) ({ (Nat) := 7, (Bool) := false }) = true
test TypeRec (cons Nat (cons Bool nil)) ({ (Nat) := false, (Bool) := false }) = false

// 5. Intersection: a list of predicates, all applied to the subject itself.
all_rows := fix ({self, tys} ->
  if (is_leaf tys) { done }
  else {
    _ <- self_is (pair_fst tys)
    self (pair_snd tys)
  })
AllOf := {tys} -> Tele Guard (all_rows tys)
test AllOf (cons Nat (cons (Point 5) nil)) 5 = true
test AllOf (cons Nat (cons (Point 5) nil)) 6 = false
test AllOf nil 5 = true

// 6. Unique application: each predicate must claim a distinct list element.
// The continuation searches for a bijection (untrusted), then emits one row
// per matched pair so every claim is re-judged by the checker.
splits := fix ({self, xs} ->
  if (is_leaf xs) { nil }
  else { cons (pair (pair_fst xs) (pair_snd xs))
              (list_map ({p} -> pair (pair_fst p) (cons (pair_fst xs) (pair_snd p))) (self (pair_snd xs))) })
bijection := fix ({self, tys, xs} ->
  if (is_leaf tys) { if (is_leaf xs) { cons nil nil } else { nil } }
  else { (fix ({try, cands} ->
    if (is_leaf cands) { nil }
    else {
      let c := pair_fst cands
      let rest := if ((pair_fst tys) (pair_fst c)) { self (pair_snd tys) (pair_snd c) } else { nil }
      if (is_leaf rest) { try (pair_snd cands) }
      else { cons (cons (pair (pair_fst tys) (pair_fst c)) (pair_fst rest)) nil }
    })) (splits xs) })
unique_rows := {tys} -> {
  v <- self_is (List AnyTree)
  let m := bijection tys v
  if (is_leaf m) { reject }
  else { (fix ({go, asg} ->
    if (is_leaf asg) { done }
    else {
      _ <- see ({_} -> pair_snd (pair_fst asg)) (pair_fst (pair_fst asg))
      go (pair_snd asg)
    })) (pair_fst m) }
}
UniqueOf := {tys} -> Tele Guard (unique_rows tys)
test UniqueOf (cons (Point 5) (cons (Point 6) nil)) (cons 6 (cons 5 nil)) = true
test UniqueOf (cons (Point 5) (cons (Point 6) nil)) (cons 5 (cons 5 nil)) = false
test UniqueOf (cons AnyTree (cons (Point 5) nil)) (cons 5 (cons 7 nil)) = true
test UniqueOf (cons AnyTree (cons AnyTree nil)) (cons 5 nil) = false

// 7. Tree checkers: branch at each node, sequence the two child programs.
tree_rows := {LeafTy} -> (fix ({self, get} -> {
  node <- see get node_like
  if (is_fork node) {
    _ <- self ({v} -> pair_fst (get v))
    self ({v} -> pair_snd (get v))
  } else { see get LeafTy }
}))
TreeOf := {LeafTy} -> Tele Guard (tree_rows LeafTy ({v} -> v))
test TreeOf Unit (pair (pair t t) t) = true
test TreeOf Unit (pair (t t) t) = false

// 8. Trees with different kinds of sub-objects at tagged nodes.
MixedCode : List AnyTree := < Leaf : t, Node : t >
mixed_rows := fix ({self, get} -> {
  node <- see get (Pred is_fork)
  if (tree_eq (pair_fst node) "Leaf") {
    see ({v} -> pair_snd (get v)) Bool
  } else if (tree_eq (pair_fst node) "Node") {
    _ <- see ({v} -> pair_fst (pair_snd (get v))) Nat
    _ <- self ({v} -> pair_fst (pair_snd (pair_snd (get v))))
    self ({v} -> pair_snd (pair_snd (pair_snd (get v))))
  } else { reject }
})
MixedTree := Tele Guard (mixed_rows ({v} -> v))
test MixedTree (Leaf false) = true
test MixedTree (Node (pair 2 (pair (Leaf false) (Leaf false)))) = true
test MixedTree (Node (pair false (pair (Leaf false) (Leaf false)))) = false
test MixedTree (Node (pair 2 (pair (Leaf 5) (Leaf false)))) = false
test MixedTree 5 = false

// 9. Perfect trees of depth n: no data branching at all, pure parameter recursion.
perfect_rows := fix ({self, n, get} ->
  if (is_leaf n) { see get Unit }
  else {
    _ <- see get (Pred is_fork)
    _ <- self (pair_snd n) ({v} -> pair_fst (get v))
    self (pair_snd n) ({v} -> pair_snd (get v))
  })
Perfect := {n} -> Tele Guard (perfect_rows n ({v} -> v))
test Perfect 1 (pair t t) = true
test Perfect 2 (pair (pair t t) (pair t t)) = true
test Perfect 2 (pair (pair t t) t) = false

// 10. Balanced trees: observe a computed measure, constrain it with a type.
height := fix ({self, v} ->
  if (is_fork v) {
    let hl := self (pair_fst v)
    let hr := self (pair_snd v)
    succ (if (nat_le hl hr) { hr } else { hl })
  } else { zero })
near := Pred ({p} -> and (nat_le (pair_fst p) (succ (pair_snd p))) (nat_le (pair_snd p) (succ (pair_fst p))))
bal_rows := fix ({self, get} -> {
  node <- see get node_like
  if (is_leaf node) { done }
  else {
    _ <- see ({v} -> pair (height (pair_fst (get v))) (height (pair_snd (get v)))) near
    _ <- self ({v} -> pair_fst (get v))
    self ({v} -> pair_snd (get v))
  }
})
Balanced := Tele Guard (bal_rows ({v} -> v))
test Balanced t = true
test Balanced (pair t t) = true
test Balanced (pair (pair t t) t) = true
test Balanced (pair (pair (pair t t) t) t) = false
test Balanced (pair (pair (pair t t) (pair t t)) (pair t t)) = true

// 11. Dependent record: the observed value of one field shapes another field's rows.
len_xs_rows := {
  _ <- see ({r} -> field_cell r "len") (Pred is_fork)
  n <- see ({r} -> field r "len") Nat
  vec_rows Bool n ({r} -> field r "xs")
}
LenXs := Tele Guard len_xs_rows
test LenXs ({ len := 2, xs := cons true (cons false nil) }) = true
test LenXs ({ len := 1, xs := cons true (cons false nil) }) = false
test LenXs ({ len := 3, xs := cons true (cons false nil) }) = false
test LenXs ({ xs := cons true nil }) = false
