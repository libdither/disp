// A verdict on a claim: "Proved", `refuted w` with a witness that re-runs
// concretely, or Open (bare "Open", or `open_on reason` when there is something
// to say: a probe count, a stuck symbol). A Refuted is a fact about every tree;
// a Proved is one only when it came from exhausting a finite domain or from a
// shortcut whose contract is agreement with the honest stream (TYPES.html §9).
open use raw "prelude.disp" {}

refuted :: {witness : Tree} -> Verdict :=> pair "Refuted" witness
open_on :: {reason : Tree} -> Verdict :=> pair "Open" reason
is_proved :: Verdict -> Bool := {v} => v == "Proved"
is_refuted :: Verdict -> Bool := {v} => v.fst == "Refuted"
is_open :: Verdict -> Bool := {v} => (v == "Open") || (v.fst == "Open")
// the plain vocabulary: Proved | Refuted w | Open
flat :: Verdict -> Verdict := {v} => if (v.is_open) { "Open" } else { v }
// a shortcut against an enumerated run: Proved needs the run to pass, Refuted
// needs it to fail, Open is consistent with either
agrees :: {verdict : Verdict, enumerated : Bool} -> Bool :=>
	if (verdict.is_proved) { enumerated } else if (verdict.is_open) { true } else { not enumerated }
// two verdicts agree unless one proves what the other refutes
agree :: {a : Verdict, b : Verdict} -> Bool :=>
	if (a.is_open) { true } else if (b.is_open) { true } else { a.is_proved == b.is_proved }
