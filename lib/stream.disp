// Checked coalgebraic stream, task, budget, worklist, and verdict library.
// Uses `Poll(V)` (`Yield` / `Skip`) so it never collides with `Option(A)` (`Some` / `None`),
// and namespaces operations cleanly under `Step.*`, `Emit.*`, `Poll.*`, `Ending.*`,
// `Coalg.*`, `Stream.*`, `Task.*`, `Items.*`, `Stopping.*`, `Taken.*`, and `Round.*`.
open use "std.disp"
open use "verdict.disp"
open use "machine.disp"
let SMod := use raw "core/stream.disp" {}

// ---------------------------------------------------------------- exact dependent types
Step : Type -> Type -> Type := {R, X} => Sigma(Tree, {tag} => if (tag == "Finished") { R } else { X })
FinishedStep : Type -> Type := {R} => Pair(The(Tree, "Finished"), R)
RunningStep : Type -> Type := {X} => Pair(The(Tree, "Running"), X)
Emit : Type -> Type -> Type := {T, X} => Pair(T, X)
Poll : Type -> Type := {V} => Sigma(Tree, {tag} => if (tag == "Yield") { V } else { Unit })
YieldPoll : Type -> Type := {V} => Pair(The(Tree, "Yield"), V)
Ending : Type := Tree
ItemStep : Type -> Type -> Type := {V, X} => Step(Ending, Emit(Poll(V), X))
RunningItemStep : Type -> Type -> Type := {V, X} => Pair(The(Tree, "Running"), Emit(Poll(V), X))
Budget : Type -> Type := {St} => Pair(Nat, St)
Outcome : Type -> Type -> Type := {V, I} => Sigma(Tree, {tag} => if (tag == "Yield") { V } else if (tag == "Split") { Pair(Tree, List(I)) } else { Tree })

let RecType := {F} => {
	let mk := fix({Self, _u} => F(pair(
		{E, fl, nx, v, k} => Self(v).fst(E, fl, nx, v, k),
		{u, b, E} => Self(u).snd(u, b, E))))
	mk(t)
}
CoalgOf := {St, F} => RecType({C} => Pair((St -> C) -> F(St) -> F(C), Pair(St -> F(St), St)))
ItemsOf := {St, V} => CoalgOf(St, {X} => ItemStep(V, X))

let until_item_map := SMod.c_until(SMod.stream_new(test, t), test).fst
let until_bound_map := SMod.c_until(SMod.s_new(test, t), test).fst

EmitCoalg := {St, T} => Pair(The(Tree, SMod.emit_map), Pair(St -> Emit(T, St), St))
TaskCoalg := {St, R} => Pair(The(Tree, SMod.halt_map), Pair(St -> Step(R, St), St))
ItemCoalg := {St, V} => Pair(The(Tree, SMod.item_map), Pair(St -> ItemStep(V, St), St))
UntilItemCoalg := {St, V} => Pair(The(Tree, until_item_map), Pair(St -> ItemStep(V, St), St))
UntilBoundCoalg := {St, V} => Pair(The(Tree, until_bound_map), Pair(St -> Step(Unit, ItemStep(V, St)), St))
AnyItemCoalg := {St, V} => Pair(Tree, Pair(St -> ItemStep(V, St), St))

StoppingOf := {St, V} => Pair(St -> Nat, ItemCoalg(St, V))
AnyStoppingOf := {St, V} => Pair(St -> Nat, AnyItemCoalg(St, V))
TakenOf := {St, V} => Pair(List(V), ItemsOf(St, V))
PhaseOf := {T1, T2} => Sigma(Tree, {tag} => if (tag == "Second") { T2 } else { T1 })
RoundOf := {St, V} => Pair(List(V), Pair(List(ItemsOf(St, V)), Bool))
RoundC := {St, V} => Pair(List(V), Pair(List(ItemCoalg(St, V)), Bool))
MergeStateOf := {S1, S2, V} => Pair(ItemsOf(S1, ItemsOf(S2, V)), Pair(List(ItemsOf(S2, V)), Pair(List(V), Pair(Bool, Step(Ending, Unit)))))
MergeStateC := {S1, S2, V} => Pair(ItemCoalg(S1, ItemCoalg(S2, V)), Pair(List(ItemCoalg(S2, V)), Pair(List(V), Pair(Bool, Step(Ending, Unit)))))

let machine_lems := cert_pick(machine_cert, ["Machine.start", "Machine.is_finished", "Machine.unwrap_result", "Machine.advance"])
let length_cert := certify(check_depth, check_fuel, "all", [], [
	pair("length_t", pair(List(Tree) -> Nat, length))
])
let worklist_lems := certify(check_depth, check_fuel, "all", [], [
	pair("append_t", pair(List(Tree) -> List(Tree) -> List(Tree), append)),
	pair("s_yielded_t", pair(ItemCoalg(Pair(List(Tree), List(Tree)), Pair(Tree, Outcome(Tree, Tree))) -> ItemCoalg(Pair(List(Tree), List(Tree)), Tree), SMod.s_yielded))
])
let merge_lems := certify(check_depth, check_fuel, "all", [], [
	pair("is_spent", pair(Ending -> Bool, SMod.is_spent)),
	pair("append_it", pair(List(ItemCoalg(Tree, Tree)) -> List(ItemCoalg(Tree, Tree)) -> List(ItemCoalg(Tree, Tree)), append)),
	pair("c_out_src", pair(ItemCoalg(Tree, ItemCoalg(Tree, Tree)) -> ItemStep(ItemCoalg(Tree, Tree), ItemCoalg(Tree, ItemCoalg(Tree, Tree))), SMod.c_out))
])

stopping_list_cert := certify(check_depth, check_fuel, "none", [length_cert], [
	pair("Stopping.from_list", pair(List(Tree) -> Pair(List(Tree) -> Nat, UntilItemCoalg(List(Tree), Tree)), SMod.stopping_list))
])
worklist_cert := certify(check_depth, check_fuel, "all", [worklist_lems], [
	pair("Items.steps", pair((Tree -> Outcome(Tree, Tree)) -> List(Tree) -> ItemCoalg(Pair(List(Tree), List(Tree)), Pair(Tree, Outcome(Tree, Tree))), SMod.s_steps)),
	pair("Items.worklist", pair((Tree -> Outcome(Tree, Tree)) -> List(Tree) -> ItemCoalg(Pair(List(Tree), List(Tree)), Tree), SMod.s_worklist))
])
merge_with_cert := certify(check_depth, check_fuel, "none", [merge_lems], [
	pair("Items.merge_with", pair(ItemCoalg(Tree, ItemCoalg(Tree, Tree)) -> (List(ItemCoalg(Tree, Tree)) -> RoundC(Tree, Tree)) -> UntilItemCoalg(MergeStateC(Tree, Tree, Tree), Tree), SMod.s_merge_with))
])

let check_module := check_with(check_depth, check_fuel, "none", [machine_lems])

// ---------------------------------------------------------------- 1. Step, Emit, Poll, Ending
Finished : Implicit({R} => Implicit({X} => R -> Step(R, X))) := SMod.finished
Running : Implicit({R} => Implicit({X} => X -> Step(R, X))) := SMod.running
Step.is_finished : Implicit({R} => Implicit({X} => Step(R, X) -> Bool)) := SMod.is_finished
Step.unwrap_result : Implicit({R} => FinishedStep(R) -> R) := SMod.finished_result
Step.unwrap_next : Implicit({X} => RunningStep(X) -> X) := SMod.running_next
Step.result : Implicit({R} => Implicit({X} => Step(R, X) -> Option(R))) := {s} => if (s.fst == "Finished") { Some(s.snd) } else { None }
Step.next : Implicit({R} => Implicit({X} => Step(R, X) -> Option(X))) := {s} => if (s.fst == "Finished") { None } else { Some(s.snd) }
Step.map : Implicit({R} => Implicit({X} => Implicit({Y} => Step(R, X) -> (X -> Y) -> Step(R, Y)))) := {s, f} => SMod.halt_map(f, s)
Step.keep_going : Implicit({R} => Step(R, Unit)) := SMod.keep_going

Emit.new : Implicit({T} => Implicit({X} => T -> X -> Emit(T, X))) := SMod.emit
Emit.item : Implicit({T} => Implicit({X} => Emit(T, X) -> T)) := SMod.emitted
Emit.next : Implicit({T} => Implicit({X} => Emit(T, X) -> X)) := SMod.emit_next
Emit.map : Implicit({T} => Implicit({X} => Implicit({Y} => Emit(T, X) -> (X -> Y) -> Emit(T, Y)))) := {e, f} => SMod.emit_map(f, e)
Emit.map_item : Implicit({T} => Implicit({U} => Implicit({X} => Emit(T, X) -> (T -> U) -> Emit(U, X)))) := {e, f} => SMod.emit_item_map(f, e)

Yield : Implicit({V} => V -> Poll(V)) := SMod.yield
Skip : Implicit({V} => Poll(V)) := SMod.skip
Poll.is_yield : Implicit({V} => Poll(V) -> Bool) := SMod.is_yield
Poll.is_skip : Implicit({V} => Poll(V) -> Bool) := {p} => not(p.fst == "Yield")
Poll.unwrap : Implicit({V} => YieldPoll(V) -> V) := SMod.yielded_item
Poll.value : Implicit({V} => Poll(V) -> Option(V)) := {p} => if (p.fst == "Yield") { Some(p.snd) } else { None }
Poll.map : Implicit({V} => Implicit({W} => Poll(V) -> (V -> W) -> Poll(W))) := {p, f} => SMod.option_map(f, p)
Poll.filter : Implicit({V} => Poll(V) -> (V -> Bool) -> Poll(V)) := {p, pred} => SMod.option_filter(pred, p)

Exhausted : Ending := SMod.exhausted
Spent : Ending := SMod.spent
SpentOn : Tree -> Ending := SMod.spent_on
Ending.is_exhausted : Ending -> Bool := SMod.is_exhausted
Ending.is_spent : Ending -> Bool := SMod.is_spent
Ending.to_verdict : Ending -> Verdict := SMod.ending_verdict

// ---------------------------------------------------------------- 2. Coalgebra core
Coalg.new : Implicit({St} => Implicit({V} => ((St -> ItemsOf(St, V)) -> ItemStep(V, St) -> ItemStep(V, ItemsOf(St, V))) -> (St -> ItemStep(V, St)) -> St -> ItemsOf(St, V))) := SMod.c_new
Coalg.fmap : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> (St -> ItemsOf(St, V)) -> ItemStep(V, St) -> ItemStep(V, ItemsOf(St, V)))) := SMod.c_fmap
Coalg.stepper : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St -> ItemStep(V, St))) := SMod.c_stepper
Coalg.state : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St)) := SMod.c_state
Coalg.with_state : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> St -> ItemsOf(St, V))) := SMod.c_with
Coalg.out : Implicit({St} => Implicit({V} => ItemsOf(St, V) -> ItemStep(V, ItemsOf(St, V)))) := SMod.c_out
Coalg.hoist : Implicit({St} => Implicit({V} => Implicit({W} => ((St -> ItemsOf(St, W)) -> ItemStep(W, St) -> ItemStep(W, ItemsOf(St, W))) -> (ItemStep(V, St) -> ItemStep(W, St)) -> ItemsOf(St, V) -> ItemsOf(St, W)))) := SMod.c_hoist
Coalg.until : Implicit({St} => Implicit({T} => Implicit({R} => EmitCoalg(St, T) -> (St -> Step(R, Unit)) -> CoalgOf(St, {X} => Step(R, Emit(T, X)))))) := SMod.c_until
Coalg.after : Implicit({St} => Implicit({T} => Implicit({R} => EmitCoalg(St, T) -> (Emit(T, St) -> Step(R, Unit)) -> CoalgOf(St, {X} => Step(R, Emit(T, X)))))) := SMod.c_after
Coalg.fold : Implicit({St} => Implicit({V} => Implicit({A} => PartialFn(PartialFn(ItemsOf(St, V), A) -> ItemStep(V, ItemsOf(St, V)) -> A, PartialFn(ItemsOf(St, V), A))))) := SMod.c_fold

// ---------------------------------------------------------------- 3. Stream / Task / Items
Stream.new : Implicit({St} => Implicit({T} => (St -> Emit(T, St)) -> St -> EmitCoalg(St, T))) := SMod.stream_new
Stream.nats : EmitCoalg(Nat, Nat) := SMod.nats
Stream.as_items : Implicit({St} => Implicit({V} => EmitCoalg(St, V) -> ItemCoalg(St, V))) := SMod.as_items
Stream.trace : Machine -> Nat -> EmitCoalg(Machine, Machine) := SMod.m_trace

Task.new : Implicit({St} => Implicit({R} => (St -> Step(R, St)) -> St -> TaskCoalg(St, R))) := SMod.task_new
Task.of_call : Tree -> Tree -> Nat -> TaskCoalg(Machine, Tree) := SMod.task
Task.pure : Implicit({R} => R -> TaskCoalg(R, R)) := SMod.task_return
Task.and_then : Implicit({S1} => Implicit({S2} => Implicit({R} => Implicit({S} => TaskCoalg(S1, R) -> (R -> TaskCoalg(S2, S)) -> TaskCoalg(PhaseOf(TaskCoalg(S1, R), TaskCoalg(S2, S)), S))))) := SMod.task_then
Task.answers : Implicit({St} => Implicit({R} => TaskCoalg(St, R) -> UntilItemCoalg(Step(Unit, TaskCoalg(St, R)), R))) := SMod.answers

Items.new : Implicit({St} => Implicit({V} => (St -> ItemStep(V, St)) -> St -> ItemCoalg(St, V))) := SMod.s_new
Items.from_list : Implicit({V} => List(V) -> UntilItemCoalg(List(V), V)) := SMod.s_from_list
Items.map : Implicit({St} => Implicit({V} => Implicit({W} => AnyItemCoalg(St, V) -> (V -> W) -> ItemCoalg(St, W)))) := SMod.s_map
Items.filter : Implicit({St} => Implicit({V} => AnyItemCoalg(St, V) -> (V -> Bool) -> ItemCoalg(St, V))) := SMod.s_filter
Items.bounded : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> Nat -> ItemCoalg(Budget(St), V))) := SMod.bounded
Items.take : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(Nat, TakenOf(St, V))))) := SMod.s_take
Items.all : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(V -> Bool, Bool)))) := SMod.s_all
Items.ending : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), Ending))) := SMod.s_ending
Items.upto : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), PartialFn(V -> Bool, List(V))))) := SMod.s_upto
Items.collect : Implicit({St} => Implicit({V} => PartialFn(ItemsOf(St, V), List(V)))) := SMod.s_list
Items.verdict : Implicit({St} => PartialFn(ItemsOf(St, Tree), Verdict)) := SMod.verdict
Items.yielded : Implicit({St} => ItemCoalg(St, Pair(Tree, Outcome(Tree, Tree))) -> ItemCoalg(St, Tree)) := SMod.s_yielded

// ---------------------------------------------------------------- 4. Budget, Stopping, Taken, Round, Outcomes
Stopping.new : Implicit({St} => Implicit({V} => ItemCoalg(St, V) -> (St -> Nat) -> StoppingOf(St, V))) := SMod.stopping
Stopping.measure : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> St -> Nat)) := SMod.stopping_measure
Stopping.items : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> ItemCoalg(St, V))) := SMod.stopping_items
Stopping.fuel : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> Nat)) := SMod.stopping_fuel
Stopping.settle : Implicit({St} => Implicit({V} => StoppingOf(St, V) -> ItemCoalg(Budget(St), V))) := SMod.settle
Stopping.map : Implicit({St} => Implicit({V} => Implicit({W} => AnyStoppingOf(St, V) -> (V -> W) -> StoppingOf(St, W)))) := SMod.stopping_map
Stopping.filter : Implicit({St} => Implicit({V} => AnyStoppingOf(St, V) -> (V -> Bool) -> StoppingOf(St, V))) := SMod.stopping_filter

Taken.new : Implicit({St} => Implicit({V} => List(V) -> ItemsOf(St, V) -> TakenOf(St, V))) := SMod.taken
Taken.items : Implicit({St} => Implicit({V} => TakenOf(St, V) -> List(V))) := SMod.s_items
Taken.rest : Implicit({St} => Implicit({V} => TakenOf(St, V) -> ItemsOf(St, V))) := SMod.s_rest

Round.new : Implicit({St} => Implicit({V} => List(V) -> List(ItemsOf(St, V)) -> Bool -> RoundOf(St, V))) := SMod.round
Round.found : Implicit({St} => Implicit({V} => RoundOf(St, V) -> List(V))) := SMod.round_found
Round.survivors : Implicit({St} => Implicit({V} => RoundOf(St, V) -> List(ItemsOf(St, V)))) := SMod.round_survivors
Round.dropped_spent : Implicit({St} => Implicit({V} => RoundOf(St, V) -> Bool)) := SMod.round_dropped_spent
Round.advance_head : Implicit({St} => Implicit({V} => NonEmpty(ItemsOf(St, V)) -> RoundOf(St, V))) := SMod.advance_head
Round.advance_all : Implicit({St} => Implicit({V} => List(ItemsOf(St, V)) -> RoundOf(St, V))) := SMod.advance_all

Noted : Implicit({V} => Implicit({I} => Tree -> Outcome(V, I))) := SMod.noted
SplitOn : Implicit({V} => Implicit({I} => Tree -> List(I) -> Outcome(V, I))) := SMod.split_on
SplitInto : Implicit({V} => Implicit({I} => List(I) -> Outcome(V, I))) := SMod.split_into

// Scoped-lemma combinators (certified above; pinned with `is_cert` = true)
Stopping.from_list := SMod.stopping_list
Items.steps := SMod.s_steps
Items.worklist := SMod.s_worklist
Items.merge_with := SMod.s_merge_with
stopping_list_verified : The(Bool, true) := is_cert(stopping_list_cert)
worklist_verified : The(Bool, true) := is_cert(worklist_cert)
merge_with_verified : The(Bool, true) := is_cert(merge_with_cert)
