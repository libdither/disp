// Recreating lib/theories/{cube,system_t,mltt}.test.disp directly on eval_types.disp.
// Every type former is a `(check, assume)` evaluator-map combinator; zero ASTs, zero custom ops.
open use raw "../prelude.disp" {}
open use raw "../list.disp" {}
open use raw "kernel.disp" {}

rec NatP :: {v : Tree} -> Bool :=> if (is_leaf(v)) { true } else if (is_fork(v)) { if (is_leaf(v.fst)) { NatP(v.snd) } else { false } } else { false }
BitP :: {v : Tree} -> Bool :=> if (is_leaf(v)) { true } else if (is_stem(v)) { is_leaf(stem_child(v)) } else { false }

Nat := data_t(NatP)
Bit := data_t(BitP)
NN := fn_t(Nat, Nat)
NNN := fn_t(Nat, NN)

rec args_pred :: {kinds : List(Tree)} -> Tree :=>
	if (kinds.is_nil) { {_self, v} => is_leaf(v) }
	else {
		let here := if (kinds.head == "Rec") { {self} => self } else { {_self} => kinds.head }
		let rest := args_pred(kinds.tail)
		{self, v} => if (is_fork(v)) { if (here(self)(v.fst)) { rest(self, v.snd) } else { false } } else { false }
	}
rec ctor_pred :: {shapes : List(List(Tree))} -> Tree :=>
	if (shapes.is_nil) { {_self, _tag, _args} => false }
	else {
		let here := args_pred(shapes.head)
		let rest := ctor_pred(shapes.tail)
		{self, tag, args} => if (is_leaf(tag)) { here(self, args) } else if (is_fork(tag)) { if (is_leaf(tag.fst)) { rest(self, tag.snd, args) } else { false } } else { false }
	}
data_pred :: {shapes : List(List(Tree))} -> Tree :=> {
	let check := ctor_pred(shapes)
	fix({self, v} => if (is_fork(v)) { check(self, v.fst, v.snd) } else { false })
}
data_desc :: {shapes : List(List(Tree))} -> Tree :=> data_t(data_pred(shapes))

// ================================================================ 1. Lambda Cube (cube.test.disp)
Base := Nat
Other := Bit

id_base := {x} => x
id_base_ty := fn_t(Base, Base)
test accepts(id_base_ty, id_base) = true

compose := {f, g, x} => f(g(x))
compose_ty := fn_t(fn_t(Other, Base), fn_t(fn_t(Base, Other), fn_t(Base, Base)))
test accepts(compose_ty, compose) = true
test compose({b} => if (b) { 1 } else { 0 }, is_zero, 0) = 1
bad_compose_ty := fn_t(fn_t(Base, Other), fn_t(fn_t(Other, Base), fn_t(Base, Base)))
test accepts(bad_compose_ty, compose) = false
test is_found(refute_at(bad_compose_ty, compose, 64)) = true
omega_term := {x} => x(x)
test accepts(fn_t(fn_t(Base, Base), Base), omega_term) = false
test is_found(refute_at(fn_t(fn_t(Base, Base), Base), omega_term, 64)) = true

// System F
poly_id := {X, x} => x
poly_id_ty := forall_t({X} => fn_t(X, X))
test accepts(poly_id_ty, poly_id) = true

church_nat := forall_t({X} => fn_t(fn_t(X, X), fn_t(X, X)))
church_two := {X, f, x} => f(f(x))
church_plus := {m, n, X, f, x} => m(X, f, n(X, f, x))
test accepts(church_nat, church_two) = true
test accepts(fn_t(church_nat, fn_t(church_nat, church_nat)), church_plus) = true
test church_plus(church_two, church_two, Nat, succ, 0) = 4

church_bool := forall_t({X} => fn_t(X, fn_t(X, X)))
yes_term := {X, a, _b} => a
stray := {X, _a, _b} => Other
test accepts(church_bool, yes_term) = true
test accepts(church_bool, stray) = false
test is_found(refute_at(church_bool, stray, 64)) = true

// Type operators
twice_op := {X} => fn_t(X, X)
endo_base := twice_op(Base)
test accepts(fn_t(endo_base, id_base_ty), {f} => f) = true

// LF (dependent types)
family := {_x} => Other
same_fam := {_x, y} => y
test accepts(pi_t(Base, {x} => fn_t(family(x), family(x))), same_fam) = true
test accepts(pi_t(Base, {_x} => fn_t(Other, Other)), same_fam) = true
test accepts(pi_t(Base, {_x} => fn_t(Other, Base)), same_fam) = false
test is_found(refute_at(pi_t(Base, {_x} => fn_t(Other, Base)), same_fam, 64)) = true

// System F-omega
pair_op := {A, B} => forall_t({R} => fn_t(fn_t(A, fn_t(B, R)), R))
mk_pair := {A, B, a, b, R, k} => k(a, b)
mk_pair_ty := forall_t({A} => forall_t({B} => fn_t(A, fn_t(B, pair_op(A, B)))))
test accepts(mk_pair_ty, mk_pair) = true
test mk_pair(Nat, Nat, 3, 4, Nat, {a, _b} => a) = 3
test mk_pair(Nat, Nat, 3, 4, Nat, {_a, b} => b) = 4

poly_op := {F, X, x} => x
poly_op_ty := forall_fam_t({F} => forall_t({X} => fn_t(F(X), F(X))))
test accepts(poly_op_ty, poly_op) = true

// lambda-P2
eq_base := {x, y} => forall_fam_t({P} => fn_t(P(x), P(y)))
refl_base := {x, P, px} => px
test accepts(pi_t(Base, {x} => eq_base(x, x)), refl_base) = true
wrong_refl := {x, y, P, px} => px
test accepts(pi_t(Base, {x} => pi_t(Base, {y} => eq_base(x, y))), wrong_refl) = false
test is_found(refute_at(pi_t(Base, {x} => pi_t(Base, {y} => eq_base(x, y))), wrong_refl, 64)) = true
trans_base := {x, y, z, xy, yz, P, px} => yz(P, xy(P, px))
trans_ty := pi_t(Base, {x} => pi_t(Base, {y} => pi_t(Base, {z} => fn_t(eq_base(x, y), fn_t(eq_base(y, z), eq_base(x, z))))))
test accepts(trans_ty, trans_base) = true
poly_family := {P, x, px} => px
test accepts(forall_fam_t({P} => pi_t(Base, {x} => fn_t(P(x), P(x)))), poly_family) = true

// lambda-P-omega-under
imp_self := {P, x} => fn_t(P(x), P(x))
built := {x} => imp_self(family, x)
use_built := {x, f} => f
test accepts(pi_t(Base, {x} => fn_t(built(x), fn_t(Other, Other))), use_built) = true
test accepts(pi_t(Base, {x} => fn_t(built(x), fn_t(Other, Base))), use_built) = false

// Calculus of Constructions
leibniz := {A, x, y} => forall_fam_t({P} => fn_t(P(x), P(y)))
refl_any := {A, x, P, px} => px
refl_any_ty := forall_t({A} => pi_t(A, {x} => leibniz(A, x, x)))
test accepts(refl_any_ty, refl_any) = true
sym_any := {A, x, y, xy} => xy({z} => leibniz(A, z, x), refl_any(A, x))
sym_any_ty := forall_t({A} => pi_t(A, {x} => pi_t(A, {y} => fn_t(leibniz(A, x, y), leibniz(A, y, x)))))
test accepts(sym_any_ty, sym_any) = true
bad_sym_ty := forall_t({A} => pi_t(A, {x} => pi_t(A, {y} => fn_t(leibniz(A, x, y), leibniz(A, x, x)))))
test accepts(bad_sym_ty, sym_any) = false

// ================================================================ 2. System T (system_t.test.disp)
nat_iter := {A, z, s} => fix({self, n} => if (is_zero(n)) { z } else { s(nat_pred(n), self(nat_pred(n))) })
IterT := forall_t({A} => fn_t(A, fn_t(fn_t(Nat, fn_t(A, A)), fn_t(Nat, A))))
test accepts(IterT, nat_iter) = true

plus_t := {n} => nat_iter(Nat, n, {_k, r} => succ(r))
times_t := {n} => nat_iter(Nat, 0, {_k, r} => plus_t(n, r))
ack_t := {m} => nat_iter(NN, {n} => succ(n), {_k, f} => {n} => nat_iter(Nat, f(1), {_j, r} => f(r), n), m)

test accepts(NNN, plus_t) = true
test why([pair(plus_t, NNN)], NNN, times_t) = yes
test accepts(NNN, ack_t) = true
test plus_t(2, 3) = 5
test times_t(3, 3) = 9
test ack_t(2, 2) = 7

lie := {_a, b} => b
test accepts(NN, lie) = false
test is_found(refute_at(NN, lie, 64)) = true
test accepts(NN, {n} => n(n)) = false
test is_found(refute_at(NN, {n} => n(n), 16)) = true
test accepts(bounded_t(Nat, Nat, {_a} => 500), {n} => plus_t(n, 2)) = true
test accepts(bounded_t(Nat, Nat, {_a} => 500), {n} => plus_t(2, n)) = false

// ================================================================ 3. MLTT (mltt.test.disp)
nat_ind := {P, z, s} => fix({self, n} => if (is_zero(n)) { z } else { s(nat_pred(n), self(nat_pred(n))) })
NatIndT := forall_fam_t({P} => fn_t(P(0), fn_t(pi_t(Nat, {k} => fn_t(P(k), P(succ(k)))), pi_t(Nat, P))))
test accepts(NatIndT, nat_ind) = true

transport_nat := {P, _x, _y, _eq, d} => d
TransportNatT := forall_fam_t({P} => pi_t(Nat, {x} => pi_t(Nat, {y} => fn_t(eq_t(x, y), fn_t(P(x), P(y))))))
test accepts(TransportNatT, transport_nat) = true

rec plus_n :: {a : Tree, b : Tree} -> Tree :=> if (is_zero(a)) { b } else { succ(plus_n(nat_pred(a), b)) }
test accepts(NNN, plus_n) = true

test accepts(pi_t(Nat, {n} => eq_t(plus_n(0, n), n)), {_n} => t) = true

plus_zero_ty := pi_t(Nat, {n} => eq_t(plus_n(n, 0), n))
test accepts(plus_zero_ty, {_n} => t) = false
plus_zero_direct := nat_ind({n} => eq_t(plus_n(n, 0), n), t, {_k, ih} => ih)
test accepts(plus_zero_ty, plus_zero_direct) = true

false_ty := pi_t(Nat, {n} => eq_t(plus_n(n, n), n))
test accepts(false_ty, {_n} => t) = false
test is_found(refute_at(false_ty, {_n} => t, 64)) = true
plus_self_bad := nat_ind({n} => eq_t(plus_n(n, n), n), t, {_k, ih} => ih)
test accepts(false_ty, plus_self_bad) = false
test is_found(refute_at(false_ty, plus_self_bad, 64)) = true

double_spec := pi_t(Nat, {n} => sigma_t(Nat, {m} => eq_t(m, plus_n(n, n))))
double_proof := {n} => pair(plus_n(n, n), t)
test why([pair(plus_n, NNN)], double_spec, double_proof) = yes
test double_proof(3).fst = 6
test accepts(double_spec, {n} => pair(n, t)) = false
test is_found(refute_at(double_spec, {n} => pair(n, t), 64)) = true

// Booleans
bool_d := [[], []]
BoolD := data_desc(bool_d)
b_yes := pair(0, [])
b_no := pair(1, [])
flip := {b} => if (is_zero(b.fst)) { b_no } else { b_yes }
test accepts(fn_t(BoolD, BoolD), flip) = true
flip_twice := pi_t(BoolD, {b} => eq_t(flip(flip(b)), b))
test accepts(flip_twice, {_b} => t) = true
test accepts(pi_t(BoolD, {b} => eq_t(flip(b), b)), {_b} => t) = false

// Lists of Nats
list_d := [[], [NatP, "Rec"]]
ListD := data_desc(list_d)
l_empty := pair(0, [])
l_push := {h, rest} => pair(1, [h, rest])
pair_list := l_push(0, l_push(2, l_empty))
test accepts(ListD, pair_list) = true
test accepts(ListD, l_push(pair_list, l_empty)) = false
test accepts(ListD, pair(1, [l_empty, t])) = false
test accepts(ListD, pair(1, [0])) = false
test accepts(ListD, pair(5, [])) = false

rec len_d :: {xs : Tree} -> Tree :=> if (is_zero(xs.fst)) { 0 } else { succ(len_d(xs.snd.tail.head)) }
test accepts(fn_t(ListD, Nat), len_d) = true
test len_d(pair_list) = 2
test accepts(eq_t(len_d(pair_list), 2), t) = true

rec append_d :: {xs : Tree, ys : Tree} -> Tree :=>
	if (is_zero(xs.fst)) { ys } else { l_push(xs.snd.head, append_d(xs.snd.tail.head, ys)) }
test accepts(fn_t(ListD, fn_t(ListD, ListD)), append_d) = true

append_empty_ty := pi_t(ListD, {xs} => eq_t(append_d(xs, l_empty), xs))
test accepts(append_empty_ty, {_xs} => t) = false
rec append_empty :: {xs : Tree} -> Tree :=>
	if (is_zero(xs.fst)) { t } else { append_empty(xs.snd.tail.head) }
test accepts(append_empty_ty, append_empty) = true

// Binary Trees
tree_d := [[], ["Rec", "Rec"]]
TreeD := data_desc(tree_d)
t_tip := pair(0, [])
t_fork := {l, r} => pair(1, [l, r])
rec size_d :: {tr : Tree} -> Tree :=>
	if (is_zero(tr.fst)) { 1 } else { succ(plus_n(size_d(tr.snd.head), size_d(tr.snd.tail.head))) }
test why([pair(plus_n, NNN)], fn_t(TreeD, Nat), size_d) = yes
test size_d(t_fork(t_tip, t_fork(t_tip, t_tip))) = 5
