open use raw "prelude.disp" {}

// No comments in this file beyond this one; the code is meant to be self-explanatory.
// Unused-looking defs below may be compiler sugar targets looked up by name:
// make_record + list_const (record literals), Coproduct (sum literals), prod (match).

nil := t
cons := {h, tl} -> t h tl
list_const := {x} -> t t x
make_record := {names, payload} -> pair names payload
inj := {name, payload} -> pair name payload
Coproduct := {variants} -> variants
Tree := t
prod := {table} -> (fix ({go, names, arms, v} ->
  if (is_leaf names) {
    if (is_leaf arms) { t } else { (pair_fst arms) (pair_snd v) }
  } else if (tree_eq (pair_fst names) (pair_fst v)) {
    (pair_fst arms) (pair_snd v)
  } else {
    go (pair_snd names) (pair_snd arms) v
  })) (pair_fst table) (pair_snd table)

wait_payload := {w} -> pair_snd (pair_snd w)
sig_of := {marker} -> pair_fst (wait marker t)
has_sig := {sig, v} -> and (is_fork v) (tree_eq (pair_fst v) sig)

hyp_marker := {a, b} -> a
make_mark := {meta} -> wait hyp_marker meta
make_hyp := {ty, history} -> make_mark (pair ty history)
hyp_sig := sig_of hyp_marker
is_neutral := {v} -> has_sig hyp_sig v
neutral_type := {v} -> pair_fst (wait_payload v)
neutral_history := {v} -> pair_snd (wait_payload v)

invalid_marker := {a, b} -> b
invalid := {reason} -> wait invalid_marker reason
invalid_sig := sig_of invalid_marker
is_invalid := {v} -> has_sig invalid_sig v

member := fix ({self, node, xs} ->
  if (is_leaf xs) { false } else if (tree_eq node (pair_fst xs)) { true } else { self node (pair_snd xs) })

resumable := fix ({self, payload, arg} -> (pair_fst payload) (wait self payload) arg)
make_type := {recognize, gate, members, elim} -> wait resumable (pair recognize (pair gate (pair members elim)))
type_recognizer := {T} -> pair_fst (wait_payload T)
type_gate := {T} -> pair_fst (pair_snd (wait_payload T))
type_members := {T} -> pair_fst (pair_snd (pair_snd (wait_payload T)))
type_elim := {T} -> pair_snd (pair_snd (pair_snd (wait_payload T)))
inert_gate := {_check, _Pi, _Ind, _B, _ca, _cb} -> false

elim_of := {Ind, B} -> wait resumable (pair (type_elim Ind) (pair Ind B))
elim_raw := {E} -> pair_fst (wait_payload E)
elim_ind := {E} -> pair_fst (pair_snd (wait_payload E))
elim_motive := {E} -> pair_snd (pair_snd (wait_payload E))
elim_sig := sig_of resumable
is_elim_head := {f} -> has_sig elim_sig f

raw_nat_rec := {self, n, base, step} ->
  triage base ({_} -> base) ({_l, k} -> step k (self k base step)) n
NatType := make_type
  ({self, v} -> triage true ({_} -> false) ({l, r} -> and (tree_eq l t) (self r)) v)
  ({check, Pi, Nat, B, base, step} -> and
    (check (B zero) base)
    (check (Pi Nat ({k} -> Pi (B k) ({_} -> B (succ k)))) step))
  nil
  raw_nat_rec
nat_rec := elim_of NatType ({_} -> NatType)
add := {n, m} -> nat_rec n m ({k, ih} -> succ ih)

raw_bool_rec := {_self, b, true_case, false_case} ->
  triage true_case ({_} -> false_case) ({_l, _r} -> true_case) b
BoolType := make_type
  ({_self, v} -> triage true ({c} -> tree_eq c t) ({l, r} -> false) v)
  ({check, _Pi, _Bool, B, true_case, false_case} -> and
    (check (B true) true_case)
    (check (B false) false_case))
  (cons true (cons false nil))
  raw_bool_rec
bool_rec := elim_of BoolType ({_} -> BoolType)
not_bool := {b} -> bool_rec b false true

Point := {c} -> make_type ({_self, v} -> tree_eq c v) inert_gate (cons c nil) t

list_all := fix ({self, p, xs} ->
  if (is_leaf xs) { true } else { and (p (pair_fst xs)) (self p (pair_snd xs)) })
list_map := fix ({self, f, xs} ->
  if (is_leaf xs) { nil } else { cons (f (pair_fst xs)) (self f (pair_snd xs)) })

Row := < Fresh : Tree, JApply : Tree, JSelf : Tree, JProj : Tree, JGuard : Tree >
pi_tele := {A, B} -> pair (Fresh A) ({x} -> pair (JApply (B x)) ({_} -> nil))
isect_tele := {A, P} -> pair (Fresh A) ({x} -> pair (JSelf (P x)) ({_} -> nil))
sigma_tele := {A, B} -> pair (JGuard is_fork) ({_} ->
  pair (JProj (pair pair_fst A)) ({a} ->
  pair (JProj (pair pair_snd (B a))) ({_} -> nil)))

make_table := {admit, lift, fresh, apply, read, judge} ->
  pair admit (pair lift (pair fresh (pair apply (pair read judge))))
table_admit := {table} -> pair_fst table
table_lift := {table} -> pair_fst (pair_snd table)
table_fresh := {table} -> pair_fst (pair_snd (pair_snd table))
table_apply := {table} -> pair_fst (pair_snd (pair_snd (pair_snd table)))
table_read := {table} -> pair_fst (pair_snd (pair_snd (pair_snd (pair_snd table))))
table_judge := {table} -> pair_snd (pair_snd (pair_snd (pair_snd (pair_snd table))))

Tele := {table, tele, descriptor} -> {
  let admit := table_admit table
  let lift := table_lift table
  let fresh := table_fresh table
  let apply := table_apply table
  let read := table_read table
  let judge := table_judge table
  let run := fix ({chk, st, rows, fV, prior} ->
    if (is_leaf rows) { true } else {
      let row := pair_fst rows
      let tail := pair_snd rows
      match row {
        Fresh ty => {
          let points := fresh st ty tail
          if (is_leaf points) { false } else {
            list_all ({p} -> chk (pair_snd p) (tail (read (pair_fst p))) fV (pair_fst p)) points
          }
        }
        JApply ty => {
          let r := apply chk fV prior
          if (judge chk st ty r) { chk st (tail (read r)) fV prior } else { false }
        }
        JSelf ty => (if (judge chk st ty fV) { chk st (tail (read fV)) fV prior } else { false })
        JProj acc ty => {
          let ob := acc (read fV)
          if (judge chk st ty (lift ob)) { chk st (tail ob) fV prior } else { false }
        }
        JGuard p => (if (p (read fV)) { chk st (tail (read fV)) fV prior } else { false })
      }
    })
  make_type ({_self, f} -> if (admit f) { run t tele (lift f) t } else { false }) inert_gate nil descriptor
}

Pi := {table, A, B} -> Tele table (pi_tele A B) (inj "Pi" (pair A B))
Sigma := {table, A, B} -> Tele table (sigma_tele A B) t
Isect := {table, A, P} -> Tele table (isect_tele A P) (inj "ISect" (pair A P))

Enum := {
  let admit := {_f} -> true
  let lift := {f} -> f
  let fresh := {st, ty, _tail} -> list_map ({a} -> pair a st) (type_members ty)
  let apply := {_chk, f, a} -> f a
  let read := {a} -> a
  let judge := {_chk, _st, T, r} -> T r
  make_table admit lift fresh apply read judge
}
Sampled := {samples} -> {
  let admit := {_f} -> true
  let lift := {f} -> f
  let fresh := {st, _ty, _tail} -> list_map ({a} -> pair a st) samples
  let apply := {_chk, f, a} -> f a
  let read := {a} -> a
  let judge := {_chk, _st, T, r} -> T r
  make_table admit lift fresh apply read judge
}

Meta := {
  let Value := < Conc : Tree, Neu : Tree, Stem : Tree, Fork : Tree, Poison : Tree, Chain1 : Tree, Chain2 : Tree >
  let teq_sig := sig_of tree_eq
  let vstem := {V} -> if let Conc c = V { Conc (t c) } else { Stem V }
  let vfork := {L, R} -> if let Conc lc = L { if let Conc rc = R { Conc (t lc rc) } else { Fork (pair L R) } } else { Fork (pair L R) }
  let readback := (fix ({rb, V} ->
    match V {
      Conc tr => tr
      Neu m => (make_mark m)
      Stem c => (t (rb c))
      Fork l r => (t (rb l) (rb r))
      Poison r => (invalid r)
      Chain1 e scr => (invalid (pair e scr))
      Chain2 e scr ca => (invalid (pair e (pair scr ca)))
    }))
  let collect := (fix ({co, V, acc} ->
    match V {
      Conc tr => acc
      Neu m => (cons (make_mark m) acc)
      Stem c => (co c acc)
      Fork l r => (co l (co r acc))
      Poison r => acc
      Chain1 e scr => acc
      Chain2 e scr ca => acc
    }))
  let verify_inband := (fix ({vf, minted, T, v} ->
    if (is_invalid v) {
      false
    } else if (is_neutral v) {
      and (tree_eq (neutral_type v) T) (member v minted)
    } else {
      (type_recognizer T) (wait (wait vf minted) T) v
    }))
  let vcheck := ({chk, T, V} ->
    match V {
      Poison r => false
      Neu ty _ => (tree_eq ty T)
      _ => (if let Pi dom cod = (type_elim T) {
        chk t (pi_tele dom cod) V t
      } else if let Conc tr = V {
        T tr
      } else {
        verify_inband (collect V nil) T (readback V)
      })
    })
  let s_rule := ({self, chk, C, TB, X} -> self chk (self chk C X) (self chk TB X))
  let triage_case := ({self, chk, TC, TD, TB, X} ->
    match X {
      Conc xt => (triage TC ({u} -> self chk TD (Conc u)) ({l, r} -> self chk (self chk TB (Conc l)) (Conc r)) xt)
      Neu m => (if (and (tree_eq TC (Conc t)) (and (tree_eq TD (Conc t)) (tree_eq TB (Conc t)))) { Neu m } else { Poison (Neu m) })
      Stem c => (self chk TD c)
      Fork l r => (self chk (self chk TB l) r)
      Poison r => (Poison r)
      Chain1 e scr => (Poison (Chain1 (pair e scr)))
      Chain2 e scr ca => (Poison (Chain2 (pair e (pair scr ca))))
    })
  let apply_fork := ({self, chk, A, TB, X} ->
    match A {
      Conc at => (if (is_leaf at) {
        TB
      } else if (is_stem at) {
        s_rule self chk (Conc (stem_child at)) TB X
      } else {
        triage_case self chk (Conc (pair_fst at)) (Conc (pair_snd at)) TB X
      })
      Stem c => (s_rule self chk c TB X)
      Fork tc td => (triage_case self chk tc td TB X)
      Neu m => (Poison (Neu m))
      Poison r => (Poison r)
      Chain1 e scr => (Poison (Chain1 (pair e scr)))
      Chain2 e scr ca => (Poison (Chain2 (pair e (pair scr ca))))
    })
  let absorb_v := ({chk, E, scr, ca, cb} -> {
    let Ind := elim_ind E
    let B := elim_motive E
    let GatePi := {dom, cod} -> make_type ({_self, f} -> chk t (pi_tele dom cod) (Conc f) t) inert_gate nil (inj "Pi" (pair dom cod))
    let vch := vcheck chk
    if let Neu sTy _ = scr {
      if (and (tree_eq sTy Ind) (tree_eq (elim_raw E) (type_elim Ind))) {
        if ((type_gate Ind) vch GatePi Ind B ca cb) {
          Neu (pair (B (readback scr)) (pair scr (pair B (pair ca cb))))
        } else {
          Poison E
        }
      } else {
        Poison scr
      }
    } else {
      Poison scr
    }
  })
  let mwalk := (fix ({self, chk, F, X} ->
    if let Poison _ = X {
      X
    } else {
      match F {
        Conc tr => (if (tree_eq tr is_neutral) {
          Conc false
        } else if (or (tree_eq tr tree_eq) (has_sig teq_sig tr)) {
          (if let Conc xt = X { Conc (tr xt) } else { Poison X })
        } else if let Conc xt = X {
          Conc (tr xt)
        } else if (is_elim_head tr) {
          if let Neu m = X { Chain1 (pair tr X) } else { self chk (Conc ((elim_raw tr) tr)) X }
        } else {
          triage (vstem X) ({a} -> vfork (Conc a) X) ({a, b} -> apply_fork self chk (Conc a) (Conc b) X) tr
        })
        Neu m => (if let Pi dom cod = (type_elim (pair_fst m)) {
          if (vcheck chk dom X) { Neu (pair (cod (readback X)) (pair "Sp" (pair m X))) } else { Poison (Neu m) }
        } else { Poison (Neu m) })
        Poison r => (Poison r)
        Chain1 e scr => (Chain2 (pair e (pair scr X)))
        Chain2 e scr ca => (absorb_v chk e scr ca X)
        Stem c => (vfork c X)
        Fork a b => (apply_fork self chk a b X)
      }
    }))
  let admit := {_f} -> true
  let lift := {f} -> Conc f
  let fresh := {st, ty, tail} -> cons (pair (Neu (pair ty tail)) st) nil
  let apply := {chk, fV, x} -> mwalk chk fV x
  let read := readback
  let judge := {chk, _st, T, r} -> vcheck chk T r
  make_table admit lift fresh apply read judge
}

neutral_free := fix ({self, v} ->
  if (is_neutral v) { false } else { triage true ({c} -> self c) ({l, r} -> and (self l) (self r)) v })

GuardAt := {on_is_neutral, on_tree_eq} -> {
  let cert_absorb := ({E, scr, ca, cb} -> {
    let Ind := elim_ind E
    let B := elim_motive E
    if (and (tree_eq (neutral_type scr) Ind) (tree_eq (elim_raw E) (type_elim Ind))) {
      make_hyp (B scr) (pair scr (pair B (pair ca cb)))
    } else {
      invalid scr
    }
  })
  let shim := fix ({sm, payload, arg} -> {
    let E := pair_fst payload
    let acc := pair_snd payload
    if (is_leaf acc) {
      if (is_neutral arg) { wait sm (pair E (cons arg nil)) } else { (elim_raw E) (wait sm (pair E nil)) arg }
    } else if (is_leaf (pair_snd acc)) {
      wait sm (pair E (cons (pair_fst acc) (cons arg nil)))
    } else {
      cert_absorb E (pair_fst acc) (pair_fst (pair_snd acc)) arg
    }
  })
  let shim_sig := sig_of shim
  let is_shim := {v} -> has_sig shim_sig v
  let tree_eq_sig := sig_of tree_eq
  let is_teq_partial := {v} -> has_sig tree_eq_sig v
  let w_stem := {a, x} -> {
    let r := t a x
    if (is_neutral r) { invalid r } else { r }
  }
  let w_s := {self, c, b, x} -> {
    let cx := self c x
    if (is_invalid cx) { cx } else {
      let bx := self b x
      if (is_invalid bx) { bx } else { self cx bx }
    }
  }
  let w_tfk := {self, b, l, r} -> {
    let bl := self b l
    if (is_invalid bl) { bl } else { self bl r }
  }
  let w_fork := {self, a, b, x} ->
    (triage
      b
      ({c} -> w_s self c b x)
      ({tc, td} ->
        if (is_neutral x) { invalid x }
        else { triage tc ({ci} -> self td ci) ({l, r} -> w_tfk self b l r) x })
      a)
  let hyp_apply := {f, x} ->
    if let Pi dom cod = (type_elim (neutral_type f)) {
      make_hyp (cod x) (pair "Sp" (pair f x))
    } else {
      invalid f
    }
  let walk := fix ({self, f, x} ->
    if (is_invalid f) { f }
    else if (tree_eq f tree_eq) { on_tree_eq ({_} -> wait tree_eq x) x }
    else if (is_teq_partial f) { on_tree_eq ({_} -> f x) x }
    else if (tree_eq f is_neutral) { on_is_neutral ({_} -> is_neutral x) x }
    else if (is_neutral f) { hyp_apply f x }
    else if (is_elim_head f) { (wait shim (pair f nil)) x }
    else if (is_shim f) { f x }
    else if (tree_eq f ({x} -> x)) { x }
    else { triage (t x) ({a} -> w_stem a x) ({a, b} -> w_fork self a b x) f })
  let hyp_ok := (fix ({ok, vch, Pi, legit, v} ->
    if (member v legit) {
      true
    } else {
      let hist := neutral_history v
      if (tree_eq (pair_fst hist) "Sp") {
        let parent := pair_fst (pair_snd hist)
        let frame := pair_snd (pair_snd hist)
        if let Pi dom cod = (type_elim (neutral_type parent)) {
          and (ok vch Pi legit parent) (vch dom frame)
        } else {
          false
        }
      } else {
        let scr := pair_fst hist
        let B := pair_fst (pair_snd hist)
        let ca := pair_fst (pair_snd (pair_snd hist))
        let cb := pair_snd (pair_snd (pair_snd hist))
        if (is_neutral scr) {
          let Ind := neutral_type scr
          and (ok vch Pi legit scr) (and (tree_eq (neutral_type v) (B scr)) ((type_gate Ind) vch Pi Ind B ca cb))
        } else {
          false
        }
      }
    }))
  let admit := neutral_free
  let lift := {f} -> f
  let fresh := {st, ty, tail} -> {
    let x := make_hyp ty tail
    cons (pair x (cons x st)) nil
  }
  let apply := {_chk, f, x} -> walk f x
  let read := {x} -> x
  let judge := {chk, st, T, v} -> {
    let PiF := {dom, cod} -> make_type ({_self, g} -> chk st (pi_tele dom cod) g t) inert_gate nil (inj "Pi" (pair dom cod))
    (fix ({vf, T2, v2} ->
      if (is_invalid v2) {
        false
      } else if (is_neutral v2) {
        and (tree_eq (neutral_type v2) T2) (hyp_ok vf PiF st v2)
      } else if let Pi dom cod = (type_elim T2) {
        chk st (pi_tele dom cod) v2 t
      } else if let ISect dom pred = (type_elim T2) {
        chk st (isect_tele dom pred) v2 t
      } else {
        (type_recognizer T2) (wait vf T2) v2
      })) T v
  }
  make_table admit lift fresh apply read judge
}
Guard := GuardAt
  ({_resume, _x} -> false)
  ({resume, x} -> if (neutral_free x) { resume t } else { invalid x })
Ambient := GuardAt
  ({resume, _x} -> resume t)
  ({resume, _x} -> resume t)

Five := Point 5
Six := Point 6
MetaNatToNat := Pi Meta NatType ({_} -> NatType)
GuardNatToNat := Pi Guard NatType ({_} -> NatType)
EnumBoolToBool := Pi Enum BoolType ({_} -> BoolType)
EnumNatToNat := Pi Enum NatType ({_} -> NatType)
FiveToNat := Pi Enum Five ({_} -> NatType)
FiveToSix := Pi Enum Five ({_} -> Six)

forge_hyp := make_hyp
shift := {b} -> if (is_neutral b) { true } else { 5 }
junk_raw := {_self, n, base, step} -> base
unblessed_rec := wait (fix ({em, payload, x} -> (pair_fst payload) (wait em payload) x)) (pair junk_raw (pair NatType ({_} -> BoolType)))
elim_id := {n} -> nat_rec n zero ({k, ih} -> succ ih)

pi_suite := {Pi} -> {
  let BB := Pi BoolType ({_} -> BoolType)
  ({ negation := BB not_bool, identity := BB ({b} -> b), junk_arm := BB ({b} -> bool_rec b 5 true), sniff := BB shift })
}
pi_expected := { negation := true, identity := true, junk_arm := false, sniff := false }

fn_suite := {Pi} -> {
  let NN := Pi NatType ({_} -> NatType)
  let NNN := Pi NatType ({_} -> NN)
  ({ successor := NN succ, identity := NN ({n} -> n), duplicate := NN ({n} -> pair n n), curried_add := NNN add, const_first := NNN ({a} -> {b} -> a), const_second := NNN ({a} -> {b} -> b) })
}
fn_expected := { successor := true, identity := true, duplicate := false, curried_add := true, const_first := true, const_second := true }

elim_suite := {Pi} -> {
  let NN := Pi NatType ({_} -> NatType)
  let NB := Pi NatType ({_} -> BoolType)
  ({ fold := NN elim_id, after_constructor := NN ({n} -> succ (elim_id n)), on_constructor := NN ({n} -> elim_id (succ n)), step_discard := NN ({n} -> nat_rec (succ n) zero ({k, ih} -> zero)), composed := NN ({n} -> elim_id (elim_id n)), wrong_motive := NB elim_id, bad_base := NN ({n} -> nat_rec n false ({k, ih} -> false)), bad_step_on_constructor := NN ({n} -> nat_rec (succ n) zero ({k, ih} -> pair 5 5)) })
}
elim_expected := { fold := true, after_constructor := true, on_constructor := true, step_discard := true, composed := true, wrong_motive := false, bad_base := false, bad_step_on_constructor := false }

guard_suite := {Pi} -> {
  let NB := Pi NatType ({_} -> BoolType)
  let BB := Pi BoolType ({_} -> BoolType)
  ({ unblessed := NB ({n} -> unblessed_rec n true ({k, ih} -> true)), cross_type := BB ({b} -> elim_id b), forged_return := NB ({n} -> forge_hyp BoolType BoolType) })
}
guard_expected := { unblessed := false, cross_type := false, forged_return := false }

reader_suite := {Pi} -> {
  let BB := Pi BoolType ({_} -> BoolType)
  ({ sniff_junk := BB ({b} -> if (is_neutral b) { b } else { 5 }), concrete_read := BB ({b} -> if (is_neutral zero) { 5 } else { not_bool b }) })
}
reader_expected := { sniff_junk := false, concrete_read := true }

dep_suite := {Pi, D} -> {
  let DP := Pi D ({n} -> Point (succ n))
  ({ successor := DP succ, identity := DP ({n} -> n), doubled := DP ({n} -> succ (succ n)) })
}
dep_expected := { successor := true, identity := false, doubled := false }

ho_suite := {Pi} -> {
  let NN := Pi NatType ({_} -> NatType)
  let F := Pi NN ({_} -> NatType)
  let FF := Pi NN ({_} -> NN)
  ({
    apply_zero := F ({g} -> g zero)
    const_arg := F ({g} -> 5)
    ill_typed_frame := F ({g} -> g false)
    use_result := F ({g} -> succ (g zero))
    elim_on_spine := F ({g} -> nat_rec (g zero) zero ({k, ih} -> succ ih))
    bad_frame_under_elim := F ({g} -> nat_rec (g false) zero ({k, ih} -> succ ih))
    eta_arg := FF ({g} -> g)
    eta_expanded := FF ({g} -> {n} -> g n)
    succ_frame := F ({g} -> g (succ zero))
    neutral_in_frame := FF ({g} -> {n} -> g (succ n))
  })
}
ho_expected := { apply_zero := true, const_arg := true, ill_typed_frame := false, use_result := true, elim_on_spine := true, bad_frame_under_elim := false, eta_arg := true, eta_expanded := true, succ_frame := true, neutral_in_frame := true }
